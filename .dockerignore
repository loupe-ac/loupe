node_modules/
vendor/
var/
tests/
.claude/
.worktrees/
.phpunit.cache/
.serena/
e2e/
# Local override files hold real secrets. The prod image does `COPY . .` and the
# entrypoint runs `composer dump-env prod`, which merges .env.local — without
# these excludes a build would bake the builder's local credentials into the
# image and let them override real production environment variables.
.env.local
.env.*.local
# Same reasoning: the filled-in configuration for the reference production stack
# holds real secrets and must never be baked into the image it configures.
docker/compose/prod.env
.env.dev*
.env.test*
# Never ship the repository history (and its size) inside the runtime image.
.git/
.gitignore
.gitleaksignore
# Local-only skeleton sync state; records an absolute path on the dev's machine.
.skeleton.json
# Terraform state and tfvars hold APP_SECRET, database credentials and the
# registry token in plaintext. They are gitignored, but gitignore does not
# filter the Docker build context, so without this a local-state apply followed
# by a push would bake those secrets into published image layers.
terraform/
# Developer-local code index and the Go bridge CLI. The PHP runtime uses neither,
# except the install script that /install.sh serves. graft/ alone is ~14 MB.
graft/
cli/*
!cli/install.sh
# The docs build (the `docs` stage of docker/prod/Dockerfile) needs website/ and
# docs/, but not the 234 MB of node_modules and dist that a local build leaves.
website/node_modules/
website/dist/
website/.astro/
website/.env
.vite/
test-results/
.agents/
.superpowers/
skill-observations/
