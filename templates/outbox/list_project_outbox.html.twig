{% extends 'base.html.twig' %}

{% block title %}{{ 'outbox.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'outbox.page.title'|trans},
    ]" />
{% endblock %}

{% block body %}
<div class="lp-site-review-page">
    <header class="lp-site-review-header">
        <h1 class="lp-site-review-title">{{ 'outbox.page.title'|trans }}</h1>
        <p class="lp-site-review-description">{{ 'outbox.page.description'|trans }}</p>
        <p class="lp-site-review-meta-line">{{ 'outbox.count'|trans({'%count%': events|length}) }}</p>
    </header>

    {% if events|length > 0 %}
    <div class="lp-site-review-list">
        {% for event in events %}
            <article class="lp-site-review-item" data-outbox-event-id="{{ event.id }}">
                <span class="lp-site-review-index lp-site-review-index--pending">{{ '%02d'|format(loop.index) }}</span>
                <div class="lp-site-review-main">
                    <div class="lp-site-review-title-row">
                        <p class="lp-site-review-quote">{{ 'outbox.event_label'|trans({'%date%': event.createdAt|date('j M Y, H:i')}) }}</p>
                        <twig:Ds:StatusChip modifier="pending" class="shrink-0">{{ 'outbox.status.unsent'|trans }}</twig:Ds:StatusChip>
                    </div>

                    <div class="lp-site-review-context">
                        <span data-outbox-event-type>{{ event.type }}</span>
                        <span>{{ 'outbox.attempts'|trans({'%count%': event.publishAttempts}) }}</span>
                        <span>
                            {%- if event.nextAttemptAt is null -%}
                                {{ 'outbox.next_attempt.due_now'|trans }}
                            {%- else -%}
                                {{ 'outbox.next_attempt.scheduled'|trans({'%date%': event.nextAttemptAt|date('j M Y, H:i')}) }}
                            {%- endif -%}
                        </span>
                    </div>

                    {% if event.lastPublishError %}
                    <div class="lp-connect-alert">
                        <p class="lp-connect-alert__text">{{ event.lastPublishError }}</p>
                    </div>
                    {% endif %}
                </div>
            </article>
        {% endfor %}
    </div>
    {% else %}
    <twig:Ds:EmptyState icon="lucide:circle-check" iconClass="text-accent" :title="'outbox.empty'|trans" />
    {% endif %}
</div>
{% endblock %}
