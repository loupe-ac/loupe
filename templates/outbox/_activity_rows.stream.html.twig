{% for entry in view.entries %}
<turbo-stream action="replace" method="morph" target="activity-row-{{ entry.event.id }}">
    <template>{% include 'outbox/_activity_row.html.twig' with {entry: entry} only %}</template>
</turbo-stream>
{% endfor %}
{% for id in view.removedIds %}
<turbo-stream action="remove" target="activity-row-{{ id }}"></turbo-stream>
{% endfor %}
<turbo-stream action="update" target="activity-live-band">
    <template>
        {% if view.newerCount > 0 %}
        <twig:Ds:Flash severity="info" data-activity-live-newer>
            {{ 'activity.live.newer'|trans({'%count%': view.newerCount}) }}
            <twig:block name="actions"><a href="{{ path('app_project_activity', {id: project.id}|merge(listQuery.withPage(1).routeParams)) }}" data-activity-live-first-page>{{ 'activity.live.show_first_page'|trans }}</a></twig:block>
        </twig:Ds:Flash>
        {% endif %}
    </template>
</turbo-stream>
