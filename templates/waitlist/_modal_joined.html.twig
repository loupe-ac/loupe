<h2 class="lp-dialog-title lp-home-waitlist-dialog__title" id="waitlist-modal-title"{% if joinForm %} data-controller="analytics-join" data-analytics-join-form-value="{{ joinForm }}"{% endif %}>{{ 'account.waitlist.joined.title'|trans }}</h2>
<p class="lp-dialog-desc">{{ 'account.waitlist.joined.body'|trans }}</p>
{% include '_discord_card.html.twig' with {
    heading: 'account.waitlist.joined.community.heading'|trans,
    body: 'account.waitlist.joined.community.body'|trans,
    button: 'account.waitlist.joined.community.button'|trans,
    headingId: 'waitlist-modal-community',
} only %}
<twig:Ds:FormActions>
    <twig:Ds:Button type="button" data-action="click->modal#close">{{ 'landing.waitlist_dialog.close'|trans }}</twig:Ds:Button>
</twig:Ds:FormActions>
