{# The public pages' frame for a signed-out visitor: the site bar, the page body
   and the site footer. A signed-in visitor gets the app shell from base.html.twig.
   A page fills block body, and swaps the bar or the footer when it draws its own.
   It may set marketingAttributes outside any block. #}
{% extends 'base.html.twig' %}

{% block body_unauthenticated %}
<div class="lp-home"{% for name, value in marketingAttributes|default({}) %} {{ name }}="{{ value }}"{% endfor %}>
    {% block marketing_header %}
    {% include '@Landing/landing/_nav.html.twig' only %}
    {% endblock %}

    <main id="main-content" tabindex="-1">{% block marketing_main %}{{ block('body') }}{% endblock %}</main>

    {% block marketing_footer %}{% include '@Landing/landing/_footer.html.twig' only %}{% endblock %}
    {% block marketing_after %}{% endblock %}
</div>
{% endblock %}
