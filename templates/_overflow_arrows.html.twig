{# The two arrow buttons of an overflow-cue strip. They sit after the viewport inside the element that holds the overflow-cue controller. #}
<button type="button" class="lp-overflow-cue__arrow lp-overflow-cue__arrow--prev" data-overflow-cue-target="prev" data-action="overflow-cue#scrollPrev" aria-label="{{ 'tabs.scroll_prev'|trans }}">
    <twig:ux:icon name="lucide:chevron-left" class="lp-icon lp-icon--md" />
</button>
<button type="button" class="lp-overflow-cue__arrow lp-overflow-cue__arrow--next" data-overflow-cue-target="next" data-action="overflow-cue#scrollNext" aria-label="{{ 'tabs.scroll_next'|trans }}">
    <twig:ux:icon name="lucide:chevron-right" class="lp-icon lp-icon--md" />
</button>
