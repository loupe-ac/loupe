{% for label, messages in flashes %}
    {% for message in messages %}
    <twig:Ds:Flash :severity="label" :dismissLabel="'flash.dismiss'|trans" :data-flash-auto-dismiss-value="autoDismiss|default(false) and 'success' == label ? 5000 : false">{{ message|inline_code }}</twig:Ds:Flash>
    {% endfor %}
{% endfor %}
