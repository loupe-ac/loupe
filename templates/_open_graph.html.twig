<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ 'app.name'|trans }}">
<meta property="og:title" content="{% if '' != ogTitle %}{{ ogTitle|raw }}{% else %}{{ title|raw }}{% endif %}">
<meta property="og:description" content="{{ description|raw }}">
<meta property="og:url" content="{{ public_url(app.request.pathInfo) }}">
<meta property="og:image" content="{% if '' != image %}{{ image|raw }}{% else %}{{ public_url(og_image_path()) }}{% endif %}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{% if '' != imageAlt %}{{ imageAlt|raw }}{% else %}{{ 'landing.open_graph.image_alt'|trans }}{% endif %}">
<meta name="twitter:card" content="summary_large_image">
