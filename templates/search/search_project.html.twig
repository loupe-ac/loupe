{% extends 'base.html.twig' %}

{% block title %}{{ (project ? 'search.title' : 'search.all_title')|trans }} — {{ 'app.name'|trans }}{% endblock %}
{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: (project ? 'search.title' : 'search.all_title')|trans},
    ]" />
{% endblock %}

{% block body %}
<twig:Ds:Workspace>
    <twig:Ds:PageHeader :title="(project ? 'search.title' : 'search.all_title')|trans" :description="project ? 'search.scope'|trans({'%project%': project.name}) : 'search.all_scope'|trans" />
    {{ form_start(form, {action: (project ? path('app_project_search', {id: project.id}) : path('app_search_owned_projects')), attr: {class: 'lp-form'}}) }}
        <twig:Ds:FormField>
            {{ form_label(form.query, null, {label_attr: {class: ds_label_class()}}) }}
            {{ form_widget(form.query, {attr: {class: ds_input_class(), maxlength: 200, autofocus: true}}) }}
            <twig:Ds:FieldErrors>{{ form_errors(form.query) }}{{ form_errors(form.page) }}{{ form_errors(form) }}</twig:Ds:FieldErrors>
        </twig:Ds:FormField>
        <twig:Ds:Button variant="primary" type="submit">{{ 'search.submit'|trans }}</twig:Ds:Button>
    {{ form_end(form, {render_rest: false}) }}
    {% if view %}
    {% include 'search/_search_results.html.twig' with {project: project, view: view} only %}
    {% endif %}
</twig:Ds:Workspace>
{% endblock %}
