<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        {% if app.user %}<meta name="turbo-cache-control" content="no-preview">{% endif %}
        <title>{% block title %}{{ 'app.name'|trans }}{% endblock %}</title>
        {# block() returns text the block already escaped, so it is printed with |raw #}
        {% set pageDescription = block('description') is defined ? block('description')|trim : '' %}
        {% if '' != pageDescription %}
        <meta name="description" content="{{ pageDescription|raw }}">
        {% include '_open_graph.html.twig' with {title: block('title')|trim, description: pageDescription} only %}
        {% endif %}
        <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml">
        <link rel="icon" href="/icons/favicon-32.png" type="image/png" sizes="32x32">
        <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
        <link rel="manifest" href="/manifest.webmanifest">
        <meta name="theme-color" content="#181d18">
        {% block head_links %}{% endblock %}
        {# A plain <link>, not an `import` in app.js: AssetMapper turns a CSS
           import into a `data:application/javascript,` entry in the import map,
           which an enforcing script-src blocks outright. #}
        {% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/app.css') }}">{% endblock %}
        {% include '_sentry_browser.html.twig' only %}
        {% include '@Analytics/_script.html.twig' only %}
        {% block javascripts %}
            {# The importmap renders two inline <script> tags, which are the only
               inline scripts this app emits. Nonces are what will let script-src
               drop 'unsafe-inline' when the CSP moves from report to enforce;
               they are inert until then. csp_nonce() exists in every
               environment — see config/bundles.php. #}
            {% block importmap %}{{ importmap('app', {nonce: csp_nonce('script')}) }}{% endblock %}
        {% endblock %}
        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="{% block body_class %}{% endblock %}" data-reply-draft-owner="{{ app.user ? app.user.id : '' }}">
        <a class="lp-skip-link" href="#main-content" data-turbo="false">{{ 'nav.skip_to_content'|trans }}</a>
        {# The page's outermost chrome, and the only thing that decides whether
           the application shell is present. `base.html.twig` fills it with the
           sidebar shell; `@Account/auth_base.html.twig` fills it with a bare
           centred card. They are siblings on purpose: an auth page that
           extended the shell could only ever nest inside it. #}
        {% block page %}{% endblock %}
        {# A block so a page can swap what loads here. The widget guards itself
           against a second instance, so a page that loads its own replaces
           this one rather than sitting alongside it. #}
        {% block site_review_widget %}
        {% include '_site_review_widget.html.twig' only %}
        {% endblock %}
    </body>
</html>
