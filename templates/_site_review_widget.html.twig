{% if site_review_widget_project and (site_review_widget_public or is_granted('ROLE_ADMIN')) %}
<script src="{{ site_review_widget_backend|trim('/', 'right') }}/live-review/widget.js"
    data-project="{{ site_review_widget_project }}"
    {%- if site_review_widget_context %} data-context="{{ site_review_widget_context }}"{% endif %}
    {%- if site_review_widget_preview_token %} data-preview-token="{{ site_review_widget_preview_token }}"{% endif %}></script>
{% endif %}
