{#
  Props: width (default, narrow or full, optional). With a width the page also draws the Workspace frame.
  Other attributes, class included, go to the element.
  The page writes the lp-split-region, lp-split-view and lp-split-pane markup inside it.
#}
{%- props width = null -%}
<div{{ attributes.defaults({class: 'lp-split-page' ~ (width ? ' lp-workspace' ~ ('default' != width ? ' lp-workspace--' ~ width : '') : '')}) }}>{% block content %}{% endblock %}</div>
