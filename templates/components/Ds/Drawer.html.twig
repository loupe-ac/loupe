{#
  Props: loading (string, optional): the loading text. Set, the header stays, a loading line replaces the body, and the footer is left out.
  Other attributes, class included, go to the dialog, such as a controller target.
  The blocks header, body and footer each draw their band only when they hold content. The block content replaces all three.
#}
{%- props loading = null -%}
<dialog{{ attributes.defaults({class: 'lp-drawer'}) }}>
    {%- block content -%}
        {%- set headerContent -%}{% block header %}{% endblock %}{%- endset -%}
        {%- set bodyContent -%}{% if loading %}<p class="lp-drawer__loading" role="status"><twig:ux:icon name="lucide:loader-circle" class="lp-icon lp-icon--lg" />{{ loading }}</p>{% else %}{% block body %}{% endblock %}{% endif %}{%- endset -%}
        {%- set footerContent -%}{% if not loading %}{% block footer %}{% endblock %}{% endif %}{%- endset -%}
        {%- if headerContent|trim %}<header class="lp-drawer__header">{{ headerContent }}</header>{% endif -%}
        {%- if bodyContent|trim %}<div class="lp-drawer__body">{{ bodyContent }}</div>{% endif -%}
        {%- if footerContent|trim %}<footer class="lp-drawer__footer">{{ footerContent }}</footer>{% endif -%}
    {%- endblock -%}
</dialog>
