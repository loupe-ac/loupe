<div class="lp-experiment-heading">
    <a class="lp-experiment-heading__back" href="{{ path('app_project_analytics_experiments', {id: project.id}) }}">{{ 'bridge.experiments.back'|trans }}</a>
    <h2 class="lp-experiment-heading__name">{{ experiment }}</h2>
    {% if archived %}<twig:Ds:Tag data-experiment-archived>{{ 'bridge.experiments.archived'|trans }}</twig:Ds:Tag>{% endif %}
    {% if is_granted(constant('App\\Module\\Project\\Security\\ProjectVoter::MANAGE'), project) %}
    <twig:Ds:ActionForm class="lp-experiment-heading__archive"
        :action="path(archived ? 'app_project_analytics_experiment_unarchive' : 'app_project_analytics_experiment_archive', {id: project.id, experiment: experiment})"
        :token="archived ? 'experiment-unarchive' : 'experiment-archive'">
        <twig:Ds:Button type="submit" variant="outline" size="sm" data-experiment-archive-toggle>{{ (archived ? 'bridge.experiments.unarchive_action' : 'bridge.experiments.archive_action')|trans }}</twig:Ds:Button>
    </twig:Ds:ActionForm>
    {% endif %}
</div>
<twig:Ds:Tabs class="lp-experiment-tabs" aria-label="{{ 'bridge.experiments.tabs.label'|trans }}">
    <a class="lp-tabs__tab"
       href="{{ path('app_project_analytics_experiment', {id: project.id, experiment: experiment}) }}"
       {% if active == 'comparison' %}aria-current="page"{% endif %}>{{ 'bridge.experiments.tabs.comparison'|trans }}</a>
    <a class="lp-tabs__tab"
       href="{{ path('app_project_analytics_experiment_cards', {id: project.id, experiment: experiment}) }}"
       {% if active == 'cards' %}aria-current="page"{% endif %}>{{ 'bridge.experiments.tabs.cards'|trans }}</a>
</twig:Ds:Tabs>
