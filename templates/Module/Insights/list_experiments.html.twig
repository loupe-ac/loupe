{% extends 'base.html.twig' %}

{% block title %}{{ 'analytics.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'analytics.page.title'|trans},
    ]" />
{% endblock %}

{% block body %}
<twig:Ds:Workspace class="lp-redesign-secondary lp-redesign-runs">
    {% include '@Insights/_header.html.twig' with {} only %}

    {% include '@Insights/_tabs.html.twig' with {project: project, active: 'experiments'} only %}

    {% set canManage = is_granted(constant('App\\Module\\Project\\Security\\ProjectVoter::MANAGE'), project) %}
    {% if archivedCount > 0 or includeArchived %}
    <twig:Ds:FilterBar
        :action="path('app_project_analytics_experiments', {id: project.id})"
        :switch="{name: 'archived', label: 'bridge.experiments.show_archived'|trans, checked: includeArchived, attributes: {'data-experiment-archived-toggle': true}}"
        :count="'bridge.experiments.count'|trans({'%count%': experiments|length})"
        :countAttributes="{'data-experiment-count': true}" />
    {% endif %}

    {% if experiments is not empty %}
    <twig:Ds:DataTable modifier="experiments" :label="'bridge.experiments.table.label'|trans" :columns="[
        {label: 'bridge.experiments.column.experiment'|trans},
        {label: 'bridge.experiments.column.cards'|trans, align: 'end'},
        {label: 'bridge.experiments.column.last_run'|trans},
        {label: 'bridge.experiments.column.actions'|trans, srOnly: true},
    ]">
        {% for experiment in experiments %}
        <div class="lp-data-table__row{% if experiment.archived %} lp-document-row--archived{% endif %}" role="row" data-experiment="{{ experiment.name }}">
            <div class="lp-data-table__cell lp-data-table__primary" role="cell">
                <a class="lp-data-table__target" href="{{ path('app_project_analytics_experiment', {id: project.id, experiment: experiment.name}) }}">
                    <span class="lp-data-table__title" data-experiment-name>{{ experiment.name }}</span>
                </a>
            </div>
            <span class="lp-data-table__cell lp-data-table__cell--end" role="cell" data-experiment-cards>{{ 'bridge.experiments.card_count'|trans({'%count%': experiment.cards}) }}</span>
            <span class="lp-data-table__cell" role="cell">
                {% if experiment.lastRunAt is not null %}
                    <twig:Ds:RelativeTime :datetime="experiment.lastRunAt" />
                {% else %}
                    {{ 'bridge.experiments.no_run'|trans }}
                {% endif %}
            </span>
            <div class="lp-data-table__cell lp-document-row__actions" role="cell">
                {% if canManage %}
                {# Both states are written out, because the icon importer sees only literal names. #}
                <form method="post" class="lp-document-row__action-form"
                      action="{{ path(experiment.archived ? 'app_project_analytics_experiment_unarchive' : 'app_project_analytics_experiment_archive', {id: project.id, experiment: experiment.name}) }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token(experiment.archived ? 'experiment-unarchive' : 'experiment-archive') }}">
                    <input type="hidden" name="from" value="list">
                    {% if includeArchived %}<input type="hidden" name="archived" value="1">{% endif %}
                    <button type="submit" class="lp-document-row__action" data-experiment-row-archive
                            aria-label="{{ (experiment.archived ? 'bridge.experiments.unarchive' : 'bridge.experiments.archive')|trans({'%name%': experiment.name}) }}">
                        {% if experiment.archived %}
                        <twig:ux:icon name="lucide:archive-restore" class="lp-icon lp-icon--md" />
                        {% else %}
                        <twig:ux:icon name="lucide:archive" class="lp-icon lp-icon--md" />
                        {% endif %}
                    </button>
                </form>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </twig:Ds:DataTable>
    {% elseif includeArchived %}
    <twig:Ds:EmptyState icon="lucide:archive" :title="'bridge.experiments.archived_empty.title'|trans" :body="'bridge.experiments.archived_empty.description'|trans" data-experiments-archived-empty>
        <twig:Ds:Button href="{{ path('app_project_analytics_experiments', {id: project.id}) }}" data-experiments-archived-empty-back>{{ 'bridge.experiments.archived_empty.back'|trans }}</twig:Ds:Button>
    </twig:Ds:EmptyState>
    {% elseif archivedCount > 0 %}
    <twig:Ds:EmptyState icon="lucide:archive" :title="'bridge.experiments.all_archived.title'|trans" :body="'bridge.experiments.all_archived.description'|trans" data-experiments-all-archived>
        <twig:Ds:Button href="{{ path('app_project_analytics_experiments', {id: project.id, archived: 1}) }}" data-experiments-all-archived-show>{{ 'bridge.experiments.show_archived'|trans }}</twig:Ds:Button>
    </twig:Ds:EmptyState>
    {% else %}
    <twig:Ds:EmptyState icon="lucide:chart-column" :title="'bridge.experiments.empty.title'|trans" :body="'bridge.experiments.empty.description'|trans" linkHref="{{ app_docs_url }}/extending/cli-bridge/#experiments" :linkLabel="'bridge.experiments.empty.docs'|trans" data-experiments-empty />
    {% endif %}
</twig:Ds:Workspace>
{% endblock %}
