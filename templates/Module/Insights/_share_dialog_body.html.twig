{# The part of the share dialog that a share changes. The share stream replaces it. Props: graph (InsightsSavedGraph), share (PublicLinkShareView), error (string or null). #}
{% set shareForm = dashboard_graph_share_form(graph, share) %}
<div class="lp-dashboard-share__body" id="share-graph-body-{{ graph.id }}">
    {% if share.block is not null %}
        <twig:Ds:Flash severity="warning">{{ share.block.translationKey|trans }}</twig:Ds:Flash>
    {% elseif error is not empty %}
        <twig:Ds:Flash severity="error">{{ error }}</twig:Ds:Flash>
    {% endif %}
    {{ form_start(shareForm, {attr: {'class': 'lp-dashboard-share__form', 'data-controller': 'submit-on-change', 'data-action': 'change->submit-on-change#submit'}}) }}
        <twig:Ds:Switch :fieldView="shareForm.enabled" :help="'insights.form.share_graph_form.enabled.help'|trans" />
    {{ form_end(shareForm) }}
    {% if share.isEnabled %}
        {% set linkUrl = public_link_url(share.link.code) %}
        <div class="lp-dashboard-share__link">
            <twig:Ds:Input type="text" readonly="readonly" :value="linkUrl" :aria-label="'insights.public_link.dialog.link'|trans" />
            <twig:Ds:CopyButton :text="linkUrl" :label="'insights.public_link.dialog.copy'|trans" :copiedLabel="'insights.public_link.dialog.copied'|trans" buttonVariant="primary" />
        </div>
        <p class="lp-dialog-desc">{{ 'insights.public_link.dialog.note'|trans }}</p>
    {% endif %}
</div>
