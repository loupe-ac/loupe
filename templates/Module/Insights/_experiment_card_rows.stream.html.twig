{% for id in ids %}
{% if cards[id] is defined %}
<turbo-stream action="replace" method="morph" target="experiment-card-{{ id }}"><template>{% include '@Insights/_experiment_card_row.html.twig' with {card: cards[id], project: project} only %}</template></turbo-stream>
{% else %}
<turbo-stream action="remove" target="experiment-card-{{ id }}"></turbo-stream>
{% endif %}
{% endfor %}
<turbo-stream action="update" target="experiment-cards-newer"><template>{% include '@Insights/_newer_band.html.twig' with {count: newer, label: 'insights.live.newer_cards', href: firstPage} only %}</template></turbo-stream>
<turbo-stream action="replace" method="morph" target="experiment-cards-filter"><template>{% include '@Insights/_experiment_cards_filter.html.twig' with {report: report, query: query, routeParams: routeParams} only %}</template></turbo-stream>
