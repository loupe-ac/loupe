{# The controls table of an experiment. Props: headline (ExperimentHeadline), text (ExperimentHeadlineText). #}
    {% if headline.controls is not empty %}
        <h3 class="lp-experiment-section">{{ 'bridge.experiments.controls.heading'|trans }}</h3>
        <div class="lp-experiment-table lp-overflow-cue lp-overflow-cue--scroll lp-table-cue" data-controller="overflow-cue">
<div class="lp-experiment-table__scroll" data-overflow-cue-target="viewport">
<table class="lp-experiment-table__table" data-experiment-controls>
                <thead>
                    <tr>
                        <th scope="col">{{ 'bridge.experiments.controls.control'|trans }}</th>
                        <th scope="col">{{ 'bridge.experiments.controls.variant'|trans }}</th>
                        <th scope="col" class="lp-experiment-table__number">{{ 'bridge.experiments.controls.passing'|trans }}</th>
                        <th scope="col" class="lp-experiment-table__number">{{ 'bridge.experiments.controls.needs'|trans }}</th>
                        <th scope="col" class="lp-experiment-table__number">{{ 'bridge.experiments.controls.with_data'|trans }}</th>
                        <th scope="col">{{ 'bridge.experiments.controls.result'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for control in headline.controls %}
                        <tr data-experiment-control="{{ control.metric }}" data-experiment-control-variant="{{ control.variant }}" data-experiment-control-result="{{ control.result.value }}">
                            <th scope="row">{{ text.controlLabel(control) }}</th>
                            <td>{{ control.variant }}</td>
                            <td class="lp-experiment-table__number">{{ control.passingShare is null ? '–' : text.share(control.passingShare) }}</td>
                            <td class="lp-experiment-table__number">{{ text.share(control.share) }}</td>
                            <td class="lp-experiment-table__number">{{ control.result.value == 'unknown-metric' ? '–' : 'bridge.experiments.controls.cards'|trans({'%with%': control.cardsWithData, '%finished%': control.cardsFinished}) }}</td>
                            <td>
                                {% if control.result.value == 'passed' %}
                                    <twig:Ds:StatusChip modifier="ok" :label="'bridge.experiments.controls.result.passed'|trans" />
                                {% elseif control.result.value == 'failed' %}
                                    <twig:Ds:StatusChip modifier="failed" :label="'bridge.experiments.controls.result.failed'|trans" />
                                {% else %}
                                    <twig:Ds:StatusChip modifier="neutral" :label="'bridge.experiments.controls.result.no_data'|trans" />
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
</div>
{% include '_overflow_arrows.html.twig' only %}
</div>
    {% endif %}
