{% extends '@Insights/public/public_base.html.twig' %}

{% block title %}{{ 'analytics.public.title'|trans({'%graph%': view.itemName, '%project%': view.project.name}) }} — {{ 'app.name'|trans }}{% endblock %}

{% block description %}{{ view.description }}{% endblock %}

{% block og_title %}{{ view.itemName }} · {{ view.project.name }}{% endblock %}

{% block og_image %}{{ public_url(path('app_public_link_preview', {code: view.code})) ~ '?v=' ~ view.previewVersion }}{% endblock %}

{% block og_image_alt %}{{ 'insights.public_link.preview.image_alt'|trans({'%name%': view.itemName, '%project%': view.project.name}) }}{% endblock %}

{% block public_bar %}
    {% set takedownUrl = public_link_takedown_url(view.code) %}
    {% if takedownUrl is not null %}
        <div class="lp-public__admin-bar" data-admin-bar>
            <span>{{ 'insights.public_link.admin_bar.text'|trans }}</span>
            <twig:Ds:Button variant="outline" size="sm" href="{{ takedownUrl }}" data-turbo="false">{{ 'insights.public_link.admin_bar.action'|trans }}</twig:Ds:Button>
        </div>
    {% endif %}
{% endblock %}

{% block public_body %}
    {% set computedAt = view.isExperiment ? view.experiment.computedAt : (view.result ? view.result.computedAt : null) %}
    <div class="lp-public__item" data-controller="dashboard-age" data-dashboard-age-now-value="{{ date().timestamp }}" data-dashboard-age-texts-value="{{ dashboard_age_texts()|json_encode }}">
        <p class="lp-public__project">{{ view.project.name }}</p>
        {% if view.isExperiment %}
            {% include '@Insights/public/_public_experiment.html.twig' with {experiment: view.experiment, noteHtml: view.noteHtml} only %}
        {% else %}
            {% include '@Insights/public/_public_graph.html.twig' with {graph: view.graph, result: view.result, settings: view.description} only %}
        {% endif %}
        <div class="lp-public__meta">
            <span data-dashboard-age-target="line"{% if computedAt is null %} hidden{% endif %}>
                {%- if computedAt is not null -%}
                    {{ dashboard_age_text((date().timestamp - computedAt.timestamp)) }}
                {%- endif -%}
            </span>
            <a href="{{ site_url('/') }}" data-turbo="false" class="lp-public__made-with">{{ 'analytics.public.made_with'|trans }}</a>
        </div>
    </div>
{% endblock %}
