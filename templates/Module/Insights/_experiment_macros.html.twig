{% macro amount(value, format) %}
    {%- if format == 'percent' -%}
        {{ value|format_percent_number }}
    {%- elseif format == 'currency' -%}
        {{ value|format_currency('USD') }}
    {%- elseif format == 'integer' -%}
        {{ value|number_format(0) }}
    {%- elseif format == 'minutes' -%}
        {{ (value / 60000)|number_format(1) }}
    {%- else -%}
        {{ value|number_format(1) }}
    {%- endif -%}
{% endmacro %}

{% macro metric_row(metric, label, format, variants, part) %}
    <tr {% if part %}class="lp-experiment-table__part" data-metric-part="{{ metric.key }}"{% else %}data-metric="{{ metric.key }}"{% endif %}>
        <th scope="row">
            {{ label }}
            {% if metric.clear is same as(false) %}<span data-metric-unclear><twig:Ds:StatusChip modifier="neutral" :label="'bridge.experiments.too_few_cards'|trans" /></span>{% endif %}
        </th>
        {% for variant in variants %}
            {% set interval = metric.for(variant.name) %}
            {% if interval is null %}
                <td class="lp-experiment-table__number">–</td>
                <td class="lp-experiment-table__number">–</td>
            {% else %}
                <td class="lp-experiment-table__number">{{ _self.amount(interval.point, format) }}</td>
                <td class="lp-experiment-table__number lp-experiment-table__range">{{ 'bridge.experiments.range'|trans({'%low%': _self.amount(interval.low, format), '%high%': _self.amount(interval.high, format)}) }}</td>
            {% endif %}
        {% endfor %}
    </tr>
{% endmacro %}

{# The result chip of one comparison. Props: comparison (ExperimentComparison), text (ExperimentHeadlineText), baselineArm (ExperimentArm). #}
{% macro goal_chip(comparison, text, baselineArm) %}
    {% if comparison.state.value == 'held' %}
        {% if comparison.hold.reason.value == 'failed' %}
            <twig:Ds:StatusChip modifier="failed" :label="'bridge.experiments.goal.hold.chip_failed'|trans" />
        {% else %}
            <twig:Ds:StatusChip modifier="neutral" :label="'bridge.experiments.controls.result.no_data'|trans" />
        {% endif %}
    {% elseif comparison.state.value == 'not-enough-cards' %}
        <twig:Ds:StatusChip modifier="neutral" :label="text.needs(comparison, baselineArm)" />
    {% elseif comparison.state.value == 'clear' %}
        <twig:Ds:StatusChip modifier="ok" :label="'bridge.experiments.goal.state.clear'|trans" />
    {% else %}
        <twig:Ds:StatusChip modifier="pending" :label="'bridge.experiments.goal.state.not_clear'|trans" />
    {% endif %}
{% endmacro %}
