{% extends 'base.html.twig' %}

{% block title %}{{ report.experiment }} — {{ 'bridge.experiments.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'analytics.page.title'|trans},
    ]" />
{% endblock %}

{% block body %}
{% set headline = report.headline %}
<twig:Ds:Workspace class="lp-redesign-secondary lp-redesign-runs">
    {% include '@Insights/_header.html.twig' with {} only %}

    {% include '@Insights/_tabs.html.twig' with {project: project, active: 'experiments'} only %}

    {% include '@Insights/_experiment_tabs.html.twig' with {project: project, experiment: report.experiment, active: 'comparison', archived: report.archived} only %}

    {% set text = experiment_headline_text() %}
    {% if headline is not null %}
        {% include '@Insights/_experiment_goal.html.twig' with {headline: headline, text: text} only %}

        {% include '@Insights/_experiment_controls.html.twig' with {headline: headline, text: text} only %}

        {% include '@Insights/_experiment_guards.html.twig' with {headline: headline, text: text} only %}
    {% endif %}
    {% if report.unknownGuards is not empty %}
        <p class="lp-experiment-note" data-experiment-unknown-guards>{{ 'bridge.experiments.guards.unknown'|trans({'%metrics%': report.unknownGuards|map(key => '<code class="lp-experiment-config-key">' ~ key|e ~ '</code>')|join(', ')})|raw }}</p>
    {% endif %}

    {% include '@Insights/_experiment_variants.html.twig' with {variants: report.variants, headline: headline} only %}

    {% include '@Insights/_experiment_metrics.html.twig' with {metrics: report.metrics, variants: report.variants, headline: headline, text: text, unknownMetrics: report.unknownMetrics} only %}


    <p class="lp-experiment-note" data-experiment-left-out>
        {{ 'bridge.experiments.left_out'|trans({'%count%': report.leftOutCards}) }}
        {% if report.leftOutCards > 0 %}
            <a href="{{ path('app_project_analytics_experiment_cards', {id: project.id, experiment: report.experiment, 'left-out': 1}) }}">{{ 'bridge.experiments.left_out_link'|trans }}</a>
        {% endif %}
    </p>

    {% if is_granted(constant('App\\Module\\Project\\Security\\ProjectVoter::MANAGE'), project) %}
        <p class="lp-experiment-note">
            <twig:Ds:Button variant="outline" size="sm" href="{{ path('app_project_analytics_reports', {id: project.id, topic: 'experiment', experiment: report.experiment}) }}" data-experiment-analyse>{{ 'bridge.experiments.analyse'|trans }}</twig:Ds:Button>
        </p>
    {% endif %}
</twig:Ds:Workspace>
{% endblock %}
