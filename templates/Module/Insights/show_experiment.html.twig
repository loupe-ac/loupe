{% extends 'base.html.twig' %}

{% block title %}{{ report.experiment }} — {{ 'bridge.experiments.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'analytics.page.title'|trans},
    ]" />
{% endblock %}

{% block body %}
{% set knownReasons = ['conflict', 'checks-failed', 'changes-requested', 'agent-review'] %}
{% set headline = report.headline %}
<twig:Ds:Workspace class="lp-redesign-secondary lp-redesign-runs">
    {% import '@Insights/_experiment_macros.html.twig' as experimentRows %}
    {% include '@Insights/_header.html.twig' with {} only %}

    {% include '@Insights/_tabs.html.twig' with {project: project, active: 'experiments'} only %}

    {% include '@Insights/_experiment_tabs.html.twig' with {project: project, experiment: report.experiment, active: 'comparison'} only %}

    {% if headline is not null %}
        {% set text = experiment_headline_text() %}
        {% set goal = headline.goal %}
        {% set floor = constant('App\\Module\\Bridge\\Experiment\\Stats::MIN_FINISHED_CARDS') %}
        {% for comparison in headline.comparisons %}
        {% set baselineArm = headline.baselineArm %}
        {% set firstComparison = loop.first %}
        {% set ordered = text.leads(goal, comparison, baselineArm) ? [comparison.arm, baselineArm] : [baselineArm, comparison.arm] %}
        <twig:Ds:Panel as="section" aria-label="{{ 'bridge.experiments.goal.heading'|trans }}" data-experiment-goal data-experiment-goal-state="{{ comparison.state.value }}">
            <div class="lp-experiment-goal">
                {% if comparison.state.value == 'held' %}
                    {% set goalName = goal.metric.shape is null ? goal.metric.key : (goal.metric.label ?? ('bridge.experiments.metric.' ~ goal.metric.key)|trans) %}
                    <p class="lp-experiment-goal__label">{{ goal.direction is null ? 'bridge.experiments.goal.label_plain'|trans({'%metric%': goalName}) : 'bridge.experiments.goal.label'|trans({'%metric%': goalName, '%direction%': ('bridge.experiments.goal.' ~ goal.direction.value)|trans}) }}</p>
                    <div class="lp-experiment-goal__answer">
                        <p class="lp-experiment-goal__sentence" data-experiment-goal-sentence>{{ text.holdSentence(comparison) }}</p>
                        {% if comparison.hold.reason.value == 'failed' %}
                            <twig:Ds:StatusChip modifier="failed" :label="'bridge.experiments.goal.hold.chip_failed'|trans" />
                        {% else %}
                            <twig:Ds:StatusChip modifier="neutral" :label="'bridge.experiments.controls.result.no_data'|trans" />
                        {% endif %}
                    </div>
                    <p class="lp-experiment-goal__detail" data-experiment-goal-hold="{{ comparison.hold.reason.value }}">{{ text.holdDetail(goal, comparison, baselineArm) }}</p>
                {% elseif comparison.state.value in ['unknown-metric', 'no-direction'] %}
                    {% if firstComparison %}<p class="lp-experiment-goal__sentence lp-experiment-goal__sentence--small" data-experiment-goal-problem>{{ ('bridge.experiments.goal.problem.' ~ comparison.state.value)|trans({'%metric%': '<code class="lp-experiment-config-key">' ~ goal.metric.key|e ~ '</code>', '%lower%': '<code class="lp-experiment-config-key">' ~ 'better: lower</code>', '%higher%': '<code class="lp-experiment-config-key">' ~ 'better: higher</code>'})|raw }}</p>{% endif %}
                {% else %}
                    {% set goalLabel = goal.metric.label ?? ('bridge.experiments.metric.' ~ goal.metric.key)|trans %}
                    <p class="lp-experiment-goal__label">{{ 'bridge.experiments.goal.label'|trans({'%metric%': goalLabel, '%direction%': ('bridge.experiments.goal.' ~ goal.direction.value)|trans}) }}</p>
                    {% if comparison.state.value == 'not-enough-cards' %}
                        <p class="lp-experiment-goal__sentence lp-experiment-goal__sentence--small" data-experiment-goal-sentence>{{ text.sentence(goal, comparison, baselineArm) }}</p>
                        <p class="lp-experiment-goal__detail" data-experiment-goal-progress>
                            {%- for arm in [baselineArm, comparison.arm] -%}
                                {%- if not loop.first %} · {% endif -%}
                                {{ arm.variant }} <span class="lp-experiment-guards__value">{{ 'bridge.experiments.goal.progress'|trans({'%done%': min(arm.finishedCards, floor), '%floor%': floor}) }}</span> {{ 'bridge.experiments.goal.finished'|trans }}
                            {%- endfor -%}
                        </p>
                    {% else %}
                        <div class="lp-experiment-goal__answer">
                            <p class="lp-experiment-goal__sentence" data-experiment-goal-sentence>{{ text.sentence(goal, comparison, baselineArm) }}</p>
                            {% if comparison.state.value == 'clear' %}
                                <twig:Ds:StatusChip modifier="ok" :label="'bridge.experiments.goal.state.clear'|trans" />
                            {% else %}
                                <twig:Ds:StatusChip modifier="pending" :label="'bridge.experiments.goal.state.not_clear'|trans" />
                            {% endif %}
                        </div>
                        {% set firstPoint = text.point(goal.metric, ordered[0].point) %}
                        {% set secondPoint = text.point(goal.metric, ordered[1].point) %}
                        {% set goalRange = text.range(comparison) %}
                        {% if firstPoint is not null and secondPoint is not null %}
                            <p class="lp-experiment-goal__detail" data-experiment-goal-detail>
                                <span class="lp-experiment-guards__value">{{ firstPoint }}</span> {{ 'bridge.experiments.goal.against'|trans }} <span class="lp-experiment-guards__value">{{ secondPoint }}</span>
                                {%- if goalRange is not null %} · {{ 'bridge.experiments.goal.range_label'|trans }} <span class="lp-experiment-guards__range">{{ goalRange }}</span>{% endif -%}
                            </p>
                        {% endif %}
                    {% endif %}
                {% endif %}
            </div>
        </twig:Ds:Panel>
        {% endfor %}

        {% if headline.controls is not empty %}
            <h3 class="lp-experiment-section">{{ 'bridge.experiments.controls.heading'|trans }}</h3>
            <div class="lp-experiment-table lp-overflow-cue lp-overflow-cue--scroll lp-table-cue" data-controller="overflow-cue">
<div class="lp-experiment-table__scroll" data-overflow-cue-target="viewport">
<table class="lp-experiment-table__table" data-experiment-controls>
                    <thead>
                        <tr>
                            <th scope="col">{{ 'bridge.experiments.controls.control'|trans }}</th>
                            <th scope="col">{{ 'bridge.experiments.controls.variant'|trans }}</th>
                            <th scope="col" class="lp-experiment-table__number">{{ 'bridge.experiments.controls.passing'|trans }}</th>
                            <th scope="col" class="lp-experiment-table__number">{{ 'bridge.experiments.controls.needs'|trans }}</th>
                            <th scope="col" class="lp-experiment-table__number">{{ 'bridge.experiments.controls.with_data'|trans }}</th>
                            <th scope="col">{{ 'bridge.experiments.controls.result'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for control in headline.controls %}
                            <tr data-experiment-control="{{ control.metric }}" data-experiment-control-variant="{{ control.variant }}" data-experiment-control-result="{{ control.result.value }}">
                                <th scope="row">{{ text.controlLabel(control) }}</th>
                                <td>{{ control.variant }}</td>
                                <td class="lp-experiment-table__number">{{ control.passingShare is null ? '–' : text.share(control.passingShare) }}</td>
                                <td class="lp-experiment-table__number">{{ text.share(control.share) }}</td>
                                <td class="lp-experiment-table__number">{{ control.result.value == 'unknown-metric' ? '–' : 'bridge.experiments.controls.cards'|trans({'%with%': control.cardsWithData, '%finished%': control.cardsFinished}) }}</td>
                                <td>
                                    {% if control.result.value == 'passed' %}
                                        <twig:Ds:StatusChip modifier="ok" :label="'bridge.experiments.controls.result.passed'|trans" />
                                    {% elseif control.result.value == 'failed' %}
                                        <twig:Ds:StatusChip modifier="failed" :label="'bridge.experiments.controls.result.failed'|trans" />
                                    {% else %}
                                        <twig:Ds:StatusChip modifier="neutral" :label="'bridge.experiments.controls.result.no_data'|trans" />
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
</div>
{% include '_overflow_arrows.html.twig' only %}
</div>
        {% endif %}

        {% if headline.guards is not empty %}
        {% for comparison in headline.comparisons %}
            <h3 class="lp-experiment-section">{{ 'bridge.experiments.guards.heading'|trans }}</h3>
            <div class="lp-experiment-table lp-overflow-cue lp-overflow-cue--scroll lp-table-cue" data-controller="overflow-cue">
<div class="lp-experiment-table__scroll" data-overflow-cue-target="viewport">
<table class="lp-experiment-table__table" data-experiment-guards>
                    <thead>
                        <tr>
                            <th scope="col">{{ 'bridge.experiments.guards.guard'|trans }}</th>
                            <th scope="col" class="lp-experiment-table__number">{{ 'bridge.experiments.guards.change'|trans({'%from%': headline.baseline, '%to%': comparison.variant}) }}</th>
                            <th scope="col" class="lp-experiment-table__number">{{ 'bridge.experiments.guards.likely_range'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for guard in headline.guards %}
                            {% set guardChange = comparison.guards[loop.index0] %}
                            <tr data-experiment-guard="{{ guard.metric.key }}">
                                <th scope="row">{{ guard.metric.label ?? ('bridge.experiments.metric.' ~ guard.metric.key)|trans }}</th>
                                <td class="lp-experiment-table__number">{{ text.guardChange(guard, guardChange) ?? '–' }}</td>
                                <td class="lp-experiment-table__number lp-experiment-table__range">{{ text.guardRange(guard, guardChange) ?? '–' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
</div>
{% include '_overflow_arrows.html.twig' only %}
</div>
        {% endfor %}
        {% endif %}
    {% endif %}
    {% if report.unknownGuards is not empty %}
        <p class="lp-experiment-note" data-experiment-unknown-guards>{{ 'bridge.experiments.guards.unknown'|trans({'%metrics%': report.unknownGuards|map(key => '<code class="lp-experiment-config-key">' ~ key|e ~ '</code>')|join(', ')})|raw }}</p>
    {% endif %}

    <h3 class="lp-experiment-section">{{ 'bridge.experiments.variants.heading'|trans }}</h3>
    <div class="lp-experiment-table lp-overflow-cue lp-overflow-cue--scroll lp-table-cue" data-controller="overflow-cue">
<div class="lp-experiment-table__scroll" data-overflow-cue-target="viewport">
<table class="lp-experiment-table__table" data-experiment-variants>
            <thead>
                <tr>
                    <th scope="col">{{ 'bridge.experiments.variants.variant'|trans }}</th>
                    <th scope="col">{{ 'bridge.experiments.variants.model'|trans }}</th>
                    <th scope="col" class="lp-experiment-table__number">{{ 'bridge.experiments.variants.weight'|trans }}</th>
                    <th scope="col" class="lp-experiment-table__number">{{ 'bridge.experiments.variants.cards'|trans }}</th>
                    <th scope="col" class="lp-experiment-table__number">{{ 'bridge.experiments.variants.finished'|trans }}</th>
                    <th scope="col" class="lp-experiment-table__number">{{ 'bridge.experiments.variants.runs'|trans }}</th>
                    <th scope="col" class="lp-experiment-table__number">{{ 'bridge.experiments.variants.covered_cost'|trans }}</th>
                    <th scope="col" class="lp-experiment-table__number">{{ 'bridge.experiments.variants.cost'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for variant in report.variants %}
                    <tr data-experiment-variant="{{ variant.name }}">
                        <th scope="row">{{ variant.name }}</th>
                        <td>{{ variant.models is empty ? '–' : variant.models|join(', ') }}</td>
                        <td class="lp-experiment-table__number">{{ variant.weight ?? '–' }}</td>
                        <td class="lp-experiment-table__number">{{ variant.cards }}</td>
                        <td class="lp-experiment-table__number">{{ variant.finishedCards }}</td>
                        <td class="lp-experiment-table__number">{{ variant.runs }}</td>
                        <td class="lp-experiment-table__number">{{ variant.coveredCostMicros is null ? '–' : (variant.coveredCostMicros / 1000000)|format_currency('USD') }}</td>
                        <td class="lp-experiment-table__number">{{ variant.costMicros is null ? '–' : (variant.costMicros / 1000000)|format_currency('USD') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
</div>
{% include '_overflow_arrows.html.twig' only %}
</div>

    <h3 class="lp-experiment-section">{{ 'bridge.experiments.metrics.heading'|trans }}</h3>
    <div class="lp-experiment-table lp-overflow-cue lp-overflow-cue--scroll lp-table-cue" data-controller="overflow-cue">
<div class="lp-experiment-table__scroll" data-overflow-cue-target="viewport">
<table class="lp-experiment-table__table" data-experiment-metrics>
            <thead>
                <tr>
                    <th scope="col">{{ 'bridge.experiments.metrics.metric'|trans }}</th>
                    {% for variant in report.variants %}
                        <th scope="col" class="lp-experiment-table__number">{{ variant.name }}</th>
                        <th scope="col" class="lp-experiment-table__number">{{ 'bridge.experiments.metrics.likely_range'|trans }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for metric in report.metrics %}
                    {% set format = metric.format %}
                    {{ experimentRows.metric_row(metric, metric.label ?? ('bridge.experiments.metric.' ~ metric.key)|trans, format, report.variants, false) }}
                    {% for part in metric.parts %}
                        {{ experimentRows.metric_row(part, part.label ?? (part.key in knownReasons ? ('bridge.experiments.fix_reason.' ~ part.key)|trans : 'bridge.experiments.fix_reason.other'|trans({'%reason%': part.key})), format, report.variants, true) }}
                    {% endfor %}
                {% endfor %}
            </tbody>
        </table>
</div>
{% include '_overflow_arrows.html.twig' only %}
</div>
    {% if report.unknownMetrics is not empty %}
        <p class="lp-experiment-note" data-experiment-unknown-metrics>{{ 'bridge.experiments.metrics.unknown'|trans({'%metrics%': report.unknownMetrics|map(key => '<code class="lp-experiment-config-key">' ~ key|e ~ '</code>')|join(', ')})|raw }}</p>
    {% endif %}
    <p class="lp-experiment-note">{{ 'bridge.experiments.metrics.note'|trans({'%count%': constant('App\\Module\\Bridge\\Experiment\\Stats::MIN_FINISHED_CARDS')}) }}</p>

    <p class="lp-experiment-note" data-experiment-left-out>
        {{ 'bridge.experiments.left_out'|trans({'%count%': report.leftOutCards}) }}
        {% if report.leftOutCards > 0 %}
            <a href="{{ path('app_project_analytics_experiment_cards', {id: project.id, experiment: report.experiment, 'left-out': 1}) }}">{{ 'bridge.experiments.left_out_link'|trans }}</a>
        {% endif %}
    </p>

    {% if is_granted(constant('App\\Module\\Project\\Security\\ProjectVoter::MANAGE'), project) %}
        <p class="lp-experiment-note">
            <twig:Ds:Button variant="outline" size="sm" href="{{ path('app_project_analytics_reports', {id: project.id, topic: 'experiment', experiment: report.experiment}) }}" data-experiment-analyse>{{ 'bridge.experiments.analyse'|trans }}</twig:Ds:Button>
        </p>
    {% endif %}
</twig:Ds:Workspace>
{% endblock %}
