{% extends 'base.html.twig' %}

{% block title %}{{ 'analytics.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'analytics.page.title'|trans},
    ]" />
{% endblock %}

{% block body %}
{% set metric = query.metric %}
<twig:Ds:Workspace class="lp-redesign-secondary lp-redesign-runs">
    {% include '@Insights/_header.html.twig' with {} only %}

    {% include '@Insights/_tabs.html.twig' with {project: project, active: 'metrics'} only %}

    {% if app.request.query.has('saved') %}
    <p class="lp-metric-saved">
        <twig:Ds:Button variant="outline" size="sm" href="{{ path('app_project_analytics_dashboard', {id: project.id}) }}" data-metrics-saved-link>
            <twig:ux:icon name="lucide:chart-column" class="lp-icon lp-icon--sm" />{{ 'analytics.metrics.saved_graph.view'|trans }}
        </twig:Ds:Button>
    </p>
    {% endif %}

    {% if graph is not null %}
    <div class="lp-metric-edit-banner" data-edit-banner>
        {# The graph name is text that a person wrote, so it is escaped here before it enters the sentence. #}
        <span>{{ 'analytics.metrics.edit.banner'|trans({'%name%': '<strong>' ~ graph.name|e ~ '</strong>'})|raw }}</span>
        <a href="{{ path('app_project_analytics_dashboard', {id: project.id}) }}">{{ 'analytics.metrics.edit.back'|trans }}</a>
    </div>
    {% endif %}

    {% set formulaOpen = query.formula is not null %}
    {% set unitOptions = formulaOpen and query.formula.rows is not empty ? query.formula.units : metric.units %}
    {% set groupOptions = formulaOpen and query.formula.rows is not empty ? query.formula.groups : metric.groups %}
    {% set statisticLabels = {} %}
    {% for statistic in statisticCases %}{% set statisticLabels = statisticLabels|merge({(statistic.value): ('analytics.metrics.statistic.' ~ statistic.value)|trans}) %}{% endfor %}
    {# A GET form, so the controls land in the URL. It reloads the result frame alone. A control lists only the values its metric allows. #}
    <form method="get" action="{{ path('app_project_analytics_metrics', {id: project.id}) }}" data-controller="metric-formula" data-turbo-frame="metrics-result" data-turbo-action="replace" class="lp-metric-controls" data-metrics-form{{ formulaOpen and query.formula.problem is not null ? ' data-formula-invalid' : '' }}
        data-action="submit->metric-formula#guard"
        data-metric-formula-joinable-value="{{ joinable is empty ? '{}' : joinable|json_encode }}"
        data-metric-formula-labels-value="{{ statisticLabels|json_encode }}"
        data-metric-formula-check-url-value="{{ path('app_project_analytics_formula_check', {id: project.id}) }}"
        data-metric-formula-default-metric-value="cost"
        data-metric-formula-open-value="{{ formulaOpen ? 'true' : 'false' }}">
        {% if graph is not null %}<input type="hidden" name="graph" value="{{ graph.id }}">{% endif %}
        <div class="lp-metric-formula" data-metric-formula-target="panel"{{ formulaOpen ? '' : ' hidden' }}>
            <div class="lp-metric-formula__row lp-metric-formula__heads" aria-hidden="true">
                <span></span>
                <span>{{ 'analytics.metrics.form.metric'|trans }}</span>
                <span>{{ 'analytics.metrics.form.statistic'|trans }}</span>
                <span></span>
            </div>
            <div class="lp-metric-formula__rows" data-metric-formula-target="rows">
                {% if formulaOpen %}
                {% for part in rowParts %}
                {% include '@Insights/_formula_row.html.twig' with {letter: part.letter, selected: part.metric, statistic: part.statistic, metrics: metrics, bucketNames: bucketNames, harnessEventKinds: harnessEventKinds, joinable: joinable, statisticLabels: statisticLabels} only %}
                {% endfor %}
                {% endif %}
            </div>
            <template data-metric-formula-target="rowTemplate">
                {% include '@Insights/_formula_row.html.twig' with {letter: '@', selected: '', statistic: '', metrics: metrics, bucketNames: bucketNames, harnessEventKinds: harnessEventKinds, joinable: joinable, statisticLabels: statisticLabels} only %}
            </template>
            <template data-metric-formula-target="unitTemplate">{% for option in unitCases %}<option value="{{ option.value }}">{{ ('analytics.metrics.unit.' ~ option.value)|trans }}</option>{% endfor %}</template>
            <template data-metric-formula-target="groupTemplate">{% for option in groupCases %}<option value="{{ option.value }}">{{ ('analytics.metrics.group.' ~ option.value)|trans }}</option>{% endfor %}</template>
            <twig:Ds:Button type="button" variant="ghost" size="sm" data-metric-formula-target="addRow" data-action="click->metric-formula#addRow">
                <twig:ux:icon name="lucide:plus" class="lp-icon lp-icon--sm" />{{ 'analytics.metrics.formula.add_metric'|trans }}
            </twig:Ds:Button>
            <div class="lp-metric-formula__row lp-metric-formula__formula">
                <span class="lp-metric-formula__mark"><twig:ux:icon name="lucide:square-function" class="lp-icon lp-icon--md" /></span>
                <div class="lp-metric-controls__field">
                    <twig:Ds:Label for="metrics-formula">{{ 'analytics.metrics.formula.label'|trans }}</twig:Ds:Label>
                    <twig:Ds:Input id="metrics-formula" mono maxlength="200" autocomplete="off" spellcheck="false" :value="formulaOpen ? query.formula.formula : ''" data-metric-formula-target="formulaText" data-action="input->metric-formula#change" />
                </div>
                <div class="lp-metric-controls__field">
                    <twig:Ds:Label for="metrics-format">{{ 'analytics.metrics.formula.format.label'|trans }}</twig:Ds:Label>
                    <twig:Ds:Select id="metrics-format" name="format" data-metric-formula-target="format" data-action="change->metric-formula#change" :disabled="formulaOpen ? null : 'disabled'">
                        {% for option in formatCases %}
                        <option value="{{ option.value }}"{{ (formulaOpen ? option == query.formula.format : option.value == 'auto') ? ' selected' : '' }}>{{ ('analytics.metrics.formula.format.' ~ option.value)|trans }}</option>
                        {% endfor %}
                    </twig:Ds:Select>
                </div>
                <twig:Ds:Button type="button" variant="ghost icon" size="sm" class="lp-metric-formula__remove" aria-label="{{ 'analytics.metrics.formula.remove'|trans }}" data-action="click->metric-formula#close">
                    <twig:ux:icon name="lucide:x" class="lp-icon lp-icon--sm" />
                </twig:Ds:Button>
            </div>
            <input type="hidden" name="rows" value="{{ formulaOpen ? query.formula.rowsText : '' }}" data-metric-formula-target="rowsField"{{ formulaOpen ? '' : ' disabled' }}>
            <input type="hidden" name="formula" value="{{ formulaOpen ? query.formula.formula : '' }}" data-metric-formula-target="formulaField"{{ formulaOpen ? '' : ' disabled' }}>
            {% set formulaProblem = formulaOpen ? query.formula.problem : null %}
            <p class="lp-metric-formula__error" role="alert" data-metric-formula-target="error"{{ formulaProblem is null ? ' hidden' : ' data-metrics-note="formula-problem"' }}>{{ formulaProblem is null ? '' : formulaProblem.key|trans(formulaProblem.parameters) }}</p>
        </div>
        <div class="lp-metric-controls__primary" data-metric-formula-target="single"{{ formulaOpen ? ' hidden' : '' }}>
            <div class="lp-metric-controls__field lp-metric-controls__metric">
                <twig:Ds:Label for="metrics-metric">{{ 'analytics.metrics.form.metric'|trans }}</twig:Ds:Label>
                <twig:Ds:Select id="metrics-metric" name="metric" data-metric-formula-target="metric" data-controller="symfony--ux-autocomplete--autocomplete" data-symfony--ux-autocomplete--autocomplete-tom-select-options-value="{{ {maxOptions: 500, refreshThrottle: 0}|json_encode }}" data-action="change->metric-formula#apply" :disabled="formulaOpen ? 'disabled' : null">
                    {% include '@Insights/_metric_options.html.twig' with {metrics: metrics, bucketNames: bucketNames, harnessEventKinds: harnessEventKinds, selected: metric.key.key, only: null, blank: false} only %}
                </twig:Ds:Select>
            </div>
            <div class="lp-metric-controls__field">
                <twig:Ds:Label for="metrics-statistic">{{ 'analytics.metrics.form.statistic'|trans }}</twig:Ds:Label>
                <twig:Ds:Select id="metrics-statistic" name="statistic" data-metric-formula-target="statistic" data-action="change->metric-formula#apply" :disabled="formulaOpen ? 'disabled' : null">
                    {% include '@Insights/_metrics_field_options.html.twig' with {field: 'statistic', options: metric.statistics(), query: query} only %}
                </twig:Ds:Select>
            </div>
        </div>
        <div data-metric-formula-target="addFormula"{{ formulaOpen ? ' hidden' : '' }}>
            <twig:Ds:Button type="button" variant="ghost" size="sm" data-action="click->metric-formula#open">
                <twig:ux:icon name="lucide:plus" class="lp-icon lp-icon--sm" />{{ 'analytics.metrics.formula.add'|trans }}
            </twig:Ds:Button>
        </div>
        <div class="lp-metric-controls__settings">
            <div class="lp-metric-controls__field">
                <twig:Ds:Label for="metrics-unit">{{ 'analytics.metrics.form.unit'|trans }}</twig:Ds:Label>
                <twig:Ds:Select id="metrics-unit" name="unit" data-metric-formula-target="unit" data-action="change->metric-formula#apply">
                    {% include '@Insights/_metrics_field_options.html.twig' with {field: 'unit', options: unitOptions, query: query} only %}
                </twig:Ds:Select>
            </div>
            <div class="lp-metric-controls__field">
                <twig:Ds:Label for="metrics-group">{{ 'analytics.metrics.form.group'|trans }}</twig:Ds:Label>
                <twig:Ds:Select id="metrics-group" name="group" data-metric-formula-target="group" data-action="change->metric-formula#apply">
                    {% include '@Insights/_metrics_field_options.html.twig' with {field: 'group', options: groupOptions, query: query} only %}
                </twig:Ds:Select>
            </div>
            <div class="lp-metric-controls__field">
                <twig:Ds:Label for="metrics-range">{{ 'analytics.metrics.form.range'|trans }}</twig:Ds:Label>
                <twig:Ds:Select id="metrics-range" name="range" data-action="change->metric-formula#apply">
                    {% for option in ranges %}
                        <option value="{{ option.value }}"{{ option == query.range ? ' selected' : '' }}>{{ ('analytics.metrics.range.' ~ option.value)|trans }}</option>
                    {% endfor %}
                </twig:Ds:Select>
            </div>
            <div class="lp-metric-controls__field">
                <twig:Ds:Label for="metrics-bucket">{{ 'analytics.metrics.form.bucket'|trans }}</twig:Ds:Label>
                <twig:Ds:Select id="metrics-bucket" name="bucket" data-action="change->metric-formula#apply">
                    {% include '@Insights/_metrics_field_options.html.twig' with {field: 'bucket', options: buckets, query: query} only %}
                </twig:Ds:Select>
            </div>
            <div class="lp-metric-controls__field">
                <twig:Ds:Label for="metrics-compare">{{ 'analytics.metrics.form.compare'|trans }}</twig:Ds:Label>
                <twig:Ds:Select id="metrics-compare" name="compare" data-action="change->metric-formula#apply">
                    {% include '@Insights/_metrics_field_options.html.twig' with {field: 'compare', options: compares, query: query} only %}
                </twig:Ds:Select>
            </div>
            <div class="lp-metric-controls__field">
                <twig:Ds:Label for="metrics-chart">{{ 'analytics.metrics.form.chart'|trans }}</twig:Ds:Label>
                <twig:Ds:Select id="metrics-chart" name="chart" data-action="change->metric-formula#apply">
                    {% include '@Insights/_metrics_field_options.html.twig' with {field: 'chart', options: chartTypes, query: query, view: view} only %}
                </twig:Ds:Select>
            </div>
        </div>
        <noscript><twig:Ds:Button type="submit">{{ 'analytics.metrics.form.apply'|trans }}</twig:Ds:Button></noscript>
    </form>

    <div class="lp-metric-result" data-metrics-result>
        <p class="lp-metric-result__loading" role="status" data-metrics-loading>
            <twig:ux:icon name="lucide:loader-circle" class="lp-icon lp-icon--md lp-metric-result__spinner" />{{ 'analytics.metrics.loading'|trans }}
        </p>
        {% include '@Insights/_metrics_result.html.twig' with {streams: streams, project: project, query: query, view: view, graph: graph, dirty: dirty, saveForm: saveForm, capReached: capReached, capLimit: capLimit, buckets: buckets, compares: compares, chartTypes: chartTypes} only %}
    </div>
</twig:Ds:Workspace>
{% endblock %}
