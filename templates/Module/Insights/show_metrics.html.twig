{% extends 'base.html.twig' %}

{% block title %}{{ 'analytics.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'analytics.page.title'|trans},
    ]" />
{% endblock %}

{% block body %}
{% set metric = query.metric %}
<twig:Ds:Workspace class="lp-redesign-secondary lp-redesign-runs">
    {% include '@Insights/_header.html.twig' with {} only %}

    {% include '@Insights/_tabs.html.twig' with {project: project, active: 'metrics'} only %}

    {# A GET form, so the controls land in the URL. A control lists only the values its metric allows. #}
    <form method="get" action="{{ path('app_project_analytics_metrics', {id: project.id}) }}" data-controller="autosearch" class="lp-metric-controls" data-metrics-form>
        <div class="lp-metric-controls__field">
            <twig:Ds:Label for="metrics-metric">{{ 'analytics.metrics.form.metric'|trans }}</twig:Ds:Label>
            <twig:Ds:Select id="metrics-metric" name="metric" data-action="change->autosearch#search">
                {% for option in metrics %}
                    {# A template label and description are text that a person wrote, so they are rendered escaped. Never add |raw here. #}
                    <option value="{{ option.key.key }}"{{ option.key.key == metric.key.key ? ' selected' : '' }}{% if option.template is not null %} title="{{ option.template.description }}"{% endif %}>{{ option.template is null ? ('analytics.metrics.metric.' ~ option.key.key)|trans : option.template.label }}</option>
                {% endfor %}
                {% if bucketNames is not empty %}
                {# A bucket name comes from the project rules, so it is rendered as text. Never add |raw here. #}
                {% for family in ['bucket-time', 'bucket-time-all', 'bucket-calls'] %}
                {% set familyKey = family|replace({'-': '_'}) %}
                <optgroup label="{{ ('analytics.metrics.metric_group.' ~ familyKey)|trans }}">
                    {% for name in bucketNames %}
                    <option value="{{ family }}:{{ name }}"{{ metric.key.name is same as(name) and metric.key.metric.value == family ? ' selected' : '' }}>{{ ('analytics.metrics.metric.' ~ familyKey ~ '_named')|trans({'%bucket%': name}) }}</option>
                    {% endfor %}
                </optgroup>
                {% endfor %}
                {% endif %}
                {% if harnessEventKinds is not empty %}
                {# A kind name comes from the bridge, so it is rendered as text. Never add |raw here. #}
                <optgroup label="{{ 'analytics.metrics.metric_group.harness_events'|trans }}">
                    {% for kind in harnessEventKinds %}
                    <option value="harness-events:{{ kind }}"{{ metric.key.name is same as(kind) and metric.key.metric.value == 'harness-events' ? ' selected' : '' }}>{{ 'analytics.metrics.metric.harness_events_named'|trans({'%kind%': kind}) }}</option>
                    {% endfor %}
                </optgroup>
                {% endif %}
            </twig:Ds:Select>
        </div>
        <div class="lp-metric-controls__field">
            <twig:Ds:Label for="metrics-statistic">{{ 'analytics.metrics.form.statistic'|trans }}</twig:Ds:Label>
            <twig:Ds:Select id="metrics-statistic" name="statistic" data-action="change->autosearch#search">
                {% for option in metric.statistics() %}
                    <option value="{{ option.value }}"{{ option == query.statistic ? ' selected' : '' }}>{{ ('analytics.metrics.statistic.' ~ option.value)|trans }}</option>
                {% endfor %}
            </twig:Ds:Select>
        </div>
        <div class="lp-metric-controls__field">
            <twig:Ds:Label for="metrics-unit">{{ 'analytics.metrics.form.unit'|trans }}</twig:Ds:Label>
            <twig:Ds:Select id="metrics-unit" name="unit" data-action="change->autosearch#search">
                {% for option in metric.units() %}
                    <option value="{{ option.value }}"{{ option == query.unit ? ' selected' : '' }}>{{ ('analytics.metrics.unit.' ~ option.value)|trans }}</option>
                {% endfor %}
            </twig:Ds:Select>
        </div>
        <div class="lp-metric-controls__field">
            <twig:Ds:Label for="metrics-group">{{ 'analytics.metrics.form.group'|trans }}</twig:Ds:Label>
            <twig:Ds:Select id="metrics-group" name="group" data-action="change->autosearch#search">
                {% for option in metric.groups() %}
                    <option value="{{ option.value }}"{{ option == query.group ? ' selected' : '' }}>{{ ('analytics.metrics.group.' ~ option.value)|trans }}</option>
                {% endfor %}
            </twig:Ds:Select>
        </div>
        <div class="lp-metric-controls__field">
            <twig:Ds:Label for="metrics-range">{{ 'analytics.metrics.form.range'|trans }}</twig:Ds:Label>
            <twig:Ds:Select id="metrics-range" name="range" data-action="change->autosearch#search">
                {% for option in ranges %}
                    <option value="{{ option.value }}"{{ option == query.range ? ' selected' : '' }}>{{ ('analytics.metrics.range.' ~ option.value)|trans }}</option>
                {% endfor %}
            </twig:Ds:Select>
        </div>
        <div class="lp-metric-controls__field">
            <twig:Ds:Label for="metrics-bucket">{{ 'analytics.metrics.form.bucket'|trans }}</twig:Ds:Label>
            <twig:Ds:Select id="metrics-bucket" name="bucket" data-action="change->autosearch#search">
                {% for option in buckets %}
                    <option value="{{ option.value }}"{{ option == query.bucket ? ' selected' : '' }}{{ option in query.range.allowedBuckets() ? '' : ' disabled' }}>{{ ('analytics.metrics.bucket.' ~ option.value)|trans }}</option>
                {% endfor %}
            </twig:Ds:Select>
        </div>
        <div class="lp-metric-controls__field">
            <twig:Ds:Label for="metrics-compare">{{ 'analytics.metrics.form.compare'|trans }}</twig:Ds:Label>
            <twig:Ds:Select id="metrics-compare" name="compare" data-action="change->autosearch#search">
                {% for option in compares %}
                    <option value="{{ option.value }}"{{ option == query.compare ? ' selected' : '' }}{{ option.value == 'previous' and query.range.length() is null ? ' disabled' : '' }}>{{ ('analytics.metrics.compare.' ~ option.value)|trans }}</option>
                {% endfor %}
            </twig:Ds:Select>
        </div>
        <div class="lp-metric-controls__field">
            <twig:Ds:Label for="metrics-chart">{{ 'analytics.metrics.form.chart'|trans }}</twig:Ds:Label>
            <twig:Ds:Select id="metrics-chart" name="chart" data-action="change->autosearch#search">
                {% for option in chartTypes %}
                    <option value="{{ option.value }}"{{ option == view.chart.type ? ' selected' : '' }}{{ view.locks[option.value] is null ? '' : ' disabled' }}>{{ ('analytics.metrics.chart_type.' ~ option.value|replace({'-': '_'}))|trans }}</option>
                {% endfor %}
            </twig:Ds:Select>
        </div>
        <noscript><twig:Ds:Button type="submit">{{ 'analytics.metrics.form.apply'|trans }}</twig:Ds:Button></noscript>
    </form>

    {% if view.layout is null %}
    <twig:Ds:EmptyState icon="lucide:chart-column" :title="'analytics.metrics.empty.title'|trans" data-metrics-empty>
        <p>{{ 'analytics.metrics.empty.description'|trans }}</p>
    </twig:Ds:EmptyState>
    {% else %}
    {% set barsLock = view.locks['stacked-bars'] %}
    {% if view.chart.fellBack %}
    <twig:Ds:Flash severity="info" data-metrics-note="switched">{{ ('analytics.metrics.note.switched.' ~ view.chart.reason.value|replace({'-': '_'}))|trans }}</twig:Ds:Flash>
    {% elseif barsLock is not null %}
    <twig:Ds:Flash severity="info" data-metrics-note="locked">{{ ('analytics.metrics.note.locked.' ~ barsLock.value|replace({'-': '_'}))|trans }}</twig:Ds:Flash>
    {% endif %}
    {% if query.compare.value == 'previous' and view.chart.type.value in ['bars', 'stacked-bars', 'percent-stacked', 'donut'] %}
    <twig:Ds:Flash severity="info" data-metrics-note="previous-in-table">{{ 'analytics.metrics.note.previous_in_table'|trans }}</twig:Ds:Flash>
    {% endif %}

    <twig:Ds:Panel as="section" class="lp-metric-graph" data-metrics-chart>
        {# The title holds a template label or a bucket name that a person wrote, so it is rendered escaped. Never add |raw here. #}
        <h2 class="lp-metric-table__title" data-metrics-title>{{ view.title }}</h2>
        <twig:Ds:Chart :layout="view.layout" :labels="view.labels" :label="view.title" :valueLabel="('analytics.metrics.statistic.' ~ query.statistic.value)|trans" :changeLabel="'analytics.metrics.table.vs_previous'|trans" id="metrics-graph" />
    </twig:Ds:Panel>
    {% endif %}
</twig:Ds:Workspace>
{% endblock %}
