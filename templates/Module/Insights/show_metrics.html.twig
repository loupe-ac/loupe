{% extends 'base.html.twig' %}

{% block title %}{{ 'analytics.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'analytics.page.title'|trans},
    ]" />
{% endblock %}

{% block body %}
{% set metric = query.metric %}
{% if metric.template is not null %}
    {% set metricName = metric.template.label %}
{% elseif metric.key.bucketName is null %}
    {% set metricName = ('analytics.metrics.metric.' ~ metric.key.key)|trans %}
{% else %}
    {% set metricName = 'analytics.metrics.metric.bucket_time_named'|trans({'%bucket%': metric.key.bucketName}) %}
{% endif %}
{% set rowsKey = 'analytics.metrics.rows.' ~ query.unit.value %}
<twig:Ds:Workspace class="lp-redesign-secondary lp-redesign-runs">
    {% include '@Insights/_header.html.twig' with {} only %}

    {% include '@Insights/_tabs.html.twig' with {project: project, active: 'metrics'} only %}

    {# A GET form, so the controls land in the URL. A control lists only the values its metric allows. #}
    <twig:Ds:FilterBar :action="path('app_project_analytics_metrics', {id: project.id})" :formAttributes="{'data-metrics-form': true}">
        <twig:block name="secondary">
            <label class="sr-only" for="metrics-metric">{{ 'analytics.metrics.form.metric'|trans }}</label>
            <twig:Ds:Select id="metrics-metric" name="metric" data-action="change->autosearch#search">
                {% for option in metrics %}
                    {# A template label and description are text that a person wrote, so they are rendered escaped. Never add |raw here. #}
                    <option value="{{ option.key.key }}"{{ option.key.key == metric.key.key ? ' selected' : '' }}{% if option.template is not null %} title="{{ option.template.description }}"{% endif %}>{{ option.template is null ? ('analytics.metrics.metric.' ~ option.key.key)|trans : option.template.label }}</option>
                {% endfor %}
                {% if bucketNames is not empty %}
                {# A bucket name comes from the project rules, so it is rendered as text. Never add |raw here. #}
                <optgroup label="{{ 'analytics.metrics.metric_group.bucket_time'|trans }}">
                    {% for name in bucketNames %}
                    <option value="bucket-time:{{ name }}"{{ metric.key.bucketName is same as(name) ? ' selected' : '' }}>{{ 'analytics.metrics.metric.bucket_time_named'|trans({'%bucket%': name}) }}</option>
                    {% endfor %}
                </optgroup>
                {% endif %}
            </twig:Ds:Select>
            <label class="sr-only" for="metrics-unit">{{ 'analytics.metrics.form.unit'|trans }}</label>
            <twig:Ds:Select id="metrics-unit" name="unit" data-action="change->autosearch#search">
                {% for option in metric.units() %}
                    <option value="{{ option.value }}"{{ option == query.unit ? ' selected' : '' }}>{{ ('analytics.metrics.unit.' ~ option.value)|trans }}</option>
                {% endfor %}
            </twig:Ds:Select>
            <label class="sr-only" for="metrics-statistic">{{ 'analytics.metrics.form.statistic'|trans }}</label>
            <twig:Ds:Select id="metrics-statistic" name="statistic" data-action="change->autosearch#search">
                {% for option in metric.statistics() %}
                    <option value="{{ option.value }}"{{ option == query.statistic ? ' selected' : '' }}>{{ ('analytics.metrics.statistic.' ~ option.value)|trans }}</option>
                {% endfor %}
            </twig:Ds:Select>
            <label class="sr-only" for="metrics-group">{{ 'analytics.metrics.form.group'|trans }}</label>
            <twig:Ds:Select id="metrics-group" name="group" data-action="change->autosearch#search">
                {% for option in metric.groups() %}
                    <option value="{{ option.value }}"{{ option == query.group ? ' selected' : '' }}>{{ ('analytics.metrics.group.' ~ option.value)|trans }}</option>
                {% endfor %}
            </twig:Ds:Select>
            <label class="sr-only" for="metrics-range">{{ 'analytics.metrics.form.range'|trans }}</label>
            <twig:Ds:Select id="metrics-range" name="range" data-action="change->autosearch#search">
                {% for option in ranges %}
                    <option value="{{ option.value }}"{{ option == query.range ? ' selected' : '' }}>{{ ('analytics.metrics.range.' ~ option.value)|trans }}</option>
                {% endfor %}
            </twig:Ds:Select>
            <label class="sr-only" for="metrics-bucket">{{ 'analytics.metrics.form.bucket'|trans }}</label>
            <twig:Ds:Select id="metrics-bucket" name="bucket" data-action="change->autosearch#search">
                {% for option in buckets %}
                    <option value="{{ option.value }}"{{ option == query.bucket ? ' selected' : '' }}>{{ ('analytics.metrics.bucket.' ~ option.value)|trans }}</option>
                {% endfor %}
            </twig:Ds:Select>
            <noscript><twig:Ds:Button type="submit">{{ 'analytics.metrics.form.apply'|trans }}</twig:Ds:Button></noscript>
        </twig:block>
    </twig:Ds:FilterBar>

    {% if chart is null %}
    <twig:Ds:EmptyState icon="lucide:chart-column" :title="'analytics.metrics.empty.title'|trans" data-metrics-empty>
        <p>{{ 'analytics.metrics.empty.description'|trans }}</p>
    </twig:Ds:EmptyState>
    {% else %}
    {% set labels = [] %}
    {% for series in view.series %}
        {% set labels = labels|merge([series.group is null ? (view.series|length > 1 ? 'analytics.metrics.series.none'|trans : metricName) : groupLabels[series.group] ?? series.group]) %}
    {% endfor %}

    <dl class="lp-metric-summary" data-metrics-summary>
        {% for series in view.series %}
        <div class="lp-metric-summary__figure" data-metrics-series="{{ series.group ?? 'none' }}">
            {# A group name comes from the bridge, so it is rendered as text. Never add |raw here. #}
            <dt class="lp-metric-summary__label">{{ labels[loop.index0] }}</dt>
            <dd class="lp-metric-summary__value">{{ series.total.value|metric_value(metric, query.statistic) }}</dd>
            <dd class="lp-metric-summary__rows">{{ rowsKey|trans({'%count%': series.rows|length}) }}</dd>
        </div>
        {% endfor %}
    </dl>

    {% set dayFormat = chart.longSpan ? 'M j, Y' : 'M j' %}
    {% set plotLeft = constant('App\\Module\\Insights\\View\\MetricChart::PLOT_LEFT') %}
    {% set plotRight = constant('App\\Module\\Insights\\View\\MetricChart::PLOT_RIGHT') %}
    {% set plotTop = constant('App\\Module\\Insights\\View\\MetricChart::PLOT_TOP') %}
    {% set baseline = constant('App\\Module\\Insights\\View\\MetricChart::BASELINE') %}
    {% set height = constant('App\\Module\\Insights\\View\\MetricChart::HEIGHT') %}
    <figure class="lp-metric-chart" data-metrics-chart>
        {% if chart.hasLegend %}
        <ul class="lp-metric-legend" data-metrics-legend>
            {% for series in chart.series %}
                <li class="lp-metric-legend__item"><span class="lp-metric-legend__swatch lp-metric-legend__swatch--{{ series.slot }}"></span>{{ labels[loop.index0] }}</li>
            {% endfor %}
        </ul>
        {% endif %}
        {# A chart drawn from data, not an icon. #}
        {# twig-cs-fixer-disable-line InlineSvg #}<svg class="lp-metric-chart__svg" viewBox="0 0 {{ constant('App\\Module\\Insights\\View\\MetricChart::WIDTH') }} {{ height }}" role="group" aria-label="{{ 'analytics.metrics.chart.label'|trans({'%statistic%': ('analytics.metrics.statistic.' ~ query.statistic.value)|trans, '%metric%': metricName, '%bucket%': ('analytics.metrics.bucket.' ~ query.bucket.value)|trans}) }}">
            {% for tick in chart.yTicks %}
                <line class="lp-metric-chart__grid" x1="{{ plotLeft }}" x2="{{ plotRight }}" y1="{{ tick.position }}" y2="{{ tick.position }}" />
                <text class="lp-metric-chart__tick" x="{{ plotLeft - 8 }}" y="{{ tick.position }}" text-anchor="end" dominant-baseline="middle">{{ tick.value|metric_value(metric, query.statistic, chart.moneyDecimals) }}</text>
            {% endfor %}
            {% for tick in chart.xTicks %}
                <text class="lp-metric-chart__tick" x="{{ tick.position }}" y="{{ height - 6 }}" text-anchor="middle">{{ tick.start|date(chart.bucket.value == 'month' ? (chart.longSpan ? 'M Y' : 'M') : dayFormat, 'UTC') }}</text>
            {% endfor %}
            {% for bucket in chart.buckets %}
                {% set bucketLabel = chart.bucket.value == 'week' ? 'analytics.metrics.chart.week'|trans({'%date%': bucket.start|date(dayFormat, 'UTC')}) : bucket.start|date(chart.bucket.value == 'month' ? 'F Y' : dayFormat, 'UTC') %}
                {% for bar in bucket.bars %}
                    {% set barLabel = 'analytics.metrics.chart.bar'|trans({'%bucket%': bucketLabel, '%series%': labels[bar.series.position], '%value%': bar.point.value|metric_value(metric, query.statistic), '%rows%': rowsKey|trans({'%count%': bar.point.rows})}) %}
                    <g class="lp-metric-chart__bar" role="img" tabindex="0" aria-label="{{ barLabel }}" data-metrics-bar="{{ bucket.start|date('Y-m-d', 'UTC') }}">
                        <title>{{ barLabel }}</title>
                        <rect class="lp-metric-chart__hit" x="{{ bar.x }}" y="{{ plotTop }}" width="{{ bar.width }}" height="{{ baseline - plotTop }}" />
                        {% if bar.path %}<path class="lp-metric-chart__bar-shape lp-metric-chart__bar-shape--{{ bar.series.slot }}" d="{{ bar.path }}" />{% endif %}
                    </g>
                {% endfor %}
            {% endfor %}
            <line class="lp-metric-chart__baseline" x1="{{ plotLeft }}" x2="{{ plotRight }}" y1="{{ baseline }}" y2="{{ baseline }}" />
        </svg>
    </figure>
    {% endif %}
</twig:Ds:Workspace>
{% endblock %}
