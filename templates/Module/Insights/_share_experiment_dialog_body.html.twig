{# The part of the experiment share dialog that a share changes. The share stream replaces it.
   Props: project (Project), experiment (string), share (PublicLinkShareView), error (string or null), archived (bool).
   An archived experiment waits for the owner to confirm, because sharing it also unarchives it. #}
{% set shareForm = experiment_share_form(project, experiment, share) %}
<div class="lp-dashboard-share__body" id="share-experiment-body-{{ experiment_share_key(experiment) }}">
    {% if share.block is not null %}
        <twig:Ds:Flash severity="warning">{{ share.block.translationKey|trans }}</twig:Ds:Flash>
    {% elseif error is not empty %}
        <twig:Ds:Flash severity="error">{{ error }}</twig:Ds:Flash>
    {% endif %}
    {% if archived %}
        <twig:Ds:Flash severity="info" data-experiment-share-archived>{{ 'bridge.experiments.share.archived_note'|trans }}</twig:Ds:Flash>
        {{ form_start(shareForm, {attr: {'class': 'lp-dashboard-share__form', 'data-turbo': 'false', 'data-experiment-share-confirm': ''}}) }}
            <input type="hidden" name="{{ shareForm.enabled.vars.full_name }}" value="1">
            {% do shareForm.enabled.setRendered() %}
            <twig:Ds:FormField :fieldView="shareForm.note" widgetKind="textarea" :widgetAttr="{rows: 4, 'data-share-note': ''}" :hintText="'insights.form.share_experiment_form.note.help'|trans" />
            <twig:Ds:FormActions>
                <twig:Ds:Button variant="ghost" size="sm" type="button" data-action="click->modal#close">{{ 'bridge.experiments.share.cancel'|trans }}</twig:Ds:Button>
                <twig:Ds:Button variant="primary" size="sm" type="submit" :disabled="share.block is not null" data-experiment-share-unarchive>{{ 'bridge.experiments.share.unarchive'|trans }}</twig:Ds:Button>
            </twig:Ds:FormActions>
        {{ form_end(shareForm) }}
    {% else %}
    {{ form_start(shareForm, {attr: {'class': 'lp-dashboard-share__form', 'data-controller': 'submit-on-change', 'data-action': 'change->submit-on-change#submit'}}) }}
        <twig:Ds:Switch :fieldView="shareForm.enabled" :help="'insights.form.share_experiment_form.enabled.help'|trans" />
        <twig:Ds:FormField :fieldView="shareForm.note" widgetKind="textarea" :widgetAttr="{rows: 4, 'data-share-note': ''}" :hintText="'insights.form.share_experiment_form.note.help'|trans" />
    {{ form_end(shareForm) }}
    {% endif %}
    {% if share.isEnabled and not archived %}
        {% set linkUrl = public_link_url(share.link.code) %}
        <div class="lp-dashboard-share__link">
            <twig:Ds:Input type="text" readonly="readonly" :value="linkUrl" :aria-label="'insights.public_link.dialog.link'|trans" />
            <twig:Ds:CopyButton :text="linkUrl" :label="'insights.public_link.dialog.copy'|trans" :copiedLabel="'insights.public_link.dialog.copied'|trans" buttonVariant="primary" />
        </div>
        <p class="lp-dialog-desc">{{ 'insights.public_link.dialog.note'|trans }}</p>
    {% endif %}
</div>
