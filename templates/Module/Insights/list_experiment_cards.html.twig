{% extends 'base.html.twig' %}

{% block title %}{{ report.experiment }} — {{ 'bridge.experiments.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'analytics.page.title'|trans},
    ]" />
{% endblock %}

{% block body %}
{% set routeParams = {id: project.id, experiment: report.experiment} %}
<twig:Ds:Workspace class="lp-redesign-secondary lp-redesign-runs">
    {% include '@Insights/_header.html.twig' with {} only %}

    {% include '@Insights/_tabs.html.twig' with {project: project, active: 'experiments'} only %}

    {% include '@Insights/_experiment_tabs.html.twig' with {project: project, experiment: report.experiment, active: 'cards', archived: report.archived} only %}

    <twig:Ds:FilterBar class="lp-cost-controls" :count="'bridge.experiments.card_count'|trans({'%count%': report.filteredTotal})">
        <nav class="lp-cost-toggle" aria-label="{{ 'bridge.experiments.cards.filter_label'|trans }}" data-experiment-filter>
            <a class="lp-cost-toggle__option"
               href="{{ path('app_project_analytics_experiment_cards', routeParams) }}"
               {% if query.variant is null and not query.leftOutOnly %}aria-current="true"{% endif %}>{{ 'bridge.experiments.cards.all'|trans }}</a>
            {% for variant in report.variants %}
                <a class="lp-cost-toggle__option"
                   href="{{ path('app_project_analytics_experiment_cards', routeParams|merge({variant: variant.name})) }}"
                   {% if query.variant == variant.name %}aria-current="true"{% endif %}>{{ variant.name }}</a>
            {% endfor %}
            <a class="lp-cost-toggle__option"
               href="{{ path('app_project_analytics_experiment_cards', routeParams|merge({'left-out': 1})) }}"
               {% if query.leftOutOnly %}aria-current="true"{% endif %}>{{ 'bridge.experiments.cards.left_out'|trans }}</a>
        </nav>
    </twig:Ds:FilterBar>

    {% if report.cards is not empty %}
    <twig:Ds:DataTable modifier="experiment-cards" :label="'bridge.experiments.cards.table.label'|trans" :columns="[
        {label: 'bridge.experiments.cards.column.card'|trans},
        {label: 'bridge.experiments.cards.column.variant'|trans},
        {label: 'bridge.experiments.cards.column.column'|trans},
        {label: 'bridge.experiments.cards.column.runs'|trans, align: 'end'},
        {label: 'bridge.experiments.cards.column.covered_cost'|trans, align: 'end'},
        {label: 'bridge.experiments.cards.column.fix_rounds'|trans, align: 'end'},
        {label: 'bridge.experiments.cards.column.cost'|trans, align: 'end'},
        {label: 'bridge.experiments.cards.column.left_out'|trans},
    ]">
        {% for card in report.cards %}
        <div class="lp-data-table__row" role="row" data-experiment-card="{{ card.cardId }}">
            <div class="lp-data-table__cell lp-data-table__primary" role="cell">
                {% if card.column is not null %}<a class="lp-data-table__target" href="{{ path('app_board_card', {projectId: project.id, cardId: card.cardId}) }}">{% endif %}
                    {% if card.number is not null %}<span class="lp-data-table__number">{{ 'bridge.worker_runs.card_number'|trans({'%number%': card.number}) }}</span>{% endif %}
                    <span class="lp-data-table__title">{{ card.title is not null ? card.title|reference_plain : 'bridge.experiments.cards.untitled'|trans }}</span>
                {% if card.column is not null %}</a>{% endif %}
            </div>
            <span class="lp-data-table__cell" role="cell">{{ card.variant ?? '–' }}</span>
            <span class="lp-data-table__cell" role="cell" data-experiment-card-column>{{ card.column is not null ? card.column.label|trans : '–' }}</span>
            <span class="lp-data-table__cell lp-data-table__cell--end" role="cell" data-experiment-card-runs>{{ card.runs }}</span>
            <span class="lp-data-table__cell lp-data-table__cell--end" role="cell" data-experiment-card-covered-cost>{{ card.coveredCostMicros is null ? '–' : (card.coveredCostMicros / 1000000)|format_currency('USD') }}</span>
            <span class="lp-data-table__cell lp-data-table__cell--end" role="cell">{{ card.fixRounds }}</span>
            <span class="lp-data-table__cell lp-data-table__cell--end" role="cell" data-experiment-card-cost>{{ card.costMicros is null ? '–' : (card.costMicros / 1000000)|format_currency('USD') }}</span>
            <span class="lp-data-table__cell lp-experiment-reasons" role="cell">
                {% for reason in card.leftOut %}<twig:Ds:Tag tone="amber">{{ ('bridge.experiments.left_out_reason.' ~ reason.value)|trans }}</twig:Ds:Tag>{% endfor %}
            </span>
        </div>
        {% endfor %}
    </twig:Ds:DataTable>

    <twig:Ds:Pagination route="app_project_analytics_experiment_cards" :page="report.page" :totalPages="report.totalPages" :pageList="report.pageList" :routeParams="routeParams|merge(query.routeParams)" />
    {% else %}
    <twig:Ds:EmptyState icon="lucide:chart-column" :title="'bridge.experiments.cards.empty'|trans" data-experiment-cards-empty />
    {% endif %}
</twig:Ds:Workspace>
{% endblock %}
