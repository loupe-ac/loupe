{% extends 'base.html.twig' %}

{% block title %}{{ report.experiment }} — {{ 'bridge.experiments.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'analytics.page.title'|trans},
    ]" />
{% endblock %}

{% block body %}
{% do mercure_subscribe(analytics_topic(project)) %}
{% set routeParams = {id: project.id, experiment: report.experiment} %}
<twig:Ds:Workspace class="lp-redesign-secondary lp-redesign-runs">
    {% include '@Insights/_header.html.twig' with {} only %}

    {% include '@Insights/_tabs.html.twig' with {project: project, active: 'experiments'} only %}

    {% include '@Insights/_experiment_tabs.html.twig' with {project: project, experiment: report.experiment, active: 'cards', archived: report.archived, liveUrl: path('app_project_analytics_experiment_cards', routeParams|merge(query.routeParams))} only %}


    {# One frame on every page, so a filter or a page swaps only the list. The live region sits inside it, so each swap brings the address of the new filter and page. A signal reads the rows by id, so a card that runs again never moves a row. #}
    <turbo-frame id="experiment-cards-list" target="_top">
    {% include '@Insights/_experiment_cards_filter.html.twig' with {report: report, query: query, routeParams: routeParams} only %}
    <div data-controller="live-region"
         data-live-region-types-value="{{ ['analytics.changed', 'worker_run.changed']|json_encode }}"
         data-live-region-match-type-value="{{ {'analytics.changed': {area: 'experiments'}}|json_encode }}"
         data-live-region-url-value="{{ path('app_project_analytics_experiment_cards_rows', routeParams|merge(query.routeParams)) }}"
         data-live-region-mode-value="rows"
         {% if report.page > 1 %}data-live-since="{{ since|date('Y-m-d\\TH:i:s.vP') }}"{% endif %}
         data-live-content>
        {% if report.page > 1 %}<div id="experiment-cards-newer" data-experiment-cards-newer></div>{% endif %}
        {% include '@Insights/_experiment_cards_results.html.twig' with {report: report, project: project, query: query, routeParams: routeParams} only %}
    </div>
    </turbo-frame>
</twig:Ds:Workspace>
{% endblock %}
