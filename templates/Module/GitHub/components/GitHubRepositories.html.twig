{% if visible %}
{% do mercure_subscribe(topic) %}
<twig:Ds:Panel as="section" id="repositories" data-testid="github-repositories" data-controller="repository-checks-live">
    <twig:Ds:SectionHeading>{{ 'github.repositories.title'|trans }}</twig:Ds:SectionHeading>

    {% if not connectionsAvailable %}
    <p class="lp-connect-hint" data-testid="forge-connections-disabled">{{ 'github.repositories.disabled'|trans }}</p>
    {% elseif rows is empty %}
    {% include '@GitHub/components/_repositories_empty.html.twig' with {project: project, appConfigured: appConfigured} only %}
    {% else %}
    <div data-repository-checks-live-target="populated">
        <p class="lp-connect-hint">{{ 'github.repositories.purpose'|trans }}</p>
        <div class="lp-repository-list">
            {% for row in rows %}
            {% include '@GitHub/components/_repository_row.html.twig' with {row: row, project: project} only %}
            {% endfor %}
        </div>
    </div>
    <template data-repository-checks-live-target="empty">
        {% include '@GitHub/components/_repositories_empty.html.twig' with {project: project, appConfigured: appConfigured} only %}
    </template>
    {% endif %}
</twig:Ds:Panel>
{% endif %}
