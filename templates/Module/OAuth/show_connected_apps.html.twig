{% extends '@Account/_settings_layout.html.twig' %}

{% block settings_section 'connected-apps' %}

{% block settings_content %}
<twig:Ds:Panel as="section" class="lp-connect-block" data-testid="connected-apps-section">
    <twig:Ds:SectionHeading>{{ 'oauth.connected_apps.heading'|trans }}</twig:Ds:SectionHeading>
    <p class="lp-connect-hint">{{ 'oauth.connected_apps.intro'|trans }}</p>

    {% set widgetClientId = constant('App\\Module\\OAuth\\Widget\\WidgetClient::ID') %}
    {% for app in view.apps|filter(app => app.clientId != widgetClientId) %}
    <div class="lp-identity-row" data-connected-app="{{ app.clientId }}">
        <twig:ux:icon name="lucide:plug" class="lp-icon lp-icon--md lp-identity-row__glyph" />
        <span class="lp-identity-row__text">
            <span class="lp-identity-row__name">{{ app.clientName }}</span>
            {% for grant in app.grants %}
            <span class="lp-identity-row__meta lp-identity-row__meta--plain">
                {% for scope in grant.scopes %}{{ loop.first ? '' : ', ' }}{{ ('oauth.consent.scope.' ~ scope.value|replace({'-': '_'}))|trans }}{% endfor %}
                {%- if grant.project %} · {{ grant.project.name }}{% elseif grant.allProjects %} · {{ 'oauth.connected_apps.all_projects'|trans }}{% endif %}
            </span>
            {% endfor %}
        </span>
        <div data-controller="modal">
            <twig:Ds:Button variant="danger-ghost" size="sm" type="button" data-action="click->modal#open">{{ 'oauth.connected_apps.action.revoke'|trans }}</twig:Ds:Button>
            <twig:Ds:Dialog aria-labelledby="revoke-app-title-{{ loop.index }}" data-action="cancel->modal#close">
                <h2 class="lp-dialog-title" id="revoke-app-title-{{ loop.index }}">{{ 'oauth.connected_apps.revoke.title'|trans }}</h2>
                <p class="lp-dialog-desc">{{ 'oauth.connected_apps.revoke.description'|trans({'%client%': app.clientName}) }}</p>
                <form method="post" action="{{ path('app_account_connected_app_revoke', {clientId: app.clientId}) }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('revoke-connected-app') }}">
                    <twig:Ds:FormActions>
                        <twig:Ds:Button variant="ghost" type="button" data-action="click->modal#close">{{ 'oauth.connected_apps.revoke.cancel'|trans }}</twig:Ds:Button>
                        <twig:Ds:Button variant="danger" type="submit">{{ 'oauth.connected_apps.revoke.confirm'|trans }}</twig:Ds:Button>
                    </twig:Ds:FormActions>
                </form>
            </twig:Ds:Dialog>
        </div>
    </div>
    {% endfor %}

    {% set widget = view.apps|filter(app => app.clientId == widgetClientId)|first %}
    <div class="lp-app-group" data-preview-widget>
        <div class="lp-identity-row lp-app-group__head" data-connected-app="{{ widgetClientId }}">
            <twig:ux:icon name="lucide:plug" class="lp-icon lp-icon--md lp-identity-row__glyph" />
            <span class="lp-identity-row__text">
                <span class="lp-identity-row__name">{{ 'oauth.connected_apps.preview_tokens.app_name'|trans }}</span>
                <span class="lp-identity-row__meta lp-identity-row__meta--plain">{{ 'oauth.connected_apps.preview_tokens.description'|trans }}</span>
                {% for grant in widget ? widget.grants : [] %}
                <span class="lp-identity-row__meta lp-identity-row__meta--plain">
                    {% for scope in grant.scopes %}{{ loop.first ? '' : ', ' }}{{ ('oauth.consent.scope.' ~ scope.value|replace({'-': '_'}))|trans }}{% endfor %}
                    {%- if grant.project %} · {{ grant.project.name }}{% elseif grant.allProjects %} · {{ 'oauth.connected_apps.all_projects'|trans }}{% endif %}
                </span>
                {% endfor %}
            </span>
            {% if widget or view.previewTokens is not empty %}
            <div data-controller="modal" data-preview-widget-revoke-all>
                <twig:Ds:Button variant="danger-ghost" size="sm" type="button" data-action="click->modal#open">{{ 'oauth.connected_apps.preview_tokens.revoke_all.action'|trans }}</twig:Ds:Button>
                <twig:Ds:Dialog aria-labelledby="revoke-widget-title" data-action="cancel->modal#close">
                    <h2 class="lp-dialog-title" id="revoke-widget-title">{{ 'oauth.connected_apps.preview_tokens.revoke_all.title'|trans }}</h2>
                    <p class="lp-dialog-desc">{{ 'oauth.connected_apps.preview_tokens.revoke_all.description'|trans }}</p>
                    <form method="post" action="{{ path('app_account_connected_app_revoke', {clientId: widgetClientId}) }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('revoke-connected-app') }}">
                        <twig:Ds:FormActions>
                            <twig:Ds:Button variant="ghost" type="button" data-action="click->modal#close">{{ 'oauth.connected_apps.revoke.cancel'|trans }}</twig:Ds:Button>
                            <twig:Ds:Button variant="danger" type="submit">{{ 'oauth.connected_apps.preview_tokens.revoke_all.confirm'|trans }}</twig:Ds:Button>
                        </twig:Ds:FormActions>
                    </form>
                </twig:Ds:Dialog>
            </div>
            {% endif %}
        </div>
        {% if view.previewTokens is empty %}
        <p class="lp-app-group__empty">{{ 'oauth.connected_apps.preview_tokens.empty'|trans }}</p>
        {% else %}
        <ul class="lp-preview-token-list" aria-label="{{ 'oauth.connected_apps.preview_tokens.list_label'|trans }}">
            {% for token in view.previewTokens %}
            <li class="lp-preview-token-row" data-preview-token="{{ token.accessTokenId }}">
                <span class="lp-preview-token-row__text">
                    <span class="lp-preview-token-row__card">
                        {% if token.cardNumber is not null %}
                        <span class="lp-preview-token-row__number">#{{ token.cardNumber }}</span>
                        <span class="lp-preview-token-row__title">{{ token.cardTitle }}</span>
                        {% else %}
                        <span class="lp-preview-token-row__title">{{ 'oauth.connected_apps.preview_tokens.no_card'|trans }}</span>
                        {% endif %}
                    </span>
                    <span class="lp-preview-token-row__meta">
                        {{- token.projectName }} · {{ 'oauth.connected_apps.preview_tokens.expires'|trans({'%count%': token.expiresAt|preview_token_days_left}) }} · {{ token.lastUsedAt ? 'oauth.connected_apps.preview_tokens.last_used'|trans({'%when%': token.lastUsedAt|relative_time}) : 'oauth.connected_apps.preview_tokens.not_used'|trans -}}
                    </span>
                </span>
                <div data-controller="modal">
                    <twig:Ds:Button variant="danger-ghost" size="sm" type="button" data-action="click->modal#open">{{ 'oauth.connected_apps.action.revoke'|trans }}</twig:Ds:Button>
                    <twig:Ds:Dialog aria-labelledby="revoke-preview-token-title-{{ loop.index }}" data-action="cancel->modal#close">
                        <h2 class="lp-dialog-title" id="revoke-preview-token-title-{{ loop.index }}">{{ 'oauth.connected_apps.preview_tokens.revoke.title'|trans }}</h2>
                        <p class="lp-dialog-desc">{{ 'oauth.connected_apps.preview_tokens.revoke.description'|trans }}</p>
                        <form method="post" action="{{ path('app_account_preview_token_revoke', {accessTokenId: token.accessTokenId}) }}">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('revoke-preview-token') }}">
                            <twig:Ds:FormActions>
                                <twig:Ds:Button variant="ghost" type="button" data-action="click->modal#close">{{ 'oauth.connected_apps.revoke.cancel'|trans }}</twig:Ds:Button>
                                <twig:Ds:Button variant="danger" type="submit">{{ 'oauth.connected_apps.revoke.confirm'|trans }}</twig:Ds:Button>
                            </twig:Ds:FormActions>
                        </form>
                    </twig:Ds:Dialog>
                </div>
            </li>
            {% endfor %}
        </ul>
        {% endif %}
    </div>
</twig:Ds:Panel>

<twig:GitHubAccountConnection />
{% endblock %}
