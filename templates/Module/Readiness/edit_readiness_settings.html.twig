{% extends '@Project/_settings_layout.html.twig' %}

{% block title %}{{ 'readiness.settings.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'nav.link.project_settings'|trans},
    ]" />
{% endblock %}

{% block settings_section 'readiness' %}

{% block settings_content %}
<twig:Ds:Panel as="section" data-readiness-settings data-live-content>
    <twig:Ds:SectionHeading>{{ 'readiness.settings.title'|trans }}</twig:Ds:SectionHeading>
    <p class="lp-connect-hint">{{ 'readiness.settings.description'|trans }}</p>

    <twig:Ds:SectionHeading :level="3">{{ 'readiness.settings.discovery.title'|trans }}</twig:Ds:SectionHeading>
    {% include '@Readiness/_discovery_frame.html.twig' with {project: project, discovery: discovery} only %}

    <twig:Ds:SectionHeading :level="3">{{ 'readiness.settings.agent_account.title'|trans }}</twig:Ds:SectionHeading>
    <p class="lp-connect-hint">{{ 'readiness.settings.agent_account.description'|trans }}</p>
    <a class="lp-workshop-text-link" href="{{ path('app_project_readiness_agent_account', {id: project.id}) }}" data-agent-account-link>{{ 'readiness.settings.agent_account.link'|trans }} <twig:ux:icon name="lucide:chevron-right" /></a>

    <twig:Ds:SectionHeading :level="3">{{ 'readiness.settings.guide.title'|trans }}</twig:Ds:SectionHeading>
    <div data-controller="live-region" data-live-region-types-value="{{ ['project.updated']|json_encode }}" data-live-region-url-value="{{ path('app_project_settings_fingerprint', {id: project.id}) }}" data-live-region-mode-value="band" data-live-fingerprint="{{ project_settings_fingerprint(project) }}">
    {% include '_live_form_band.html.twig' with {message: 'readiness.live.form_changed'|trans, linkLabel: 'readiness.live.form_open'|trans, url: path('app_readiness_settings', {id: project.id})} only %}
    {{ form_start(form, {attr: {class: 'lp-form'}}) }}
        <twig:Ds:FormField>
            <twig:Ds:Choice>
                {{ form_widget(form.showGuide) }}
                {{ form.showGuide.vars.label|trans }}
            </twig:Ds:Choice>
            {% if project.readinessGuideHiddenAt is not null %}
            <twig:Ds:Hint data-readiness-hidden-at>{{ 'readiness.settings.guide.hidden_at'|trans({'%date%': project.readinessGuideHiddenAt|date('j M Y')}) }}</twig:Ds:Hint>
            {% endif %}
            <twig:Ds:FieldErrors :fieldView="form.showGuide" />
        </twig:Ds:FormField>
        <twig:Ds:FormActions>
            <twig:Ds:Button variant="primary" type="submit">{{ 'readiness.settings.submit'|trans }}</twig:Ds:Button>
        </twig:Ds:FormActions>
    {{ form_end(form) }}
    </div>
</twig:Ds:Panel>
{% endblock %}
