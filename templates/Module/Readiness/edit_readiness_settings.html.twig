{% extends 'base.html.twig' %}

{% block title %}{{ 'readiness.settings.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <span class="lp-topbar__crumb">{{ project.name }}</span>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'nav.link.project_settings'|trans }}</span>
{% endblock %}

{% block body %}
<div class="lp-workspace lp-redesign-secondary lp-redesign-settings">
    <header class="lp-page-header">
        <div>
            <h1 class="lp-workspace-title">{{ 'project.edit.page.title'|trans }}</h1>
            <p class="lp-workspace-desc">{{ 'project.edit.page.description'|trans }}</p>
        </div>
    </header>
    <div class="lp-settings-layout">
        {% include '@Project/_settings_nav.html.twig' with {project: project, active: 'readiness'} only %}
        <twig:Ds:Panel as="section" class="lp-settings-content" data-readiness-settings>
            <twig:Ds:SectionHeading>{{ 'readiness.settings.title'|trans }}</twig:Ds:SectionHeading>
            <p class="lp-connect-hint">{{ 'readiness.settings.description'|trans }}</p>

            <twig:Ds:SectionHeading :level="3">{{ 'readiness.settings.discovery.title'|trans }}</twig:Ds:SectionHeading>
            {% if discovery is not null %}<p class="lp-connect-hint" data-readiness-discovery-state="{{ discovery.discoveryState }}">{{ discovery.status|trans(discovery.statusParameters) }}</p>{% endif %}

            <twig:Ds:SectionHeading :level="3">{{ 'readiness.settings.agent_account.title'|trans }}</twig:Ds:SectionHeading>
            <p class="lp-connect-hint">{{ 'readiness.settings.agent_account.description'|trans }}</p>
            <a class="lp-workshop-text-link" href="{{ path('app_project_readiness_agent_account', {id: project.id}) }}" data-agent-account-link>{{ 'readiness.settings.agent_account.link'|trans }} <twig:ux:icon name="lucide:chevron-right" /></a>

            <twig:Ds:SectionHeading :level="3">{{ 'readiness.settings.guide.title'|trans }}</twig:Ds:SectionHeading>
            {{ form_start(form, {attr: {class: 'lp-form'}}) }}
                <twig:Ds:FormField>
                    <label class="lp-choice">
                        {{ form_widget(form.showGuide) }}
                        {{ form.showGuide.vars.label|trans }}
                    </label>
                    {% if project.readinessGuideHiddenAt is not null %}
                    <twig:Ds:Hint data-readiness-hidden-at>{{ 'readiness.settings.guide.hidden_at'|trans({'%date%': project.readinessGuideHiddenAt|date('Y-m-d')}) }}</twig:Ds:Hint>
                    {% endif %}
                    <twig:Ds:FieldErrors :fieldView="form.showGuide" />
                </twig:Ds:FormField>
                <twig:Ds:FormActions>
                    <twig:Ds:Button variant="primary" type="submit">{{ 'readiness.settings.submit'|trans }}</twig:Ds:Button>
                </twig:Ds:FormActions>
            {{ form_end(form) }}
        </twig:Ds:Panel>
    </div>
</div>
{% endblock %}
