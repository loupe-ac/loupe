{#
  Turbo Stream that re-renders the cards and the Comments panel rows in place.
  Vars: comments, every comment of the version; morph, true when another actor's change is read.
#}
{% set method = morph|default(false) ? ' method="morph"' : '' %}
<turbo-stream action="replace"{{ method|raw }} target="comment-threads">
    <template>
        {% include '@Review/_comment_threads.html.twig' with {comments: comments} only %}
    </template>
</turbo-stream>
<turbo-stream action="replace"{{ method|raw }} target="comment-rows">
    <template>
        {% include '@Review/_comment_rows.html.twig' with {comments: comments} only %}
    </template>
</turbo-stream>
<turbo-stream action="replace"{{ method|raw }} target="sheet-comment-rows">
    <template>
        {% include '@Review/_comment_sheet_rows.html.twig' with {comments: comments} only %}
    </template>
</turbo-stream>
{% include '@Review/_review_bar_comments.stream.html.twig' with {comments: comments} only %}
