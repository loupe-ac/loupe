{# `data-decision-page` names the page the summary is for; decision_controller.js
   drops the stream on any other page. `answers` and the data-decision-unanswered
   figures come from the summary route alone. decision_controller.js and
   review_finish_verdict_controller.js read them from the response, not the DOM. #}
<turbo-stream data-decision-page="{{ page }}" action="update" target="decision-summary-count"
    {%- if answers is defined %} data-decision-answers="{{ answers|json_encode }}"
    data-decision-unanswered="{{ unansweredCount }}"
    data-decision-unanswered-hint="{{ 'review.finish.approve_blocked'|trans({'%count%': unansweredCount}) }}"
    data-decision-first-unanswered="{{ firstUnansweredElementId }}"
    data-decision-pending-threads="{{ pendingThreadCount }}"{% endif %}>
    <template>{{ 'review.document.panels.decisions_count'|trans({'%answered%': answeredCount, '%total%': rows|length}) }}</template>
</turbo-stream>
<turbo-stream data-decision-page="{{ page }}" action="update" target="decision-summary-list">
    <template>{% include '@Review/_decision_summary_rows.html.twig' with {rows: rows} only %}</template>
</turbo-stream>
{# The review bar carries a second copy of the same figures below lg.
   Left out, it reports the state the page was loaded with. #}
<turbo-stream data-decision-page="{{ page }}" action="update" target="review-bar-decisions-count">
    <template>{{ 'review.document.decisions.count'|trans({'%answered%': answeredCount, '%total%': rows|length}) }}</template>
</turbo-stream>
<turbo-stream data-decision-page="{{ page }}" action="update" target="review-bar-decisions-label">
    <template>{{ 'review.bar.decisions_label'|trans({'%answered%': answeredCount, '%total%': rows|length}) }}</template>
</turbo-stream>
<turbo-stream data-decision-page="{{ page }}" action="update" target="review-toolbar-decisions-count">
    <template>{{ 'review.document.decisions.count'|trans({'%answered%': answeredCount, '%total%': rows|length}) }}</template>
</turbo-stream>
<turbo-stream data-decision-page="{{ page }}" action="update" target="review-toolbar-decisions-label">
    <template>{{ 'review.document.panels.decisions_label'|trans({'%answered%': answeredCount, '%total%': rows|length}) }}</template>
</turbo-stream>
<turbo-stream data-decision-page="{{ page }}" action="update" target="review-bar-decisions-head-count">
    <template>{{ 'review.document.decisions.count'|trans({'%answered%': answeredCount, '%total%': rows|length}) }}</template>
</turbo-stream>
<turbo-stream data-decision-page="{{ page }}" action="update" target="review-bar-decisions-list">
    <template>{% include '@Review/_sheet_decision_rows.html.twig' with {rows: rows} only %}</template>
</turbo-stream>
