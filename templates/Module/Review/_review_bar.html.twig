{# The review bar below lg. Each button opens a sheet, and Finish review opens the sheet of the review block.
   Params: document, version, versions, showVersions, showContents, sectionRows,
   referenceCount, decisionRows, decisionsUrl, answeredDecisions,
   showResolvedToggle, showVerdict, diffMode, diffFromVersion, diffViewValue,
   showComments, canComment, comments, openCommentCount. #}
<div class="lp-review-bar" role="group" aria-label="{{ 'review.bar.label'|trans }}" data-controller="review-jump">
    {% if showContents %}
    <div class="lp-review-bar__group" data-controller="sheet">
        <twig:Ds:Button variant="icon" type="button" class="lp-review-bar__button"
                aria-haspopup="dialog" aria-label="{{ 'review.document.contents.label'|trans }}"
                data-action="click->sheet#open">
            <twig:ux:icon name="lucide:list" class="lp-icon lp-icon--lg" />
        </twig:Ds:Button>
        <twig:Ds:Sheet title="{{ 'review.document.contents.label'|trans }}">
            {% include '@Review/_sheet_section_rows.html.twig' with {rows: sectionRows} only %}
        </twig:Ds:Sheet>
    </div>
    {% endif %}

    {% if showComments %}
    <div class="lp-review-bar__group" data-controller="sheet comments-sheet">
        {# Streams update the count and the label by id, so the bar never goes stale. #}
        <twig:Ds:Button variant="icon" type="button" class="lp-review-bar__button"
                aria-haspopup="dialog" data-action="click->sheet#open">
            <twig:ux:icon name="lucide:message-square" class="lp-icon lp-icon--lg" />
            <span class="lp-review-bar__count" id="review-bar-comments-count" aria-hidden="true">{{ openCommentCount }}</span>
            <span class="sr-only" id="review-bar-comments-label">{{ 'review.bar.comments_label'|trans({'%count%': openCommentCount}) }}</span>
        </twig:Ds:Button>
        <twig:Ds:Sheet title="{{ 'review.document.panels.comments'|trans }}">
            <div class="lp-review-sheet__comments-view" data-comments-sheet-target="view" data-status="open">
                <twig:Ds:Tabs tag="div" role="tablist" variant="segmented" aria-label="{{ 'review.document.panels.comments'|trans }}">
                    <button type="button" role="tab" class="lp-tabs__tab" aria-selected="true"
                            data-comments-sheet-target="tab"
                            data-comments-sheet-status-param="open"
                            data-action="click->comments-sheet#choose">{{ 'review.document.margin.filter_open'|trans }}</button>
                    <button type="button" role="tab" class="lp-tabs__tab" aria-selected="false"
                            data-comments-sheet-target="tab"
                            data-comments-sheet-status-param="resolved"
                            data-action="click->comments-sheet#choose">{{ 'review.document.margin.filter_resolved'|trans }}</button>
                </twig:Ds:Tabs>
                {% include '@Review/_comment_sheet_rows.html.twig' with {comments: comments} only %}
            </div>
            {% if canComment %}
            <twig:Ds:Button variant="ghost" type="button" class="lp-review-sheet__whole-document" data-action="click->comment-anchor#commentWholeDocument">
                <twig:ux:icon name="lucide:message-square-plus" class="lp-icon lp-icon--md" />
                {{ 'review.document.comment.whole_document'|trans }}
            </twig:Ds:Button>
            <p class="lp-review-sheet__hint">{{ 'review.bar.comment_hint'|trans }}</p>
            {% endif %}
        </twig:Ds:Sheet>
    </div>
    {% endif %}

    {% if decisionRows|length > 0 %}
    <div class="lp-review-bar__group" data-controller="sheet">
        {# The hidden label is the name of the button, so a screen reader hears the words and never the bare digits. #}
        <twig:Ds:Button variant="icon" type="button" class="lp-review-bar__button"
                aria-haspopup="dialog" data-action="click->sheet#open">
            <twig:ux:icon name="lucide:square-check-big" class="lp-icon lp-icon--lg" />
            <span class="lp-review-bar__count" id="review-bar-decisions-count" aria-hidden="true">{{ 'review.document.decisions.count'|trans({
                '%answered%': answeredDecisions,
                '%total%': decisionRows|length,
            }) }}</span>
            <span class="sr-only" id="review-bar-decisions-label">{{ 'review.bar.decisions_label'|trans({
                '%answered%': answeredDecisions,
                '%total%': decisionRows|length,
            }) }}</span>
        </twig:Ds:Button>
        <twig:Ds:Sheet title="{{ 'review.document.meta.decisions'|trans }}">
            <p class="lp-review-sheet__head">
                <span class="lp-review-sheet__head-count" id="review-bar-decisions-head-count">{{ 'review.document.decisions.count'|trans({
                    '%answered%': answeredDecisions,
                    '%total%': decisionRows|length,
                }) }}</span>
            </p>
            <div id="review-bar-decisions-list">
                {% include '@Review/_sheet_decision_rows.html.twig' with {rows: decisionRows, documentUrl: decisionsUrl} only %}
            </div>
        </twig:Ds:Sheet>
    </div>
    {% endif %}

    {% if showVersions or referenceCount > 0 or showResolvedToggle %}
    <div class="lp-review-bar__more" data-controller="sheet">
        <twig:Ds:Button variant="icon" type="button" class="lp-review-bar__button"
                aria-haspopup="dialog" aria-label="{{ 'review.bar.more'|trans }}"
                data-action="click->sheet#open">
            <twig:ux:icon name="lucide:ellipsis" class="lp-icon lp-icon--lg" />
        </twig:Ds:Button>
        <twig:Ds:Sheet title="{{ 'review.bar.more'|trans }}">
            <div data-sheet-view="more">
                {% if showVersions %}
                <button type="button" class="lp-review-sheet__row"
                        data-sheet-view-param="versions"
                        data-action="click->sheet#show">
                    <twig:ux:icon name="lucide:history" class="lp-icon lp-icon--md" />
                    <span class="lp-review-sheet__label">{{ 'review.document.meta.versions'|trans }}</span>
                    <span class="lp-review-sheet__count">{{ 'v' ~ version.versionNumber }}</span>
                </button>
                {% endif %}
                {% if referenceCount > 0 %}
                <button type="button" class="lp-review-sheet__row"
                        data-sheet-view-param="references"
                        data-action="click->sheet#show">
                    <twig:ux:icon name="lucide:link" class="lp-icon lp-icon--md" />
                    <span class="lp-review-sheet__label">{{ 'review.document.meta.references'|trans }}</span>
                    <span class="lp-review-sheet__count">{{ referenceCount }}</span>
                </button>
                {% endif %}
                {# The comment-anchor controller hides this until a resolved thread
                   exists, and rewrites its text, so the row carries no child. #}
                {% if showResolvedToggle %}
                <button type="button" class="lp-review-sheet__row"
                        data-resolved-toggle
                        data-label-hide="{{ 'review.document.threads.hide_resolved'|trans }}"
                        data-label-show="{{ 'review.document.threads.show_resolved'|trans }}"
                        data-action="click->comment-anchor#toggleResolved click->sheet#close"
                        hidden>{{ 'review.document.threads.hide_resolved'|trans }}</button>
                {% endif %}
            </div>

            {% if showVersions %}
            <div data-sheet-view="versions">
                <p class="lp-review-sheet__head">
                    <span>{{ 'review.document.meta.versions'|trans }}</span>
                    <span class="lp-review-sheet__head-count">{{ versions|length }}</span>
                </p>
                {# The desktop versions panel is display:none below lg, so without
                   this the picker for an arbitrary pair is unreachable here. #}
                {% if diffMode and versions|length > 1 %}
                {% include '@Review/_version_compare_picker.html.twig' with {
                    document: document,
                    versions: versions,
                    fromVersionNumber: diffFromVersion,
                    toVersionNumber: version.versionNumber,
                    viewValue: diffViewValue,
                    idPrefix: 'bar-diff',
                } only %}
                {% endif %}
                {% for meta in versions %}
                <a class="lp-review-sheet__section"
                   href="{{ loop.first
                       ? path('app_document_review', {projectId: document.project.id, documentId: document.id})
                       : path('app_document_review_version', {projectId: document.project.id, documentId: document.id, versionNumber: meta.versionNumber}) }}"
                   {% if meta.versionNumber == version.versionNumber %}aria-current="page"{% endif %}>
                    <span class="lp-review-sheet__label">{{ meta.description ?: ('v' ~ meta.versionNumber) }}</span>
                    <span class="lp-review-sheet__count">{{ 'v' ~ meta.versionNumber }}</span>
                </a>
                {# The desktop panel is hidden below lg, so without this row the diff
                   screen has no way in from the review page. #}
                {% if meta.versionNumber > 1 %}
                <a class="lp-review-sheet__section lp-review-sheet__section--sub"
                   href="{{ path('app_document_review_diff', {projectId: document.project.id, documentId: document.id, fromVersionNumber: meta.versionNumber - 1, toVersionNumber: meta.versionNumber}) }}">
                    <span class="lp-review-sheet__label">{{ 'review.document.diff.link'|trans({'%from%': meta.versionNumber - 1}) }}</span>
                </a>
                {% endif %}
                {% endfor %}
                {# The drawer keeps the whole list, because it overlays the document
                   rather than pushing it down. The row is here so the history page
                   is reachable below lg, where the desktop panel is display:none. #}
                <a class="lp-review-sheet__section" href="{{ path('app_document_review_history', {projectId: document.project.id, documentId: document.id}) }}">
                    <span class="lp-review-sheet__label">{{ 'review.document.version.see_all'|trans({'%count%': versions|length}) }}</span>
                </a>
            </div>
            {% endif %}

            {% if referenceCount > 0 %}
            <div data-sheet-view="references">
                <p class="lp-review-sheet__head">
                    <span>{{ 'review.document.meta.references'|trans }}</span>
                    <span class="lp-review-sheet__head-count">{{ referenceCount }}</span>
                </p>
                {% for group in [
                    {label: 'review.document.references.outgoing', documents: document.references},
                    {label: 'review.document.references.incoming', documents: document.referencedBy},
                ] %}
                    {% for reference in group.documents %}
                    <a class="lp-review-sheet__section" href="{{ path('app_document_review', {projectId: reference.project.id, documentId: reference.id}) }}"
                       title="{{ reference.title|reference_plain }}">
                        <span class="lp-review-sheet__label">{{ reference.title|reference_plain }}</span>
                        <span class="lp-review-sheet__count">{{ group.label|trans }}</span>
                    </a>
                    {% endfor %}
                {% endfor %}
            </div>
            {% endif %}
        </twig:Ds:Sheet>
    </div>
    {% endif %}

    {% if showVerdict %}
    <twig:Ds:Button variant="primary" type="button" class="lp-review-bar__finish" data-controller="review-finish" data-action="click->review-finish#open">
        {{ 'review.document.finish.title'|trans }}
    </twig:Ds:Button>
    {% endif %}
</div>
