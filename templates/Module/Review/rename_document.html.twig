{% extends 'base.html.twig' %}

{% set backPath = path('app_project_documents', {id: document.project.id}|merge(listQuery.routeParams)) %}

{% block title %}{{ 'review.rename.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'nav.link.documents'|trans, url: backPath},
        {label: 'review.rename.page.title'|trans},
    ]" />
{% endblock %}

{% block body %}
<div class="lp-workspace">
    <h1 class="lp-workspace-title">{{ 'review.rename.page.title'|trans }}</h1>
    <p class="lp-workspace-desc">{{ 'review.rename.description'|trans }}</p>

    <div class="max-w-160">
        {{ form_start(form, {'attr': {'class': 'lp-form'}}) }}
            <twig:Ds:FormField :fieldView="form.title" />
            <div class="flex items-center justify-end gap-3 pt-2">
                <twig:Ds:Button variant="ghost" href="{{ backPath }}" class="mr-auto">{{ 'review.rename.cancel'|trans }}</twig:Ds:Button>
                <twig:Ds:Button variant="primary" type="submit">{{ 'review.rename.submit'|trans }}</twig:Ds:Button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
