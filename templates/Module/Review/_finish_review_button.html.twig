{# `inReviewBar`: the page's review bar holds Finish review below lg, so the top bar drops it there. Otherwise the top bar keeps only its icon. #}
<div class="lp-review-topbar-actions {{ inReviewBar ? 'lp-review-topbar-actions--finish' : 'lp-review-topbar-actions--compact' }}">
    <twig:Ds:Button variant="primary" type="button" data-controller="review-finish" data-action="click->review-finish#open" aria-label="{{ 'review.document.finish.title'|trans }}">
        <twig:ux:icon name="lucide:check" />
        <span>{{ 'review.document.finish.title'|trans }}</span>
    </twig:Ds:Button>
</div>
