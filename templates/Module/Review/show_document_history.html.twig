{% extends 'base.html.twig' %}

{% block title %}{{ 'review.document.history.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}


{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'nav.link.documents'|trans, url: path('app_project_documents', {id: document.project.id})},
        {label: document.title|reference_plain, url: path('app_document_review', {projectId: document.project.id, documentId: document.id})},
        {label: 'review.document.history.page.title'|trans},
    ]" />
{% endblock %}

{% block topbar_meta %}
    <span class="lp-topbar__meta">{{ 'review.document.history.count'|trans({'%count%': versions|length}) }}</span>
{% endblock %}

{% block topbar_actions %}
{% if document.status.value in ['draft', 'in-review'] %}
{% include '@Review/_finish_review_button.html.twig' with {inReviewBar: false} only %}
{% endif %}
{% endblock %}

{% block body %}
{% set routeParameters = {projectId: document.project.id, documentId: document.id} %}
{% set latestVersion = versions|first.versionNumber %}
{% set earliestVersion = versions|last.versionNumber %}
{% set finishReviewAvailable = document.status.value in ['draft', 'in-review'] %}
{% do mercure_subscribe(documentTopic) %}
<div class="lp-review" data-site-review-quotes="off" data-controller="{{ finishReviewAvailable ? 'sheet ' : '' }}review-draft-live"
     data-review-draft-live-url-value="{{ path('app_document_draft_state', routeParameters) }}" data-review-draft-live-stopped-value="{{ 'review.draft_band.live_stopped'|trans }}"
     {% if finishReviewAvailable %}data-action="review:finish@window->sheet#open"{% endif %}>
<div class="lp-review-block">
    {% include '@Review/_document_header.html.twig' with {
        document: document,
        version: version,
        versionCount: versions|length,
        activeView: 'history',
        showDocumentActions: true,
        reviseDocumentForm: reviseDocumentForm,
        showPageMenu: false,
        showDraftBand: true,
        draftReviewLoop: draftReviewLoop,
    } only %}
    <div class="lp-history-tools">
        <h2 class="lp-history-title">{{ 'review.document.history.page.title'|trans }}</h2>

        {# A plain GET form, so the picker works with no JavaScript. The diff route
           carries its two versions as path segments, which a GET form cannot build,
           so the action is the redirect route that turns the pair into that path. #}
        {% if versions|length > 1 %}
        <section class="lp-history-compare">
            <form class="lp-version-compare" method="GET" action="{{ path('app_document_review_compare', routeParameters) }}">
                <label class="lp-version-compare__label" for="history-compare-from">{{ 'review.document.diff.picker.from'|trans }}</label>
                <twig:Ds:Select id="history-compare-from" name="from" compact aria-label="{{ 'review.document.diff.picker.from_label'|trans }}">
                    {% for meta in versions %}
                    <option value="{{ meta.versionNumber }}"{{ meta.versionNumber == latestVersion - 1 ? ' selected' : '' }}>{{ 'v' ~ meta.versionNumber }}</option>
                    {% endfor %}
                </twig:Ds:Select>
                <twig:ux:icon name="lucide:arrow-right" class="lp-version-compare__arrow" aria-hidden="true" />
                <label class="lp-version-compare__label" for="history-compare-to">{{ 'review.document.diff.picker.to'|trans }}</label>
                <twig:Ds:Select id="history-compare-to" name="to" compact aria-label="{{ 'review.document.diff.picker.to_label'|trans }}">
                    {% for meta in versions %}
                    <option value="{{ meta.versionNumber }}"{{ meta.versionNumber == latestVersion ? ' selected' : '' }}>{{ 'v' ~ meta.versionNumber }}</option>
                    {% endfor %}
                </twig:Ds:Select>
                <twig:Ds:Button type="submit">{{ 'review.document.diff.picker.submit'|trans }}</twig:Ds:Button>
            </form>
        </section>
        {% endif %}
    </div>

    <twig:Ds:DataTable modifier="history" :label="'review.document.history.table.label'|trans" :columns="[
        {label: 'review.document.history.column.version'|trans},
        {label: 'review.document.history.column.revision'|trans},
        {label: 'review.document.history.column.discussion'|trans},
        {label: 'review.document.history.column.open'|trans},
    ]">
        {% for meta in versions %}
        {% set isLatest = meta.versionNumber == latestVersion %}
        {% set readPath = isLatest
            ? path('app_document_review', routeParameters)
            : path('app_document_review_version', routeParameters|merge({versionNumber: meta.versionNumber})) %}
        <div class="lp-data-table__row lp-history__row{{ isLatest ? ' lp-history__row--current' : '' }}" role="row"
            data-version-number="{{ meta.versionNumber }}">
            <div class="lp-data-table__cell" role="cell"><span class="lp-history__version">{{ 'v' ~ meta.versionNumber }}</span></div>
            <div class="lp-data-table__cell" role="cell">
                {% if meta.description %}
                <strong class="lp-history__note">{{ meta.description }}</strong>
                {% else %}
                <strong class="lp-history__note lp-history__note--empty">{{ (isLatest ? 'review.document.history.current' : 'review.document.history.no_note')|trans }}</strong>
                {% endif %}
                <twig:Ds:RelativeTime :datetime="meta.createdAt" class="lp-history__date" />
            </div>
            <div class="lp-data-table__cell" role="cell">{{ 'review.document.history.threads'|trans({'%count%': meta.threadCount}) }}</div>
            <div class="lp-data-table__cell" role="cell">
                <div class="lp-history__actions">
                    <a class="lp-history__action" href="{{ readPath }}">
                        <twig:ux:icon name="lucide:file-text" />
                        {{ 'review.document.history.read'|trans }}
                    </a>
                    {# The oldest version has no predecessor, so it carries no control. #}
                    {% if meta.versionNumber > earliestVersion %}
                    <a class="lp-history__action lp-history__compare"
                       href="{{ path('app_document_review_diff', routeParameters|merge({fromVersionNumber: meta.versionNumber - 1, toVersionNumber: meta.versionNumber})) }}"
                       aria-label="{{ 'review.document.history.compare_with'|trans({'%from%': meta.versionNumber - 1}) }}">
                        <twig:ux:icon name="lucide:git-compare" />
                        {{ 'review.document.history.diff'|trans }}
                    </a>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endfor %}
    </twig:Ds:DataTable>

    <h2 class="lp-history-title lp-history-title--log">{{ 'review.document.history.reviews'|trans }}</h2>
    <div class="lp-history-surface lp-history-log">
        {% set verdicts = versions|reduce((carry, meta) => carry|merge(meta.reviews|map(review => {review: review, versionNumber: meta.versionNumber})), []) %}
        {% for entry in verdicts %}
        <div class="lp-history__review" data-review-sequence="{{ entry.review.sequence }}">
            <span class="lp-history__verdict lp-history__verdict--{{ entry.review.verdict.value }}">{{ ('review.document.verdict.' ~ entry.review.verdict.value)|trans }}</span>
            <span>{{ entry.review.reviewer.fullName }}</span>
            {% if entry.review.workflowRule %}<twig:Ds:Tag tone="neutral">{{ entry.review.workflowRule }}</twig:Ds:Tag>{% endif %}
            <span class="lp-history__version">{{ 'v' ~ entry.versionNumber }}</span>
            <twig:Ds:RelativeTime :datetime="entry.review.submittedAt" class="lp-history__date" />
            {% if entry.review.workflowRule and entry.review.verdict.value == 'approved' %}<p class="lp-history__review-note">{{ 'review.document.verdict.workflow_approved_note'|trans }}</p>
            {% elseif entry.review.note %}<p class="lp-history__review-note">{{ entry.review.note }}</p>{% endif %}
            {% if entry.review.throughAgent %}<p class="lp-history__review-agent"><twig:ux:icon name="lucide:bot" class="lp-icon lp-icon--sm" aria-hidden="true" />{{ 'review.document.verdict.through_agent'|trans }}</p>{% endif %}
            {% if entry.review.apiKeyId %}<p class="lp-history__review-api-key"><twig:ux:icon name="lucide:key-round" class="lp-icon lp-icon--sm" aria-hidden="true" />{{ entry.review.apiKeyName ? 'review.document.verdict.through_named_api_key'|trans({'%name%': entry.review.apiKeyName}) : 'review.document.verdict.through_api_key'|trans }}</p>{% endif %}
        </div>
        {% else %}
        <p class="lp-history__empty">{{ 'review.document.history.no_verdicts'|trans }}</p>
        {% endfor %}
    </div>
</div>
{% if finishReviewAvailable %}
{% include '@Review/_finish_review.html.twig' with {
    document: document,
    submitReviewForm: submitReviewForm,
    signals: signals,
    decisions: decisions,
    draftReviewLoop: draftReviewLoop,
} only %}
{% endif %}
</div>
{% endblock %}
