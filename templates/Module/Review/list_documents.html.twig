{% extends 'base.html.twig' %}

{% block title %}{{ 'review.dashboard.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'nav.link.documents'|trans},
    ]" />
{% endblock %}

{% block body %}
{# Unfiltered and archive-free, so it can tell "this project has nothing" from
   "the filters matched nothing". Same number the shell's nav pill shows. #}
{% set totalDocuments = project_document_count(project) %}
<twig:Ds:Workspace class="lp-core-prototype-page lp-core-documents" data-live-content data-controller="modal" data-modal-reopen-value="{{ createDocumentForm.vars.submitted ? 'true' : 'false' }}">
    {# The default line promises newest-first, which a ranked search and a series
       both make untrue. The series wins, because its order wins in the query. #}
    {% if listQuery.seriesName %}
        {% set descriptionKey = 'review.dashboard.description_series' %}
    {% elseif listQuery.search %}
        {% set descriptionKey = 'review.dashboard.description_ranked' %}
    {% else %}
        {% set descriptionKey = 'review.dashboard.description' %}
    {% endif %}
    <twig:Ds:PageHeader :title="'review.dashboard.page.title'|trans" :description="descriptionKey|trans" titleClass="lp-workspace-title--doc">
        <twig:block name="actions">
            <twig:Ds:Button variant="primary" type="button" data-action="click->modal#open"><twig:ux:icon name="lucide:plus" class="lp-icon lp-icon--md" />{{ 'review.create.title'|trans }}</twig:Ds:Button>
        </twig:block>
    </twig:Ds:PageHeader>
    {% include '@Review/_create_document.html.twig' with {form: createDocumentForm, projectId: project.id} only %}

    {% do mercure_subscribe(documentsTopic) %}
    {% if page == 1 %}
    <turbo-frame id="documents-live" refresh="morph" target="_top"
                 data-controller="live-region"
                 data-live-region-mode-value="frame"
                 data-live-region-types-value="{{ ['documents.changed']|json_encode|e('html_attr') }}"
                 data-live-region-url-value="{{ path('app_project_documents', {id: project.id}|merge(listQuery.routeParams)) }}">
        {% include '@Review/_documents_list.html.twig' with {project: project, listQuery: listQuery, totalDocuments: totalDocuments, items: items, filteredTotal: filteredTotal, page: page, totalPages: totalPages, pageList: pageList, statuses: statuses, projectTags: projectTags, projectSeries: projectSeries} only %}
    </turbo-frame>
    {% else %}
    <div id="documents-live"
         data-controller="live-region"
         data-live-region-mode-value="rows"
         data-live-region-types-value="{{ ['documents.changed']|json_encode|e('html_attr') }}"
         data-live-region-url-value="{{ path('app_project_documents_live_rows', {id: project.id}|merge(listQuery.routeParams)) }}"
         data-live-since="{{ newest ? newest.createdAt|date('U') : 0 }}"
         data-live-since-id="{{ newest ? newest.id : '' }}"
         data-live-total="{{ filteredTotal }}"{% if knownIds is not null %}
         data-live-known="{{ knownIds|json_encode|e('html_attr') }}"{% endif %}>
        <div id="documents-live-band"></div>
        {% include '@Review/_documents_list.html.twig' with {project: project, listQuery: listQuery, totalDocuments: totalDocuments, items: items, filteredTotal: filteredTotal, page: page, totalPages: totalPages, pageList: pageList, statuses: statuses, projectTags: projectTags, projectSeries: projectSeries} only %}
    </div>
    {% endif %}
</twig:Ds:Workspace>
{% endblock %}
