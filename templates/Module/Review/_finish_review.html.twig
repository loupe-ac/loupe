<twig:Ds:Sheet class="lp-finish-review" title="{{ 'review.document.finish.title'|trans }}">
    <p class="lp-dialog-desc">{{ 'review.document.finish.context'|trans({
        '%version%': submitReviewForm.versionNumber.vars.value,
        '%open%': signals.openThreadCount,
    }) }}</p>
    {% set documentUrl = path('app_document_review', {projectId: document.project.id, documentId: document.id}) %}
    {% set versionNumber = submitReviewForm.versionNumber.vars.value %}
    {% set summaryUrl = versionNumber is empty ? null : path('app_document_decision_summary', {projectId: document.project.id, documentId: document.id, versionNumber: versionNumber}) %}
    {{ form_start(submitReviewForm, {attr: {class: 'lp-form', 'data-controller': 'form-draft review-stop-confirm review-finish-verdict', 'data-review-finish-verdict-summary-url-value': summaryUrl, 'data-review-finish-verdict-document-url-value': documentUrl, 'data-review-stop-confirm-active-value': draftReviewLoop is not null ? 'true' : 'false', 'data-review-stop-confirm-dialog-value': 'review-stop-confirm', 'data-form-draft-owner-value': app.user.id, 'data-form-draft-key-value': 'document:review:' ~ document.id, 'data-action': 'review:finish@window->review-finish-verdict#refresh input->form-draft#remember change->form-draft#remember submit->review-stop-confirm#check submit->form-draft#start turbo:before-fetch-response->form-draft#response form-draft:cleared@document->form-draft#cleared'}}) }}
        {% include '@Review/_draft_notice.html.twig' with {} only %}
        {% if document.status.value == 'draft' %}
        <p class="lp-draft-live-status" role="status" data-review-draft-live-status></p>
        {% include '@Review/_draft_review_warning.html.twig' with {document: document, draftReviewLoop: draftReviewLoop} only %}
        {% endif %}
        <twig:Ds:FieldErrors>{{ form_errors(submitReviewForm) }}{{ form_errors(submitReviewForm.versionNumber) }}</twig:Ds:FieldErrors>
        {{ form_widget(submitReviewForm.versionNumber, {type: 'hidden', attr: {'data-form-draft-target': 'guard'}}) }}
        {{ form_widget(submitReviewForm.expectedReviewId, {attr: {'data-form-draft-target': 'guard'}}) }}
        <twig:Ds:FieldErrors :fieldView="submitReviewForm.expectedReviewId" />
        <twig:Ds:FormField as="fieldset">
            <twig:Ds:Label as="legend">{{ submitReviewForm.verdict.vars.label|trans }}</twig:Ds:Label>
            {% for choice in submitReviewForm.verdict %}
            {% set isApprove = choice.vars.value == 'approved' %}
            {% set blocked = isApprove and decisions.unansweredCount > 0 %}
            <label class="lp-review-verdict-choice{{ blocked ? ' lp-review-verdict-choice--disabled' }}">
                {# The hint describes the choice rather than naming it, so it stays out
                   of the radio's accessible name. A blocked Approve points at its reason. #}
                {{ form_widget(choice, {attr: {'data-form-draft-target': 'option', 'data-review-finish-verdict-target': isApprove ? 'approve' : 'changes', 'aria-describedby': choice.vars.id ~ (blocked ? '_reason' : '_hint'), disabled: blocked}}) }}
                <span class="lp-review-verdict-choice__text">
                    <span class="lp-review-verdict-choice__label">{{ choice.vars.label|trans }}</span>
                    <span class="lp-review-verdict-choice__hint" id="{{ choice.vars.id }}_hint" aria-hidden="true"{% if isApprove %} data-review-finish-verdict-target="hint"{% if blocked %} hidden{% endif %}{% endif %}>{{ ('review.document.finish.hint.' ~ choice.vars.value|replace({'-': '_'}))|trans }}</span>
                    {% if isApprove %}
                    <span class="lp-review-verdict-choice__reason" id="{{ choice.vars.id }}_reason" data-review-finish-verdict-target="reason"{% if not blocked %} hidden{% endif %}>
                        <span data-review-finish-verdict-target="reasonText">{{ 'review.finish.approve_blocked'|trans({'%count%': decisions.unansweredCount}) }}</span>
                        <a href="{{ documentUrl }}#{{ decisions.firstUnansweredElementId }}" data-review-finish-verdict-target="link" data-action="click->review-finish-verdict#go">{{ 'review.finish.approve_blocked_link'|trans }}</a>
                    </span>
                    {% endif %}
                </span>
            </label>
            {% endfor %}
            <twig:Ds:FieldErrors :fieldView="submitReviewForm.verdict" />
        </twig:Ds:FormField>
        <twig:Ds:FormField :fieldView="submitReviewForm.note" widgetKind="textarea" :widgetAttr="{rows: 3, 'data-form-draft-target': 'text'}" :hintText="submitReviewForm.note.vars.help|trans" />
        {% if not submitReviewForm.versionNumber.vars.valid or not submitReviewForm.expectedReviewId.vars.valid %}
        <twig:Ds:Button href="{{ path('app_document_review', {projectId: document.project.id, documentId: document.id}) }}">{{ 'review.document.version.back_to_latest'|trans }}</twig:Ds:Button>
        {% endif %}
        <div class="lp-review-verdict-actions">
            <twig:Ds:Button variant="ghost" type="button" data-action="click->sheet#close">{{ 'review.document.finish.cancel'|trans }}</twig:Ds:Button>
            <twig:Ds:Button variant="primary" type="submit">{{ 'review.document.finish.submit'|trans }}</twig:Ds:Button>
        </div>
    {{ form_end(submitReviewForm) }}
</twig:Ds:Sheet>
{% if document.status.value == 'draft' %}
<div id="review-stop-confirm" data-controller="modal" data-action="review:stop-confirm@window->modal#open">
    <twig:Ds:Dialog aria-labelledby="review-stop-confirm-title" data-action="cancel->modal#close">
        <h2 class="lp-dialog-title" id="review-stop-confirm-title">{{ 'review.document.finish.stop_confirm.title'|trans }}</h2>
        <p class="lp-dialog-desc" data-review-stop-confirm-lead></p>
        <p class="lp-draft-review-stop__body" data-review-stop-confirm-body></p>
        <twig:Ds:FormActions>
            <twig:Ds:Button variant="ghost" type="button" data-action="click->modal#close">{{ 'review.document.finish.stop_confirm.back'|trans }}</twig:Ds:Button>
            <twig:Ds:Button variant="danger" type="button" data-review-stop-confirm-confirm data-action="click->modal#close"></twig:Ds:Button>
        </twig:Ds:FormActions>
    </twig:Ds:Dialog>
</div>
{% endif %}
