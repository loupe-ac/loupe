{% extends '@Account/_settings_layout.html.twig' %}

{% block title %}{{ 'billing.subscribe.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'nav.link.account'|trans, url: path('app_account_profile')},
        {label: 'nav.link.billing'|trans},
    ]" />
{% endblock %}

{% block settings_section 'billing' %}

{% block settings_content %}
<twig:Ds:Panel as="section" class="lp-connect-block" data-testid="billing-section">
    <twig:Ds:SectionHeading>{{ 'billing.subscribe.heading'|trans }}</twig:Ds:SectionHeading>
    <p class="lp-connect-hint">{{ 'billing.subscribe.description'|trans }}</p>

    {% do mercure_subscribe(account_topic(app.user)) %}
    {% include '@Billing/_subscribe_frame.html.twig' with {view: view} only %}
</twig:Ds:Panel>
{% endblock %}
