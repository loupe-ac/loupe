{% extends '@Account/auth_base.html.twig' %}

{% block title %}{{ 'billing.beta_invite.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block auth_body %}
<div class="flex flex-col gap-3 py-4 text-center">
    <h1 class="text-xl font-semibold tracking-tight text-fg">{{ 'billing.beta_invite.sign_up.heading'|trans }}</h1>
    <p class="text-fg-mute text-sm leading-normal">{{ 'billing.beta_invite.sign_up.description'|trans }}</p>

    <twig:Ds:ActionForm :action="path('app_billing_beta_invite_claim', {token: token})" token="billing-beta-invite-claim" data-beta-sign-up-form>
        <button type="submit" class="auth-submit mt-1.5">{{ 'billing.beta_invite.sign_up.submit'|trans }}</button>
    </twig:Ds:ActionForm>
</div>
{% endblock %}
