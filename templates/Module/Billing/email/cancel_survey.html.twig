{% extends 'email/_layout.html.twig' %}

{% block title %}{{ 'billing.email.cancel_survey.subject'|trans }}{% endblock %}

{% block content %}
    <h1>{{ 'billing.email.cancel_survey.heading'|trans }}</h1>
    <p class="body-text">{{ 'billing.email.cancel_survey.body'|trans }}</p>
    <a href="{{ surveyUrl }}" class="btn">{{ 'billing.email.cancel_survey.button_label'|trans }}</a>
{% endblock %}

{% block footer %}
    {{ 'billing.email.survey.footer_copy_link'|trans }} {{ surveyUrl }}
{% endblock %}
