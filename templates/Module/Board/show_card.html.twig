{% extends 'base.html.twig' %}

{% block title %}{{ card.title|reference_plain }} — {{ 'app.name'|trans }}{% endblock %}

{% block flash_messages %}
    {% if app.request.headers.get('Turbo-Frame') != 'card-drawer-frame' and not app.request.headers.has('X-Loupe-Live-Refresh') %}{{ parent() }}{% endif %}
{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'nav.link.board'|trans, url: path('app_project_board', {id: card.project.id})},
        {label: '#' ~ card.number},
    ]" />
{% endblock %}

{% block body %}
{% set inDrawer = app.request.headers.get('Turbo-Frame') == 'card-drawer-frame' %}
{% set tabs = ['overview', 'details', 'conversation', 'feedback', 'history'] %}
{% set activeTab = app.request.query.get('tab') in tabs ? app.request.query.get('tab') : 'overview' %}
{# In the board drawer the host page subscribes, and a frame response would replace its cookie. #}
{% if not inDrawer %}
    {% do mercure_subscribe(board_topic(card.project)) %}
    {% do mercure_subscribe(worker_runs_topic(card.project)) %}
{% endif %}
<turbo-frame id="card-drawer-frame"{% if not inDrawer %} target="_top"{% endif %}>
<div class="lp-card-drawer" data-card-drawer-card-id="{{ card.id }}" data-controller="panel-tabs card-live" data-panel-tabs-active-value="{{ activeTab }}" data-card-live-card-id-value="{{ card.id }}" data-card-live-url-value="{{ path('app_board_card', {projectId: card.project.id, cardId: card.id}) }}" data-card-live-frame-value="{{ inDrawer ? 'true' : 'false' }}">
    {% if inDrawer and not app.request.headers.has('X-Loupe-Live-Refresh') %}
        {% include '_flash_messages.html.twig' with {flashes: app.flashes(['success', 'error', 'warning', 'info'])} only %}
    {% endif %}
    <header class="lp-card-drawer__header">
        <div class="lp-card-drawer__identity">
            <span class="lp-card-drawer__icon"><twig:ux:icon name="lucide:layout-list" class="lp-icon lp-icon--md" /></span>
            <span class="lp-card-number">#{{ card.number }}</span>
            {% include '@Board/_card_type_tag.html.twig' with {card: card} only %}
            {% include '@Board/_card_source_tag.html.twig' with {card: card, class: 'lp-card-drawer__source'} only %}
            {% include '@Board/_column_tag.html.twig' with {column: card.column} only %}
        </div>
        <div class="lp-card-drawer__header-actions">
            <twig:Ds:Button variant="ghost" href="{{ path('app_board_card_edit', {projectId: card.project.id, cardId: card.id}) }}"><twig:ux:icon name="lucide:pencil" class="lp-icon lp-icon--md" />{{ 'board.card.edit.action'|trans }}</twig:Ds:Button>
            <twig:Ds:Button variant="ghost icon" href="{{ path('app_project_board', {id: card.project.id}) }}" aria-label="{{ 'board.card.drawer.close'|trans }}" data-action="card-drawer#close"><twig:ux:icon name="lucide:x" class="lp-icon lp-icon--md" /></twig:Ds:Button>
        </div>
    </header>

    <div class="lp-card-drawer__body">
        <h1 class="lp-card-drawer__title">{{ card.title|reference_plain }}</h1>
        <twig:Ds:Tabs tag="div" role="tablist" aria-label="{{ 'board.card.drawer.sections'|trans }}">
            {% for tab in tabs %}
            <button type="button" class="lp-tabs__tab" role="tab" id="card-tab-{{ tab }}" aria-controls="card-panel-{{ tab }}" aria-selected="{{ tab == activeTab ? 'true' : 'false' }}" tabindex="{{ tab == activeTab ? '0' : '-1' }}" data-panel-tabs-target="tab" data-panel-tab="{{ tab }}" data-action="click->panel-tabs#select keydown->panel-tabs#keydown">{{ ('board.card.tab.' ~ tab)|trans }}</button>
            {% endfor %}
        </twig:Ds:Tabs>

        <section class="lp-card-panel" id="card-panel-overview" role="tabpanel" aria-labelledby="card-tab-overview" data-panel-tabs-target="panel" data-panel-panel="overview"{% if activeTab != 'overview' %} hidden{% endif %}>
            <div class="lp-card-overview">
                {% if not markers.isEmpty %}
                {% set primary = markers.primary %}
                {% set stateName = primary.kind.translationKey|trans %}
                {% set stateFields = [{label: primary.kind.sinceLabelKey|trans, value: card_state_text('board.card_state.since_value', primary.since)}] %}
                {% if primary.remedy is not null %}
                {% set stateFields = stateFields|merge([{label: primary.kind.remedyLabelKey|trans, value: primary.remedy|trans(primary.params), wide: true, link: primary.link is null ? null : {href: marker_link_href(primary.link, card.project), label: primary.link.translationKey|trans}}]) %}
                {% endif %}
                <div class="lp-card-overview__state">
                <twig:Ds:StatusBox
                    :kind="primary.kind.value"
                    :title="'board.card_state.status'|trans"
                    :chip="card_state_text('board.card_state.held_for', primary.since, 'duration', {'%state%': stateName})"
                    :lead="card_marker_label(primary)"
                    :fields="stateFields"
                    :othersTitle="'board.card_state.others'|trans"
                    :others="markers.alsoApplies|map(other => {kind: other.kind.value, label: other.kind.translationKey|trans, lead: card_marker_label(other), since: card_state_text(other.kind.sinceKey, other.since), link: other.link is null ? null : {href: marker_link_href(other.link, card.project), label: other.link.translationKey|trans}})"
                    data-card-state="{{ primary.kind.value }}"
                />
                {% if primary.label == 'marker.usage_limit' and (primary.params['%canTryNow%'] ?? 0) == 1 and (primary.params['%bridgeId%'] ?? '') != '' and is_granted('project.manage', card.project) %}
                <twig:Ds:ActionForm :action="path('app_project_bridge_account_try_now', {id: card.project.id, bridgeId: primary.params['%bridgeId%'], account: primary.params['%account%']})" token="bridge-try-now" frame="_top" data-card-try-now>
                    <twig:Ds:Button type="submit" variant="ghost" size="sm">
                        <twig:ux:icon name="lucide:circle-play" class="lp-icon lp-icon--sm" />
                        {{ 'board.card_state.try_now'|trans }}
                    </twig:Ds:Button>
                </twig:Ds:ActionForm>
                {% endif %}
                </div>
                {% endif %}
                <section class="lp-card-overview__section">
                    <twig:Ds:SectionHeading>{{ 'board.card.overview.description'|trans }}</twig:Ds:SectionHeading>
                    {% if card.body|trim is not empty %}{% apply link_references(card.project) %}<div class="prose lp-prose lp-card-detail__body" data-references>{{ card.body|card_body }}</div>{% endapply %}{% else %}<p class="lp-card-detail__empty">{{ 'board.card.body.empty'|trans }}</p>{% endif %}
                </section>
                <section class="lp-card-docs lp-card-pulls lp-card-overview__section">
                    {% if card.documents|length > 0 or card.pullRequests|length > 0 %}
                    <div class="lp-inbox-linked-table-wrap">
                        <table class="lp-inbox-linked-table">
                            <caption>{{ 'board.card.linked_work.title'|trans }}</caption>
                            <thead><tr><th>{{ 'inbox.linked_items.item'|trans }}</th><th>{{ 'inbox.linked_items.status'|trans }}</th><th><span class="sr-only">{{ 'inbox.linked_items.open'|trans }}</span></th></tr></thead>
                            <tbody>
                                {% for link in card.documents %}
                                <tr>
                                    <td><span class="lp-inbox-linked-table__type"><twig:ux:icon name="lucide:file-text" class="lp-icon lp-icon--md" />{{ 'inbox.linked_items.document'|trans }}</span><strong>{{ link.document.title|reference_plain }}</strong></td>
                                    <td><twig:Ds:Tag>{{ link.document.status.translationKey()|trans }}</twig:Ds:Tag></td>
                                    <td><twig:Ds:Button variant="ghost open" href="{{ path('app_document_review', {projectId: card.project.id, documentId: link.document.id}) }}" data-turbo-frame="_top" aria-label="{{ 'inbox.linked_items.open_document'|trans({'%title%': link.document.title|reference_plain}) }}"><twig:ux:icon name="lucide:arrow-up-right" class="lp-icon lp-icon--md" /><span class="lp-btn__label">{{ 'inbox.linked_items.open'|trans }}</span></twig:Ds:Button></td>
                                </tr>
                                {% endfor %}
                                {% for link in card.pullRequests %}
                                    {% include '@Board/_linked_pull_request.html.twig' with {link: link, state: pullRequestStates.of(link), agentReview: agentReviews[link.id ~ ''] ?? null} only %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}<twig:Ds:SectionHeading>{{ 'board.card.linked_work.title'|trans }}</twig:Ds:SectionHeading><p class="lp-card-detail__empty">{{ 'board.card.linked_work.empty'|trans }}</p>{% endif %}
                </section>
                {% if artifacts is not empty and is_feature_enabled('artifacts.enabled') %}
                <section class="lp-card-overview__section" data-card-artifacts>
                    <div class="lp-inbox-linked-table-wrap">
                        <table class="lp-inbox-linked-table">
                            <caption>{{ 'board.card.artifacts.title'|trans }}</caption>
                            <thead><tr><th>{{ 'inbox.linked_items.item'|trans }}</th><th>{{ 'board.card.artifacts.version'|trans }}</th><th><span class="sr-only">{{ 'inbox.linked_items.open'|trans }}</span></th></tr></thead>
                            <tbody>
                                {% for entry in artifacts %}
                                {% set artifact = entry.link.artifact %}
                                <tr data-card-artifact="{{ artifact.id }}">
                                    <td><span class="lp-inbox-linked-table__type"><twig:ux:icon name="lucide:app-window" class="lp-icon lp-icon--md" />{{ 'board.card.artifacts.type'|trans }}</span><strong>{{ artifact.name }}</strong></td>
                                    <td><twig:Ds:Tag>{{ 'board.card.artifacts.latest_version'|trans({'%number%': entry.versionNumber}) }}</twig:Ds:Tag></td>
                                    <td><twig:Ds:Button variant="ghost open" href="{{ path('app_project_artifact', {id: card.project.id, artifactId: artifact.id}) }}" data-turbo-frame="_top" aria-label="{{ 'board.card.artifacts.open'|trans({'%name%': artifact.name}) }}"><span class="lp-btn__label">{{ 'inbox.linked_items.open'|trans }}</span><twig:ux:icon name="lucide:chevron-right" class="lp-icon lp-icon--md" /></twig:Ds:Button></td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </section>
                {% endif %}
                {% if card.parent %}
                <section class="lp-card-overview__section" data-card-parent>
                    <div class="lp-inbox-linked-table-wrap">
                        <table class="lp-inbox-linked-table">
                            <caption>{{ 'board.card.parent.title'|trans }}</caption>
                            <thead><tr><th>{{ 'inbox.linked_items.item'|trans }}</th><th>{{ 'inbox.linked_items.status'|trans }}</th><th><span class="sr-only">{{ 'inbox.linked_items.open'|trans }}</span></th></tr></thead>
                            <tbody>
                                {% include '@Board/_linked_card_row.html.twig' with {card: card.parent, href: path('app_board_card', {projectId: card.project.id, cardId: card.parent.id}), drawer: true} only %}
                            </tbody>
                        </table>
                    </div>
                </section>
                {% endif %}
                {% if progress %}
                <section class="lp-card-overview__section" data-epic-children>
                    <div class="lp-card-epic__head">
                        <twig:Ds:SectionHeading>{{ 'board.card.children.title'|trans }}</twig:Ds:SectionHeading>
                        <span class="lp-card-epic__progress" data-epic-progress>{{ 'board.card.children.progress'|trans({'%done%': progress.done, '%total%': progress.total}) }}</span>
                        {% include '@Board/_card_lane_form.html.twig' with {card: card, returnTo: 'card'} only %}
                    </div>
                    {% if children|length > 0 %}
                    <div class="lp-inbox-linked-table-wrap">
                        <table class="lp-inbox-linked-table">
                            <thead><tr><th>{{ 'inbox.linked_items.item'|trans }}</th><th>{{ 'inbox.linked_items.status'|trans }}</th><th><span class="sr-only">{{ 'inbox.linked_items.open'|trans }}</span></th></tr></thead>
                            <tbody>
                                {% for child in children %}
                                    {% include '@Board/_linked_card_row.html.twig' with {card: child, href: path('app_board_card', {projectId: child.project.id, cardId: child.id}), drawer: true} only %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}<p class="lp-card-detail__empty">{{ 'board.card.children.empty'|trans }}</p>{% endif %}
                </section>
                {% endif %}
                {% if relatedCards|length > 0 %}
                <section class="lp-card-overview__section" data-linked-cards>
                    <div class="lp-inbox-linked-table-wrap">
                        <table class="lp-inbox-linked-table lp-inbox-linked-table--kind">
                            <caption>{{ 'board.card.linked_cards.title'|trans }}</caption>
                            <thead><tr><th>{{ 'board.card.linked_cards.relation'|trans }}</th><th>{{ 'inbox.linked_items.item'|trans }}</th><th>{{ 'inbox.linked_items.status'|trans }}</th><th><span class="sr-only">{{ 'inbox.linked_items.open'|trans }}</span></th></tr></thead>
                            <tbody>
                                {% for related in relatedCards %}
                                    {% include '@Board/_linked_card_row.html.twig' with {card: related.card, href: path('app_board_card', {projectId: related.card.project.id, cardId: related.card.id}), drawer: true, kind: related.kind} only %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </section>
                {% endif %}
                {{ workflow_card_panel(card.snapshot()) }}
                {{ oauth_preview_sign_in_panel(card.project, card.id) }}
                {% include '@Bridge/_card_worker_runs.html.twig' with {project: card.project, cardId: card.id ~ ''} only %}
            </div>
        </section>
        <section class="lp-card-panel" id="card-panel-details" role="tabpanel" aria-labelledby="card-tab-details" data-panel-tabs-target="panel" data-panel-panel="details"{% if activeTab != 'details' %} hidden{% endif %}>
            <dl class="lp-card-fields" aria-label="{{ 'board.card.tab.details'|trans }}">
                <div class="lp-card-field lp-card-field--wide">
                    <dt>{{ 'board.card.overview.status'|trans }}</dt>
                    <dd>
                        {% set moveForm = card_move_form(card) %}
                        {# Turbo is off: the move answers with a redirect to the board. #}
                        <form method="post" data-turbo="false" action="{{ path('app_board_card_move', {projectId: card.project.id, cardId: card.id}) }}" class="lp-card-move__form" data-controller="submit-on-change">
                            {{ form_widget(moveForm._token) }}
                            {{ form_label(moveForm.column, null, {label_attr: {class: 'sr-only'}}) }}
                            {{ form_widget(moveForm.column, {attr: {class: ds_input_class('select') ~ ' lp-card-move__select', 'data-action': 'change->submit-on-change#submit'}}) }}
                            {{ form_widget(moveForm.position, {attr: {hidden: 'hidden'}}) }}
                            <noscript><twig:Ds:Button type="submit">{{ 'board.card.move.submit'|trans }}</twig:Ds:Button></noscript>
                        </form>
                    </dd>
                </div>
                <div class="lp-card-field lp-card-field--prose" data-card-human-review>
                    <dt>{{ 'board.card.human_review.field'|trans }}</dt>
                    <dd>{% include '@Board/_card_human_review.html.twig' with {card: card, error: null} only %}</dd>
                </div>
                {% include '@Board/_card_values.html.twig' with {card: card, values: values} only %}
                <div class="lp-card-field"><dt>{{ 'board.card.overview.type'|trans }}</dt><dd>{% include '@Board/_card_type_tag.html.twig' with {card: card} only %}</dd></div>
                <div class="lp-card-field"><dt>{{ 'board.card.overview.reporter'|trans }}</dt><dd>{{ ('board.card.reporter.' ~ card.reporter.value)|trans }}</dd></div>
                <div class="lp-card-field"><dt>{{ 'board.card.overview.source'|trans }}</dt><dd>{{ ('board.card.source.' ~ card.source.kind.value)|trans }}</dd></div>
                <div class="lp-card-field"><dt>{{ 'board.card.overview.created'|trans }}</dt><dd><twig:Ds:RelativeTime :datetime="card.createdAt" mode="date" /></dd></div>
                <div class="lp-card-field"><dt>{{ 'board.card.overview.updated'|trans }}</dt><dd><twig:Ds:RelativeTime :datetime="card.updatedAt" /></dd></div>
                {% if card.completedAt %}<div class="lp-card-field"><dt>{{ 'board.card.overview.completed'|trans }}</dt><dd><twig:Ds:RelativeTime :datetime="card.completedAt" mode="date" /></dd></div>{% endif %}
            </dl>
        </section>

        <section class="lp-card-panel" id="card-panel-conversation" role="tabpanel" aria-labelledby="card-tab-conversation" data-panel-tabs-target="panel" data-panel-panel="conversation"{% if activeTab != 'conversation' %} hidden{% endif %}>
            <div class="lp-card-conversation-intro"><twig:Ds:Avatar icon="lucide:messages-square" size="sm" shape="square" tone="tint" /><twig:Ds:SectionHeading :description="'board.card.conversation.description'|trans">{{ 'board.card.conversation.title'|trans }}</twig:Ds:SectionHeading></div>
            {{ inbox_card_section(card) }}
        </section>

        <section class="lp-card-panel" id="card-panel-feedback" role="tabpanel" aria-labelledby="card-tab-feedback" data-panel-tabs-target="panel" data-panel-panel="feedback"{% if activeTab != 'feedback' %} hidden{% endif %}>
            <div class="lp-card-conversation-intro"><twig:Ds:Avatar icon="lucide:globe-2" size="sm" shape="square" tone="tint" /><twig:Ds:SectionHeading :description="'board.card.feedback.description'|trans">{{ 'board.card.site_review.title'|trans }}</twig:Ds:SectionHeading></div>
            {% if siteReviewLinks|length > 0 %}
            <ul class="lp-card-feedback-list">
                {% for link in siteReviewLinks %}
                    <li>{% include '@Board/_feedback_entry.html.twig' with {link: link, surface: 'feedback', screenshotSizes: screenshotSizes} only %}</li>
                {% endfor %}
            </ul>
            {% else %}<p class="lp-card-detail__empty">{{ 'board.card.site_review.empty'|trans }}</p>{% endif %}
        </section>

        <section class="lp-card-panel" id="card-panel-history" role="tabpanel" aria-labelledby="card-tab-history" data-panel-tabs-target="panel" data-panel-panel="history"{% if activeTab != 'history' %} hidden{% endif %}>
            {% if history.entries is not empty %}
            <div data-card-history>{% include '@Board/_card_history_entries.html.twig' with {history: history} only %}</div>
            {% else %}<p class="lp-card-detail__empty" data-card-history-empty>{{ 'board.card.history.empty'|trans }}</p>{% endif %}
        </section>
    </div>

    <footer class="lp-card-drawer__footer">
        <div data-controller="modal">
            <twig:Ds:Button variant="danger" type="button" data-action="click->modal#open">{{ 'board.card.delete.action'|trans }}</twig:Ds:Button>
            <twig:Ds:Dialog><h3 class="lp-dialog-title">{{ 'board.card.delete.confirm.title'|trans }}</h3><p class="lp-dialog-desc">{{ 'board.card.delete.confirm.body'|trans({'%title%': card.title|reference_plain}) }}</p><form method="post" action="{{ path('app_board_card_delete', {projectId: card.project.id, cardId: card.id}) }}" class="flex items-center justify-end gap-3 pt-2" data-turbo-frame="_top" data-card-delete><input type="hidden" name="_csrf_token" value="{{ csrf_token('board-card-delete') }}"><twig:Ds:Button type="button" data-action="click->modal#close">{{ 'board.card.delete.confirm.cancel'|trans }}</twig:Ds:Button><twig:Ds:Button variant="danger" type="submit">{{ 'board.card.delete.confirm.submit'|trans }}</twig:Ds:Button></form></twig:Ds:Dialog>
        </div>
    </footer>
</div>
</turbo-frame>
{% endblock %}
