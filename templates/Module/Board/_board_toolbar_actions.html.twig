{# The board settings link and the Board or List switch. Props: projectId (string), backlogCount (int), inMenu (bool): true in the phone "…" menu, where a switch also closes the menu. #}
{% set close = inMenu ? ' popover#close' : '' %}
{% if inMenu %}
<twig:Ds:MenuItem :href="path('app_project_board_backlog', {projectId: projectId})" title="{{ 'board.backlog.button.hint'|trans }}">
    <twig:ux:icon name="lucide:inbox" class="lp-icon lp-icon--md" />
    {{ 'board.backlog.button'|trans }}
    <span class="lp-board-backlog__count ml-auto" data-board-backlog-count>{{ backlogCount }}</span>
</twig:Ds:MenuItem>
<twig:Ds:MenuItem :href="path('app_board_settings', {id: projectId})">
    <twig:ux:icon name="lucide:settings" class="lp-icon lp-icon--md" />
    {{ 'board.settings.action'|trans }}
</twig:Ds:MenuItem>
{% else %}
<twig:Ds:Button variant="ghost icon"
   href="{{ path('app_board_settings', {id: projectId}) }}"
   aria-label="{{ 'board.settings.action'|trans }}"
   title="{{ 'board.settings.action'|trans }}">
    <twig:ux:icon name="lucide:settings" class="lp-icon lp-icon--md" />
</twig:Ds:Button>
{% endif %}
<div class="lp-board-toolbar__mode" aria-label="{{ 'board.view.label'|trans }}">
    <button type="button"
            class="lp-board-toolbar__mode-button"
            aria-pressed="true"
            data-board-view-target="boardButton"
            data-action="board-view#showBoard{{ close }}">
        <twig:ux:icon name="lucide:square-kanban" class="lp-icon lp-icon--md" />
        {{ 'board.view.board'|trans }}
    </button>
    <button type="button"
            class="lp-board-toolbar__mode-button"
            aria-pressed="false"
            data-board-view-target="listButton"
            data-action="board-view#showList{{ close }}">
        <twig:ux:icon name="lucide:list" class="lp-icon lp-icon--md" />
        {{ 'board.view.list'|trans }}
    </button>
</div>
