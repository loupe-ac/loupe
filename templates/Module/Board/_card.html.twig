{# One card face. The whole card is the drag handle, and the Move button opens the Move sheet.
   Props: card (Card), pendingComments (int), documentCount (int), static (bool, optional): a card shown outside the board,
   which does not drag, skips the prefetch and names its column. progress (CardProgress, optional) shows on an epic.
   inLane (bool, optional) hides the parent tag its lane gives. markers (?StoredCardMarkers, optional) draws the one state mark.
   inboxItem (?int, optional) is the number of its open inbox item, which the mark links. runWarning, markers and inboxItem feed the digest. #}
{% set static = static ?? false %}
{% set markers = markers ?? null %}
{% set inboxItem = inboxItem ?? null %}
{% set progress = progress ?? null %}
{% set inLane = inLane ?? false %}
{% set runWarning = runWarning ?? null %}
<article class="lp-board-card{{ static ? ' lp-board-card--static' }}"
         {% if not static %}data-controller="card-prefetch"
         data-board-drag-target="card"
         data-board-view-target="card"
         data-action="pointerdown->board-drag#press mouseenter->card-prefetch#enter mouseleave->card-prefetch#leave focusin->card-prefetch#enter"
         id="board-card-{{ card.id }}"
         data-card-digest="{{ card_digest(card, pendingComments, documentCount, progress, runWarning, markers, inboxItem) }}"{% endif %}
         data-card-id="{{ card.id }}"
         data-card-type="{{ card.type }}"
         data-card-lane="{{ card_type(card).lane ? 'true' : 'false' }}"
         data-card-title="{{ card.title|reference_plain }}">
    {# The identifier and the card's type lead the card face, as the design draws
       them. The number is the handle a person quotes. #}
    <div class="lp-board-card__identity">
        <span class="lp-board-card__number">#{{ card.number }}</span>
        {% include '@Board/_card_type_tag.html.twig' with {card: card} only %}
        {% include '@Board/_card_source_tag.html.twig' with {card: card} only %}
        {% if card.parent and not inLane %}
        {% embed '@Board/_card_marker.html.twig' with {class: 'lp-board-card__parent', marker: 'data-card-parent-tag', tooltip: 'board.card.parent.tooltip'|trans({'%number%': card.parent.number, '%title%': card.parent.title|reference_plain}), card: card} only %}
            {% block marker %}<twig:ux:icon name="lucide:arrow-up" class="lp-icon lp-icon--xs" aria-hidden="true" />#{{ card.parent.number }}{% endblock %}
        {% endembed %}
        {% endif %}
        {% if progress %}
        {% embed '@Board/_card_marker.html.twig' with {class: 'lp-board-card__progress', marker: 'data-card-progress', tooltip: 'board.card.children.progress_tooltip'|trans({'%done%': progress.done, '%total%': progress.total}), progress: progress} only %}
            {% block marker %}{{ 'board.card.children.progress'|trans({'%done%': progress.done, '%total%': progress.total}) }}{% endblock %}
        {% endembed %}
        {% endif %}
        {% if markers is not null %}
        {% include '@Board/_card_state_mark.html.twig' with {card: card, markers: markers, inboxItem: inboxItem, link: true} only %}
        {% endif %}
        {% if not static %}
        <twig:Ds:Button variant="ghost icon"
                class="lp-board-card__move"
                aria-label="{{ 'board.card.move.label'|trans({'%number%': card.number}) }}"
                data-action="click->card-move#open"
                data-card-move-id-param="{{ card.id }}"
                data-card-move-number-param="{{ card.number }}"><twig:ux:icon name="lucide:ellipsis" class="lp-icon lp-icon--md" /></twig:Ds:Button>
        {% endif %}
    </div>
    {# draggable="false" stops the browser's own link drag taking the gesture. #}
    <a class="lp-board-card__title"
       data-card-prefetch-target="link"
       draggable="false"
       href="{{ path('app_board_card', {projectId: card.project.id, cardId: card.id}) }}"
       data-turbo-frame="card-drawer-frame"
       data-drawer-title="#{{ card.number }}"
       data-action="click->card-drawer#prepare">
        {{ card.title|reference_plain }}
    </a>
    {% if static %}
    <twig:Ds:StatusChip :dot="false" class="lp-board-card__status">{{ card.column.label|trans }}</twig:Ds:StatusChip>
    {% endif %}
    {% if pendingComments > 0 or card.pullRequests|length > 0 or documentCount > 0 %}
    <div class="lp-board-card__meta">
        {% if pendingComments > 0 %}
        {% embed '@Board/_card_marker.html.twig' with {class: 'lp-board-card__reviews', tooltip: 'board.card.site_review.count'|trans({'%count%': pendingComments}), count: pendingComments} only %}
            {% block marker %}<twig:ux:icon name="lucide:message-square" class="lp-icon lp-icon--sm" aria-hidden="true" />{{ count }}{% endblock %}
        {% endembed %}
        {% endif %}
        {% if card.pullRequests|length > 0 %}
        {% embed '@Board/_card_marker.html.twig' with {class: 'lp-board-card__pulls', tooltip: 'board.card.pull_requests.count'|trans({'%count%': card.pullRequests|length}), count: card.pullRequests|length} only %}
            {% block marker %}<twig:ux:icon name="lucide:git-pull-request" class="lp-icon lp-icon--sm" aria-hidden="true" />{{ count }}{% endblock %}
        {% endembed %}
        {% endif %}
        {% if documentCount > 0 %}
        {% embed '@Board/_card_marker.html.twig' with {class: 'lp-board-card__documents', tooltip: 'board.card.documents.count'|trans({'%count%': documentCount}), count: documentCount} only %}
            {% block marker %}<twig:ux:icon name="lucide:file-text" class="lp-icon lp-icon--sm" aria-hidden="true" />{{ count }}{% endblock %}
        {% endembed %}
        {% endif %}
    </div>
    {% endif %}
</article>
