{% extends 'base.html.twig' %}

{% block title %}{{ column.label|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'nav.link.board'|trans, url: path('app_project_board', {id: project.id})},
        {label: column.label|trans},
    ]" />
{% endblock %}

{% block body %}
{% do mercure_subscribe(board_topic(project)) %}
<twig:Ds:Workspace>
    <h1 class="lp-workspace-title lp-workspace-title--doc">{{ column.label|trans }}</h1>
    <p class="lp-workspace-desc">{{ 'board.terminal.page.description'|trans }}</p>

    {% set liveRows = page > 1 %}
    {% set liveTag = liveRows ? 'div' : 'turbo-frame' %}
    <{{ liveTag }} id="terminal-live"{{ liveRows ? '' : ' target="_top"' }}
        data-controller="live-region"
        data-live-region-types-value="{{ ['board.card_changed']|json_encode }}"
        data-live-region-mode-value="{{ liveRows ? 'rows' : 'frame' }}"
        data-live-region-url-value="{{ path(liveRows ? 'app_project_board_terminal_column_rows' : 'app_project_board_terminal_column', routeParams|merge({page: page})) }}"
        {% if liveRows %}data-live-since="{{ since }}"{% endif %}>
    {% if liveRows %}<div id="terminal-live-band" aria-live="polite"></div>{% endif %}
    <p id="terminal-total" class="lp-workspace-desc">{{ 'board.terminal.meta.total'|trans({'%count%': total}) }}</p>
    {% if items|length > 0 %}
    <div class="lp-done-list">
        {% for card in items %}
        {% include '@Board/_terminal_row.html.twig' with {project: project, card: card} only %}
        {% endfor %}
    </div>

    <twig:Ds:Pagination route="app_project_board_terminal_column" :page="page" :totalPages="totalPages" :pageList="pageList" :routeParams="routeParams" />
    {% else %}
    <twig:Ds:EmptyState icon="lucide:square-check-big" :title="'board.terminal.empty.title'|trans" :body="'board.terminal.empty.body'|trans">
        <twig:Ds:Button href="{{ path('app_project_board', {id: project.id}) }}">{{ 'board.terminal.empty.action'|trans }}</twig:Ds:Button>
    </twig:Ds:EmptyState>
    {% endif %}
    </{{ liveTag }}>
</twig:Ds:Workspace>
{% endblock %}
