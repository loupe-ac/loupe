{% extends 'base.html.twig' %}

{% block title %}{{ column.label|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'nav.link.board'|trans, url: path('app_project_board', {id: project.id})},
        {label: column.label|trans},
    ]" />
{% endblock %}

{% block body %}
{% do mercure_subscribe(board_topic(project)) %}
<twig:Ds:Workspace data-live-content>
    <h1 class="lp-workspace-title lp-workspace-title--doc">{{ column.label|trans }}</h1>
    <p class="lp-workspace-desc">{{ 'board.terminal.page.description'|trans }}</p>

    {# One frame on every page, so a page change swaps only the list. The live region sits inside it, so each swap brings the address of the new page. #}
    <turbo-frame id="terminal-list" target="_top">
    {% set liveRows = page > 1 %}
    <div id="terminal-live"
        data-controller="live-region"
        data-live-region-types-value="{{ ['board.card_changed']|json_encode }}"
        data-live-region-mode-value="rows"
        data-live-region-url-value="{{ path('app_project_board_terminal_column_rows', routeParams|merge({page: page})) }}"
        {% if liveRows %}data-live-since="{{ since }}"{% endif %}>
    {% if liveRows %}<div id="terminal-live-band" aria-live="polite"></div>{% endif %}
    <p id="terminal-total" class="lp-workspace-desc">{{ 'board.terminal.meta.total'|trans({'%count%': total}) }}</p>
    <div id="terminal-results">
        {% include '@Board/_terminal_results.html.twig' with {project: project, items: items, page: page, totalPages: totalPages, pageList: pageList, routeParams: routeParams} only %}
    </div>
    </div>
    </turbo-frame>
</twig:Ds:Workspace>
{% endblock %}
