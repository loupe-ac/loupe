<twig:Ds:FormField as="fieldset">
    <twig:Ds:Label as="legend">{{ field.vars.label|trans }}</twig:Ds:Label>
    <div class="lp-tone-picker">
        {% for choice in field %}
        <twig:Ds:Choice>
            {{ form_widget(choice) }}
            <span class="lp-tone-dot lp-tone-dot--{{ choice.vars.value }}" aria-hidden="true"></span>
            {{ choice.vars.label|trans }}
        </twig:Ds:Choice>
        {% endfor %}
    </div>
    <twig:Ds:FieldErrors :fieldView="field" data-field-errors="tone" />
</twig:Ds:FormField>
