{#- One value row of a card: its label, switch, help tooltip and who set it. Props: card (Card), value (CardValueView), error (?string: why a save was refused). -#}
{% set valueForm = card_value_form(card, value) %}
{% set tooltipId = 'card-value-tip-' ~ card.id ~ '-' ~ value.key %}
{% set setBy = value.setBy %}
<twig:Ds:ValueRow id="card-value-{{ value.key }}" :label="value.label|trans" :help="value.help|trans" :helpLabel="'board.card.values.help_label'|trans" :helpId="tooltipId">
    {{ form_start(valueForm, {action: path('app_board_card_value', {projectId: card.project.id, cardId: card.id, key: value.key}), attr: {'data-controller': 'submit-on-change'}}) }}
        {{ form_widget(valueForm._token) }}
        <twig:Ds:Switch :name="valueForm.value.vars.full_name" :id="valueForm.value.vars.id" :checked="true === value.value" :label="value.caption|trans" :disabled="not is_granted(constant('App\\Module\\Board\\Security\\CardVoter::WRITE'), card)" aria-describedby="{{ tooltipId }}" data-action="change->submit-on-change#submit" />
    {{ form_end(valueForm, {render_rest: false}) }}
    <twig:block name="meta">
        {%- if setBy is not null and value.updatedAt is not null -%}
            {{ setBy|trans }} · <twig:Ds:RelativeTime :datetime="value.updatedAt" />
        {%- else -%}
            {{ 'board.card.values.not_set'|trans }}
        {%- endif -%}
    </twig:block>
    <twig:block name="footer">
        {% if error is not null %}
            <twig:Ds:Flash severity="error">{{ error }}</twig:Ds:Flash>
        {% endif %}
    </twig:block>
</twig:Ds:ValueRow>
