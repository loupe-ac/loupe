{% extends 'base.html.twig' %}

{% block title %}{{ 'board.card.create.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block flash_messages %}
    {% if app.request.headers.get('Turbo-Frame') != 'card-drawer-frame' %}{{ parent() }}{% endif %}
{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'nav.link.board'|trans, url: path('app_project_board', {id: project.id})},
        {label: 'board.card.create.page.title'|trans},
    ]" />
{% endblock %}

{% block body %}
{# The same frame as the card view, so the board opens this form in its drawer. #}
{% set returnUrl = path('app_project_board', {id: project.id}) %}
<turbo-frame id="card-drawer-frame"{% if app.request.headers.get('Turbo-Frame') != 'card-drawer-frame' %} target="_top"{% endif %}>
<div class="lp-card-drawer">
    {% if app.request.headers.get('Turbo-Frame') == 'card-drawer-frame' %}
        {% include '_flash_messages.html.twig' with {flashes: app.flashes(['success', 'error', 'warning', 'info'])} only %}
    {% endif %}
    <header class="lp-card-drawer__header">
        <div class="lp-card-drawer__identity">
            <span class="lp-card-drawer__icon"><twig:ux:icon name="lucide:plus" class="lp-icon lp-icon--md" /></span>
            <span>{{ 'board.card.create.page.title'|trans }}</span>
        </div>
        <div class="lp-card-drawer__header-actions">
            <twig:Ds:Button variant="ghost icon" href="{{ returnUrl }}" aria-label="{{ 'board.card.drawer.close'|trans }}" data-turbo-frame="_top" data-action="card-drawer#close"><twig:ux:icon name="lucide:x" class="lp-icon lp-icon--md" /></twig:Ds:Button>
        </div>
    </header>

    <div class="lp-card-drawer__body">
        <h1 class="lp-card-drawer__title">{{ 'board.card.create.page.title'|trans }}</h1>
        <p class="lp-workspace-desc">{{ 'board.card.create.page.description'|trans }}</p>

        {% include '@Board/_card_form.html.twig' with {
            form: form,
            action: path('app_board_card_create', {id: project.id, column: form.vars.data.column.id}),
            submitLabel: 'board.card.create.submit',
            busyLabel: 'board.card.form.creating',
            cancelUrl: returnUrl,
            cancelLeavesFrame: true,
            card: null,
            saved: false,
        } only %}
    </div>
</div>
</turbo-frame>
{% endblock %}
