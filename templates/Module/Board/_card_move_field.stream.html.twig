{#- The answer to a move on the card page. Props: card (Card), error (?string). -#}
<turbo-stream action="replace" target="card-move-{{ card.id }}">
    <template>{% include '@Board/_card_move_field.html.twig' with {card: card, error: error} only %}</template>
</turbo-stream>
<turbo-stream action="update" target="card-column-{{ card.id }}">
    <template>{% include '@Board/_column_tag.html.twig' with {column: card.column} only %}</template>
</turbo-stream>
<turbo-stream action="update" target="card-updated-{{ card.id }}">
    <template><twig:Ds:RelativeTime :datetime="card.updatedAt" /></template>
</turbo-stream>
<turbo-stream action="replace" target="card-completed-{{ card.id }}">
    <template>{% include '@Board/_card_completed_field.html.twig' with {card: card} only %}</template>
</turbo-stream>
