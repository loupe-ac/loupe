{% extends 'base.html.twig' %}

{% block title %}{{ backlog.label|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'nav.link.board'|trans, url: path('app_project_board', {id: project.id})},
        {label: backlog.label|trans},
    ]" />
{% endblock %}

{% block body %}
{% set backlogPath = path('app_project_board_backlog', {projectId: project.id}) %}
{% do mercure_subscribe(board_topic(project)) %}
<twig:Ds:Workspace class="lp-core-prototype-page lp-core-documents" data-controller="backlog-select card-drawer">
    <twig:Ds:PageHeader :title="backlog.label|trans" :description="'board.backlog.page.description'|trans" titleClass="lp-workspace-title--doc" />

    <div id="backlog-confirmation" aria-live="polite"></div>

    {% set liveRows = listQuery.page > 1 %}
    {% set liveTag = liveRows ? 'div' : 'turbo-frame' %}
    <{{ liveTag }} id="backlog-live"{{ liveRows ? '' : ' target="_top"' }}
        data-controller="live-region"
        data-live-region-types-value="{{ ['board.card_changed', 'board.columns_changed']|json_encode }}"
        data-live-region-mode-value="{{ liveRows ? 'rows' : 'frame' }}"
        data-live-region-url-value="{{ path(liveRows ? 'app_project_board_backlog_rows' : 'app_project_board_backlog', {projectId: project.id}|merge(listQuery.routeParams)) }}"
        {% if liveRows %}data-live-since="{{ since }}"{% endif %}>
    {% if liveRows %}<div id="backlog-live-band" aria-live="polite"></div>{% endif %}
    {% if view.total > 0 or listQuery.isNarrowed %}
    {% set backlogCount %}<span id="backlog-filter-count">{% include '@Board/_backlog_count.html.twig' with {view: view, listQuery: listQuery} only %}</span>{% endset %}
    {# A GET form, so the filters land in the URL. `page` is not a field, so a changed filter starts at page one. #}
    <twig:Ds:FilterBar
        :action="backlogPath"
        :search="{id: 'backlog-search', name: 'search', value: listQuery.search, label: 'board.backlog.filter.search_label'|trans, placeholder: 'board.backlog.filter.search_placeholder'|trans}"
        :clearHref="backlogPath"
        :clearLabel="'board.backlog.filter.clear'|trans"
        :count="backlogCount">
        <label class="sr-only" for="backlog-type">{{ 'board.backlog.filter.type_label'|trans }}</label>
        <twig:Ds:Select id="backlog-type" name="type" data-action="change->autosearch#search">
            <option value="">{{ 'board.backlog.filter.all_types'|trans }}</option>
            {% for type in types %}
            <option value="{{ type.key }}"{{ listQuery.type == type.key ? ' selected' : '' }}>{{ type.label|trans }}</option>
            {% endfor %}
        </twig:Ds:Select>

        <label class="sr-only" for="backlog-epic">{{ 'board.backlog.filter.epic_label'|trans }}</label>
        <twig:Ds:Select id="backlog-epic" name="epic" data-action="change->autosearch#search">
            <option value="">{{ 'board.backlog.filter.any_epic'|trans }}</option>
            <option value="{{ constant('App\\Module\\Board\\View\\BacklogListQuery::NO_EPIC') }}"{{ listQuery.epic == constant('App\\Module\\Board\\View\\BacklogListQuery::NO_EPIC') ? ' selected' : '' }}>{{ 'board.backlog.filter.no_epic'|trans }}</option>
            {% for epic in view.epics %}
            <option value="{{ epic.id }}"{{ listQuery.epic == epic.id ~ '' ? ' selected' : '' }}>#{{ epic.number }} {{ epic.title|reference_plain }}</option>
            {% endfor %}
        </twig:Ds:Select>

        <twig:block name="secondary">
            {# A filter change keeps the order the column headers chose. #}
            {% if listQuery.routeParams.sort is defined %}
            <input type="hidden" name="sort" value="{{ listQuery.sort.value }}">
            <input type="hidden" name="dir" value="{{ listQuery.dir.value }}">
            {% endif %}
        </twig:block>
    </twig:Ds:FilterBar>
    {% endif %}

    <div id="backlog-results">
        {% include '@Board/_backlog_results.html.twig' with {project: project, view: view, listQuery: listQuery} only %}
    </div>

    {% include '@Board/_backlog_bulk.html.twig' with {project: project, listQuery: listQuery, nextColumn: view.nextColumn, boardColumns: view.boardColumns} only %}
    </{{ liveTag }}>

    {% include '@Board/_card_drawer.html.twig' with {project: project} only %}
</twig:Ds:Workspace>
{% endblock %}
