{# The one mark a card shows, with its tooltip of the main state alone. Props: card (Card), markers (StoredCardMarkers), inboxItem (?int, optional):
   the number of the card's open inbox item, link (bool): whether the tooltip ends with its links, which a list row, itself a link, leaves out. #}
{% set state = markers.state %}
{% set main = markers.primary %}
{% set inboxItem = inboxItem ?? null %}
{% set title = (state is null ? 'board.card_state.chip' : state.kind.translationKey)|trans %}
<twig:Ds:StateMark :kind="state is null ? 'chip' : state.kind.value" :label="title">
    <span data-marker-key="{{ main.key }}"><strong class="lp-tooltip__title">{{ title }}.</strong> {{ main.label|trans(main.params) }}</span>
    <span class="lp-tooltip__line--quiet">{{ card_state_text(main.kind.sinceKey, main.since) }}</span>
    {% if link %}
    {% if main.link is not null %}
    <a class="lp-tooltip__link"
       draggable="false"
       href="{{ marker_link_href(main.link, card.project) }}"
       data-turbo-frame="_top"
       data-marker-link="{{ main.link.value }}">{{ main.link.translationKey|trans }}</a>
    {% endif %}
    {% if inboxItem is not null %}
    <a class="lp-tooltip__link"
       draggable="false"
       href="{{ path('app_project_inbox', {id: card.project.id, item: inboxItem}) }}"
       data-turbo-frame="_top"
       data-card-inbox-item="{{ inboxItem }}">{{ 'board.card_state.open_inbox_item'|trans }}</a>
    {% endif %}
    <a class="lp-tooltip__link"
       draggable="false"
       href="{{ path('app_board_card', {projectId: card.project.id, cardId: card.id}) }}"
       data-turbo-frame="card-drawer-frame"
       data-drawer-title="#{{ card.number }}"
       data-action="click->card-drawer#prepare">{{ 'board.card_state.open_card'|trans }}</a>
    {% endif %}
</twig:Ds:StateMark>
