{# The drawer updates live, and a frame response cannot add a topic to the page that hosts it. #}
{% if project is defined and project %}{% do mercure_subscribe(worker_runs_topic(project)) %}{% do mercure_subscribe(board_topic(project)) %}{% endif %}
<twig:Ds:Drawer class="lp-card-drawer-overlay" aria-label="{{ 'board.card.drawer.label'|trans }}" data-card-drawer-target="dialog" data-action="cancel->card-drawer#close">
    <twig:block name="content">
    {# Escape and the backdrop close a drawer that is still loading. The header keeps the title the opener passed and the close
       button. The error state below keeps its buttons, where a reader needs a way out. #}
    <div class="lp-card-drawer-overlay__loading" data-card-drawer-target="loading" tabindex="-1">
        <header class="lp-drawer__header">
            <h2 class="lp-drawer__title" data-card-drawer-target="title"></h2>
            <twig:Ds:Button variant="ghost icon" type="button" aria-label="{{ 'board.card.drawer.close'|trans }}" data-action="card-drawer#close"><twig:ux:icon name="lucide:x" class="lp-icon lp-icon--md" /></twig:Ds:Button>
        </header>
        <div class="lp-drawer__body">
            <p class="lp-drawer__loading" role="status"><twig:ux:icon name="lucide:loader-circle" class="lp-icon lp-icon--lg" />{{ 'board.card.drawer.loading'|trans }}</p>
        </div>
    </div>
    <div class="lp-card-drawer-overlay__error" data-card-drawer-target="error" hidden>
        <p class="lp-dialog-desc" role="alert">{{ 'board.card.drawer.failed'|trans }}</p>
        <twig:Ds:FormActions>
            <twig:Ds:Button variant="primary" type="button" data-action="card-drawer#retry">{{ 'board.card.drawer.retry'|trans }}</twig:Ds:Button>
            <twig:Ds:Button type="button" data-action="card-drawer#close">{{ 'board.card.drawer.close'|trans }}</twig:Ds:Button>
        </twig:Ds:FormActions>
    </div>
    <div class="lp-card-drawer-overlay__deleted" data-card-drawer-target="deleted" hidden>
        <p class="lp-dialog-desc" role="alert">{{ 'board.card.drawer.deleted'|trans }}</p>
        <twig:Ds:FormActions>
            <twig:Ds:Button type="button" data-action="card-drawer#close">{{ 'board.card.drawer.close'|trans }}</twig:Ds:Button>
        </twig:Ds:FormActions>
    </div>
    <turbo-frame id="card-drawer-frame"
                 data-card-drawer-target="frame"
                 data-action="turbo:frame-load->card-drawer#loaded turbo:before-fetch-response->card-drawer#received turbo:fetch-request-error->card-drawer#failed turbo:frame-missing->card-drawer#failed turbo:submit-end->card-drawer#submitted"></turbo-frame>
    </twig:block>
</twig:Ds:Drawer>
