{% extends '@Project/_settings_layout.html.twig' %}

{% block title %}{{ 'board.settings.heading'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'nav.link.project_settings'|trans},
    ]" />
{% endblock %}

{% block settings_section 'columns' %}
{% block settings_columns '1' %}

{% block settings_content %}
{% do mercure_subscribe(board_topic(board.project)) %}
{% include '@Board/_board_settings_frame.html.twig' with {board: board, addColumnForm: addColumnForm, configureColumnForm: configureColumnForm, terminalWindowForm: terminalWindowForm} only %}
{% endblock %}
