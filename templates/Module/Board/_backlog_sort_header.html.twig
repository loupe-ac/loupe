{#- A Backlog column header that sorts the list. Props: project (Project), listQuery (BacklogListQuery), column (BacklogSort), label (string). -#}
{% set ariaSort = listQuery.ariaSort(column) %}
<span class="lp-data-table__cell" role="columnheader" aria-sort="{{ ariaSort }}">
    <a class="lp-backlog-sort-link" href="{{ path('app_project_board_backlog', {projectId: project.id}|merge(listQuery.sortParams(column))) }}">
        {{ label }}
        {% if ariaSort == 'ascending' %}
        <twig:ux:icon name="lucide:arrow-up" class="lp-icon lp-icon--sm" aria-hidden="true" />
        {% elseif ariaSort == 'descending' %}
        <twig:ux:icon name="lucide:arrow-down" class="lp-icon lp-icon--sm" aria-hidden="true" />
        {% else %}
        <twig:ux:icon name="lucide:arrow-up-down" class="lp-icon lp-icon--sm lp-backlog-sort-link__idle" aria-hidden="true" />
        {% endif %}
    </a>
</span>
