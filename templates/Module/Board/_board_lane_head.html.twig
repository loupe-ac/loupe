{# The head of an epic lane: the lane buttons, the number and progress over the title, and the Up next deck at the right end.
   The board page draws it, and a card placement morphs it.
   The phone hides most of the head. Its "…" button opens the lane sheet and carries the data the sheet needs.
   Props: epic (Card), progress (CardProgress), deck (LaneDeckView, or null when no child waits in Backlog), markers (?StoredCardMarkers): the state mark of the epic. #}
<header class="lp-board-lane__head"
        data-board-filter-target="laneHead"
        data-card-title="{{ epic.title }}"
        data-lane-digest="{{ lane_head_digest(epic, progress, deck, markers) }}">
    <button type="button"
            class="lp-board-lane__collapse"
            aria-expanded="true"
            aria-label="{{ 'board.lane.collapse'|trans }}"
            data-board-lane-target="toggle"
            data-action="board-lane#toggle">
        <twig:ux:icon name="lucide:chevron-right" class="lp-board-lane__chevron" />
    </button>
    {% include '@Board/_card_lane_form.html.twig' with {card: epic, returnTo: 'board', compact: true} only %}
    <twig:Ds:Button variant="ghost icon"
            class="lp-board-lane__move"
            aria-label="{{ 'board.card.move.label'|trans({'%number%': epic.number}) }}"
            data-action="click->card-move#open"
            data-card-move-id-param="{{ epic.id }}"
            data-card-move-number-param="{{ epic.number }}"
            data-card-move-column-param="{{ epic.column.id }}"><twig:ux:icon name="lucide:ellipsis" class="lp-icon lp-icon--md" /></twig:Ds:Button>
    <div class="lp-board-lane__heading">
        <span class="lp-board-card__number lp-board-lane__number" data-board-lane-target="glide">#{{ epic.number }}</span>
        <span class="lp-board-lane__status" data-lane-status data-board-lane-target="glide">
            {% if markers %}
            {% include '@Board/_card_state_mark.html.twig' with {card: epic, markers: markers, link: true} only %}
            {% endif %}
            {% include '@Board/_column_tag.html.twig' with {column: epic.column} only %}
        </span>
        <span class="lp-board-lane__progress" data-lane-progress data-board-lane-target="glide">
            <progress class="lp-board-lane__bar" value="{{ progress.done }}" max="{{ max(progress.total, 1) }}" aria-hidden="true"></progress>
            {{ 'board.lane.progress.fraction'|trans({'%done%': progress.done, '%total%': progress.total}) }}
            <span class="lp-board-lane__done">{{ 'board.lane.progress.done'|trans }}</span>
        </span>
        <a class="lp-board-lane__title"
           href="{{ path('app_board_card', {projectId: epic.project.id, cardId: epic.id}) }}"
           data-board-lane-target="glide"
           data-turbo-frame="card-drawer-frame"
           data-drawer-title="#{{ epic.number }}"
           data-action="click->card-drawer#prepare">{{ epic.title }}</a>
    </div>
    {% if deck %}
    {% include '@Board/_board_lane_deck.html.twig' with {epic: epic, deck: deck} only %}
    {% endif %}
    <twig:Ds:Button variant="ghost icon"
            class="lp-board-lane__menu"
            aria-label="{{ 'board.lane.menu'|trans({'%number%': epic.number}) }}"
            aria-haspopup="dialog"
            data-action="click->lane-sheet#open"
            data-lane-sheet-epic-param="{{ epic.id }}"
            data-lane-sheet-number-param="{{ epic.number }}"
            data-lane-sheet-column-param="{{ epic.column.id }}"
            data-lane-sheet-move-label-param="{{ 'board.card.move.label'|trans({'%number%': epic.number}) }}"
            data-lane-sheet-up-next-label-param="{{ deck ? 'board.lane.sheet.up_next'|trans({'%count%': deck.count}) : '' }}"
            data-lane-sheet-up-next-url-param="{{ deck ? path('app_project_board_backlog', {projectId: epic.project.id, epic: epic.id}) : '' }}"><twig:ux:icon name="lucide:ellipsis" class="lp-icon lp-icon--md" /></twig:Ds:Button>
</header>
