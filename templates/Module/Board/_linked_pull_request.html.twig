{% set href = safe_pull_request_url(link.url) %}
<tr class="lp-card-pulls__item" data-linked-pull-request="{{ link.id }}">
    <td>
        <span class="lp-inbox-linked-table__type"><twig:ux:icon name="lucide:git-pull-request" class="lp-icon lp-icon--md" />{{ 'board.card.link.pull_request'|trans }}</span>
        <strong>{{ link.repository ? link.repository ~ ' #' ~ link.number : link.url }}</strong>
        {% if agentReview and agentReview.overriddenBy %}
            <p class="lp-inbox-linked-table__note" data-agent-review-override>
                {{ 'board.card.agent_review.overridden'|trans({'%login%': agentReview.overriddenBy}) }}
                {% if agentReview.checkUrl %}<a href="{{ agentReview.checkUrl }}" rel="noopener noreferrer" target="_blank">{{ 'board.card.agent_review.findings'|trans }}</a>{% endif %}
            </p>
        {% endif %}
        {% if not href %}<p class="lp-inbox-linked-table__note">{{ 'board.card.pull_requests.not_linkable'|trans }}</p>{% endif %}
    </td>
    <td>{% if state and state.refreshedAt %}{% include '@Board/_pull_request_state.html.twig' with {state: state} only %}{% else %}<twig:Ds:Tag>{{ (href ? 'board.card.link.status_not_reported' : 'board.card.link.status_unavailable')|trans }}</twig:Ds:Tag>{% endif %}</td>
    <td>{% if href %}<twig:Ds:Button variant="ghost open" href="{{ href }}" rel="noopener noreferrer" target="_blank" aria-label="{{ 'board.card.link.open_pull_request'|trans }}"><span class="lp-btn__label">{{ 'inbox.linked_items.open'|trans }}</span><twig:ux:icon name="lucide:chevron-right" class="lp-icon lp-icon--md" /></twig:Ds:Button>{% endif %}</td>
</tr>
