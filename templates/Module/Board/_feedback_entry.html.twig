<article class="lp-conversation-entry" data-site-feedback="{{ link.comment.id }}">
    <twig:Ds:Avatar icon="lucide:globe-2" size="sm" shape="square" tone="tint" />
    <div>
        <div class="lp-card-feedback-list__head"><span>{{ 'site_review.source.widget'|trans }}</span><twig:Ds:StatusChip :modifier="link.comment.status.value" :dot="false">{{ ('site_review.comment.status.' ~ link.comment.status.value)|trans }}</twig:Ds:StatusChip></div>
        <p class="lp-inbox-item__answer-text">{{ link.comment.body }}</p>
        {% if link.comment.url starts with 'https://' or link.comment.url starts with 'http://' %}
            <a href="{{ link.comment.url }}" rel="noopener noreferrer nofollow" target="_blank">{{ 'site_review.comment.open_source'|trans }}</a>
        {% endif %}
        <details class="lp-site-review-selector">
            <summary>{{ 'site_review.feedback.captured_elements'|trans }}</summary>
            {% for anchor in link.comment.anchors %}
                {% if anchor.text is not empty %}<blockquote>{{ anchor.text }}</blockquote>{% endif %}
                <code>{{ anchor.selector }}</code>
            {% else %}<p>{{ 'site_review.comment.general_page'|trans }}</p>{% endfor %}
        </details>
        <div class="lp-feedback-detail__actions">
            {% if link.comment.status.value != 'resolved' and is_granted(constant('App\\Module\\Board\\Security\\CardFeedbackVoter::RESOLVE'), link) %}
                <twig:Ds:ActionForm :action="path('app_card_feedback_resolve', {id: link.id, surface: surface})" token="site-review-comment-action">
                    <twig:Ds:Button variant="primary" type="submit">{{ 'site_review.comment.action.resolve'|trans }}</twig:Ds:Button>
                </twig:Ds:ActionForm>
            {% endif %}
            {% if link.comment.status.value != 'pending' and is_granted(constant('App\\Module\\Board\\Security\\CardFeedbackVoter::REOPEN'), link) %}
                <twig:Ds:ActionForm :action="path('app_card_feedback_reopen', {id: link.id, surface: surface})" token="site-review-comment-action">
                    <twig:Ds:Button variant="ghost" type="submit">{{ 'site_review.comment.action.reopen'|trans }}</twig:Ds:Button>
                </twig:Ds:ActionForm>
            {% endif %}
        </div>
    </div>
</article>
