{# The sidebar pill of the Activity link, in a frame that the sidebar-counts stream replaces when a count changes. #}
<turbo-frame id="activity-open-count-{{ project.id }}" class="lp-sidebar__pill-frame">
    {% if openCount > 0 %}
    <span class="lp-sidebar__pill" data-activity-open-count aria-hidden="true">{{ openCount }}</span>
    <span class="sr-only">{{ 'bridge.nav.open_runs'|trans({'%count%': openCount}) }}</span>
    {% endif %}
</turbo-frame>
