{# Variables: project, cardId (string) and wait (CardWorkerWait). #}
<div class="lp-card-wait-controls" data-card-wait-controls{% if wait.stranded %} data-card-wait-stranded{% endif %}>
    <twig:Ds:ActionForm :action="path('app_project_card_wait_resume', {id: project.id, cardId: cardId})" token="card-worker-wait" frame="_top" data-card-wait-resume>
        <twig:Ds:Button type="submit" variant="ghost" size="sm">{{ 'bridge.wait.resume_now'|trans }}</twig:Ds:Button>
    </twig:Ds:ActionForm>
    {% if not wait.stranded %}
    <twig:Ds:Disclosure caret="none" class="lp-card-wait-controls__limit" data-card-wait-limit>
        <twig:block name="summary"><span class="{{ ds_button_class('ghost', 'sm') }}">{{ 'bridge.wait.change_limit'|trans }}</span></twig:block>
        <twig:block name="content">
            {{ form_start(wait.limitForm, {attr: {class: 'lp-form', 'data-turbo-frame': '_top'}}) }}
                <twig:Ds:FormField :fieldView="wait.limitForm.minutes" />
                <twig:Ds:Button type="submit" variant="primary" size="sm">{{ 'bridge.wait.change_limit.submit'|trans }}</twig:Ds:Button>
            {{ form_end(wait.limitForm) }}
        </twig:block>
    </twig:Ds:Disclosure>
    {% endif %}
    <twig:Ds:ActionForm :action="path('app_project_card_wait_cancel', {id: project.id, cardId: cardId})" token="card-worker-wait" frame="_top" data-card-wait-cancel data-turbo-confirm="{{ 'bridge.wait.cancel.confirm'|trans }}">
        <twig:Ds:Button type="submit" variant="danger-ghost" size="sm">{{ 'bridge.wait.cancel'|trans }}</twig:Ds:Button>
    </twig:Ds:ActionForm>
</div>
