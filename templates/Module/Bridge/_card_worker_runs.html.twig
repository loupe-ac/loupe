{% set runs = card_worker_runs(project, cardId) %}
{% set usage = card_usage_total(project, cardId) %}
{% set held = card_held(project, cardId) %}
{% set canManage = is_granted('project.manage', project) %}
<turbo-frame id="card-worker-runs" class="lp-live-frame" target="_top">
{# A manager always sees the section, because the pause control shows on a card with no runs. #}
{% if canManage or runs is not empty or usage.known or usage.pendingRuns > 0 or usage.noCostRuns > 0 or held or commandErrors|default([]) is not empty %}
<section class="lp-card-overview__section" data-card-runs>
    <twig:Ds:SectionHeading>{{ (runs is not empty ? 'board.card.runs.open_title' : 'board.card.runs.title')|trans }}
        <twig:block name="actions"><a class="lp-workshop-text-link" href="{{ path('app_project_worker_runs', {id: project.id}) }}" data-turbo-frame="_top" data-card-runs-all>{{ 'board.card.runs.all'|trans }}</a></twig:block>
    </twig:Ds:SectionHeading>
    {% if commandErrors|default([]) is not empty %}
    <div class="lp-worker-run-flashes" data-worker-run-command-flash>
        {% include '_flash_messages.html.twig' with {flashes: {error: commandErrors}} only %}
    </div>
    {% endif %}
    {% if held %}
    <p class="lp-card-held" data-card-held><twig:ux:icon name="lucide:circle-pause" class="lp-card-held__icon" />{{ 'board.card.runs.held'|trans }}</p>
    {% endif %}
    {% if canManage %}
    <twig:Ds:ActionForm :action="path(held ? 'app_project_card_agents_release' : 'app_project_card_agents_pause', {id: project.id, cardId: cardId})" token="card-agents" frame="card-worker-runs" :data-card-agents-release="held ? true : false" :data-card-agents-pause="held ? false : true">
        <twig:Ds:Button variant="outline" size="sm" type="submit">{% if held %}<twig:ux:icon name="lucide:circle-play" class="lp-icon lp-icon--md" />{% else %}<twig:ux:icon name="lucide:circle-pause" class="lp-icon lp-icon--md" />{% endif %}{{ (held ? 'board.card.runs.release' : 'board.card.runs.pause')|trans }}</twig:Ds:Button>
    </twig:Ds:ActionForm>
    {% endif %}
    {% for item in runs %}
    {% set control = item.control %}
    <div class="lp-card-run-row" data-card-run-row="{{ item.run.id }}">
        <div class="lp-card-run__main">
            <a class="lp-card-run" href="{{ path('app_project_worker_runs', {id: project.id, search: item.run.id}) }}" data-turbo-frame="_top" data-card-run="{{ item.run.id }}">
                <span class="lp-card-run__rule">{{ item.run.workKind ?? 'bridge.worker_runs.no_work_kind'|trans }}</span>
                {% if item.interactive %}<twig:Ds:Tag tone="neutral" class="lp-card-run__kind">{{ 'bridge.worker_runs.interactive'|trans }}</twig:Ds:Tag>{% endif %}
                {% if item.command %}<twig:Ds:Tag tone="neutral" class="lp-card-run__kind" data-worker-run-command>{{ 'bridge.worker_runs.command'|trans }}</twig:Ds:Tag>{% endif %}
                {% set shownAt = item.run.startedAt ?? item.run.receivedAt %}
                <span class="lp-card-run__meta"><twig:Ds:RelativeTime :datetime="shownAt" />{% if item.duration() is not null %} · {% if item.interactive and item.state.isOpen() %}{{ 'bridge.worker_runs.running_for'|trans({'%duration%': item.duration()}) }}{% else %}{{ item.duration() }}{% endif %}{% endif %}</span>
                {% if control and control.label %}{% set controlLabel = control.label|trans(control.labelParameters) %}<span class="lp-worker-run-control-label{{ control.labelWarns ? ' lp-worker-run-control-label--warns' : '' }}" title="{{ controlLabel }}" data-worker-run-control-label>{{ controlLabel }}</span>{% endif %}
            </a>
            {% if canManage and control and control.action %}
            {% include '@Bridge/_worker_run_control_form.html.twig' with {project: project, run: item.run, control: control, frame: 'card-worker-runs', compact: true} only %}
            {% endif %}
        </div>
        <twig:Ds:StatusChip :modifier="item.state.chipModifier()" :dot="false">{{ item.state.translationKey()|trans }}</twig:Ds:StatusChip>
        <twig:ux:icon name="lucide:chevron-right" class="lp-card-run__chevron" />
    </div>
    {% endfor %}
    <p class="lp-card-usage-total" data-card-usage-total>
        <span class="lp-card-usage-total__label">{{ 'board.card.runs.usage.total'|trans }}</span>
        {% if usage.known %}
        {% if usage.costUsd is not null %}<span class="lp-card-usage-total__cost" data-card-usage-cost>{{ usage.costUsd|format_currency('USD') }}</span>{% endif %}
        <span data-card-usage-tokens>{{ 'board.card.runs.usage.tokens'|trans({'%input%': usage.compact(usage.inputTokens), '%output%': usage.compact(usage.outputTokens), '%cacheRead%': usage.compact(usage.cacheReadTokens), '%cacheWrite%': usage.compact(usage.cacheWriteTokens)}) }}</span>
        {% if usage.estimated %}<twig:Ds:Tag tone="neutral" data-card-usage-estimated>{{ 'board.card.runs.usage.estimated'|trans }}</twig:Ds:Tag>{% endif %}
        {% if usage.partialRuns > 0 %}<twig:Ds:Tag tone="amber" data-card-usage-partial>{{ 'board.card.runs.usage.partial'|trans({'%count%': usage.partialRuns}) }}</twig:Ds:Tag>{% endif %}
        {% else %}
        <span data-card-usage-unknown>{{ 'board.card.runs.usage.unknown'|trans }}</span>
        {% endif %}
        {% if usage.pendingRuns > 0 %}<twig:Ds:Tag tone="neutral" data-card-usage-pending>{{ 'board.card.runs.usage.pending'|trans({'%count%': usage.pendingRuns}) }}</twig:Ds:Tag>{% endif %}
        {% if usage.noCostRuns > 0 %}<twig:Ds:Tag tone="amber" data-card-usage-no-cost>{{ 'board.card.runs.usage.no_cost'|trans({'%count%': usage.noCostRuns}) }}</twig:Ds:Tag>{% endif %}
    </p>
</section>
{% endif %}
</turbo-frame>
