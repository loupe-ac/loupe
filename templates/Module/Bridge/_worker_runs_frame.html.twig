{#- The list of runs inside its frame, with its live region. Props: project, items, filteredTotal, page, totalPages, pageList, listQuery, bridgeLabels, commandFlashes (list of string), requestFrame (?string, the Turbo-Frame header), reopen (bool, open the drawer of the run that the search names), live (bool, false while the page reloads whole). -#}
{% if live %}
<div hidden data-controller="live-region" data-live-region-mode-value="stream" data-live-region-types-value="{{ ['worker_run.changed']|json_encode }}" data-live-region-url-value="{{ path('app_project_worker_runs_live', {id: project.id}|merge(listQuery.withPage(page).routeParams)) }}"></div>
{% endif %}
{% if commandFlashes is not empty %}
<div class="lp-worker-run-flashes lp-worker-run-flashes--page" data-worker-run-command-flash>
    {% include '_flash_messages.html.twig' with {flashes: {error: commandFlashes}} only %}
</div>
{% endif %}
{% if items|length > 0 or listQuery.isNarrowed %}
<p class="lp-list-count">{{ 'bridge.worker_runs.filter.count'|trans({'%count%': filteredTotal}) }}</p>
{% endif %}
{# The shown count sits in the topbar, outside this frame, so a swap sends it again. #}
{% if requestFrame == 'worker-runs-frame' %}
<turbo-stream action="update" target="worker-runs-shown"><template><span class="lp-topbar__meta">{{ 'bridge.worker_runs.meta.shown'|trans({'%count%': items|length}) }}</span></template></turbo-stream>
{% endif %}
{% if items|length > 0 %}
<twig:Ds:DataTable modifier="runs" :label="'bridge.worker_runs.table.label'|trans" :columns="[
    {label: 'bridge.worker_runs.column.work'|trans},
    {label: 'bridge.worker_runs.column.outcome'|trans},
    {label: 'bridge.worker_runs.column.work_kind'|trans},
    {label: 'bridge.worker_runs.column.duration'|trans, align: 'end'},
    {label: 'bridge.worker_runs.column.started'|trans},
]">
    {% for item in items %}
    {% set run = item.run %}
    {% set shownAt = run.startedAt ?? run.receivedAt %}
    {# A search by this run's id is a link to it, so its drawer opens on arrival, and not on each live reload.
       The drawer stays inside the row and the frame, so a live reload sees it open and waits. #}
    <div class="lp-data-table__row" role="row" data-worker-run-id="{{ run.id }}" data-controller="modal" data-modal-drawer-value="true"{% if reopen and listQuery.search|lower == (run.id ~ '')|lower %} data-modal-reopen-value="true"{% endif %}>
        <div class="lp-data-table__cell lp-data-table__primary" role="cell">
            <button type="button" class="lp-data-table__target" data-action="modal#open">
                {% if run.cardNumber is not null %}<span class="lp-data-table__number">{{ 'bridge.worker_runs.card_number'|trans({'%number%': run.cardNumber}) }}</span>{% else %}<span class="lp-data-table__number" data-worker-run-subject>{{ run.subjectType }}</span>{% endif %}
                {% if item.cardTitle is not null %}<span class="lp-data-table__title">{{ item.cardTitle }}</span>{% endif %}
                <span class="sr-only">{{ 'bridge.worker_runs.details.open'|trans }}</span>
            </button>
            {% if item.interactive %}<twig:Ds:Tag tone="neutral">{{ 'bridge.worker_runs.interactive'|trans }}</twig:Ds:Tag>{% endif %}
            {% if item.command %}<twig:Ds:Tag tone="neutral" data-worker-run-command>{{ 'bridge.worker_runs.command'|trans }}</twig:Ds:Tag>{% endif %}
        </div>
        <div class="lp-worker-run-outcome" role="cell">
            <div class="lp-worker-run-outcome__status">
                <twig:Ds:StatusChip :modifier="item.state.chipModifier()" :label="item.state.translationKey()|trans" :reason="run.failureReason" :id="'worker-run-reason-' ~ run.id" />
                {% if item.control and item.control.action and item.control.action.value == 'close' and is_granted('project.manage', project) %}
                {% include '@Bridge/_worker_run_control_form.html.twig' with {project: project, run: run, control: item.control, frame: 'worker-runs-frame', compact: true, query: listQuery.routeParams} only %}
                {% endif %}
            </div>
            {% if item.control and item.control.label %}{% set controlLabel = item.control.label|trans(item.control.labelParameters) %}<span class="lp-worker-run-control-label{{ item.control.labelWarns ? ' lp-worker-run-control-label--warns' : '' }}" title="{{ controlLabel }}" data-worker-run-control-label>{{ controlLabel }}</span>{% endif %}
            {% if run.closeReason is not null %}{% set closeReasonLabel = ('bridge.worker_runs.close_reason.' ~ run.closeReason.value)|trans %}<span class="lp-worker-run-control-label" title="{{ closeReasonLabel }}" data-worker-run-close-reason-label>{{ closeReasonLabel }}</span>{% endif %}
        </div>
        <span class="lp-data-table__cell" role="cell">{{ run.workKind ?? 'bridge.worker_runs.no_work_kind'|trans }}{% if run.workerPool is not null %} <twig:Ds:Tag tone="neutral" data-worker-pool>{{ 'bridge.worker_runs.worker_pool_label'|trans({'%pool%': run.workerPool}) }}</twig:Ds:Tag>{% endif %}{% if run.harness is not null %} <twig:Ds:Tag tone="neutral" title="{{ 'bridge.worker_runs.details.harness'|trans }}" data-worker-run-harness>{{ run.harness }}</twig:Ds:Tag>{% endif %}{% if run.account is not null %} <twig:Ds:Tag tone="neutral" title="{{ 'bridge.worker_runs.details.account'|trans }}" data-worker-run-account>{{ run.account }}</twig:Ds:Tag>{% endif %}{% if run.model is not null %} <twig:Ds:Tag tone="neutral" title="{{ 'bridge.worker_runs.details.model'|trans }}" data-worker-run-model>{{ run.model }}</twig:Ds:Tag>{% endif %}</span>
        <span class="lp-data-table__cell lp-data-table__cell--end" role="cell">{% if item.interactive and item.state.isOpen() and item.duration() is not null %}{{ 'bridge.worker_runs.running_for'|trans({'%duration%': item.duration()}) }}{% else %}{{ item.duration() }}{% endif %}</span>
        <span class="lp-data-table__cell" role="cell"><twig:Ds:RelativeTime :datetime="shownAt" /></span>
        {% include '@Bridge/_worker_run_drawer.html.twig' with {item: item, project: project, bridgeLabels: bridgeLabels, listQuery: listQuery} only %}
    </div>
    {% endfor %}
</twig:Ds:DataTable>

<twig:Ds:Pagination route="app_project_worker_runs" :page="page" :totalPages="totalPages" :pageList="pageList" :routeParams="{id: project.id}|merge(listQuery.routeParams)" frame="worker-runs-frame" />
{% else %}
<twig:Ds:EmptyState icon="lucide:bot" iconClass="text-accent" :title="(listQuery.isNarrowed ? 'bridge.worker_runs.empty_filtered' : 'bridge.worker_runs.empty')|trans" />
{% endif %}
