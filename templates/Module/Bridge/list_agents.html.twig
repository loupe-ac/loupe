{% extends 'base.html.twig' %}

{% block title %}{{ 'bridge.agents.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'bridge.agents.page.title'|trans},
    ]" />
{% endblock %}

{% block body %}
<twig:Ds:Workspace class="lp-orchestration-page lp-redesign-secondary lp-redesign-agents">
    <twig:Ds:PageHeader :title="'bridge.agents.page_heading'|trans" :description="'bridge.agents.description'|trans">
        <twig:block name="actions">
            <twig:Ds:Button href="{{ path('app_project_connect', {id: project.id}) }}">
                <twig:ux:icon name="lucide:cable" />
                {{ 'bridge.agents.connection'|trans }}
            </twig:Ds:Button>
        </twig:block>
    </twig:Ds:PageHeader>

    {% set pauseFlashes = app.flashes('bridge-pause') %}
    {% if pauseFlashes is not empty %}
    <div class="lp-agent-flashes" data-bridge-pause-flash>
        {% include '_flash_messages.html.twig' with {flashes: {error: pauseFlashes}} only %}
    </div>
    {% endif %}

    {% set tryNowFlashes = app.flashes('bridge-try-now') %}
    {% if tryNowFlashes is not empty %}
    <div class="lp-agent-flashes" data-bridge-try-now-flash>
        {% include '_flash_messages.html.twig' with {flashes: {error: tryNowFlashes}} only %}
    </div>
    {% endif %}

    {% do mercure_subscribe(worker_runs_topic(project)) %}
    {% set canManage = is_granted('project.manage', project) %}
    <div class="lp-live-frame" data-controller="worker-run-refresh">
    <turbo-frame id="agents-frame" class="lp-live-frame" target="_top" data-worker-run-refresh-target="frame">
    {% if connections is not empty %}
    <div class="lp-agent-grid">
        {% for connection in connections %}
        {% set bridge = connection.bridge %}
        <article class="lp-agent-card" id="agent-connection-{{ bridge.id }}" data-agent-connection-id="{{ bridge.id }}" tabindex="-1">
            <div class="lp-agent-card__art">
                <twig:Ds:StatusChip :modifier="connection.healthChip.tone" data-agent-health data-agent-health-state="{{ connection.healthChip.state }}">{{ connection.healthChip.label|trans }}</twig:Ds:StatusChip>
                <twig:ux:icon name="lucide:bot" />
            </div>
            <div class="lp-agent-card__body"{% if connection.updateChip and connection.updateChip.command %} data-controller="disclosure"{% endif %}>
                <div class="lp-agent-card__heading">
                    <div>
                        <p class="lp-agent-card__eyebrow">{{ 'bridge.agents.connection_label'|trans }}</p>
                        <h2 class="lp-agent-card__name"><span title="{{ bridge.id }}" data-bridge-label>{{ bridge.label }}</span></h2>
                    </div>
                    {% if canManage %}
                    <twig:Ds:Menu id="agent-menu-{{ bridge.id }}" class="lp-agent-card__menu" data-agent-menu>
                        <twig:block name="trigger">
                            <twig:Ds:Button type="button" variant="icon"
                                    aria-label="{{ 'bridge.agents.menu'|trans }}"
                                    aria-expanded="false"
                                    aria-controls="agent-menu-{{ bridge.id }}"
                                    data-popover-target="trigger"
                                    data-action="click->popover#toggle">
                                <twig:ux:icon name="lucide:ellipsis" class="lp-icon lp-icon--md" />
                            </twig:Ds:Button>
                        </twig:block>
                        <twig:block name="content">
                            {% if bridge.pauseRequested or bridge.takesCommands() %}
                            {% set pauseAction = bridge.pauseRequested ? 'unpause' : 'pause' %}
                            <twig:Ds:ActionForm :action="path(pauseAction == 'pause' ? 'app_project_bridge_pause' : 'app_project_bridge_unpause', {id: project.id, bridgeId: bridge.id})" token="bridge-pause" frame="_top" data-agent-pause-control="{{ pauseAction }}">
                                <twig:Ds:MenuItem type="submit">
                                    {% if pauseAction == 'pause' %}<twig:ux:icon name="lucide:circle-pause" class="lp-icon lp-icon--md" />{% else %}<twig:ux:icon name="lucide:circle-play" class="lp-icon lp-icon--md" />{% endif %}
                                    {{ (pauseAction == 'pause' ? 'bridge.agents.pause' : 'bridge.agents.unpause')|trans }}
                                </twig:Ds:MenuItem>
                            </twig:Ds:ActionForm>
                            {% else %}
                            {% set reason = 'bridge.agents.pause_outdated'|trans({'%version%': constant('App\\Module\\Bridge\\View\\WorkerRunControls::COMMANDS_SINCE_VERSION')}) %}
                            <twig:Ds:MenuItem title="{{ reason }}" data-agent-pause-control="pause" disabled>
                                <twig:ux:icon name="lucide:circle-pause" class="lp-icon lp-icon--md" />
                                {{ 'bridge.agents.pause'|trans }}
                                <span class="sr-only">{{ reason }}</span>
                            </twig:Ds:MenuItem>
                            {% endif %}
                        </twig:block>
                    </twig:Ds:Menu>
                    {% endif %}
                </div>
                <p class="lp-agent-card__purpose">{{ 'bridge.agents.project_connection'|trans({'%project%': project.name}) }}</p>
                <div class="lp-agent-card__current">
                    <span>{{ 'bridge.agents.last_seen'|trans }}</span>
                    <strong>{{ connection.status.lastSeenAt ? connection.status.lastSeenAt|date('j M Y, H:i') : 'bridge.agents.never'|trans }}</strong>
                </div>
                {% if connection.status.quiet %}
                <p class="lp-agent-card__name-clash-hint" data-agent-quiet-hint>{{ (connection.status.loginExpired ? 'bridge.agents.hint.login_expired' : 'bridge.agents.hint.stale')|trans({'%name%': bridge.label}) }}</p>
                {% endif %}
                {% if bridge.nameClashes() %}
                <div class="lp-agent-card__current lp-agent-card__name-clash" data-agent-name-clash>
                    <span>{{ 'bridge.agents.name_clash.label'|trans }}</span>
                    <strong>{{ bridge.requestedName }}</strong>
                    <p class="lp-agent-card__name-clash-hint">{{ 'bridge.agents.name_clash.description'|trans }}</p>
                </div>
                {% endif %}
                {% if bridge.pauseRequested %}
                <div class="lp-agent-card__current lp-agent-card__paused" data-agent-paused>
                    <span>{{ (bridge.pausedReported ? 'bridge.agents.paused' : 'bridge.agents.pause_requested')|trans }}</span>
                    {% if bridge.pauseRequestedAt %}
                    {% set pausedAt = bridge.pauseRequestedAt|date('j M Y, H:i') %}
                    <strong>{{ bridge.pauseRequestedBy ? 'bridge.agents.paused_by'|trans({'%time%': pausedAt, '%person%': bridge.pauseRequestedBy.fullName ?: bridge.pauseRequestedBy.email}) : pausedAt }}</strong>
                    {% endif %}
                </div>
                {% endif %}
                {% if connection.bridge.workerPools is not empty %}
                <details class="lp-agent-card__current lp-agent-card__pools lp-agent-section" data-controller="details-memory" data-details-memory-key-value="pools-{{ bridge.id }}" data-agent-worker-pools{% if connection.poolsNeedAttention %} open{% endif %}>
                    <summary class="lp-agent-section__summary">
                        <twig:ux:icon name="lucide:chevron-right" class="lp-icon lp-icon--sm lp-agent-section__caret" aria-hidden="true" />
                        <span class="lp-agent-section__title">{{ 'bridge.agents.worker_pools.heading'|trans }}</span>
                        <span class="lp-agent-section__dot lp-agent-section__dot--{{ connection.poolsTone }}" aria-hidden="true"></span>
                        {% set totals = connection.poolTotals %}
                        <span class="lp-agent-section__text" data-agent-section-summary>{{ 'bridge.agents.worker_pools.summary'|trans({'%inUse%': totals.inUse, '%size%': totals.size, '%queued%': totals.queued}) }}</span>
                    </summary>
                    {% if connection.bridge.workerPoolsReportedAt %}
                    <span>{{ 'bridge.agents.worker_pools.as_of'|trans({'%time%': connection.bridge.workerPoolsReportedAt|date('j M Y, H:i')}) }}</span>
                    {% endif %}
                    {% for pool in connection.bridge.workerPools %}
                    <p class="lp-agent-card__pool" data-agent-worker-pool>
                        <strong>{{ pool.name }}</strong>
                        <span>{{ 'bridge.agents.worker_pools.in_use'|trans({'%inUse%': pool.inUse, '%size%': pool.size}) }} · {{ 'bridge.agents.worker_pools.queued'|trans({'%queued%': pool.queued}) }}</span>
                    </p>
                    {% endfor %}
                </details>
                {% endif %}
                {% if connection.bridge.accounts is not empty %}
                <details class="lp-agent-card__current lp-agent-card__accounts lp-agent-section" data-controller="details-memory" data-details-memory-key-value="accounts-{{ bridge.id }}" data-agent-accounts{% if connection.accountsNeedAttention %} open{% endif %}>
                    <summary class="lp-agent-section__summary">
                        <twig:ux:icon name="lucide:chevron-right" class="lp-icon lp-icon--sm lp-agent-section__caret" aria-hidden="true" />
                        <span class="lp-agent-section__title">{{ 'bridge.agents.accounts.heading'|trans }}</span>
                        <span class="lp-agent-section__dot lp-agent-section__dot--{{ connection.accountsTone }}" aria-hidden="true"></span>
                        <span class="lp-agent-section__text" data-agent-section-summary>
                            {%- for status in connection.accountStatuses -%}
                                {%- if not loop.first %} · {% endif -%}
                                {{ status.name }} {{ ('bridge.agents.accounts.summary.' ~ status.status)|trans -}}
                            {%- endfor -%}
                        </span>
                    </summary>
                    {% if connection.bridge.accountsReportedAt %}
                    <span>{{ 'bridge.agents.accounts.as_of'|trans({'%time%': connection.bridge.accountsReportedAt|date('j M Y, H:i')}) }}</span>
                    {% endif %}
                    {% for account in connection.bridge.accounts %}
                    <div class="lp-agent-card__account{% if account.state == 'failing' %} lp-agent-card__account--failing{% endif %}" data-agent-account="{{ account.name }}" data-agent-account-state="{{ account.state }}" data-agent-account-used="{{ (account.used ?? true) ? 'true' : 'false' }}">
                        <div class="lp-agent-card__account-line">
                            <strong>{{ account.name }}</strong>
                            <span>{{ account.harness }}</span>
                            <span>{{ (account.state == 'failing' ? 'bridge.agents.accounts.state.failing' : 'bridge.agents.accounts.state.ready')|trans }}</span>
                            {% if account.used ?? true %}{% else %}<span data-agent-account-unused>{{ 'bridge.agents.accounts.state.unused'|trans }}</span>{% endif %}
                            {% set tryNowState = connection.tryNowState(account.name) %}
                            {% if tryNowState == 'trying' %}
                            <span data-agent-try-now-state="trying">{{ 'bridge.agents.accounts.try_now.trying'|trans }}</span>
                            {% elseif tryNowState == 'still-limited' %}
                            <span data-agent-try-now-state="still-limited">{{ 'bridge.agents.accounts.try_now.still_limited'|trans({'%time%': connection.tryNowCheckedAt(account.name)|date('H:i')}) }}</span>
                            {% endif %}
                            {% if canManage and connection.canTryNow(account.name) %}
                            <twig:Ds:ActionForm :action="path('app_project_bridge_account_try_now', {id: project.id, bridgeId: bridge.id, account: account.name})" token="bridge-try-now" frame="_top" data-agent-try-now="{{ account.name }}">
                                <twig:Ds:Button type="submit" variant="ghost" size="sm">
                                    <twig:ux:icon name="lucide:circle-play" class="lp-icon lp-icon--sm" />
                                    {{ 'bridge.agents.accounts.try_now.action'|trans }}
                                </twig:Ds:Button>
                            </twig:Ds:ActionForm>
                            {% endif %}
                        </div>
                        {% include '@Bridge/_account_usage.html.twig' with {bars: connection.usageBars(account.name), tooltipKey: bridge.id ~ '-' ~ loop.index} only %}
                        {% if account.state == 'failing' %}
                        {% if account.reason %}
                        <p class="lp-agent-card__account-hint" data-agent-account-reason>{{ account.reason }}</p>
                        {% endif %}
                        <p class="lp-agent-card__account-hint">{{ ((account.used ?? true) ? 'bridge.agents.accounts.failing_hint' : 'bridge.agents.accounts.unused_hint')|trans }}</p>
                        {% endif %}
                    </div>
                    {% endfor %}
                </details>
                {% endif %}
                <footer>
                    <span>{{ connection.bridge.cliVersion|short_sha }}</span>
                    {% if connection.updateChip and connection.updateChip.command %}
                    <twig:Ds:StatusChip as="button" type="button" :modifier="connection.updateChip.tone" class="lp-agent-update-toggle" data-agent-update
                            data-action="disclosure#toggle" data-disclosure-target="trigger" aria-controls="agent-update-{{ connection.bridge.id }}">
                        {{ connection.updateChip.label|trans(connection.updateChip.parameters) }}
                        <twig:ux:icon name="lucide:chevron-down" class="lp-agent-update-toggle__caret" />
                    </twig:Ds:StatusChip>
                    {% elseif connection.updateChip %}
                    <twig:Ds:StatusChip :modifier="connection.updateChip.tone" data-agent-update>{{ connection.updateChip.label|trans(connection.updateChip.parameters) }}</twig:Ds:StatusChip>
                    {% endif %}
                    <span>{{ 'bridge.agents.runtime'|trans }}</span>
                </footer>
                {% if connection.updateChip and connection.updateChip.command %}
                <div id="agent-update-{{ connection.bridge.id }}" class="lp-connect-field lp-agent-update-command" data-disclosure-target="content">
                    <twig:ux:icon name="lucide:terminal" class="lp-icon lp-icon--md lp-connect-field__glyph" />
                    <code class="lp-connect-field__value" data-agent-update-command>{{ connection.updateChip.command }}</code>
                    <twig:Ds:CopyButton :text="connection.updateChip.command" :label="'project.connect.copy'|trans" :copiedLabel="'project.connect.copied'|trans" />
                </div>
                {% endif %}
            </div>
        </article>
        {% endfor %}
    </div>
    {% else %}
    <twig:Ds:EmptyState icon="lucide:unplug" :title="'bridge.agents.empty.title'|trans" data-agent-empty>
        <p>{{ 'bridge.agents.empty.description'|trans }}</p>
        <twig:Ds:Button variant="primary" href="{{ path('app_project_connect', {id: project.id}) }}">{{ 'bridge.agents.empty.action'|trans }}</twig:Ds:Button>
    </twig:Ds:EmptyState>
    {% endif %}
    </turbo-frame>
    {% include '@Bridge/_bridge_hooks.html.twig' with {project: project} only %}
    </div>
</twig:Ds:Workspace>
{% endblock %}
