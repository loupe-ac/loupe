{% set run = item.run %}
<twig:Ds:Drawer class="lp-run-drawer" aria-labelledby="run-title-{{ run.id }}" data-modal-target="dialog" data-action="cancel->modal#close" data-controller="worker-run-output" data-worker-run-output-copied-value="{{ 'bridge.worker_runs.details.copied'|trans }}" data-worker-run-output-failed-value="{{ 'bridge.worker_runs.details.copy_failed'|trans }}">
    <twig:block name="header">
        <div>
            <h2 class="lp-dialog-title" id="run-title-{{ run.id }}">{{ 'bridge.worker_runs.details.title'|trans }}</h2>
            <p class="lp-run-drawer__identifier">{{ run.id }}</p>
            <twig:Ds:StatusChip :modifier="item.state.chipModifier()" :dot="false">{{ item.state.translationKey()|trans }}</twig:Ds:StatusChip>
            {% if item.control and item.control.label %}<span class="lp-worker-run-control-label{{ item.control.labelWarns ? ' lp-worker-run-control-label--warns' : '' }}" data-worker-run-control-label>{{ item.control.label|trans(item.control.labelParameters) }}</span>{% endif %}
            {% if item.interactive %}<twig:Ds:Tag tone="neutral">{{ 'bridge.worker_runs.interactive'|trans }}</twig:Ds:Tag>{% endif %}
            {% if item.command %}<twig:Ds:Tag tone="neutral" data-worker-run-command>{{ 'bridge.worker_runs.command'|trans }}</twig:Ds:Tag>{% endif %}
        </div>
        <twig:Ds:Button type="button"  data-action="modal#close" autofocus>{{ 'bridge.worker_runs.details.close'|trans }}</twig:Ds:Button>
    </twig:block>
    <twig:block name="body">
        <dl class="lp-run-drawer__metadata">
            {% if run.cardId() is not null %}
            <div><dt>{{ 'bridge.worker_runs.details.card'|trans }}</dt><dd>
                <a href="{{ path('app_board_card', {projectId: project.id, cardId: run.cardId()}) }}">{{ 'bridge.worker_runs.card_number'|trans({'%number%': run.cardNumber}) }}</a>
                <span class="lp-run-drawer__identifier">{{ run.cardId() }}</span>
            </dd></div>
            {% else %}
            <div data-worker-run-subject><dt>{{ 'bridge.worker_runs.details.subject'|trans }}</dt><dd>{{ run.subjectType }} <span class="lp-run-drawer__identifier">{{ run.subjectId }}</span></dd></div>
            {% endif %}
            <div><dt>{{ 'bridge.worker_runs.column.work_kind'|trans }}</dt><dd data-worker-run-work-kind>{{ run.workKind ?? 'bridge.worker_runs.no_work_kind'|trans }}</dd></div>
            {# The bridge writes these names, so they are rendered as text. Never add |raw here. #}
            {% if run.experiment is not null %}<div data-worker-run-experiment><dt>{{ 'bridge.worker_runs.details.experiment'|trans }}</dt><dd>{{ run.experiment }} / {{ run.variant }}{% if run.requestedModel is not null %} ({{ run.requestedModel }}){% endif %}{% if run.switchedFrom is not null %}, {{ 'bridge.worker_runs.details.switched_from'|trans({'%variant%': run.switchedFrom}) }}{% endif %}</dd></div>{% endif %}
            {% if run.workerPool is not null %}<div data-worker-run-pool><dt>{{ 'bridge.worker_runs.details.worker_pool'|trans }}</dt><dd>{{ run.workerPool }}</dd></div>{% endif %}
            {% if run.bridgeId is not null %}<div data-worker-run-bridge><dt>{{ 'bridge.worker_runs.filter.bridge_label'|trans }}</dt><dd>{{ bridgeLabels[run.bridgeId.toRfc4122()] }} <span class="lp-run-drawer__identifier">{{ run.bridgeId }}</span></dd></div>{% endif %}
            {% if run.sessionId is not null and not item.command %}<div><dt>{{ 'bridge.worker_runs.details.session'|trans }}</dt><dd>{{ run.sessionId }}</dd></div>{% endif %}
            {% if run.harness is not null %}<div data-worker-run-harness-detail><dt>{{ 'bridge.worker_runs.details.harness'|trans }}</dt><dd>{{ run.harness }}</dd></div>{% endif %}
            {% if run.account is not null %}<div data-worker-run-account-detail><dt>{{ 'bridge.worker_runs.details.account'|trans }}</dt><dd>{{ run.account }}</dd></div>{% endif %}
            {% if run.harnessVersion is not null %}<div data-worker-run-harness-version-detail><dt>{{ 'bridge.worker_runs.details.harness_version'|trans }}</dt><dd>{{ run.harnessVersion }}</dd></div>{% endif %}
            {% if run.cliVersion is not null %}<div data-worker-run-cli-version-detail><dt>{{ 'bridge.worker_runs.details.cli_version'|trans }}</dt><dd>{{ run.cliVersion }}</dd></div>{% endif %}
            {% if run.skillVersion is not null %}<div data-worker-run-skill-version-detail><dt>{{ 'bridge.worker_runs.details.skill_version'|trans }}</dt><dd>{{ run.skillVersion }}</dd></div>{% endif %}
            {% if run.model is not null %}<div data-worker-run-model-detail><dt>{{ 'bridge.worker_runs.details.model'|trans }}</dt><dd>{{ run.model }}</dd></div>{% endif %}
            {# Claude Code reports Loupe's own session id here, so only a different id earns a row. #}
            {% if run.harnessSessionId is not null and run.harnessSessionId != (run.sessionId ? run.sessionId.toRfc4122() : null) %}<div data-worker-run-harness-session><dt>{{ 'bridge.worker_runs.details.harness_session'|trans }}</dt><dd>{{ run.harnessSessionId }}</dd></div>{% endif %}
            <div><dt>{{ 'bridge.worker_runs.column.duration'|trans }}</dt><dd>{% if item.interactive and item.state.isOpen() and item.duration() is not null %}{{ 'bridge.worker_runs.running_for'|trans({'%duration%': item.duration()}) }}{% else %}{{ item.duration() }}{% endif %}{% if run.exitCode is not null %} · {{ 'bridge.worker_runs.exit_code'|trans({'%code%': run.exitCode}) }}{% endif %}</dd></div>
            {% if run.continuesRun is not null %}<div><dt>{{ 'bridge.worker_runs.details.continues'|trans }}</dt><dd><a href="{{ path('app_project_worker_runs', {id: project.id, search: run.continuesRun.id}) }}" data-worker-run-continues>{{ run.continuesRun.id }}</a></dd></div>{% endif %}
            {% if run.resultStatus is not null %}<div data-worker-run-result-status><dt>{{ 'bridge.worker_runs.details.result_status'|trans }}</dt><dd>{{ ('bridge.worker_runs.result_status.' ~ run.resultStatus)|trans }}</dd></div>{% endif %}
            {% if run.resultReason is not null %}<div data-worker-run-result-reason><dt>{{ 'bridge.worker_runs.details.result_reason'|trans }}</dt><dd>{{ ('bridge.worker_runs.result_reason.' ~ run.resultReason.value)|trans }}</dd></div>{% endif %}
            {% if run.closeReason is not null %}<div data-worker-run-close-reason><dt>{{ 'bridge.worker_runs.details.close_reason'|trans }}</dt><dd>{{ ('bridge.worker_runs.close_reason.' ~ run.closeReason.value)|trans }}</dd></div>{% endif %}
            {% if run.resumeSkipped is not null %}<div data-worker-run-resume-skipped><dt>{{ 'bridge.worker_runs.details.resume_skipped'|trans }}</dt><dd><code>{{ run.resumeSkipped }}</code></dd></div>{% endif %}
        </dl>
        {% set fact = item.fact %}
        {% set billedCost = item.billedCost %}
        {% if (fact is not null or billedCost is not null) and not item.command %}
        <h3 class="lp-run-drawer__heading">{{ 'bridge.worker_runs.details.metrics'|trans }}</h3>
        <dl class="lp-run-drawer__metadata" data-worker-run-metrics>
            <div data-worker-run-cost><dt>{{ 'bridge.worker_runs.details.metric.cost'|trans }}</dt><dd>
                {% if billedCost is not null and billedCost.state.value == 'pending' %}
                <span data-worker-run-cost-pending>{{ 'bridge.worker_runs.details.metric.pending'|trans }}</span>
                {% elseif billedCost is not null and billedCost.state.value == 'unknown' and billedCost.reason is not null %}
                <span class="lp-run-drawer__cost-unknown" data-worker-run-cost-unknown>
                    {{ 'bridge.worker_runs.details.metric.unknown'|trans }}
                    <span data-worker-run-cost-reason>{{ ('bridge.worker_runs.details.metric.reason.' ~ billedCost.reason.value)|trans }}</span>
                    {% set keySettingsUrl = is_granted('project.manage', project) ? path('app_project_openrouter', {id: project.id}) : path('app_account_openrouter') %}
                    <twig:Ds:Button variant="ghost icon" href="{{ keySettingsUrl }}" data-turbo-frame="_top" data-worker-run-cost-settings :aria-label="'bridge.worker_runs.details.metric.key_settings'|trans"><twig:ux:icon name="lucide:settings" class="lp-icon lp-icon--md" /></twig:Ds:Button>
                </span>
                {% elseif fact is null or fact.costMicroUsd is null %}
                {{ 'bridge.worker_runs.details.metric.unknown'|trans }}
                {% else %}
                {{ (fact.costMicroUsd / 1000000)|format_currency('USD', fact.costMicroUsd > 0 and fact.costMicroUsd < 5000 ? {max_fraction_digit: 6} : {}) }}
                {% endif %}
            </dd></div>
            {% if fact is not null %}
            {% if fact.tokensIn is not null %}<div><dt>{{ 'bridge.worker_runs.details.metric.input_tokens'|trans }}</dt><dd>{{ fact.tokensIn|format_number }}</dd></div>{% endif %}
            {% if fact.tokensOut is not null %}<div><dt>{{ 'bridge.worker_runs.details.metric.output_tokens'|trans }}</dt><dd>{{ fact.tokensOut|format_number }}</dd></div>{% endif %}
            {% if fact.tokensCacheRead is not null %}<div><dt>{{ 'bridge.worker_runs.details.metric.cache_read_tokens'|trans }}</dt><dd>{{ fact.tokensCacheRead|format_number }}</dd></div>{% endif %}
            {% if fact.tokensCacheWrite is not null %}<div><dt>{{ 'bridge.worker_runs.details.metric.cache_write_tokens'|trans }}</dt><dd>{{ fact.tokensCacheWrite|format_number }}</dd></div>{% endif %}
            {# The bridge writes the model name, so it is rendered as text. Never add |raw here. #}
            {% if fact.model is not null %}<div><dt>{{ 'bridge.worker_runs.details.metric.model'|trans }}</dt><dd>{{ fact.model }}</dd></div>{% endif %}
            {% if item.factDuration() is not null %}<div><dt>{{ 'bridge.worker_runs.column.duration'|trans }}</dt><dd>{{ item.factDuration() }}</dd></div>{% endif %}
            {% endif %}
        </dl>
        {% endif %}
        {% if not item.command %}
        <h3 class="lp-run-drawer__heading">{{ 'bridge.worker_runs.details.buckets'|trans }}</h3>
        {% if item.buckets is null %}
        <p class="lp-dialog-desc" data-worker-run-buckets-empty>{{ 'bridge.worker_runs.details.buckets_empty'|trans }}</p>
        {% else %}
        <div class="lp-metric-table" data-worker-run-buckets>
            <div class="lp-metric-table__scroll">
                <table class="lp-metric-table__table">
                    <thead>
                        <tr>
                            <th scope="col">{{ 'bridge.worker_runs.details.buckets.bucket'|trans }}</th>
                            <th scope="col" class="lp-metric-table__number">{{ 'bridge.worker_runs.details.buckets.main'|trans }}</th>
                            <th scope="col" class="lp-metric-table__number">{{ 'bridge.worker_runs.details.buckets.all'|trans }}</th>
                            <th scope="col" class="lp-metric-table__number">{{ 'bridge.worker_runs.details.buckets.calls'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for bucket in item.buckets %}
                        {# A bucket name comes from the project rules or the bridge, so it is rendered as text. Never add |raw here. #}
                        <tr data-worker-run-bucket="{{ bucket.bucket }}">
                            <th scope="row">{{ bucket.bucket }}</th>
                            <td class="lp-metric-table__number">{{ bucket.mainDuration() }}</td>
                            <td class="lp-metric-table__number">{{ bucket.withSubagentsDuration() ?? 'bridge.worker_runs.details.metric.unknown'|trans }}</td>
                            <td class="lp-metric-table__number">{{ bucket.calls is null ? 'bridge.worker_runs.details.metric.unknown'|trans : bucket.calls|format_number }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        <p class="lp-dialog-desc">{{ 'bridge.worker_runs.details.buckets_note'|trans }}</p>
        {% endif %}
        <h3 class="lp-run-drawer__heading">{{ 'bridge.worker_runs.details.harness_events'|trans }}</h3>
        {% if run.harnessEvents is null %}
        <p class="lp-dialog-desc" data-worker-run-harness-events-empty>{{ 'bridge.worker_runs.details.harness_events_empty'|trans }}</p>
        {% elseif run.harnessEvents is empty %}
        <p class="lp-dialog-desc" data-worker-run-harness-events-none>{{ 'bridge.worker_runs.details.harness_events_none'|trans }}</p>
        {% else %}
        {# The bridge writes the kind names, so they are rendered as text. Never add |raw here. #}
        <dl class="lp-run-drawer__metadata" data-worker-run-harness-events>
            {% for kind, count in item.harnessEvents() %}<div><dt>{{ kind }}</dt><dd>{{ count|format_number }}</dd></div>{% endfor %}
        </dl>
        {% endif %}
        {% endif %}
        {% if item.resultFields is not empty %}
        <h3 class="lp-run-drawer__heading">{{ 'bridge.worker_runs.details.result_fields'|trans }}</h3>
        {# The worker writes these, so they are rendered as text. Never add |raw here. #}
        <dl class="lp-run-drawer__metadata" data-worker-run-result-fields>
            {% for name, value in item.resultFields %}<div><dt>{{ name }}</dt><dd>{{ value }}</dd></div>{% endfor %}
        </dl>
        {% endif %}
        {% if not item.interactive and not item.command %}<p class="lp-dialog-desc">{{ 'bridge.worker_runs.details.unreported'|trans }}</p>{% endif %}
        <h3 class="lp-run-drawer__heading">{{ 'bridge.worker_runs.details.timeline'|trans }}</h3>
        <ol class="lp-run-drawer__timeline">
            {% for change in item.history %}
            <li>{{ change.state.translationKey()|trans }} <twig:Ds:RelativeTime :datetime="change.at" mode="datetime" /></li>
            {% else %}
            {# A run the previous image wrote during a deploy has no history rows. #}
            {% if run.startedAt %}<li>{{ 'bridge.worker_runs.state.running'|trans }} <twig:Ds:RelativeTime :datetime="run.startedAt" mode="datetime" /></li>{% endif %}
            {% if run.endedAt %}<li>{{ run.state.translationKey()|trans }} <twig:Ds:RelativeTime :datetime="run.endedAt" mode="datetime" /></li>{% endif %}
            {% endfor %}
            <li>{{ 'bridge.worker_runs.details.received'|trans }} <twig:Ds:RelativeTime :datetime="run.receivedAt" mode="datetime" /></li>
        </ol>
        {% if run.failureReason %}<p class="lp-worker-run__failure">{{ run.failureReason }}</p>{% endif %}
        <h3 class="lp-run-drawer__heading">{{ 'bridge.worker_runs.output.toggle'|trans }}</h3>
        {% if run.output is empty %}<p>{{ 'bridge.worker_runs.output.empty'|trans }}</p>{% endif %}
        {# The bridge writes this and no person approves it, so it is rendered as text. Never add |raw here. #}
        <pre class="lp-worker-run__output" data-worker-run-output-target="output">{{ run.output }}</pre>
    </twig:block>
    <twig:block name="footer">
        <p role="status" data-worker-run-output-target="status"></p>
        {% if item.control and item.control.action and is_granted('project.manage', project) %}
        {% include '@Bridge/_worker_run_control_form.html.twig' with {project: project, run: run, control: item.control, frame: '_top', compact: false} only %}
        {% endif %}
        <twig:Ds:Button type="button"  data-action="worker-run-output#copy">{{ 'bridge.worker_runs.details.copy'|trans }}</twig:Ds:Button>
    </twig:block>
</twig:Ds:Drawer>
