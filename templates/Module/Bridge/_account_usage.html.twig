{#
  Props:  @comment-budget-ignore
    limit      AccountLimit  The usage windows of one account, from the latest readings.
    tooltipKey string        A prefix that makes the tooltip ids of this account unique on the page.
  Draws one bar for each window. A window with no use value draws an empty bar.
#}
<div class="lp-usage" data-agent-usage-bars>
    {% for window in limit.orderedWindows %}
    {% set reading = window.reading %}
    {% set state = window.state.value %}
    {% set percent = reading.usedPercent %}
    {% set windowName = reading.window in ['session', 'week'] ? ('bridge.agents.usage.window.' ~ reading.window)|trans : reading.window %}
    {% set tooltipId = 'usage-tip-' ~ tooltipKey ~ '-' ~ loop.index %}
    {% if state == 'unknown' %}
        {% set valueLabel = 'bridge.agents.usage.unknown'|trans %}
    {% elseif percent is null %}
        {% set valueLabel = (reading.limited ? 'bridge.agents.usage.at_limit' : 'bridge.agents.usage.not_reported')|trans %}
    {% else %}
        {% set valueLabel = 'bridge.agents.usage.percent'|trans({'%percent%': percent|round}) %}
    {% endif %}
    {% set fill = state != 'unknown' and percent is not null ? min(percent, 100) : 0 %}
    {% set tone = state == 'at-limit' ? 'limit' : (state == 'at-stop' ? 'stop' : (state == 'unknown' ? 'unknown' : 'open')) %}
    <div class="lp-usage-bar lp-usage-bar--{{ tone }}" tabindex="0" aria-describedby="{{ tooltipId }}" data-agent-usage="{{ reading.window }}" data-agent-usage-state="{{ state }}">
        <p class="lp-usage-bar__line">
            <span class="lp-usage-bar__name">{{ windowName }}</span>
            <strong class="lp-usage-bar__value" data-agent-usage-value>{{ valueLabel }}</strong>
            {% if state != 'unknown' %}
            <span class="lp-usage-bar__reset" data-agent-usage-reset>
                <twig:ux:icon name="lucide:rotate-ccw" class="lp-icon lp-icon--xs" aria-hidden="true" />
                <time datetime="{{ reading.resetsAt|date('c') }}" title="{{ reading.resetsAt|date('Y-m-d H:i:s T') }}">{{ reading.resetsAt|date('D H:i') }}</time>
            </span>
            {% endif %}
        </p>
        <progress class="lp-usage-bar__track" max="100" value="{{ fill }}" aria-label="{{ windowName }}" aria-valuetext="{{ valueLabel }}"></progress>
        <twig:Ds:Tooltip id="{{ tooltipId }}" data-agent-usage-age>{{ 'bridge.agents.usage.read'|trans({'%age%': reading.readAt|relative_time}) }}{# @design-system-ignore #}</twig:Ds:Tooltip>
    </div>
    {% endfor %}
</div>
