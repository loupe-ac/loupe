{# twig-cs-fixer-disable #}
{# Dev-only specimen of the Disclosure for the styleguide, so it is intentionally untranslated. #}
<twig:Ds:Disclosure :open="true">
    <twig:block name="summary"><strong>Open section</strong></twig:block>
    <span>The body folds away when the summary is pressed.</span>
    <span>With reduced motion preferred, it snaps instead.</span>
</twig:Ds:Disclosure>
<twig:Ds:Disclosure>
    <twig:block name="summary"><strong>Closed section</strong></twig:block>
    <span>Hidden until the summary is pressed.</span>
</twig:Ds:Disclosure>
<twig:Ds:Disclosure caret="end">
    <twig:block name="summary"><strong>Caret at the end</strong></twig:block>
    <span>The caret sits after the summary.</span>
</twig:Ds:Disclosure>
<twig:Ds:Disclosure caret="none" :open="true">
    <twig:block name="summary"><strong>No caret of its own</strong> <twig:ux:icon name="lucide:chevron-right" class="lp-icon lp-icon--sm lp-disclosure__caret" aria-hidden="true" /></twig:block>
    <span>The page draws the icon inside the summary. It turns when the section opens.</span>
</twig:Ds:Disclosure>
