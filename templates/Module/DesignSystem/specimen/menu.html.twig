{# twig-cs-fixer-disable #}
{# Dev-only specimen of the Menu for the styleguide, so it is intentionally untranslated. #}
<twig:Ds:Menu id="styleguide-menu-{{ variant }}" :tone="variant" align="start" size="sm" open>
    <twig:block name="trigger">
        <twig:Ds:Button type="button" variant="ghost" aria-expanded="true" aria-controls="styleguide-menu-{{ variant }}" data-popover-target="trigger" data-action="click->popover#toggle">Menu</twig:Ds:Button>
    </twig:block>
    <twig:block name="content">
        <twig:Ds:MenuHeading>Open in</twig:Ds:MenuHeading>
        <twig:Ds:MenuItem href="#components">A link</twig:Ds:MenuItem>
        <twig:Ds:MenuItem :current="true">The current one</twig:Ds:MenuItem>
        <twig:Ds:MenuDivider />
        <twig:Ds:MenuItem disabled>Not available</twig:Ds:MenuItem>
        <twig:Ds:MenuGroup heading="A group (2)" moreLabel="Show 1 more">
            <twig:block name="content">
                <twig:Ds:MenuItem href="#components">First row</twig:Ds:MenuItem>
            </twig:block>
            <twig:block name="more">
                <twig:Ds:MenuItem href="#components">Second row</twig:Ds:MenuItem>
            </twig:block>
        </twig:Ds:MenuGroup>
    </twig:block>
</twig:Ds:Menu>
<twig:Ds:Menu id="styleguide-menu-live-{{ variant }}" :tone="variant" live open align="start" size="md">
    <twig:block name="trigger">
        <twig:Ds:Input type="search" value="login" role="combobox" aria-expanded="true" aria-controls="styleguide-menu-live-{{ variant }}" aria-label="Search" />
    </twig:block>
    <twig:block name="content">
        <twig:Ds:MenuGroup heading="Cards" role="group">
            <twig:Ds:MenuItem role="option" href="#components"><span class="lp-board-card__number">#1116</span><span class="lp-menu__label">Login page redesign</span><twig:Ds:StatusChip :dot="false">Backlog</twig:Ds:StatusChip></twig:Ds:MenuItem>
        </twig:Ds:MenuGroup>
    </twig:block>
</twig:Ds:Menu>
