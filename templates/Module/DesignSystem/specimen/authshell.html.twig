{# twig-cs-fixer-disable #}
{# Dev-only specimen for the styleguide, so it is intentionally untranslated. #}
{# The page frame is full height, so the specimen draws the card alone. #}
<div class="lp-auth__card">
    <twig:Ds:FormField>
        <twig:Ds:Label for="styleguide-auth-email">Email</twig:Ds:Label>
        <twig:Ds:Input id="styleguide-auth-email" type="email" placeholder="you@example.com" />
    </twig:Ds:FormField>
    <twig:Ds:Button variant="primary" size="lg" type="button" class="lp-auth__action">Sign in</twig:Ds:Button>
</div>
