{# twig-cs-fixer-disable #}
{# Dev-only specimen of the Button for the styleguide, so it is intentionally untranslated. #}
{% set iconOnly = variant in ['icon', 'compact'] %}
<twig:Ds:Button :variant="variant">
    {% if iconOnly %}<twig:ux:icon name="lucide:plus" class="lp-icon lp-icon--md" />{% else %}Button{% endif %}
</twig:Ds:Button>
<twig:Ds:Button :variant="variant" size="sm">
    {% if iconOnly %}<twig:ux:icon name="lucide:plus" class="lp-icon lp-icon--md" />{% else %}Small{% endif %}
</twig:Ds:Button>
<twig:Ds:Button :variant="variant" disabled>
    {% if iconOnly %}<twig:ux:icon name="lucide:plus" class="lp-icon lp-icon--md" />{% else %}Disabled{% endif %}
</twig:Ds:Button>
<twig:Ds:Button :variant="variant" href="#">
    {% if iconOnly %}<twig:ux:icon name="lucide:plus" class="lp-icon lp-icon--md" />{% else %}Link{% endif %}
</twig:Ds:Button>
