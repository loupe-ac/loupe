{# twig-cs-fixer-disable #}
{# Dev-only specimen of the Switch for the styleguide, so it is intentionally untranslated. #}
<twig:Ds:Switch name="specimen-off" aria-label="Off" />
<twig:Ds:Switch name="specimen-on" aria-label="On" :checked="true" />
<twig:Ds:Switch name="specimen-disabled" aria-label="Disabled" :disabled="true" />
<twig:Ds:Switch name="specimen-field" label="Loupe manages the git identity of agents" help="Agents push as the Loupe app, so you can approve their pull requests." :checked="true" />
