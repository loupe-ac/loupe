{# twig-cs-fixer-disable #}{% autoescape false %}
      <div className="row">
{% for variant in entry.variants %}
        <{{ entry.name }} tone="{{ variant }}">{{ variant }}</{{ entry.name }}>
{% endfor %}
      </div>
      <div className="row" style={{ '{{' }} background: 'var(--surface-3)', padding: 8 {{ '}}' }}>
        <{{ entry.name }} tone="neutral" raised>neutral, raised</{{ entry.name }}>
        <{{ entry.name }} tone="sky" raised>sky, raised</{{ entry.name }}>
      </div>
{% endautoescape %}
