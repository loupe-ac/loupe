{# twig-cs-fixer-disable #}{% autoescape false %}
import React from 'react';

export function {{ entry.name }}({ steps = [], current = 1, complete = false, className: extra, ...rest }) {
    const classes = ['{{ entry.rootClass }}'];
    if (extra) {
        classes.push(extra);
    }

    return (
        <ol data-wizard-step={current} {...rest} className={classes.join(' ')}>
            {steps.map((label, index) => {
                const position = index + 1;
                const state = complete || position < current ? 'done' : position === current ? 'current' : 'upcoming';

                return (
                    <React.Fragment key={label}>
                        {index > 0 && <li className="{{ entry.rootClass }}__bar" aria-hidden="true"></li>}
                        <li className={'{{ entry.rootClass }}__step {{ entry.rootClass }}__step--' + state} aria-current={state === 'current' ? 'step' : undefined}>
                            {state === 'done' ? <svg className="lp-icon lp-icon--lg" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg> : <span className="{{ entry.rootClass }}__number">{position}</span>}
                            {label}
                        </li>
                    </React.Fragment>
                );
            })}
        </ol>
    );
}
{% endautoescape %}
