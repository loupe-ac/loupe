{# twig-cs-fixer-disable #}{% autoescape false %}
{% set isButton = 'button' == entry.element %}
{% set modifiers = [entry.variants ? entry.modifierProp : null, entry.sizes ? 'size' : null]|filter(v => v) %}
import React from 'react';

export const {{ entry.name|upper }}_VARIANTS = [{{ entry.variants|map(v => "'" ~ v ~ "'")|join(', ') }}];
export const {{ entry.name|upper }}_SIZES = [{{ entry.sizes|map(v => "'" ~ v ~ "'")|join(', ') }}];

{% if isButton %}
export function {{ entry.name }}({ {{ modifiers|join(', ') }}, disabled = false, type = 'button', href, onClick, className: extra, children, ...rest }) {
{% else %}
export function {{ entry.name }}({ {{ modifiers|join(', ') }}{{ modifiers ? ', ' : '' }}{% if entry.takesAs %}as: Element = '{{ entry.element }}', {% endif %}{% if entry.dotClass %}dot = true, {% endif %}className: extra, children, ...rest }) {
{% endif %}
    const classes = [{% if entry.element in ['select', 'textarea'] %}'lp-input', {% endif %}'{{ entry.rootClass }}'];
{% if modifiers %}
    for (const names of [{{ modifiers|join(', ') }}]) {
        for (const modifier of (names || '').split(/\s+/).filter(Boolean)) {
            classes.push('{{ entry.rootClass }}--' + modifier);
        }
    }
{% endif %}
    if (extra) {
        classes.push(extra);
    }
    const className = classes.join(' ');
{% if isButton %}

    if (href) {
        return (
            <a {...rest} className={className} href={href} onClick={onClick}>
                {children}
            </a>
        );
    }

    return (
        <button {...rest} className={className} type={type} disabled={disabled} onClick={onClick}>
            {children}
        </button>
    );
{% else %}

{% set tag = entry.takesAs ? 'Element' : entry.element %}

    return (
        <{{ tag }}{% for name, value in entry.attributes %} {{ name }}="{{ value }}"{% endfor %} {...rest} className={className}>
{% if entry.dotClass %}
            {dot && <span className="{{ entry.dotClass }}"></span>}
{% endif %}
{% if entry.contentClass %}
            <span className="{{ entry.contentClass }}">{children}</span>
{% else %}
            {children}
{% endif %}
        </{{ tag }}>
    );
{% endif %}
}
{% endautoescape %}
