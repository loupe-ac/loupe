{# twig-cs-fixer-disable #}{% autoescape false %}
{% set brand = 'nav.brand'|trans %}
import React from 'react';

export function {{ entry.name }}({ className: extra, children, ...rest }) {
    const classes = ['{{ entry.rootClass }}'];
    if (extra) {
        classes.push(extra);
    }

    return (
        <div {...rest} className={classes.join(' ')}>
            <header className="lp-home-nav">
                <a href="#" className="lp-home-brand">
                    <span className="lp-brand lp-brand--md">
                        <span className="lp-brand__mark" aria-hidden="true"></span>
                        <span className="lp-brand__word">{{ brand }}</span>
                    </span>
                </a>
                <nav className="lp-home-nav__links">
                    <a href="#" className="lp-home-nav__link lp-home-nav__link--section">{{ 'landing.nav.docs'|trans }}</a>
                    <a href="#" className="lp-home-nav__link lp-home-nav__link--section">{{ 'landing.nav.blog'|trans }}</a>
                    <a href="#" className="lp-home-nav__link lp-home-nav__link--section">{{ 'landing.nav.github'|trans }}</a>
                    <div className="lp-home-nav__actions">
                        <a href="#" className="lp-home-nav__link">{{ 'landing.nav.login'|trans }}</a>
                        <a href="#" className="lp-btn lp-btn--primary lp-btn--sm">{{ 'landing.cta.join'|trans }}</a>
                    </div>
                </nav>
            </header>
            <main>{children}</main>
            <footer className="lp-home-footer">
                <div className="lp-home-container lp-home-footer__inner">
                    <div className="lp-home-footer__columns">
                        <div className="lp-home-footer__about">
                            <a href="#" className="lp-home-brand">
                                <span className="lp-brand lp-brand--sm">
                                    <span className="lp-brand__mark" aria-hidden="true"></span>
                                    <span className="lp-brand__word">{{ brand }}</span>
                                </span>
                            </a>
                            <p className="lp-home-footer__tagline">{{ 'landing.footer.tagline'|trans }}</p>
                        </div>
                        <nav className="lp-home-footer__column" aria-label="{{ 'landing.footer.product'|trans }}">
                            <span className="lp-home-footer__heading">{{ 'landing.footer.product'|trans }}</span>
                            <ul className="lp-home-footer__list">
                                <li><a href="#" className="lp-home-footer__link">{{ 'landing.nav.workflow'|trans }}</a></li>
                                <li><a href="#" className="lp-home-footer__link">{{ 'landing.nav.features'|trans }}</a></li>
                                <li><a href="#" className="lp-home-footer__link">{{ 'landing.cta.join'|trans }}</a></li>
                            </ul>
                        </nav>
                        <nav className="lp-home-footer__column" aria-label="{{ 'landing.footer.resources'|trans }}">
                            <span className="lp-home-footer__heading">{{ 'landing.footer.resources'|trans }}</span>
                            <ul className="lp-home-footer__list">
                                <li><a href="#" className="lp-home-footer__link">{{ 'landing.footer.documentation'|trans }}</a></li>
                                <li><a href="#" className="lp-home-footer__link">{{ 'landing.footer.blog'|trans }}</a></li>
                                <li><a href="#" className="lp-home-footer__link">{{ 'footer.source.label'|trans }}</a></li>
                            </ul>
                        </nav>
                        <nav className="lp-home-footer__column" aria-label="{{ 'landing.footer.legal'|trans }}">
                            <span className="lp-home-footer__heading">{{ 'landing.footer.legal'|trans }}</span>
                            <ul className="lp-home-footer__list">
                                <li><a href="#" className="lp-home-footer__link">{{ 'account.auth.footer.privacy'|trans }}</a></li>
                                <li><a href="#" className="lp-home-footer__link">{{ 'account.auth.footer.terms'|trans }}</a></li>
                                <li><a href="#" className="lp-home-footer__link">{{ 'account.auth.footer.ai_policy'|trans }}</a></li>
                            </ul>
                        </nav>
                    </div>
                    <div className="lp-home-footer__base">
                        <span>{{ 'account.auth.footer.copyright'|trans }}</span>
                        <span>{{ 'landing.footer.license'|trans }}</span>
                    </div>
                </div>
            </footer>
        </div>
    );
}
{% endautoescape %}
