{# twig-cs-fixer-disable #}{% autoescape false %}
{% set brand = 'nav.brand'|trans %}
import React from 'react';

export function {{ entry.name }}({ className: extra, children, ...rest }) {
    const classes = ['{{ entry.rootClass }}'];
    if (extra) {
        classes.push(extra);
    }

    return (
        <div {...rest} className={classes.join(' ')}>
            <header className="lp-landing-nav">
                <a href="#" className="lp-landing-nav__brand">
                    <span className="lp-brand lp-brand--md">
                        <span className="lp-brand__mark" aria-hidden="true"></span>
                        <span className="lp-brand__word">{{ brand }}</span>
                    </span>
                </a>
                <nav className="lp-landing-nav__links">
                    <a href="#" className="lp-landing-nav__link">{{ 'legal.nav.back_home'|trans }}</a>
                    <a href="#" className="lp-landing-nav__link lp-landing-nav__link--wide">{{ 'landing.nav.login'|trans }}</a>
                    <a href="#" className="lp-btn lp-btn--primary lp-btn--sm">{{ 'landing.cta.signup'|trans }}</a>
                </nav>
            </header>
            <main>{children}</main>
            <footer className="lp-landing-footer">
                <div className="lp-landing-inner lp-landing-footer__row">
                    <span className="lp-landing-footer__copyright">{{ 'account.auth.footer.copyright'|trans }}</span>
                    <nav className="lp-landing-footer__nav">
                        <a href="#" className="lp-landing-footer__link">{{ 'account.auth.footer.privacy'|trans }}</a>
                        <a href="#" className="lp-landing-footer__link">{{ 'account.auth.footer.terms'|trans }}</a>
                        <a href="#" className="lp-landing-footer__link">{{ 'account.auth.footer.ai_policy'|trans }}</a>
                    </nav>
                </div>
            </footer>
        </div>
    );
}
{% endautoescape %}
