{# twig-cs-fixer-disable #}{% autoescape false %}
{% set brand = 'nav.brand'|trans %}
import React from 'react';

const defaultFooter = (
    <>
        <span>{{ 'account.auth.footer.copyright'|trans }}</span>
        <div className="{{ entry.rootClass }}__footer-links">
            <a href="#" className="{{ entry.rootClass }}__footer-link">{{ 'footer.source.label'|trans }}</a>
            <a href="#" className="{{ entry.rootClass }}__footer-link">{{ 'account.auth.footer.docs'|trans }}</a>
            <a href="#" className="{{ entry.rootClass }}__footer-link">{{ 'account.auth.footer.privacy'|trans }}</a>
            <a href="#" className="{{ entry.rootClass }}__footer-link">{{ 'account.auth.footer.terms'|trans }}</a>
            <a href="#" className="{{ entry.rootClass }}__footer-link">{{ 'account.auth.footer.ai_policy'|trans }}</a>
        </div>
    </>
);

export function {{ entry.name }}({ nav, footer = defaultFooter, wide = false, className: extra, children, ...rest }) {
    const card = ['{{ entry.rootClass }}__card', wide ? '{{ entry.rootClass }}__card--wide' : '', extra].filter(Boolean).join(' ');

    return (
        <div {...rest} className="{{ entry.rootClass }}">
            <div className="{{ entry.rootClass }}__grid"></div>
            <div className="{{ entry.rootClass }}__glow"></div>
            <div className="{{ entry.rootClass }}__topbar">
                <a href="/" className="{{ entry.rootClass }}__brand">
                    <span className="lp-brand lp-brand--md">
                        <span className="lp-brand__mark" aria-hidden="true"></span>
                        <span className="lp-brand__word">{{ brand }}</span>
                    </span>
                </a>
                {nav ? <div className="{{ entry.rootClass }}__topbar-nav">{nav}</div> : null}
            </div>
            <main className="{{ entry.rootClass }}__main">
                <div className={card}>{children}</div>
            </main>
            {footer ? <div className="{{ entry.rootClass }}__footer">{footer}</div> : null}
        </div>
    );
}
{% endautoescape %}
