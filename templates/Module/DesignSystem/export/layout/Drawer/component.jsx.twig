{# twig-cs-fixer-disable #}{% autoescape false %}
import React from 'react';

export function {{ entry.name }}({ header, children, footer, loading, className: extra, ...rest }) {
    const classes = ['{{ entry.rootClass }}'];
    if (extra) {
        classes.push(extra);
    }

    return (
        <dialog {...rest} className={classes.join(' ')}>
            {header ? <header className="lp-drawer__header">{header}</header> : null}
            <div className="lp-drawer__body">
                {loading ? <p className="lp-drawer__loading" role="status">{loading}</p> : children}
            </div>
            {footer && !loading ? <footer className="lp-drawer__footer">{footer}</footer> : null}
        </dialog>
    );
}
{% endautoescape %}
