{# twig-cs-fixer-disable #}{% autoescape false %}
import React from 'react';

export function {{ entry.name }}({ title, description, items = [], navLabel, columns, children, className: extra, ...rest }) {
    const classes = ['{{ entry.rootClass }}'];
    if (columns) {
        classes.push('{{ entry.rootClass }}--columns');
    }
    if (extra) {
        classes.push(extra);
    }

    return (
        <div {...rest} className={classes.join(' ')}>
            <header className="lp-page-header">
                <div className="lp-page-header__copy">
                    <h1 className="lp-workspace-title">{title}</h1>
                    {description && <p className="lp-workspace-desc">{description}</p>}
                </div>
            </header>
            <div className={'lp-settings-layout' + (columns ? ' lp-settings-layout--columns' : '')}>
                <div className="lp-overflow-cue lp-overflow-cue--scroll">
                <nav className="lp-settings-nav" aria-label={navLabel}>
                    {items.map((item) => (
                        <a
                            key={item.label}
                            href={item.href}
                            className={'lp-settings-nav__item' + (item.active ? ' lp-settings-nav__item--active' : '')}
                            aria-current={item.active ? 'page' : undefined}
                        >
                            {item.icon}
                            {item.label}
                        </a>
                    ))}
                </nav>
                <button type="button" className="lp-overflow-cue__arrow lp-overflow-cue__arrow--prev" aria-label="Scroll back">
                    <span className="lp-icon lp-icon--md" aria-hidden="true">&lsaquo;</span>
                </button>
                <button type="button" className="lp-overflow-cue__arrow lp-overflow-cue__arrow--next" aria-label="Scroll forward">
                    <span className="lp-icon lp-icon--md" aria-hidden="true">&rsaquo;</span>
                </button>
                </div>
                <div className="lp-settings-content">{children}</div>
            </div>
        </div>
    );
}
{% endautoescape %}
