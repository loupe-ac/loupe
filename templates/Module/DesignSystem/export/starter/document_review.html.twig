{# twig-cs-fixer-disable #}{% extends '@DesignSystem/export/starter/_shell.html.twig' %}

{% block active_nav 'documents' %}

{% block topbar_lead %}
<twig:Ds:Breadcrumbs :items="[{label: 'Documents', url: '#'}, {label: 'Product design: a starter canvas'}]">
    <span class="lp-version-pill">v2</span>
</twig:Ds:Breadcrumbs>
{% endblock %}

{% block topbar_actions %}
<div class="lp-review-topbar-actions">
    <twig:Ds:Button variant="primary" type="button">Finish review</twig:Ds:Button>
</div>
{% endblock %}

{% block body %}
<div class="lp-review">
    <div class="lp-review-block">
        <div class="lp-review-doc" data-starter-slot></div>
        <aside class="lp-review-panels lp-review-panels--document" aria-label="Review panels">
            <div class="lp-review-panels__inner">
                <div class="lp-review-toolbar">
                    <button type="button" class="lp-review-toolbar__button" aria-pressed="true" aria-label="Decisions"><twig:ux:icon name="lucide:list-checks" /></button>
                    <button type="button" class="lp-review-toolbar__button" aria-pressed="false" aria-label="Comments"><twig:ux:icon name="lucide:message-square" /><span>3</span></button>
                    <button type="button" class="lp-review-toolbar__button" aria-pressed="false" aria-label="Outline"><twig:ux:icon name="lucide:list" /></button>
                </div>
            </div>
        </aside>
    </div>
</div>
{% endblock %}
