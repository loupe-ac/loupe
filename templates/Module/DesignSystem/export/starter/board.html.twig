{# twig-cs-fixer-disable #}{% extends '@DesignSystem/export/starter/_shell.html.twig' %}

{% block active_nav 'board' %}

{% block shell_width 'full' %}

{% block topbar_lead %}<twig:Ds:Breadcrumbs :items="[{label: 'Board'}]" />{% endblock %}

{% block body %}
<twig:Ds:SplitView width="full" class="lp-core-prototype-page lp-core-board">
    <div class="lp-split-region">
        <div id="board" class="lp-board">
            <div class="lp-board-header">
                <div class="lp-board-toolbar">
                    <h1 class="lp-board-toolbar__title">Board</h1>
                    <div class="lp-board-toolbar__filters">
                        <label class="lp-board-toolbar__search">
                            <span class="sr-only">Search cards</span>
                            <twig:ux:icon name="lucide:search" class="lp-board-toolbar__search-icon" />
                            <input type="search" class="lp-board-toolbar__input" placeholder="Search cards">
                        </label>
                    </div>
                    <span class="lp-board-toolbar__count">24 cards</span>
                    <div class="lp-board-toolbar__actions">
                        <div class="lp-board-toolbar__mode" aria-label="View">
                            <button type="button" class="lp-board-toolbar__mode-button" aria-pressed="true">
                                <twig:ux:icon name="lucide:square-kanban" class="lp-icon lp-icon--md" />
                                Board
                            </button>
                            <button type="button" class="lp-board-toolbar__mode-button" aria-pressed="false">
                                <twig:ux:icon name="lucide:list" class="lp-icon lp-icon--md" />
                                List
                            </button>
                        </div>
                        <twig:Ds:Button variant="ghost icon" href="#" aria-label="Board settings">
                            <twig:ux:icon name="lucide:settings" class="lp-icon lp-icon--md" />
                        </twig:Ds:Button>
                        <twig:Ds:Button variant="primary" href="#">
                            <twig:ux:icon name="lucide:plus" class="lp-icon lp-icon--md" />
                            New card
                        </twig:Ds:Button>
                    </div>
                </div>
            </div>
            <div class="lp-board__columns lp-board__columns--lanes" data-starter-slot></div>
        </div>
    </div>
</twig:Ds:SplitView>
{% endblock %}
