{# twig-cs-fixer-disable #}<x-dc>
<helmet>
<link rel="stylesheet" href="styles/app.css">
</helmet>
<div class="font-sans antialiased text-fg bg-app text-sm tracking-normal">
<div class="lp-app">
<aside class="lp-sidebar lp-sidebar--drawer" id="lp-sidebar">
    <a href="#" class="lp-sidebar__brand"><twig:Ds:BrandMark /></a>
    <button type="button" class="lp-sidebar__switcher" aria-label="Switch project">
        <twig:Ds:Avatar name="Demo Project" size="sm" shape="square" tone="danger" />
        <span class="lp-sidebar__switcher-text">
            <span class="lp-sidebar__switcher-label">Project</span>
            <span class="lp-sidebar__switcher-name">Demo Project</span>
        </span>
        <twig:ux:icon name="lucide:arrow-down" class="lp-sidebar__switcher-caret" />
    </button>
    {% set active = block('active_nav')|trim %}
    <nav class="lp-sidebar__nav">
        <span class="lp-sidebar__nav-label">Workspace</span>
        <twig:Ds:NavItem url="#" icon="lucide:layout-dashboard" label="Workshop" :active="'workshop' == active" />
        <twig:Ds:NavItem url="#" icon="lucide:inbox" label="Inbox" :active="'inbox' == active" />
        <twig:Ds:NavItem url="#" icon="lucide:square-kanban" label="Board" :active="'board' == active" />
        <twig:Ds:NavItem url="#" icon="lucide:file-text" label="Documents" :active="'documents' == active" :count="12" />
        <span class="lp-sidebar__nav-label lp-sidebar__nav-label--spaced">Agents</span>
        <twig:Ds:NavItem url="#" icon="lucide:bot" label="Agents" />
        <twig:Ds:NavItem url="#" icon="lucide:workflow" label="Workflow" />
        <twig:Ds:NavItem url="#" icon="lucide:activity" label="Activity" />
        <twig:Ds:NavItem url="#" icon="lucide:chart-column" label="Analytics" />
        <twig:Ds:NavItem url="#" icon="lucide:send" label="Outbox" />
    </nav>
    <div class="lp-sidebar__spacer"></div>
    <nav class="lp-sidebar__nav lp-sidebar__nav--secondary">
        <twig:Ds:NavItem url="#" icon="lucide:settings" label="Project settings" :active="'settings' == active" />
        <twig:Ds:NavItem url="#" icon="lucide:user" label="Account" />
        <twig:Ds:NavItem url="#" icon="lucide:info" label="About" />
    </nav>
    <div class="lp-sidebar__account">
        <twig:Ds:Avatar name="demo@loupe.example" size="xs" tone="chrome" />
        <span class="lp-sidebar__account-text">
            <span class="lp-sidebar__account-name">demo@loupe.example</span>
        </span>
        <button type="button" class="lp-sidebar__account-logout" aria-label="Sign out"><twig:ux:icon name="lucide:log-out" /></button>
    </div>
</aside>
<div class="lp-shell lp-shell--{% block shell_width 'default' %}">
    <header class="lp-topbar">
        <div class="lp-topbar__lead">{% block topbar_lead %}{% endblock %}</div>
        {% block topbar_actions %}{% endblock %}
        <div class="lp-topbar__global-actions">
            <twig:Ds:Button variant="primary" class="lp-topbar__new-work" href="#" aria-label="New work">
                <twig:ux:icon name="lucide:plus" class="lp-icon lp-icon--md" />
                <span>New work</span>
            </twig:Ds:Button>
        </div>
    </header>
    {% block main %}<main id="main-content" class="lp-main lp-main--app" tabindex="-1">{% block body %}{% endblock %}</main>{% endblock %}
</div>
</div>
</div>
</x-dc>
