{# twig-cs-fixer-disable #}{% extends '@DesignSystem/export/starter/_shell.html.twig' %}

{% block active_nav 'settings' %}

{% block topbar_lead %}<twig:Ds:Breadcrumbs :items="[{label: 'Project settings'}]" />{% endblock %}

{% block body %}
{% set items = [
    {label: 'General', url: '#', icon: 'lucide:settings', active: true},
    {label: 'Columns', url: '#', icon: 'lucide:square-kanban', active: false},
    {label: 'Automation', url: '#', icon: 'lucide:bot', active: false},
    {label: 'Inbox', url: '#', icon: 'lucide:inbox', active: false},
    {label: 'Readiness', url: '#', icon: 'lucide:list-checks', active: false},
    {label: 'Connections', url: '#', icon: 'lucide:link', active: false},
] %}
<twig:Ds:Workspace class="lp-redesign-secondary lp-redesign-settings">
    <twig:Ds:SettingsLayout title="Project settings" description="Manage this project." :items="items" navLabel="Settings sections">
        <div data-starter-slot></div>
    </twig:Ds:SettingsLayout>
</twig:Ds:Workspace>
{% endblock %}
