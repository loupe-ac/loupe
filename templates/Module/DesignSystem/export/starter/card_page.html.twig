{# twig-cs-fixer-disable #}{% extends '@DesignSystem/export/starter/_shell.html.twig' %}

{% block active_nav 'board' %}

{% block topbar_lead %}<twig:Ds:Breadcrumbs :items="[{label: 'Board', url: '#'}, {label: '#42'}]" />{% endblock %}

{% block body %}
<div class="lp-card-drawer">
    <header class="lp-card-drawer__header">
        <div class="lp-card-drawer__identity">
            <span class="lp-card-drawer__icon"><twig:ux:icon name="lucide:layout-list" class="lp-icon lp-icon--md" /></span>
            <span class="lp-card-number">#42</span>
            <twig:Ds:Tag tone="blue">Feature</twig:Ds:Tag>
            <twig:Ds:Tag>In progress</twig:Ds:Tag>
        </div>
        <div class="lp-card-drawer__header-actions">
            <twig:Ds:Button variant="ghost" href="#"><twig:ux:icon name="lucide:pencil" class="lp-icon lp-icon--md" />Edit</twig:Ds:Button>
            <twig:Ds:Button variant="ghost icon" href="#" aria-label="Close"><twig:ux:icon name="lucide:x" class="lp-icon lp-icon--md" /></twig:Ds:Button>
        </div>
    </header>
    <div class="lp-card-drawer__body">
        <h1 class="lp-card-drawer__title">Add a starter canvas to each project</h1>
        <twig:Ds:Tabs tag="div" role="tablist" aria-label="Card sections">
            <button type="button" class="lp-tabs__tab" role="tab" aria-selected="true">Overview</button>
            <button type="button" class="lp-tabs__tab" role="tab" aria-selected="false" tabindex="-1">Details</button>
            <button type="button" class="lp-tabs__tab" role="tab" aria-selected="false" tabindex="-1">Conversation</button>
            <button type="button" class="lp-tabs__tab" role="tab" aria-selected="false" tabindex="-1">Feedback</button>
            <button type="button" class="lp-tabs__tab" role="tab" aria-selected="false" tabindex="-1">History</button>
        </twig:Ds:Tabs>
        <section class="lp-card-panel" role="tabpanel" data-starter-slot></section>
    </div>
    <footer class="lp-card-drawer__footer">
        <twig:Ds:Button variant="danger" type="button">Delete card</twig:Ds:Button>
    </footer>
</div>
{% endblock %}
