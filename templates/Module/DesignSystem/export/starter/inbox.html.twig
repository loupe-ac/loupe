{# twig-cs-fixer-disable #}{% extends '@DesignSystem/export/starter/_shell.html.twig' %}

{% block active_nav 'inbox' %}

{% block shell_width 'full' %}

{% block topbar_lead %}<twig:Ds:Breadcrumbs :items="[{label: 'Inbox'}]" />{% endblock %}

{% block topbar_actions %}
<div class="lp-inbox-topbar-actions">
    <twig:Ds:Button variant="ghost" href="#" aria-label="View activity">
        <twig:ux:icon name="lucide:activity" class="lp-icon lp-icon--md" />
        <span class="lp-inbox-topbar-actions__label">View activity</span>
    </twig:Ds:Button>
    <twig:Ds:Button variant="ghost" href="#" aria-label="Settings">
        <twig:ux:icon name="lucide:settings" class="lp-icon lp-icon--md" />
        <span class="lp-inbox-topbar-actions__label">Settings</span>
    </twig:Ds:Button>
</div>
{% endblock %}

{% block body %}
<twig:Ds:SplitView width="full" class="lp-needs-you lp-core-prototype-page lp-core-inbox">
    <h1 class="sr-only">Inbox</h1>
    <section class="lp-inbox-section lp-inbox-section--queue lp-split-region">
        <div class="lp-split-view lp-inbox-split">
            <div class="lp-inbox-request-list lp-split-pane">
                <div class="lp-inbox-list-head">
                    <twig:Ds:Tabs variant="segmented" aria-label="Inbox view">
                        <a class="lp-tabs__tab" href="#" aria-current="page">Waiting on you (3)</a>
                        <a class="lp-tabs__tab" href="#">Closed</a>
                    </twig:Ds:Tabs>
                    <twig:Ds:FilterBar :search="{id: 'inbox-search', name: 'q', value: '', label: 'Search the inbox', placeholder: 'Search the inbox'}" />
                    <div class="lp-inbox-filter" role="group" aria-label="Filter by type">
                        <a class="lp-inbox-filter__button lp-inbox-filter__button--all" href="#" aria-current="true">All</a>
                        {% for kind, label in {question: 'Questions', review: 'Reviews', todo: 'To-dos', wait: 'Waits', workflow: 'Workflow'} %}
                            <a class="lp-inbox-filter__button" href="#" aria-label="{{ label }}">
                                {% include '@Inbox/_inbox_kind_icon.html.twig' with {kind: kind} only %}
                            </a>
                        {% endfor %}
                    </div>
                </div>
                <div class="lp-inbox-rows">
                    <twig:Ds:ListRow title="Choose the export layout" :current="true">
                        <twig:block name="icon"><twig:ux:icon name="lucide:circle-help" /></twig:block>
                        <twig:block name="meta">2h</twig:block>
                    </twig:Ds:ListRow>
                    <twig:Ds:ListRow title="Review the tech design">
                        <twig:block name="icon"><twig:ux:icon name="lucide:file-text" /></twig:block>
                        <twig:block name="meta">5h</twig:block>
                    </twig:Ds:ListRow>
                    <twig:Ds:ListRow title="Approve the pull request">
                        <twig:block name="icon"><twig:ux:icon name="lucide:git-pull-request" /></twig:block>
                        <twig:block name="meta">1d</twig:block>
                    </twig:Ds:ListRow>
                </div>
            </div>
            <div class="lp-inbox-request-detail lp-split-pane" data-starter-slot></div>
        </div>
    </section>
</twig:Ds:SplitView>
{% endblock %}
