<twig:Ds:DataTable :label="'workflow.settings.rules.table.label'|trans" :columns="[
    {label: 'workflow.settings.rules.id'|trans},
    {label: 'workflow.settings.rules.applies_to'|trans},
    {label: 'workflow.settings.rules.action'|trans},
    {label: 'workflow.settings.rules.conditions'|trans},
]">
    {% for rule in rules %}
    <div class="lp-data-table__row" role="row" data-rule-id="{{ rule.id }}"{% if rule.missingConditions is not empty or rule.missingAction is not null %} data-rule-missing{% endif %}>
        <span class="lp-data-table__cell lp-data-table__title" role="cell">{{ rule.id }}</span>
        <span class="lp-data-table__cell" role="cell">{{ rule.appliesToKey|trans }}</span>
        <span class="lp-data-table__cell" role="cell">{{ rule.actionKey|trans({'%target%': rule.targetKey is null ? '' : rule.targetKey|trans, '%kind%': rule.kind ?? ''}) }}</span>
        <div class="lp-data-table__cell" role="cell" data-rule-conditions>
            {% for group in rule.whenGroups %}
            {% include '@Workflow/_condition_group.html.twig' with {group: group} only %}
            {% endfor %}
            {% if rule.untilGroups is not empty %}
            <div data-rule-until>{{ 'workflow.settings.rules.until'|trans }}
                {% for group in rule.untilGroups %}
                {% include '@Workflow/_condition_group.html.twig' with {group: group} only %}
                {% endfor %}
            </div>
            {% endif %}
            {% if rule.refillGroups is not empty %}
            <div data-rule-refill>{{ 'workflow.settings.rules.refill'|trans }}
                {% for group in rule.refillGroups %}
                {% include '@Workflow/_condition_group.html.twig' with {group: group} only %}
                {% endfor %}
            </div>
            {% endif %}
            {% for key in rule.missingConditions %}
            <twig:Ds:Tag tone="amber">{{ 'workflow.settings.rules.missing_condition'|trans({'%condition%': key}) }}</twig:Ds:Tag>
            {% endfor %}
            {% if rule.missingAction is not null %}
            <twig:Ds:Tag tone="amber">{{ 'workflow.settings.rules.missing_action'|trans({'%action%': rule.missingAction}) }}</twig:Ds:Tag>
            {% endif %}
        </div>
    </div>
    {% endfor %}
</twig:Ds:DataTable>
