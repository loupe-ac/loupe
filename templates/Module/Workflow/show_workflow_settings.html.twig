{% extends 'base.html.twig' %}

{% block title %}{{ 'workflow.settings.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'nav.link.workflow'|trans},
    ]" />
{% endblock %}

{% block body %}
{% do mercure_subscribe(board_topic(project)) %}
<twig:Ds:Workspace class="lp-orchestration-page lp-redesign-secondary" data-live-content>
    {% include '@Workflow/_workflow_settings_frame.html.twig' with {project: project, template: template} only %}
</twig:Ds:Workspace>
{% endblock %}
