{% extends 'base.html.twig' %}

{% block title %}{{ 'workflow.settings.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'nav.link.workflow'|trans},
    ]" />
{% endblock %}

{% block body %}
<twig:Ds:Workspace class="lp-orchestration-page lp-redesign-secondary">
    {% if template is null %}
    <header class="lp-orchestration-header">
        <div>
            <h1 class="lp-workspace-title">{{ 'workflow.settings.page.title'|trans }}</h1>
        </div>
    </header>
    <twig:Ds:EmptyState icon="lucide:workflow" :body="'workflow.settings.unbound'|trans" data-workflow-unbound />
    {% else %}
    <header class="lp-orchestration-header" data-workflow-template="{{ template.key }}">
        <div>
            <h1 class="lp-workspace-title">{{ template.labelKey|trans }}</h1>
            <p class="lp-workspace-desc">{{ template.descriptionKey|trans }}</p>
            <p class="lp-workspace-desc">
                {{ 'workflow.settings.version'|trans({'%version%': template.version}) }}
                · <time datetime="{{ template.boundAt|date('c') }}">{{ 'workflow.settings.bound_at'|trans({'%date%': template.boundAt|date('j M Y')}) }}</time>
            </p>
        </div>
    </header>

    <section class="lp-workflow-section">
        <twig:Ds:SectionHeading>{{ 'workflow.settings.slots.heading'|trans }}</twig:Ds:SectionHeading>
        {% if template.slots is not empty %}
        <twig:Ds:DataTable :label="'workflow.settings.slots.table.label'|trans" :columns="[
            {label: 'workflow.settings.slots.slot'|trans},
            {label: 'workflow.settings.slots.column'|trans},
        ]">
            {% for slot in template.slots %}
            <div class="lp-data-table__row" role="row" data-slot-key="{{ slot.key }}">
                <span class="lp-data-table__cell lp-data-table__title" role="cell">{{ slot.labelKey|trans }}</span>
                <span class="lp-data-table__cell" role="cell" data-slot-column>
                    {%- if slot.columnLabel is not null %}{{ slot.columnLabel|trans }}{% else %}<twig:Ds:Tag tone="amber">{{ 'workflow.settings.slots.not_linked'|trans }}</twig:Ds:Tag>{% endif -%}
                </span>
            </div>
            {% endfor %}
        </twig:Ds:DataTable>
        {% else %}
        <p class="lp-workspace-desc">{{ 'workflow.settings.slots.none'|trans }}</p>
        {% endif %}
    </section>

    <section class="lp-workflow-section" data-workflow-types>
        <twig:Ds:SectionHeading>{{ 'workflow.settings.types.heading'|trans }}</twig:Ds:SectionHeading>
        <p class="lp-workspace-desc">{{ 'workflow.settings.types.description'|trans }}</p>
        <twig:Ds:DataTable :label="'workflow.settings.types.table.label'|trans" :columns="[
            {label: 'workflow.settings.types.type'|trans},
            {label: 'workflow.settings.types.capabilities'|trans},
        ]">
            {% for type in template.types %}
            <div class="lp-data-table__row" role="row" data-card-type="{{ type.key }}">
                <span class="lp-data-table__cell lp-data-table__title" role="cell">
                    {% include '_tone_tag.html.twig' with {label: type.labelKey|trans, tone: type.tone} only %}
                    {%- if type.isDefault %} <twig:Ds:Tag tone="neutral" data-card-type-default>{{ 'workflow.settings.types.default'|trans }}</twig:Ds:Tag>{% endif -%}
                </span>
                <span class="lp-data-table__cell" role="cell" data-card-type-capabilities>
                    {%- set capabilities = [] -%}
                    {%- if type.children %}{% set capabilities = capabilities|merge(['workflow.settings.types.capability.children'|trans]) %}{% endif -%}
                    {%- if type.lane %}{% set capabilities = capabilities|merge(['workflow.settings.types.capability.lane'|trans]) %}{% endif -%}
                    {{- capabilities is empty ? 'workflow.settings.types.capability.none'|trans : capabilities|join(', ') -}}
                </span>
            </div>
            {% endfor %}
        </twig:Ds:DataTable>
    </section>

    <section class="lp-workflow-section" data-workflow-markers>
        <twig:Ds:SectionHeading>{{ 'workflow.settings.markers.heading'|trans }}</twig:Ds:SectionHeading>
        <p class="lp-workspace-desc">{{ 'workflow.settings.markers.description'|trans }}</p>
        {% if template.markers is not empty %}
        <twig:Ds:DataTable :label="'workflow.settings.markers.table.label'|trans" :columns="[
            {label: 'workflow.settings.markers.marker'|trans},
            {label: 'workflow.settings.markers.kind'|trans},
            {label: 'workflow.settings.markers.applies_to'|trans},
            {label: 'workflow.settings.rules.conditions'|trans},
        ]">
            {% for marker in template.markers %}
            <div class="lp-data-table__row" role="row" data-marker-key="{{ marker.key }}"{% if marker.missingConditions is not empty %} data-marker-missing{% endif %}>
                <span class="lp-data-table__cell lp-data-table__title" role="cell">
                    {{ marker.labelKey|trans }}
                    {%- if marker.fallback %} <twig:Ds:Tag tone="neutral" data-marker-fallback>{{ 'workflow.settings.markers.fallback'|trans }}</twig:Ds:Tag>{% endif -%}
                </span>
                <span class="lp-data-table__cell" role="cell" data-marker-kind>{{ ('workflow.settings.markers.kind.' ~ marker.kind)|trans }}</span>
                <span class="lp-data-table__cell" role="cell" data-marker-slots>
                    {%- if marker.slotLabelKeys is empty %}{{ 'workflow.settings.markers.every_open_column'|trans }}{% else %}{{ marker.slotLabelKeys|map(key => key|trans)|join(', ') }}{% endif -%}
                </span>
                <div class="lp-data-table__cell" role="cell" data-marker-conditions>
                    {% for group in marker.whenGroups %}
                    {% include '@Workflow/_condition_group.html.twig' with {group: group} only %}
                    {% endfor %}
                    {% for key in marker.missingConditions %}
                    <twig:Ds:Tag tone="amber">{{ 'workflow.settings.rules.missing_condition'|trans({'%condition%': key}) }}</twig:Ds:Tag>
                    {% endfor %}
                </div>
            </div>
            {% endfor %}
        </twig:Ds:DataTable>
        {% else %}
        <p class="lp-workspace-desc">{{ 'workflow.settings.markers.none'|trans }}</p>
        {% endif %}
    </section>

    <section class="lp-workflow-section" data-workflow-metrics>
        <twig:Ds:SectionHeading>{{ 'workflow.settings.metrics.heading'|trans }}</twig:Ds:SectionHeading>
        <p class="lp-workspace-desc">{{ 'workflow.settings.metrics.description'|trans }}</p>
        {% if template.metrics is not empty %}
        <twig:Ds:DataTable modifier="metrics" :label="'workflow.settings.metrics.table.label'|trans" :columns="[
            {label: 'workflow.settings.metrics.metric'|trans},
            {label: 'workflow.settings.metrics.key'|trans},
            {label: 'workflow.settings.metrics.type'|trans},
            {label: 'workflow.settings.metrics.reads'|trans},
        ]">
            {% for metric in template.metrics %}
            <div class="lp-data-table__row" role="row" data-metric-key="{{ metric.key }}">
                <span class="lp-data-table__cell lp-data-table__cell--wrap" role="cell">
                    <span class="lp-data-table__title" data-metric-label>{{ metric.label }}</span>
                    <span class="lp-data-table__sub" data-metric-description>{{ metric.description }}</span>
                </span>
                <span class="lp-data-table__cell lp-data-table__cell--code" role="cell" data-metric-id>{{ metric.key }}</span>
                <span class="lp-data-table__cell" role="cell" data-metric-type>
                    <twig:Ds:Tag :tone="{count: 'blue', rate: 'teal', duration: 'purple'}[metric.type]">{{ ('workflow.settings.metrics.type.' ~ metric.type)|trans }}</twig:Ds:Tag>
                </span>
                <span class="lp-data-table__cell lp-data-table__cell--wrap" role="cell" data-metric-reads>{{ metric.reads }}</span>
            </div>
            {% endfor %}
        </twig:Ds:DataTable>
        {% else %}
        <p class="lp-workspace-desc">{{ 'workflow.settings.metrics.none'|trans }}</p>
        {% endif %}
    </section>

    <section class="lp-workflow-section" data-workflow-template-rules>
        <twig:Ds:SectionHeading>{{ 'workflow.settings.rules.heading'|trans }}</twig:Ds:SectionHeading>
        {% include '@Workflow/_rule_table.html.twig' with {rules: template.rules} only %}
    </section>

    {% if template.appRules is not empty %}
    <section class="lp-workflow-section" data-workflow-app-rules>
        <twig:Ds:SectionHeading>{{ 'workflow.settings.app_rules.heading'|trans }}</twig:Ds:SectionHeading>
        <p class="lp-workspace-desc">{{ 'workflow.settings.app_rules.description'|trans }}</p>
        {% include '@Workflow/_rule_table.html.twig' with {rules: template.appRules} only %}
    </section>
    {% endif %}

    <section class="lp-workflow-section">
        <twig:Ds:SectionHeading>{{ 'workflow.settings.moves.heading'|trans }}</twig:Ds:SectionHeading>
        <p class="lp-workspace-desc">{{ 'workflow.settings.moves.description'|trans }}</p>
        {% if template.manualMoves is not empty %}
        <twig:Ds:DataTable :label="'workflow.settings.moves.table.label'|trans" :columns="[
            {label: 'workflow.settings.moves.from'|trans},
            {label: 'workflow.settings.moves.to'|trans},
            {label: 'workflow.settings.moves.by'|trans},
        ]">
            {% for move in template.manualMoves %}
            <div class="lp-data-table__row" role="row" data-manual-move>
                <span class="lp-data-table__cell" role="cell">{{ move.fromKey|trans }}</span>
                <span class="lp-data-table__cell" role="cell">{{ move.toKey|trans }}</span>
                <span class="lp-data-table__cell" role="cell" data-manual-move-by>{{ move.byKey|trans }}</span>
            </div>
            {% endfor %}
        </twig:Ds:DataTable>
        {% else %}
        <p class="lp-workspace-desc">{{ 'workflow.settings.moves.none'|trans }}</p>
        {% endif %}
    </section>

    <section class="lp-workflow-section" data-workflow-timings>
        <twig:Ds:SectionHeading>{{ 'workflow.settings.timings.heading'|trans }}</twig:Ds:SectionHeading>
        <p class="lp-workspace-desc">{{ 'workflow.settings.timings.backoff'|trans({'%minutes%': template.backoffMinutes|join(', ')}) }}</p>
        {% if template.workFailedBackoffMinutes is not null %}
            <p class="lp-workspace-desc">{{ 'workflow.settings.timings.work_failed_backoff'|trans({'%minutes%': template.workFailedBackoffMinutes|join(', ')}) }}</p>
        {% endif %}
    </section>
    {% endif %}
</twig:Ds:Workspace>
{% endblock %}
