{% extends 'base.html.twig' %}

{# Each page names its section, because a forwarded 422 render carries no _route. #}
{% block settings_section '' %}

{# A non-empty value gives the content its own column width. #}
{% block settings_columns '' %}

{% block body %}
{% set section = block('settings_section') %}
{% set columns = '' != block('settings_columns') %}
{% set settingsContent %}{% block settings_content %}{% endblock %}{% endset %}
{% set items = [
    {label: 'project.edit.nav.general'|trans, url: path('app_project_edit', {id: project.id}), icon: 'lucide:settings', active: 'general' == section},
    {label: 'project.edit.nav.columns'|trans, url: path('app_board_settings', {id: project.id}), icon: 'lucide:square-kanban', active: 'columns' == section},
    {label: 'project.edit.nav.automation'|trans, url: path('app_board_automation_settings', {id: project.id}), icon: 'lucide:bot', active: 'automation' == section},
    {label: 'project.edit.nav.readiness'|trans, url: path('app_readiness_settings', {id: project.id}), icon: 'lucide:list-checks', active: 'readiness' == section},
    {label: 'project.edit.nav.connections'|trans, url: path('app_project_connect', {id: project.id}), icon: 'lucide:link', active: 'connections' == section},
    is_granted(constant('App\\Module\\Project\\Security\\ProjectVoter::MANAGE'), project) ? {label: 'project.edit.nav.openrouter'|trans, url: path('app_project_openrouter', {id: project.id}), icon: 'lucide:key-round', active: 'openrouter' == section},
    is_granted(constant('App\\Module\\Project\\Security\\ProjectVoter::MANAGE'), project) ? {label: 'project.edit.nav.repositories'|trans, url: path('app_project_repositories_settings', {id: project.id}), icon: 'lucide:git-pull-request', active: 'repositories' == section},
]|filter(item => item) %}
<twig:Ds:Workspace class="lp-redesign-secondary lp-redesign-settings">
    <twig:Ds:SettingsLayout
        :title="'project.edit.page.title'|trans"
        :description="'project.edit.page.description'|trans"
        :items="items"
        :navLabel="'project.edit.nav.label'|trans"
        :columns="columns"
    >
        {{ settingsContent }}
    </twig:Ds:SettingsLayout>
</twig:Ds:Workspace>
{% endblock %}
