{#- The other ways to connect: the setup prompt, the endpoint, the two ways to
    wire it up by hand, and the two agent skills. Props: mcpServerName (string),
    projectId (string). -#}
{%- set mcpUrl = url('_mcp_endpoint') -%}
{%- set setupPrompt = [
    'Set up Loupe for this repository. Run',
    'curl -fsSL "' ~ url('app_setup_instructions', {project: projectId}) ~ '"',
    'and follow the steps it prints, in order. Use curl, not a web fetch tool.'
]|join("\n") -%}
{%- set claudeCommand = [
    'claude mcp add --transport http ' ~ mcpServerName ~ ' ' ~ mcpUrl,
    'claude mcp login ' ~ mcpServerName
]|join("\n") -%}
{%- set mcpJson = [
    "{",
    "  \"mcpServers\": {",
    "    \"" ~ mcpServerName ~ "\": {",
    "      \"type\": \"http\",",
    "      \"url\": \"" ~ mcpUrl ~ "\"",
    "    }",
    "  }",
    "}"
]|join("\n") -%}
{%- set skills = {
    'loupe-documents': 'project.connect.skills.documents',
    'loupe-site-review': 'project.connect.skills.site_review',
} -%}
{#- Keys spelled out rather than built from a prefix, so grepping for one finds
    this line. -#}
{%- set methods = [
    {
        icon: 'lucide:code',
        heading: 'project.connect.cli.heading',
        id: 'cli',
        sub: 'project.connect.cli.sub',
        label: 'project.connect.cli.label',
        command: claudeCommand,
    },
    {
        icon: 'lucide:file-text',
        heading: 'project.connect.mcp_json.heading',
        id: 'mcp_json',
        sub: 'project.connect.mcp_json.sub',
        label: 'project.connect.mcp_json.label',
        command: mcpJson,
    },
] -%}

<div class="lp-connect-block">
    <div class="lp-connect-block__heading">
        <p class="lp-eyebrow">{{ 'project.connect.setup_prompt.heading'|trans }}</p>
    </div>
    <p class="lp-connect-hint">{{ 'project.connect.setup_prompt.hint'|trans }}</p>
    <twig:Ds:CodeBlock
        :label="'project.connect.setup_prompt.label'|trans"
        :text="setupPrompt"
        :copyLabel="'project.connect.copy'|trans"
        :copiedLabel="'project.connect.copied'|trans"
        testid="setup-prompt" />
</div>

{# ── MCP endpoint (global; a request names the project it acts on) ── #}
<div class="lp-connect-block">
    <p class="lp-eyebrow">{{ 'project.connect.endpoint.eyebrow'|trans }}</p>
    <div class="lp-connect-field">
        <twig:ux:icon name="lucide:code-xml" class="lp-icon lp-icon--md lp-connect-field__glyph" />
        <code class="lp-connect-field__value">{{ mcpUrl }}</code>
        <twig:Ds:CopyButton :text="mcpUrl" :label="'project.connect.copy'|trans" :copiedLabel="'project.connect.copied'|trans" />
    </div>
</div>

{#- Collapsed by default: a reader picks the one client they use, and an
    expanded block is half a page nobody else needs. -#}
<div class="lp-connect-block">
    <p class="lp-eyebrow">{{ 'project.connect.methods.eyebrow'|trans }}</p>
    <div class="lp-install-list">
        {% for method in methods %}
        <details class="lp-install" data-testid="install-{{ method.id }}">
            <summary class="lp-install__summary">
                <twig:ux:icon name="{{ method.icon }}" class="lp-icon lp-icon--md lp-install__glyph" />
                <span class="lp-install__text">
                    <span class="lp-install__title">{{ method.heading|trans }}</span>
                    <span class="lp-install__sub">{{ method.sub|trans }}</span>
                </span>
                <twig:ux:icon name="lucide:chevron-right" class="lp-install__caret" />
            </summary>
            <div class="lp-install__body">
                <twig:Ds:CodeBlock
                    :label="method.label|trans"
                    :text="method.command"
                    :copyLabel="'project.connect.copy'|trans"
                    :copiedLabel="'project.connect.copied'|trans" />
            </div>
        </details>
        {% endfor %}
    </div>
</div>

{#- Sits after every method on purpose: only the plugin ships the skills, so a
    reader who took either hand-wired route would otherwise never learn they
    exist. -#}
<div class="lp-skills-panel">
    <div class="lp-skills-panel__header">
        <twig:ux:icon name="lucide:graduation-cap" class="lp-icon lp-icon--lg lp-skills-panel__icon" />
        <h3 class="lp-skills-panel__title">{{ 'project.connect.skills.heading'|trans }}</h3>
    </div>
    <p class="lp-connect-hint">{{ 'project.connect.skills.hint'|trans }}</p>
    <div class="lp-skills">
        {% for name, descriptionKey in skills %}
        <div class="lp-skills__row">
            <code class="lp-skills__name">{{ name }}</code>
            <p class="lp-skills__desc">{{ descriptionKey|trans }}</p>
        </div>
        {% endfor %}
    </div>
    <p class="lp-connect-hint">{{ 'project.connect.skills.manual'|trans }}</p>
</div>
