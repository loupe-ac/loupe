{% extends 'base.html.twig' %}

{% block title %}{{ 'project.wizard.connect.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<div class="lp-workspace">
    {% include '@Project/wizard/_wizard_progress.html.twig' with {step: 2} only %}

    <h1 class="lp-workspace-title">{{ 'project.wizard.connect.heading'|trans }}</h1>
    <p class="lp-workspace-desc">{{ 'project.wizard.connect.lead'|trans }}</p>

    <div class="flex flex-col gap-5">
        <section class="lp-connect-step">
            <div class="lp-connect-step__header">
                <span class="lp-connect-step__badge">1</span>
                <div>
                    <h2 class="lp-connect-step__heading">{{ 'project.wizard.connect.step.point.heading'|trans }}</h2>
                    <p class="lp-connect-step__purpose">{{ 'project.wizard.connect.step.point.purpose'|trans }}</p>
                </div>
            </div>

            {% include '@Project/_connect_instructions.html.twig' with {mcpServerName: mcpServerName, projectId: wizardProject.id} only %}
        </section>
    </div>

    <twig:Ds:FormActions>
        <twig:Ds:ActionForm :action="path('app_welcome_skip')" token="wizard-skip">
            <twig:Ds:Button variant="ghost" type="submit">{{ 'project.wizard.skip'|trans }}</twig:Ds:Button>
        </twig:Ds:ActionForm>
        <twig:Ds:Button variant="primary" href="{{ path('app_welcome_widget') }}">{{ 'project.wizard.connect.continue'|trans }}</twig:Ds:Button>
    </twig:Ds:FormActions>
</div>
{% endblock %}
