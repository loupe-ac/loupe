{% extends 'base.html.twig' %}

{% block title %}{{ 'project.wizard.widget.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<twig:Ds:Workspace width="narrow">
    {% include '@Project/wizard/_wizard_progress.html.twig' with {step: 3} only %}

    <h1 class="lp-workspace-title">{{ 'project.wizard.widget.heading'|trans }}</h1>
    <p class="lp-workspace-desc">{{ 'project.wizard.widget.lead'|trans }}</p>

    <div class="flex flex-col gap-5">
        <section class="lp-connect-step">
            <div class="lp-connect-step__header">
                <span class="lp-connect-step__badge">1</span>
                <div>
                    <h2 class="lp-connect-step__heading">{{ 'project.wizard.widget.step.embed.heading'|trans }}</h2>
                    <p class="lp-connect-step__purpose">
                        {%- if wizardProject.domain -%}
                            {{ 'project.connect.step.widget.purpose'|trans({'%domain%': wizardProject.domain}) }}
                        {%- else -%}
                            {{ 'project.connect.step.widget.purpose_no_domain'|trans }}
                        {%- endif -%}
                    </p>
                </div>
            </div>

            {%- set widgetSnippet = '<script src="' ~ absolute_url('/site-review/widget.js') ~ '" data-project="' ~ wizardProject.id ~ '"></script>' -%}
            <div class="lp-connect-block">
                <p class="lp-eyebrow">{{ 'project.connect.widget.eyebrow'|trans }}</p>
                <twig:Ds:CodeBlock
                    :label="'project.token.snippet_heading'|trans"
                    :text="widgetSnippet"
                    :copyLabel="'project.connect.copy'|trans"
                    :copiedLabel="'project.connect.copied'|trans"
                    testid="wizard-widget-snippet" />
            </div>
        </section>
    </div>

    <twig:Ds:FormActions>
        <twig:Ds:ActionForm :action="path('app_welcome_skip')" token="wizard-skip">
            <twig:Ds:Button variant="ghost" type="submit">{{ 'project.wizard.skip'|trans }}</twig:Ds:Button>
        </twig:Ds:ActionForm>
        <twig:Ds:Button variant="primary" href="{{ path('app_welcome_done') }}">{{ 'project.wizard.connect.continue'|trans }}</twig:Ds:Button>
    </twig:Ds:FormActions>
</twig:Ds:Workspace>
{% endblock %}
