{% extends 'base.html.twig' %}

{% block title %}{{ 'project.wizard.welcome.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block body %}
<twig:Ds:Workspace width="narrow">
    <twig:Ds:Stepper class="lp-wizard-stepper" :steps="['project.wizard.progress.step_1'|trans, 'project.wizard.progress.step_2'|trans, 'project.wizard.progress.step_3'|trans]" :current="1" :aria-label="'project.wizard.progress.label'|trans" />

    <h1 class="lp-workspace-title">{{ 'project.wizard.welcome.heading'|trans }}</h1>
    <p class="lp-workspace-desc">{{ 'project.wizard.welcome.lead'|trans }}</p>

    {{ form_start(form, {'attr': {'class': 'lp-form'}}) }}
        <twig:Ds:FormField>
            {{ form_label(form.name, null, {label_attr: {class: ds_label_class()}}) }}
            {{ form_widget(form.name, {attr: {class: ds_input_class()}}) }}
            <twig:Ds:FieldErrors :fieldView="form.name" />
        </twig:Ds:FormField>
        <twig:Ds:FormField>
            {{ form_label(form.description, null, {label_attr: {class: ds_label_class()}}) }}
            {{ form_widget(form.description, {attr: {class: ds_input_class('textarea')}}) }}
            <twig:Ds:FieldErrors :fieldView="form.description" />
        </twig:Ds:FormField>
        <twig:Ds:FormField>
            {{ form_label(form.domain, null, {label_attr: {class: ds_label_class()}}) }}
            {{ form_widget(form.domain, {attr: {class: ds_input_class()}}) }}
            <twig:Ds:FieldErrors :fieldView="form.domain" />
        </twig:Ds:FormField>
        <twig:Ds:FormActions>
            {# Submits the skip form below via `form=`: the action row sits inside
               the project form, and a nested <form> is invalid HTML. #}
            <twig:Ds:Button variant="ghost" type="submit" form="wizard-skip-form">{{ 'project.wizard.skip'|trans }}</twig:Ds:Button>
            <twig:Ds:Button variant="primary" type="submit">{{ 'project.wizard.welcome.submit'|trans }}</twig:Ds:Button>
        </twig:Ds:FormActions>
    {{ form_end(form) }}

    <form id="wizard-skip-form" method="POST" action="{{ path('app_welcome_skip') }}" hidden>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('wizard-skip') }}">
    </form>
</twig:Ds:Workspace>
{% endblock %}
