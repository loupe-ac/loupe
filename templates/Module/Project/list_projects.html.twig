{% extends 'base.html.twig' %}

{% block title %}{{ 'project.list.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'project.list.eyebrow'|trans},
        {label: 'project.list.page.title'|trans},
    ]" />
{% endblock %}

{% block body %}
{% set reopenDialog = (form.vars.submitted and not form.vars.valid) or app.request.query.has('new') %}
<twig:Ds:Workspace class="lp-redesign-secondary lp-redesign-projects" data-controller="modal" :data-modal-reopen-value="reopenDialog ? 'true' : false">
    <twig:Ds:PageHeader :title="'project.list.page.title'|trans" :description="'project.list.page.description'|trans">
        <twig:block name="actions">
            <twig:Ds:Button variant="primary" type="button" data-action="click->modal#open">
                <twig:ux:icon name="lucide:plus" class="lp-icon lp-icon--md" />
                {{ 'project.list.new'|trans }}
            </twig:Ds:Button>
        </twig:block>
    </twig:Ds:PageHeader>

    <div class="lp-project-list lp-project-tile-grid">
        {% for item in items %}
        {% set project = item.project %}
        <twig:Ds:Panel as="article" class="lp-project-tile" data-project-id="{{ project.id }}">
            <a href="{{ path('app_project_workshop', {id: project.id}) }}"
               class="lp-project-row__link" aria-label="{{ project.name }}"></a>
            <twig:Ds:Avatar :name="project.name" shape="square" tone="ink" />
            <div class="lp-project-row__main">
                <div class="lp-project-row__head">
                    <span class="lp-project-row__name">{{ project.name }}</span>
                    {% if project.domain %}<span class="lp-project-row__domain">{{ project.domain }}</span>{% endif %}
                </div>
                {% if project.description is not null %}<p class="lp-project-row__description">{{ project.description }}</p>{% endif %}
                <div class="lp-project-row__meta">
                    <span>{{ 'project.list.meta.documents'|trans({'%count%': item.documentCount}) }}</span>
                    <span class="lp-project-row__sep">·</span>
                    <span>{{ 'project.list.meta.comments'|trans({'%count%': item.commentCount}) }}</span>
                    <span class="lp-project-row__sep">·</span>
                    <span class="lp-project-row__open">{{ 'project.list.meta.open'|trans({'%count%': item.openCount}) }}</span>
                    <span class="lp-project-row__sep">·</span>
                    <span class="lp-project-row__cards">{{ 'project.list.meta.cards'|trans({'%count%': item.openCardCount}) }}</span>
                    {% if is_feature_enabled('inbox.enabled') %}
                    <span class="lp-project-row__sep">·</span>
                    <span data-project-inbox-count>{{ 'inbox.project_list.open_items'|trans({'%count%': item.openInboxItemCount}) }}</span>
                    {% endif %}
                </div>
            </div>
            <a href="{{ path('app_project_edit', {id: project.id}) }}"
               class="lp-project-row__edit"
               aria-label="{{ 'project.list.edit'|trans({'%name%': project.name}) }}">
                <twig:ux:icon name="lucide:pencil" class="lp-icon lp-icon--md" />
            </a>
            <twig:ux:icon name="lucide:chevron-right" class="lp-project-tile__arrow" />
        </twig:Ds:Panel>
        {% endfor %}

        <button type="button" class="lp-project-new" data-action="click->modal#open">
            <span class="lp-project-new__plus"><twig:ux:icon name="lucide:plus" /></span>
            <span class="lp-project-new__label">{{ 'project.list.new'|trans }}</span>
        </button>
    </div>

    <twig:Ds:Pagination route="app_projects" :page="page" :totalPages="totalPages" :pageList="pageList" />

    <twig:Ds:Dialog aria-labelledby="new-project-title" data-action="cancel->modal#close">
        <h3 class="lp-dialog-title" id="new-project-title">{{ 'project.list.new'|trans }}</h3>
        {{ form_start(form, {'action': path('app_project_create', {page: page}), 'method': 'POST', 'attr': {'class': 'lp-form'}}) }}
            <twig:Ds:FormField>
                {{ form_label(form.name, null, {label_attr: {class: ds_label_class()}}) }}
                {{ form_widget(form.name, {attr: {class: ds_input_class()}}) }}
                <twig:Ds:FieldErrors :fieldView="form.name" />
            </twig:Ds:FormField>
            <twig:Ds:FormField>
                {{ form_label(form.description, null, {label_attr: {class: ds_label_class()}}) }}
                {{ form_widget(form.description, {attr: {class: ds_input_class('textarea')}}) }}
                <twig:Ds:FieldErrors :fieldView="form.description" />
            </twig:Ds:FormField>
            <twig:Ds:FormField>
                {{ form_label(form.domain, null, {label_attr: {class: ds_label_class()}}) }}
                {{ form_widget(form.domain, {attr: {class: ds_input_class()}}) }}
                <twig:Ds:FieldErrors :fieldView="form.domain" />
            </twig:Ds:FormField>
            <twig:Ds:FormField>
                {{ form_label(form.searchLanguage, null, {label_attr: {class: ds_label_class()}}) }}
                {{ form_widget(form.searchLanguage, {attr: {class: ds_input_class('select')}}) }}
                <twig:Ds:FieldErrors :fieldView="form.searchLanguage" />
                <twig:Ds:Hint>{{ 'project.form.create_project_form.search_language.hint'|trans }}</twig:Ds:Hint>
            </twig:Ds:FormField>
            <twig:Ds:FormActions>
                <twig:Ds:Button type="button" data-action="click->modal#close">{{ 'project.list.form.cancel'|trans }}</twig:Ds:Button>
                <twig:Ds:Button variant="primary" type="submit">{{ 'project.list.form.submit'|trans }}</twig:Ds:Button>
            </twig:Ds:FormActions>
        {{ form_end(form) }}
    </twig:Ds:Dialog>
</twig:Ds:Workspace>
{% endblock %}
