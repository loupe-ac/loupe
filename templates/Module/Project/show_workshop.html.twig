{% extends 'base.html.twig' %}

{% block title %}{{ 'project.workshop.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'project.workshop.page.title'|trans},
    ]" />
{% endblock %}

{% block body %}
<twig:Ds:Workspace class="lp-workshop" data-workshop data-controller="card-drawer">
    {% set readiness = is_granted(constant('App\\Module\\Project\\Security\\ProjectVoter::MANAGE'), workshop.project) ? workshop.readiness : null %}
    {% if readiness is not null and workshop.quiet %}
    {% do mercure_subscribe(worker_runs_topic(workshop.project)) %}
    {% do mercure_subscribe(board_topic(workshop.project)) %}
    {#- A run, a card change, an inbox item or a bridge report can change the guide, so the whole page reloads. -#}
    <div class="lp-readiness-guide" data-readiness-guide data-readiness-layout="full"
         data-controller="worker-run-refresh"
         data-worker-run-refresh-target="frame"
         data-worker-run-refresh-whole-value="true"
         data-worker-run-refresh-project-value="{{ workshop.project.id }}"
         data-worker-run-refresh-events-value="{{ ['worker_run.changed', 'board.card_changed', 'inbox.open_count_changed', 'bridge.readiness_changed']|json_encode }}">
        <twig:Ds:PageHeader variant="workshop" :title="'readiness.guide.heading'|trans({'%project%': workshop.project.name})" :description="'readiness.guide.count'|trans({'%done%': readiness.doneCount, '%total%': readiness.total})" />
        {% include '@Project/_readiness_checklist.html.twig' with {project: workshop.project, readiness: readiness, layout: 'full'} only %}
    </div>
    {% else %}
    <twig:Ds:PageHeader variant="workshop" :title="'project.workshop.page.heading'|trans" :description="'project.workshop.page.description'|trans({'%project%': workshop.project.name})" />

    <div class="lp-workshop-layout">
        <div class="lp-workshop-primary">
        <section class="lp-workshop-section">
            <twig:Ds:SectionHeading>{{ 'project.workshop.needs_you.title'|trans }}{% if is_feature_enabled('inbox.enabled') %} <span>{{ workshop.stats.openInboxItemCount }}</span>{% endif %}
                <twig:block name="actions">{% if is_feature_enabled('inbox.enabled') %}<a class="lp-workshop-text-link" href="{{ path('app_project_inbox', {id: workshop.project.id}) }}">{{ 'project.workshop.needs_you.action'|trans }} <twig:ux:icon name="lucide:chevron-right" /></a>{% endif %}</twig:block>
            </twig:Ds:SectionHeading>
            {% if workshop.attention is not empty %}
            <div class="lp-workshop-attention-list">
                {% for item in workshop.attention %}
                <a class="lp-workshop-attention" href="{{ item.url }}" data-workshop-attention>
                    <span class="lp-workshop-attention__icon" data-subject="{{ item.subject }}">{% include '_attention_subject_icon.html.twig' with {subject: item.subject} only %}</span>
                    <span><strong>{{ item.title|reference_plain }}</strong>{% if item.cardNumber is not null %}<small data-workshop-attention-card>#{{ item.cardNumber }}</small>{% endif %}</span>
                    <span class="lp-workshop-attention__meta">
                        <span class="lp-workshop-attention__badge">{{ ('inbox.item.kind.' ~ item.kind)|trans }}{% if item.blocking %} · {{ 'inbox.item.blocking'|trans }}{% endif %}</span>
                        <twig:Ds:RelativeTime :datetime="item.createdAt" />
                    </span>
                    <twig:ux:icon name="lucide:chevron-right" class="lp-workshop-attention__chevron" />
                </a>
                {% endfor %}
            </div>
            {% else %}
            <twig:Ds:EmptyState compact icon="lucide:inbox" :body="is_feature_enabled('inbox.enabled') ? 'project.workshop.needs_you.clear'|trans : 'project.workshop.needs_you.disabled'|trans" />
            {% endif %}
        </section>

        <section class="lp-workshop-section">
            <twig:Ds:SectionHeading>{{ 'project.workshop.in_motion.title'|trans }}
                <twig:block name="actions"><a class="lp-workshop-text-link" href="{{ path('app_project_board', {id: workshop.project.id}) }}">{{ 'project.workshop.in_motion.action'|trans }} <twig:ux:icon name="lucide:chevron-right" /></a></twig:block>
            </twig:Ds:SectionHeading>
            {% do mercure_subscribe(board_topic(workshop.project)) %}
            <div class="lp-live-frame"
                 data-controller="worker-run-refresh"
                 data-worker-run-refresh-url-value="{{ path('app_project_workshop_in_motion', {id: workshop.project.id}) }}"
                 data-worker-run-refresh-events-value="{{ ['worker_run.changed', 'board.card_changed', 'board.columns_changed']|json_encode }}">
                {% include '@Project/_workshop_in_motion.html.twig' with {project: workshop.project, inMotion: workshop.inMotion} only %}
            </div>
        </section>
        </div>

        <aside class="lp-workshop-supporting">
            {% if readiness is not null %}
            {% include '@Project/_readiness_checklist.html.twig' with {project: workshop.project, readiness: readiness, layout: 'sidebar'} only %}
            {% endif %}
            <section class="lp-workshop-crew">
                <twig:Ds:SectionHeading>{{ 'bridge.agents.heading'|trans }}
                    <twig:block name="actions"><a class="lp-workshop-icon-link" href="{{ path('app_project_agents', {id: workshop.project.id}) }}" aria-label="{{ 'nav.link.agents'|trans }}"><twig:ux:icon name="lucide:chevron-right" /></a></twig:block>
                </twig:Ds:SectionHeading>
                {% for connection in workshop.connections %}
                <a class="lp-workshop-crew__row" href="{{ connection.url }}" data-workshop-connection="{{ connection.id }}">
                    <twig:Ds:Avatar icon="lucide:bot" size="xs" />
                    <span><strong><span title="{{ connection.id }}" data-bridge-label>{{ connection.label }}</span></strong><small>{{ connection.cliVersion|short_sha }}</small>
                    {%- if connection.quiet %}<small data-workshop-connection-hint>{{ (connection.loginExpired ? 'bridge.agents.hint.login_expired' : 'bridge.agents.hint.stale')|trans({'%name%': connection.label}) }}</small>{% endif -%}
                    </span>
                    <span class="lp-workshop-crew__status">{{ (connection.loginExpired ? 'bridge.agents.status.login_expired' : (connection.quiet ? 'bridge.agents.status.stale' : 'bridge.agents.status.healthy'))|trans }}</span>
                </a>
                {% else %}
                <a class="lp-workshop-crew__row" href="{{ path('app_project_connect', {id: workshop.project.id}) }}" data-workshop-crew-empty>
                    <twig:Ds:Avatar icon="lucide:bot" size="xs" />
                    <span><strong>{{ 'project.workshop.connection.title'|trans }}</strong><small>{{ 'project.workshop.connection.eyebrow'|trans }}</small></span>
                    <span class="lp-workshop-crew__status">{{ 'project.workshop.connection.action'|trans }}</span>
                </a>
                {% endfor %}
            </section>
        </aside>
    </div>
    {% endif %}
    {% include '@Board/_card_drawer.html.twig' with {project: workshop.project} only %}
</twig:Ds:Workspace>
{% endblock %}
