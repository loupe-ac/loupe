{# The answer to a live read of page one: each shown row in place, each new row where the page puts it, each gone row removed, and the paging. The new-project tile ends the grid, so the last new row goes before it. Props: changes (RowChanges), totalPages (int), pageList (list). #}
{% for item in changes.kept %}
<turbo-stream action="replace" method="morph" target="project-row-{{ item.project.id }}">
    <template>{% include '@Project/_project_row.html.twig' with {item: item} only %}</template>
</turbo-stream>
{% endfor %}
{% for id in changes.goneIds %}
<turbo-stream action="remove" target="project-row-{{ id }}"></turbo-stream>
{% endfor %}
{% for insert in changes.inserts %}
<turbo-stream action="before" target="{{ insert.beforeId is null ? 'projects-new-tile' : 'project-row-' ~ insert.beforeId }}">
    <template>{% include '@Project/_project_row.html.twig' with {item: insert.item} only %}</template>
</turbo-stream>
{% endfor %}
<turbo-stream action="update" target="projects-pagination">
    <template>{% include '@Project/_projects_pagination.html.twig' with {page: 1, totalPages: totalPages, pageList: pageList} only %}</template>
</turbo-stream>
