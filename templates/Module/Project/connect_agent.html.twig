{% extends '@Project/_settings_layout.html.twig' %}

{% block title %}{{ 'project.connect.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'nav.link.project_settings'|trans},
    ]" />
{% endblock %}

{% block settings_section 'connections' %}

{% block settings_content %}
<div class="lp-connect-settings">
    <twig:Ds:Panel as="section" id="agent-connection">
        <twig:Ds:SectionHeading>{{ 'project.connect.card.agent.title'|trans }}</twig:Ds:SectionHeading>
        <p class="lp-connect-hint">{{ 'project.connect.step.agent.purpose'|trans }}</p>

        <div data-controller="modal">
            <twig:Ds:Button variant="primary" type="button" data-action="click->modal#open">
                <twig:ux:icon name="lucide:link" />{{ 'project.connect.configure'|trans }}
            </twig:Ds:Button>
            <twig:Ds:Dialog size="document" class="lp-connect-dialog" aria-labelledby="connect-agent-title">
                <header class="lp-connect-dialog__header">
                    <div>
                        <h2 class="lp-dialog-title" id="connect-agent-title">{{ 'project.connect.step.agent.heading'|trans }}</h2>
                        <p class="lp-dialog-desc">{{ 'project.connect.step.agent.purpose'|trans }}</p>
                    </div>
                    <twig:Ds:Button variant="icon" type="button" data-action="modal#close" aria-label="{{ 'project.connect.dialog.close'|trans }}"><twig:ux:icon name="lucide:x" /></twig:Ds:Button>
                </header>
                {% include '@Project/_connect_instructions.html.twig' with {mcpServerName: mcpServerName, projectId: project.id} only %}
                <details class="lp-tools-disclosure">
                    <summary class="lp-tools-disclosure__summary">
                        <twig:ux:icon name="lucide:chevron-right" class="lp-tools-disclosure__caret" />
                        {{ 'project.connect.tools.summary'|trans({'%count%': tools|length}) }}
                    </summary>
                    <div class="lp-tools">
                        {% for tool in tools %}
                        <div class="lp-tools__row">
                            <code class="lp-tools__name">{{ tool.name }}</code>
                            <p class="lp-tools__desc">{{ tool.descriptionKey|trans }}</p>
                        </div>
                        {% endfor %}
                    </div>
                </details>
                <twig:Ds:FormActions>
                    <twig:Ds:Button type="button" data-action="click->modal#close">{{ 'project.connect.dialog.close'|trans }}</twig:Ds:Button>
                </twig:Ds:FormActions>
            </twig:Ds:Dialog>
        </div>
    </twig:Ds:Panel>

    <twig:Ds:Panel as="section" id="site-review-widget">
        <twig:Ds:SectionHeading>{{ 'project.connect.card.widget.title'|trans }}</twig:Ds:SectionHeading>
        <p class="lp-connect-hint">
            {%- if project.domain -%}
                {{ 'project.connect.step.widget.purpose'|trans({'%domain%': project.domain}) }}
            {%- else -%}
                {{ 'project.connect.step.widget.purpose_no_domain'|trans }}
            {%- endif -%}
        </p>

        <div class="lp-connect-toggle">
            <twig:ux:icon name="lucide:zap" class="lp-icon lp-icon--md lp-connect-toggle__icon" />
            <span class="lp-connect-toggle__text">
                <span class="lp-connect-toggle__title">{{ 'project.connect.forwarding.label'|trans }}</span>
                <span class="lp-connect-toggle__state">
                    {{ (project.forwardsToAgent
                        ? 'project.connect.forwarding.state.on'
                        : 'project.connect.forwarding.state.off')|trans }}
                </span>
            </span>
            <twig:Ds:ActionForm :action="path('app_project_widget_forwarding_toggle', {id: project.id})" token="toggle-project-widget-forwarding">
                <twig:Ds:Button size="sm" type="submit">
                    {{ (project.forwardsToAgent
                        ? 'project.connect.forwarding.disable'
                        : 'project.connect.forwarding.enable')|trans }}
                </twig:Ds:Button>
            </twig:Ds:ActionForm>
        </div>
        <p class="lp-connect-note"><twig:ux:icon name="lucide:shield" />{{ 'project.connect.forwarding.warning'|trans }}</p>

        {%- set oauthSnippet = '<script src="' ~ absolute_url('/site-review/widget.js') ~ '" data-project="' ~ project.id ~ '"></script>' -%}
        <div class="lp-connect-block" id="widget-sign-in">
            <p class="lp-eyebrow">{{ 'project.connect.widget_oauth.eyebrow'|trans }}</p>
            <p class="lp-connect-hint">{{ 'project.connect.widget_oauth.purpose'|trans }}</p>
            <twig:Ds:CodeBlock
                :label="'project.token.snippet_heading'|trans"
                :text="oauthSnippet"
                :copyLabel="'project.connect.copy'|trans"
                :copiedLabel="'project.connect.copied'|trans"
                testid="widget-oauth-snippet" />
            {{ form_start(allowedOriginsForm, {'attr': {'class': 'lp-form', 'data-testid': 'allowed-origins-form'}}) }}
                <twig:Ds:FormField>
                    {{ form_label(allowedOriginsForm.origins, null, {'label_attr': {'class': ds_label_class()}}) }}
                    {{ form_widget(allowedOriginsForm.origins, {'attr': {'class': ds_input_class('textarea')}}) }}
                    {% if allowedOriginsForm.origins.vars.help is not empty %}
                        <twig:Ds:Hint id="{{ allowedOriginsForm.origins.vars.id }}_help">{{ allowedOriginsForm.origins.vars.translation_domain is same as(false) ? allowedOriginsForm.origins.vars.help : allowedOriginsForm.origins.vars.help|trans(allowedOriginsForm.origins.vars.help_translation_parameters, allowedOriginsForm.origins.vars.translation_domain) }}</twig:Ds:Hint>
                    {% endif %}
                    <twig:Ds:FieldErrors :fieldView="allowedOriginsForm.origins" />
                </twig:Ds:FormField>
                <twig:Ds:FormActions>
                    <twig:Ds:Button variant="primary" type="submit">{{ 'project.allowed_origins.save'|trans }}</twig:Ds:Button>
                </twig:Ds:FormActions>
            {{ form_end(allowedOriginsForm) }}
        </div>
    </twig:Ds:Panel>

    <twig:GitHubRepositories :project="project" />
</div>
{% endblock %}
