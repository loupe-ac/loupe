<turbo-frame id="push-device-warning" data-live-pill-target="frame">
    {% for device in devices %}
        <twig:Ds:Flash severity="warning" data-device-id="{{ device.id }}">
            {{ 'notification.warning.message'|trans({'%device%': device.label, '%date%': device.stoppedAt|date('j M Y')}) }}
            <twig:block name="actions">
                <twig:Ds:Button variant="primary" size="sm" :href="path('app_account_notifications')" data-turbo-frame="_top">{{ 'notification.warning.settings_link'|trans }}</twig:Ds:Button>
                <form method="post" action="{{ path('app_account_notifications_device_dismiss_warning', {id: device.id}) }}" data-turbo-frame="_top">
                    <input type="hidden" name="token" value="{{ csrf_token('submit') }}" data-controller="csrf-protection">
                    {% if returnPath %}<input type="hidden" name="return" value="{{ returnPath }}">{% endif %}
                    <twig:Ds:Button variant="on-card" size="sm" type="submit">{{ 'notification.warning.dismiss'|trans }}</twig:Ds:Button>
                </form>
            </twig:block>
        </twig:Ds:Flash>
    {% endfor %}
</turbo-frame>
