{% extends '@Account/_settings_layout.html.twig' %}

{% block settings_section 'notifications' %}

{% block settings_content %}
{% set previewState = previewState|default(null) %}
<twig:Ds:Panel as="section" id="notification-preferences" data-testid="notification-preferences">
    <twig:Ds:SectionHeading :description="'notification.preferences.description'|trans">{{ 'notification.preferences.heading'|trans }}</twig:Ds:SectionHeading>

    {% if not view.available %}
    <twig:Ds:Flash severity="info" data-testid="push-unavailable">
        {% if isAdmin and view.unavailableReason %}
            {{ 'notification.push.unavailable.admin'|trans }} {{ view.unavailableReason.detailKey|trans }}
            <a href="{{ app_docs_url }}/operating/" target="_blank" rel="noopener noreferrer" data-testid="push-docs-link">{{ 'notification.push.unavailable.docs_link'|trans }}</a>
        {% else %}
            {{ 'notification.push.unavailable.user'|trans }}
        {% endif %}
    </twig:Ds:Flash>
    {% endif %}

    {{ form_start(preferencesForm, {attr: {'data-controller': 'submit-on-change', 'data-action': 'change->submit-on-change#submit'}}) }}
        <table class="lp-pref-grid" aria-label="{{ 'notification.preferences.table_label'|trans }}">
            <thead>
                <tr>
                    <th scope="col">{{ 'notification.preferences.event_column'|trans }}</th>
                    {% for channel in preferences.channels %}
                    <th scope="col" class="lp-pref-grid__channel">{{ channel.labelKey|trans }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for event in preferences.events %}
                <tr data-testid="notification-preference-row" data-event="{{ event.value }}">
                    <th scope="row">
                        <span class="lp-pref-grid__event">{{ event.labelKey|trans }}</span>
                        <span class="lp-pref-grid__description">{{ event.descriptionKey|trans }}</span>
                    </th>
                    {% for cell in preferences.cells|filter(cell => cell.event == event) %}
                    {% set field = preferencesForm.choices[cell.fieldName] %}
                    <td class="lp-pref-grid__cell">
                        <span class="lp-pref-grid__cell-label" aria-hidden="true">{{ cell.channel.labelKey|trans }}</span>
                        <twig:Ds:Switch
                            :id="field.vars.id"
                            :name="field.vars.full_name"
                            :checked="field.vars.checked"
                            :disabled="field.vars.disabled"
                            :aria-label="'notification.preferences.cell_label'|trans({'%channel%': cell.channel.labelKey|trans, '%event%': event.labelKey|trans})" />
                        {{ form_widget(preferencesForm.shown[cell.fieldName]) }}
                    </td>
                    {% endfor %}
                </tr>
                {% endfor %}
            </tbody>
        </table>
        <noscript>{{ form_widget(preferencesForm.save, {attr: {class: ds_button_class('primary')}}) }}</noscript>
        {{ form_widget(preferencesForm._token) }}
    {{ form_end(preferencesForm, {render_rest: false}) }}
</twig:Ds:Panel>

<twig:Ds:Panel as="section" class="lp-connect-block" data-testid="push-devices-section">
    <twig:Ds:SectionHeading :description="'notification.devices.description'|trans">{{ 'notification.devices.heading'|trans }}</twig:Ds:SectionHeading>

    {% set currentDevice = view.devices|filter(device => device.id.toRfc4122 == view.currentDeviceId)|first %}
    {% do mercure_subscribe(notifications_topic(app.user)) %}

    <div class="lp-connect-block"
        {% if vapidPublicKey %}
         data-controller="push-device"
         data-action="turbo:frame-load->push-device#frameLoaded"
         data-push-device-public-key-value="{{ vapidPublicKey }}"
         data-push-device-create-url-value="{{ path('app_account_notifications_device_create') }}"
         data-push-device-service-worker-url-value="/sw.js"
         data-push-device-device-known-value="{{ currentDevice ? 'true' : 'false' }}"
         data-push-device-device-stopped-value="{{ currentDevice and currentDevice.stoppedAt ? 'true' : 'false' }}"
         data-push-device-denied-message-value="{{ 'notification.push.error.denied'|trans }}"
         data-push-device-failed-message-value="{{ 'notification.push.error.failed'|trans }}"
         data-push-device-throttled-message-value="{{ 'notification.push.error.throttled'|trans }}"
         {% if previewState %}data-push-device-preview-state-value="{{ previewState }}"{% endif %}
        {% endif %}>
    <div class="lp-device-live"
         data-controller="live-pill"
         data-action="turbo:frame-missing->live-pill#keepPill"
         data-live-pill-events-value="{{ ['notifications.devices_changed']|json_encode }}"
         data-live-pill-url-value="{{ path('app_account_notifications_device_list') }}">
        {% include '@Notification/_push_device_list.html.twig' with {view: view, pushControls: vapidPublicKey is not empty, previewState: previewState, thisBrowserLabel: thisBrowserLabel} only %}
    </div>

    {% if vapidPublicKey %}
    <div class="lp-connect-block">
        <form data-push-device-target="form" hidden>
            <input type="hidden" name="token" value="{{ csrf_token('submit') }}" data-controller="csrf-protection">
        </form>

        <div class="lp-settings-panel" data-push-device-target="panel" data-panel="off" hidden>
            <div>
                <twig:Ds:Button variant="primary" type="button" data-push-device-target="button" data-action="push-device#turnOn">{{ 'notification.push.turn_on'|trans }}</twig:Ds:Button>
            </div>
            <p class="lp-connect-hint">{{ 'notification.push.turn_on_hint'|trans }}</p>
        </div>

        <p class="lp-connect-hint" data-push-device-target="panel" data-panel="on" hidden>{{ 'notification.push.on'|trans }}</p>

        <p class="lp-connect-hint" data-push-device-target="panel" data-panel="not-supported" hidden>{{ 'notification.push.not_supported'|trans }}</p>

        <div class="lp-settings-panel" data-push-device-target="panel" data-panel="ios-tab" {{ previewState == 'ios-tab' ? 'data-preview-shown="ios-tab"' : 'hidden' }}>
            <p class="lp-connect-hint">{{ 'notification.push.ios_tab.lead'|trans }}</p>
            <ol class="lp-device-steps">
                {% for step in 1..5 %}<li>{{ ('notification.push.ios_tab.step_' ~ step)|trans }}</li>{% endfor %}
            </ol>
            <p class="lp-connect-hint">{{ 'notification.push.ios_tab.requirement'|trans }}</p>
        </div>

        <p class="lp-device-error" role="alert" data-push-device-target="error" hidden></p>
    </div>
    {% endif %}
    </div>

    <p class="lp-connect-hint">{{ 'notification.devices.hint'|trans }}</p>
</twig:Ds:Panel>
{% endblock %}
