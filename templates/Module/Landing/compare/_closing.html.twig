{% set button = button|default('compare') %}
<section>
    <h2>{{ 'landing.compare.try_title'|trans }}</h2>
    <p>{{ 'landing.compare.try_body'|trans }}</p>
    <div class="not-prose lp-legal__actions">
        <twig:Ds:Button variant="primary" href="{{ site_url(path('app_waitlist_join')) }}" data-action="click->analytics#track click->modal#open" data-analytics-name-param="waitlist-click" data-analytics-button-param="{{ button }}">{{ 'landing.cta.join'|trans }}</twig:Ds:Button>
        <twig:Ds:Button href="{{ app_docs_url }}/operating/install/docker-compose/" data-action="click->analytics#track" data-analytics-name-param="self-host-click" data-analytics-button-param="{{ button }}">{{ 'landing.compare.self_host'|trans }}</twig:Ds:Button>
    </div>
</section>
