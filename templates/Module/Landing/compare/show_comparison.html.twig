{% extends 'marketing_base.html.twig' %}

{% block title %}{{ page.title }} — {{ 'app.name'|trans }}{% endblock %}

{% block description %}{{ page.description }}{% endblock %}

{% block body %}
<article class="lp-legal">
    <h1 class="lp-legal__title">{{ page.title }}</h1>
    <p class="lp-legal__updated">{{ 'landing.compare.compared_on'|trans({'%date%': page.comparedOn|date('F j, Y'), '%competitor%': page.competitor, '%version%': page.competitorVersion}) }}</p>
    <div class="prose lp-prose lp-legal__body lp-compare">
        {{ page.html|raw }}
        <section>
            <h2>{{ 'landing.compare.try_title'|trans }}</h2>
            <p>{{ 'landing.compare.try_body'|trans }}</p>
            {% include '@Landing/compare/_closing.html.twig' only %}
        </section>
        {% if others is not empty %}
            <section>
                <h2>{{ 'landing.compare.others_title'|trans }}</h2>
                <ul>
                    {% for other in others %}
                        <li><a href="{{ path('app_compare', {slug: other.slug}) }}">{{ other.title }}</a></li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    </div>
</article>
{% endblock %}
