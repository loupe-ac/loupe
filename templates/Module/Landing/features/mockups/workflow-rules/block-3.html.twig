<div class="lp-shot" aria-hidden="true">
    <div class="lp-shot__canvas lp-shot__canvas--panel">
        <div class="lp-card-overview lp-shot__section">
            <section class="lp-card-overview__section">
                <twig:Ds:SectionHeading>{{ 'workflow.panel.title'|trans }}</twig:Ds:SectionHeading>
                <div class="lp-workflow-panel__pause">
                    <p class="lp-workflow-panel__pause-title">{{ ux_icon('lucide:circle-pause', {class: 'lp-card-held__icon', 'aria-hidden': 'true'}) }}{{ 'workflow.panel.paused'|trans({'%kind%': 'workflow.panel.pause_kind.work_limit'|trans}) }} {{ '2 hours ago' }}</p>
                    <p class="lp-workflow-panel__line">{{ 'workflow.panel.pause_kind.work_limit'|trans|capitalize }}.</p>
                    <p class="lp-workflow-panel__line">{{ 'workflow.panel.release.needs_person'|trans }}</p>
                    <span class="{{ ds_button_class('outline sm') }}">{{ ux_icon('lucide:circle-play', {class: 'lp-icon lp-icon--md', 'aria-hidden': 'true'}) }}{{ 'workflow.panel.retry'|trans }}</span>
                </div>
                <dl class="lp-card-fields">
                    <div class="lp-card-field"><dt>{{ 'workflow.panel.slot.label'|trans }}</dt><dd>{{ 'workflow.slot.implementation'|trans }}</dd></div>
                    <div class="lp-card-field lp-card-field--prose"><dt>{{ 'workflow.panel.next_action'|trans }}</dt><dd>{{ 'workflow.panel.action.request'|trans({'%kind%': 'fix'}) }}</dd></div>
                </dl>
            </section>
        </div>
    </div>
</div>
