{% import '@Landing/features/mockups/_parts.html.twig' as shot %}
<div class="lp-shot" aria-hidden="true">
    <div class="lp-shot__canvas lp-shot__canvas--wide">
        <div class="lp-shot__app">
            {{ shot.sidebar('workflow') }}
            <div class="lp-shot__main">
                <div class="lp-shot__top">
                    <h3 class="lp-shot__title">{{ 'landing.shot.workflow'|trans }}</h3>
                    <span class="lp-shot__crumb">{{ 'landing.shot.driftwood'|trans }}</span>
                    <span class="lp-shot__spacer">{{ shot.pill('landing.shot.lifecycle_template'|trans) }}</span>
                </div>
                <div class="lp-shot__body">
                    <div class="lp-shot__row">
                        {% for stage in ['landing.shot.product_design'|trans, 'landing.shot.tech_design'|trans, 'landing.shot.implementation'|trans, 'landing.shot.in_review'|trans, 'landing.shot.done'|trans] %}
                            {{ shot.pill(stage, 'outline') }}
                            {% if not loop.last %}{{ shot.icon('lucide:arrow-right') }}{% endif %}
                        {% endfor %}
                    </div>
                    <div class="lp-shot__table">
                        <div class="lp-shot__table-row lp-shot__table-row--head"><span>{{ 'landing.shot.rule'|trans }}</span><span>{{ 'landing.shot.applies_in'|trans }}</span><span>{{ 'landing.shot.action'|trans }}</span></div>
                        <div class="lp-shot__table-row"><span class="lp-shot__strong lp-shot__mono">{{ 'design-approved' }}</span><span>{{ 'landing.shot.product_design'|trans }}</span><span>{{ 'landing.shot.move_to_tech_design'|trans }}</span></div>
                        <div class="lp-shot__table-row"><span class="lp-shot__strong lp-shot__mono">{{ 'tech-design-approved' }}</span><span>{{ 'landing.shot.tech_design'|trans }}</span><span>{{ 'landing.shot.move_to_implementation'|trans }}</span></div>
                        <div class="lp-shot__table-row"><span class="lp-shot__strong lp-shot__mono">{{ 'pull-request-ready' }}</span><span>{{ 'landing.shot.implementation'|trans }}</span><span>{{ 'landing.shot.move_to_in_review_ask_for'|trans }}</span></div>
                        <div class="lp-shot__table-row"><span class="lp-shot__strong lp-shot__mono">{{ 'review-passed' }}</span><span>{{ 'landing.shot.in_review'|trans }}</span><span>{{ 'landing.shot.merge_then_move_to_done'|trans }}</span></div>
                        <div class="lp-shot__table-row"><span class="lp-shot__strong lp-shot__mono">{{ 'work-failed' }}</span><span>{{ 'landing.shot.any_column'|trans }}</span><span>{{ 'landing.shot.run_again_then_send_the_repair'|trans }}</span></div>
                    </div>
                    <div class="lp-shot__row">
                        <span class="lp-shot__label">{{ 'landing.shot.agents_run_on'|trans }}</span>
                        {{ shot.pill("Maya's laptop", 'ok') }}
                        {{ shot.pill('landing.shot.build_server'|trans, 'ok') }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
