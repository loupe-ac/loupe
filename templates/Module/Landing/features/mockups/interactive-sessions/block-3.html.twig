{% import '@Landing/features/mockups/_parts.html.twig' as shot %}
<div class="lp-shot" aria-hidden="true">
    <div class="lp-shot__canvas lp-shot__canvas--panel">
        <div class="lp-shot__column">
            <div class="lp-shot__column-head"><span class="lp-shot__dot lp-shot__dot--active"></span>{{ 'landing.shot.implementation'|trans }}<span class="lp-shot__column-count">{{ '1' }}</span></div>
            <div class="lp-shot__card">
                <div class="lp-shot__row">
                    <span class="lp-shot__mono lp-shot__dim">{{ '#38' }}</span>
                    {{ shot.pill('landing.shot.feature'|trans, 'outline') }}
                    <span class="lp-shot__spacer">{{ shot.mark('working') }}</span>
                </div>
                <span class="lp-shot__card-title">{{ 'landing.shot.add_a_booking_calendar'|trans }}</span>
                <div class="lp-shot__row">
                    {{ shot.avatar('MC', 'ink') }}
                    <span class="lp-shot__dim">{{ 'landing.shot.maya_s_session_is_open'|trans }}</span>
                </div>
                <div class="lp-shot__card-meta"><span>{{ shot.icon('lucide:git-pull-request') }}{{ '1' }}</span></div>
            </div>
        </div>
        <p class="lp-shot__why">{{ 'landing.shot.while_the_session_is_open_the'|trans }}</p>
    </div>
</div>
