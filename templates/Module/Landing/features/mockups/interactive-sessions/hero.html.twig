<div class="lp-shot lp-shot--dark" aria-hidden="true">
    <div class="lp-shot__canvas lp-shot__canvas--wide">
        <div class="lp-shot__terminal-bar"><i></i><i></i><i></i><span>{{ 'claude · driftwood' }}</span></div>
        <div class="lp-shot__terminal-body">
            <div><span class="lp-shot__terminal-dim">{{ '>' }} </span>{{ '/loupe-lifecycle:product-design 42' }}</div>
            <div>
                <div class="lp-shot__terminal-call"><b>{{ 'loupe - card_get' }}</b> <span class="lp-shot__terminal-dim">{{ '(card: 42)' }}</span></div>
                <div class="lp-shot__terminal-result">{{ '#42 Show the nightly price on the cabin page' }}</div>
            </div>
            <div>
                <div class="lp-shot__terminal-call"><b>{{ 'loupe - card_run_open' }}</b> <span class="lp-shot__terminal-dim">{{ '(status: "product-design")' }}</span></div>
                <div class="lp-shot__terminal-result">{{ 'landing.shot.run_opened_card_42_shows_as'|trans }}</div>
            </div>
            <div class="lp-shot__terminal-reply">{{ 'landing.shot.i_read_the_card_and_the'|trans }}</div>
            <div class="lp-shot__terminal-option">{{ 'landing.shot.1_every_visitor_before_they_pick'|trans }}</div>
            <div class="lp-shot__terminal-option lp-shot__terminal-option--picked">{{ 'landing.shot.2_only_visitors_who_picked_dates'|trans }}</div>
            <div class="lp-shot__terminal-option">{{ 'landing.shot.3_signed_in_guests_only'|trans }}</div>
            <div class="lp-shot__terminal-input"><span class="lp-shot__terminal-dim">{{ '>' }} </span>{{ '2' }}</div>
            <div class="lp-shot__terminal-reply">{{ 'landing.shot.got_it_i_wrote_the_design'|trans }}</div>
        </div>
    </div>
</div>
