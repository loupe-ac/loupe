{% import '@Landing/features/mockups/_parts.html.twig' as shot %}
<div class="lp-shot" aria-hidden="true">
    <div class="lp-shot__canvas lp-shot__canvas--panel">
        <ol class="lp-shot__steps">
            <li class="lp-shot__step">
                <span class="lp-shot__step-mark lp-shot__step-mark--warn">{{ '1' }}</span>
                <span class="lp-shot__grow"><span class="lp-shot__strong">{{ 'landing.shot.review_round_1'|trans }}</span><br><span class="lp-shot__dim">{{ 'landing.shot.3_findings_on_pull_request_118'|trans }}</span></span>
            </li>
            <li class="lp-shot__step">
                <span class="lp-shot__step-mark lp-shot__step-mark--active">{{ shot.icon('lucide:wrench') }}</span>
                <span class="lp-shot__grow"><span class="lp-shot__strong">{{ 'landing.shot.fix_round_1'|trans }}</span><br><span class="lp-shot__dim">{{ 'landing.shot.the_agent_pushes_to_the_same'|trans }}</span></span>
                {{ shot.pill('landing.shot.pushed'|trans, 'ok') }}
            </li>
            <li class="lp-shot__step">
                <span class="lp-shot__step-mark lp-shot__step-mark--ok">{{ shot.icon('lucide:check') }}</span>
                <span class="lp-shot__grow"><span class="lp-shot__strong">{{ 'landing.shot.review_round_2'|trans }}</span><br><span class="lp-shot__dim">{{ 'landing.shot.no_findings'|trans }}</span></span>
                {{ shot.pill('landing.shot.passed'|trans, 'ok') }}
            </li>
            <li class="lp-shot__step">
                <span class="lp-shot__step-mark">{{ shot.icon('lucide:circle-user') }}</span>
                <span class="lp-shot__grow"><span class="lp-shot__strong">{{ 'landing.shot.card_comes_to_you'|trans }}</span><br><span class="lp-shot__dim">{{ 'landing.shot.ready_for_a_last_look'|trans }}</span></span>
            </li>
        </ol>
    </div>
</div>
