{% import '@Landing/features/mockups/_parts.html.twig' as shot %}
<div class="lp-shot" aria-hidden="true">
    <div class="lp-shot__canvas lp-shot__canvas--panel">
        <div class="lp-shot__panel">
            <div class="lp-shot__row"><span class="lp-shot__switch"></span><span class="lp-shot__strong">{{ 'landing.shot.human_review_off'|trans }}</span></div>
            <div class="lp-shot__row">{{ shot.icon('lucide:check') }}{{ 'landing.shot.agent_review_passed'|trans }}</div>
            <div class="lp-shot__row">{{ shot.icon('lucide:check') }}{{ 'landing.shot.checks_are_green'|trans }}</div>
            <hr class="lp-shot__rule">
            {{ shot.pill('landing.shot.ready_to_merge'|trans, 'ok') }}
        </div>
        <div class="lp-shot__panel">
            <div class="lp-shot__row"><span class="lp-shot__switch lp-shot__switch--on"></span><span class="lp-shot__strong">{{ 'landing.shot.human_review_on'|trans }}</span></div>
            <div class="lp-shot__row">{{ shot.icon('lucide:check') }}{{ 'landing.shot.agent_review_passed'|trans }}</div>
            <div class="lp-shot__row">{{ shot.icon('lucide:check') }}{{ 'landing.shot.checks_are_green'|trans }}</div>
            <hr class="lp-shot__rule">
            {{ shot.pill('landing.shot.waiting_for_maya_chen_to_approve'|trans, 'warn') }}
        </div>
    </div>
</div>
