{% import '@Landing/features/mockups/_parts.html.twig' as shot %}
<div class="lp-shot" aria-hidden="true">
    <div class="lp-shot__canvas lp-shot__canvas--panel">
        <div class="lp-shot__phone">
            <div class="lp-shot__cabin">
                <div class="lp-shot__cabin-photo"></div>
                <span class="lp-shot__strong">{{ 'landing.shot.pine_hollow_cabin'|trans }}</span>
                <span class="lp-shot__row">
                    <span class="lp-shot__picked"><span class="lp-shot__scribble"></span><span class="lp-shot__strong">{{ '$180' }}</span></span>
                </span>
            </div>
            <div class="lp-shot__panel">
                <span class="lp-shot__label">{{ 'landing.shot.ios_simulator'|trans }}</span>
                <span class="lp-shot__strong">{{ 'landing.shot.price_is_cut_off_on_small'|trans }}</span>
                <span class="lp-shot__dim">{{ 'landing.shot.marked_up_screenshot_and_the_element'|trans }}</span>
            </div>
        </div>
    </div>
</div>
