{% import '@Landing/features/mockups/inbox/_parts.html.twig' as inbox %}
<div class="lp-shot" aria-hidden="true" inert>
    <div class="lp-shot__canvas">
        <div class="lp-shot__page lp-shot__inbox-pane lp-needs-you lp-core-prototype-page lp-core-inbox">
            <section class="lp-inbox-ask">
                <div class="lp-inbox-ask__main">
                    {{ inbox.head('landing.shot.which_date_format_should_the_booking_export_use'|trans) }}
                    <div class="lp-inbox-ask__items">
                        <article class="lp-inbox-item">
                            <div class="lp-inbox-thread">
                                <ul class="lp-inbox-thread__messages">
                                    {{ inbox.message('inbox.thread.agent'|trans, 'inbox.thread.asked'|trans({'%time%': 'landing.shot.2m_ago'|trans}), 'landing.shot.both_formats_work_the_accounting_import_reads_iso_dates'|trans) }}
                                </ul>
                                <div class="lp-inbox-item__actions">
                                    <div class="lp-comment-composer lp-comment-composer--untargeted lp-inbox-thread__reply lp-inbox-answer">
                                        <fieldset class="lp-decision lp-decision--inbox" data-decision-type="single">
                                            <legend class="lp-decision__prompt">{{ 'inbox.answer.legend'|trans }}<span class="lp-decision__kind">{{ 'inbox.answer.pick_one'|trans }}</span></legend>
                                            <div class="lp-decision__options">
                                                <div class="lp-decision__option">
                                                    <input type="radio" tabindex="-1" id="shot-block-2-option-0" checked>
                                                    <label for="shot-block-2-option-0">{{ 'landing.shot.iso_dates_2026_11_24'|trans }}<span class="lp-decision__cost">{{ 'inbox.answer.cost'|trans({'%cost%': 'landing.shot.no_change_to_the_accounting_import'|trans}) }}</span></label>
                                                    <span class="lp-decision__badge" role="img" aria-label="{{ 'inbox.answer.recommended.high'|trans }}">
                                                        {% for star in 1..3 %}<span class="lp-decision__star lp-decision__star--filled"></span>{% endfor %}
                                                    </span>
                                                </div>
                                                <div class="lp-decision__option">
                                                    <input type="radio" tabindex="-1" id="shot-block-2-option-1">
                                                    <label for="shot-block-2-option-1">{{ 'landing.shot.local_dates_24_nov_2026'|trans }}<span class="lp-decision__cost">{{ 'inbox.answer.cost'|trans({'%cost%': 'landing.shot.the_accounting_import_needs_a_new_parser'|trans}) }}</span></label>
                                                </div>
                                            </div>
                                        </fieldset>
                                        <span class="lp-form-hint">{{ 'inbox.answer.deadline'|trans({'%time%': '25 Nov 2026 09:00', '%option%': 'landing.shot.iso_dates_2026_11_24'|trans}) }}</span>
                                        <div class="lp-comment-composer__actions">
                                            <span class="lp-form-hint inbox-split__hint"></span>
                                            <span class="{{ ds_button_class('ghost', 'sm') }}">{{ 'inbox.action.dismiss.label'|trans }}</span>
                                            {{ inbox.split('inbox.action.answer.label'|trans, '') }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>
