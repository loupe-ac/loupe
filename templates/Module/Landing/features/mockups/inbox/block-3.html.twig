<div class="lp-shot" aria-hidden="true">
    <div class="lp-shot__canvas lp-shot__canvas--panel">
        <div class="lp-shot__phone">
            <div class="lp-shot__notification">
                <img class="lp-shot__push-icon" src="/icons/push-192.png" alt="" width="192" height="192">
                <span class="lp-shot__grow">
                    <span class="lp-shot__row lp-shot__row--between"><span class="lp-shot__strong">{{ 'landing.shot.driftwood'|trans }}</span><span class="lp-shot__dim">{{ 'landing.shot.now'|trans }}</span></span>
                    <span class="lp-shot__text">{{ 'landing.shot.which_test_should_the_checkout_fix'|trans }}</span>
                </span>
            </div>
            <div class="lp-shot__notification">
                <img class="lp-shot__push-icon" src="/icons/push-192.png" alt="" width="192" height="192">
                <span class="lp-shot__grow">
                    <span class="lp-shot__row lp-shot__row--between"><span class="lp-shot__strong">{{ 'landing.shot.driftwood'|trans }}</span><span class="lp-shot__dim">{{ 'landing.shot.1h_ago'|trans }}</span></span>
                    <span class="lp-shot__text">{{ 'landing.shot.product_design_seasonal_rates'|trans }}</span>
                </span>
            </div>
        </div>
    </div>
</div>
