{% import '@Landing/features/mockups/document-review/_review.html.twig' as review %}
<div class="lp-shot" aria-hidden="true">
    <div class="lp-shot__canvas">
        <div class="lp-shot__sheet lp-review">
            <div class="lp-doc-meta-bar">
                <div class="lp-diff-bar">
                    <div class="lp-diff-bar__main">
                        <span class="{{ ds_button_class('ghost') }} lp-diff-bar__back">{{ ux_icon('lucide:chevron-left', {'aria-hidden': 'true'}) }}{{ 'review.document.navigation.document'|trans }}</span>
                        <div class="lp-version-compare">
                            <select class="{{ ds_input_class('select', false, true) }}" inert><option>{{ 'v1' }}</option></select>
                            {{ ux_icon('lucide:arrow-right', {class: 'lp-version-compare__arrow', 'aria-hidden': 'true'}) }}
                            <select class="{{ ds_input_class('select', false, true) }}" inert><option>{{ 'v2' }}</option></select>
                        </div>
                        <div class="lp-menu lp-menu--sm lp-diff-bar__views"><span class="{{ ds_button_class('ghost icon') }} lp-diff-bar__views-trigger">{{ ux_icon('lucide:settings-2', {'aria-hidden': 'true'}) }}</span></div>
                    </div>
                    <div class="lp-diff-nav">
                        <p class="lp-diff-nav__count">{{ 'review.document.diff.nav.count'|trans({'%count%': 3}) }}</p>
                        <span class="{{ ds_button_class('ghost icon') }}">{{ ux_icon('lucide:chevron-up', {class: 'lp-icon lp-icon--md', 'aria-hidden': 'true'}) }}</span>
                        <span class="{{ ds_button_class('ghost icon') }}">{{ ux_icon('lucide:chevron-down', {class: 'lp-icon lp-icon--md', 'aria-hidden': 'true'}) }}</span>
                    </div>
                </div>
            </div>
            <div class="prose lp-prose lp-review-doc__prose lp-diff-doc">
                <p><span>{{ 'landing.shot.peak_rates_apply_from'|trans }}</span> <del class="lp-diff__mark lp-diff__mark--deleted">{{ 'landing.shot.may_to_september'|trans }}</del> <ins class="lp-diff__mark lp-diff__mark--inserted">{{ 'landing.shot.june_to_august'|trans }}</ins><span>{{ 'landing.shot.owners_can_override_a_rate'|trans }}</span> <del class="lp-diff__mark lp-diff__mark--deleted">{{ 'landing.shot.for_a_single_night'|trans }}</del> <ins class="lp-diff__mark lp-diff__mark--inserted">{{ 'landing.shot.for_one_night_or_a_range'|trans }}</ins><span>{{ '.' }}</span></p>
                <p><span>{{ 'landing.shot.a_booking_that_is_already_paid'|trans }}</span> <del class="lp-diff__mark lp-diff__mark--deleted">{{ 'landing.shot.the_current_rate'|trans }}</del> <ins class="lp-diff__mark lp-diff__mark--inserted">{{ 'landing.shot.the_rate_it_was_sold_at'|trans }}</ins><span>{{ '.' }}</span></p>
            </div>
        </div>
    </div>
</div>
