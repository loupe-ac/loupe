{% import '@Landing/features/mockups/_parts.html.twig' as shot %}
<div class="lp-shot" aria-hidden="true">
    <div class="lp-shot__canvas lp-shot__canvas--panel">
        <div class="lp-shot__row">
            {{ shot.pill('v1', 'outline') }}
            {{ shot.icon('lucide:arrow-right') }}
            {{ shot.pill('v2', 'accent') }}
            <span class="lp-shot__spacer lp-shot__dim">{{ 'landing.shot.3_changes'|trans }}</span>
        </div>
        <div class="lp-shot__prose">
            <p>{{ 'landing.shot.peak_rates_apply_from'|trans }} <span class="lp-shot__del">{{ 'landing.shot.may_to_september'|trans }}</span> <span class="lp-shot__ins">{{ 'landing.shot.june_to_august'|trans }}</span>{{ 'landing.shot.owners_can_override_a_rate'|trans }} <span class="lp-shot__del">{{ 'landing.shot.for_a_single_night'|trans }}</span> <span class="lp-shot__ins">{{ 'landing.shot.for_one_night_or_a_range'|trans }}</span>{{ '.' }}</p>
            <p>{{ 'landing.shot.a_booking_that_is_already_paid'|trans }} <span class="lp-shot__del">{{ 'landing.shot.the_current_rate'|trans }}</span> <span class="lp-shot__ins">{{ 'landing.shot.the_rate_it_was_sold_at'|trans }}</span>{{ '.' }}</p>
        </div>
        <div class="lp-shot__row">
            <span class="lp-shot__button">{{ 'landing.shot.compare_other_versions'|trans }}</span>
            <span class="lp-shot__button lp-shot__button--primary lp-shot__spacer">{{ shot.icon('lucide:check') }}{{ 'landing.shot.approve_v2'|trans }}</span>
        </div>
    </div>
</div>
