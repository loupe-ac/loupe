{% import '@Landing/features/mockups/document-review/_review.html.twig' as review %}
<div class="lp-shot" aria-hidden="true">
    <div class="lp-shot__canvas">
        <div class="lp-shot__sheet lp-review">
            <div class="prose lp-prose lp-review-doc__prose">
                <p>{{ 'landing.shot.peak_rates_apply_from_june_to'|trans }} <span class="lp-shot__passage">{{ 'landing.shot.owners_can_override_a_rate_for'|trans }}</span>{{ 'landing.shot.and_the_booking_page_shows_the'|trans }}</p>
            </div>
            <div class="lp-anchor-toolbar lp-shot__anchor-toolbar">
                <span class="lp-anchor-toolbar__btn">{{ ux_icon('lucide:message-square-plus', {class: 'lp-icon lp-icon--sm', 'aria-hidden': 'true'}) }}{{ 'review.document.comment.add'|trans }}</span>
                <span class="lp-anchor-toolbar__btn">{{ ux_icon('lucide:replace', {class: 'lp-icon lp-icon--sm', 'aria-hidden': 'true'}) }}{{ 'review.document.suggestion.add'|trans }}</span>
                <span class="lp-anchor-toolbar__btn">{{ ux_icon('lucide:strikethrough', {class: 'lp-icon lp-icon--sm', 'aria-hidden': 'true'}) }}{{ 'review.document.strike.add'|trans }}<kbd class="lp-anchor-toolbar__key">{{ 'review.document.strike.shortcut'|trans }}</kbd></span>
                <span class="lp-anchor-toolbar__btn">{{ ux_icon('lucide:x', {class: 'lp-icon lp-icon--sm', 'aria-hidden': 'true'}) }}</span>
            </div>
            {{ review.comments_panel(2,
                review.comment_row('comment', 'landing.shot.owners_can_override_a_rate_for'|trans, 'landing.shot.can_an_override_apply_to_a'|trans)
                ~ review.comment_row('suggestion', 'landing.shot.for_a_single_night'|trans, 'landing.shot.for_one_night_or_a_range'|trans)) }}
        </div>
    </div>
</div>
