{% import '@Landing/features/mockups/_parts.html.twig' as shot %}
<div class="lp-shot" aria-hidden="true">
    <div class="lp-shot__canvas lp-shot__canvas--panel">
        <div class="lp-shot__row">
            <span class="lp-shot__toolbar">
                <span>{{ shot.icon('lucide:message-square') }}{{ 'landing.shot.comment'|trans }}</span>
                <span>{{ shot.icon('lucide:pencil') }}{{ 'landing.shot.suggest'|trans }}</span>
                <span>{{ shot.icon('lucide:strikethrough') }}{{ 'landing.shot.strike'|trans }}</span>
            </span>
        </div>
        <div class="lp-shot__prose">
            <p>{{ 'landing.shot.peak_rates_apply_from_june_to'|trans }} <span class="lp-shot__anchor">{{ 'landing.shot.owners_can_override_a_rate_for'|trans }}</span>{{ 'landing.shot.and_the_booking_page_shows_the'|trans }}</p>
        </div>
        <div class="lp-shot__comment">
            <div class="lp-shot__comment-head">{{ shot.avatar('MC', 'ink') }}{{ 'landing.shot.maya_chen'|trans }}{{ shot.pill('landing.shot.suggestion'|trans, 'accent') }}</div>
            <span><span class="lp-shot__del">{{ 'landing.shot.for_a_single_night'|trans }}</span> <span class="lp-shot__ins">{{ 'landing.shot.for_one_night_or_a_range'|trans }}</span></span>
        </div>
    </div>
</div>
