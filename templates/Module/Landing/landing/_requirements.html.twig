<section id="requirements" class="lp-home-section lp-home-section--raised">
    <div class="lp-home-container lp-home-requirements">
        <div class="lp-home-card lp-home-card--needs">
            <div class="lp-home-card__head">
                <h2 class="lp-home-card__title">{{ 'landing.requirements.need.title'|trans }}</h2>
                <p class="lp-home-card__lead">{{ 'landing.requirements.need.lead'|trans }}</p>
            </div>
            <ul class="lp-home-checklist">
                {% for item in ['agent', 'github', 'machine'] %}
                    <li class="lp-home-checklist__item">
                        <span class="lp-home-checklist__mark"><twig:UX:Icon name="lucide:check" class="w-3.5 h-3.5" aria-hidden="true" /></span>
                        <span class="lp-home-checklist__body">
                            <span class="lp-home-checklist__name">{{ ('landing.requirements.need.' ~ item ~ '.name')|trans }}</span>
                            <span class="lp-home-checklist__text">{{ ('landing.requirements.need.' ~ item ~ '.text')|trans }}</span>
                        </span>
                    </li>
                {% endfor %}
            </ul>
            <p class="lp-home-card__lead">{{ 'landing.requirements.need.usage_limit'|trans }}</p>
            {% set setupUrl = app_url('app_setup_instructions') %}
            <p class="lp-home-card__lead" data-agent-setup>{{ 'landing.requirements.need.agent_setup'|trans }} <a href="{{ setupUrl }}" class="lp-home-card__link">{{ setupUrl }}</a>.</p>
            <twig:Ds:Button variant="primary" href="{{ path('app_waitlist_join') }}" data-action="click->analytics#track click->modal#open" data-analytics-name-param="waitlist-click" data-analytics-button-param="requirements-ready" class="lp-home-card__action">{{ 'landing.requirements.need.action'|trans }}</twig:Ds:Button>
        </div>
        <div class="lp-home-card lp-home-card--extras">
            <div class="lp-home-card__head">
                <h2 class="lp-home-card__title">{{ 'landing.requirements.better.title'|trans }}</h2>
                <p class="lp-home-card__lead">{{ 'landing.requirements.better.lead'|trans }}</p>
            </div>
            <ul class="lp-home-checklist">
                {% for item in ['account', 'previews', 'worktree'] %}
                    <li class="lp-home-checklist__item">
                        <span class="lp-home-checklist__mark lp-home-checklist__mark--extra"><twig:UX:Icon name="lucide:plus" class="w-3.5 h-3.5" aria-hidden="true" /></span>
                        <span class="lp-home-checklist__body">
                            <span class="lp-home-checklist__name">{{ ('landing.requirements.better.' ~ item ~ '.name')|trans }}</span>
                            <span class="lp-home-checklist__text">{{ ('landing.requirements.better.' ~ item ~ '.text')|trans }}</span>
                        </span>
                    </li>
                {% endfor %}
            </ul>
            <twig:Ds:Button href="{{ path('app_waitlist_join') }}" data-action="click->analytics#track click->modal#open" data-analytics-name-param="waitlist-click" data-analytics-button-param="requirements-missing" class="lp-home-card__action">{{ 'landing.requirements.better.action'|trans }}</twig:Ds:Button>
        </div>
        {% include '@Landing/landing/_ask.html.twig' with {notifyForm: notifyForm, notifyJoined: notifyJoined|default(false)} only %}
    </div>
</section>
