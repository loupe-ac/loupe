{# The Loupe Explainer: one card, #42 on the Driftwood cabin site, through the six workflow steps. One scene per step, stepped by landing-explainer. #}
{% set scenes = ['product_design', 'tech_design', 'implementation', 'agent_review', 'site_review', 'done'] %}

{% macro copy(number, total, key, you) %}
    <div class="landing-explainer__copy">
        <span class="landing-explainer__step">
            {{- 'landing.explainer.step'|trans({'%number%': number, '%total%': total}) -}}
            {% if you %}<twig:Ds:Tag tone="amber">{{ 'landing.workflow.you'|trans }}</twig:Ds:Tag>{% endif %}
        </span>
        <p class="landing-explainer__title">{{ ('landing.explainer.scene.' ~ key ~ '.title')|trans }}</p>
        <p class="landing-explainer__text">{{ ('landing.explainer.scene.' ~ key ~ '.text')|trans }}</p>
    </div>
{% endmacro %}

<div class="landing-explainer" role="group" aria-label="{{ 'landing.hero.explainer_label'|trans }}"
     data-controller="landing-explainer"
     data-landing-explainer-play-label-value="{{ 'landing.explainer.play'|trans }}"
     data-landing-explainer-pause-label-value="{{ 'landing.explainer.pause'|trans }}"
     data-action="mouseenter->landing-explainer#hold mouseleave->landing-explainer#release focusin->landing-explainer#focusIn focusout->landing-explainer#focusOut">
    <ol class="landing-explainer__stage" aria-live="off">
        <li class="landing-explainer__scene" data-landing-explainer-target="scene" aria-hidden="false">
            {{ _self.copy(1, scenes|length, 'product_design', true) }}
            <div class="landing-explainer__visual">
                <div class="landing-explainer__window">
                    <div class="landing-explainer__bar"><i></i><i></i><i></i><span>{{ 'loupe.ac/' }}<b>{{ 'review' }}</b></span></div>
                    <div class="landing-explainer__body">
                        <p class="landing-explainer__heading">{{ 'landing.explainer.product.heading'|trans }}</p>
                        <p class="landing-explainer__line">{{ 'landing.explainer.product.requirement_before'|trans }} <mark class="landing-explainer__mark">{{ 'landing.explainer.product.requirement_marked'|trans }}</mark></p>
                        <p class="landing-explainer__note landing-explainer__reveal landing-explainer__reveal--second"><b>{{ 'landing.explainer.product.note_author'|trans }}</b> {{ 'landing.explainer.product.note'|trans }}</p>
                        <div class="landing-explainer__swap landing-explainer__reveal landing-explainer__reveal--third">
                            <div class="landing-explainer__before">
                                <twig:Ds:Tag tone="amber">{{ 'landing.explainer.product.requested'|trans }}</twig:Ds:Tag>
                            </div>
                            <div class="landing-explainer__after">
                                <twig:Ds:Tag tone="green">{{ 'landing.explainer.product.approved'|trans }}</twig:Ds:Tag>
                                <span class="landing-explainer__line">{{ 'landing.explainer.product.revised'|trans }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </li>

        <li class="landing-explainer__scene" data-landing-explainer-target="scene" aria-hidden="true">
            {{ _self.copy(2, scenes|length, 'tech_design', true) }}
            <div class="landing-explainer__visual">
                <div class="landing-explainer__window">
                    <div class="landing-explainer__bar"><i></i><i></i><i></i><span>{{ 'loupe.ac/' }}<b>{{ 'review' }}</b></span></div>
                    <div class="landing-explainer__body">
                        <p class="landing-explainer__heading">{{ 'landing.explainer.tech.heading'|trans }}</p>
                        <ul class="landing-explainer__list">
                            <li class="landing-explainer__reveal landing-explainer__reveal--first">{{ 'landing.explainer.tech.point_first'|trans }}</li>
                            <li class="landing-explainer__reveal landing-explainer__reveal--second">{{ 'landing.explainer.tech.point_second'|trans }}</li>
                            <li class="landing-explainer__reveal landing-explainer__reveal--third">{{ 'landing.explainer.tech.point_third'|trans }}</li>
                        </ul>
                        <div class="landing-explainer__swap">
                            <div class="landing-explainer__before">
                                <twig:Ds:Tag tone="neutral">{{ 'landing.explainer.tech.waiting'|trans }}</twig:Ds:Tag>
                            </div>
                            <div class="landing-explainer__after">
                                <twig:Ds:Tag tone="green">{{ 'landing.explainer.tech.approved'|trans }}</twig:Ds:Tag>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </li>

        <li class="landing-explainer__scene" data-landing-explainer-target="scene" aria-hidden="true">
            {{ _self.copy(3, scenes|length, 'implementation', false) }}
            <div class="landing-explainer__visual">
                <div class="landing-explainer__terminal">
                    <div class="landing-explainer__terminal-bar"><i></i><i></i><i></i><span>{{ 'driftwood · loupe bridge' }}{# translation-check-ignore #}</span></div>
                    <div class="landing-explainer__terminal-body">
                        <p class="landing-explainer__reveal landing-explainer__reveal--first">{{ '$ ' }}<b>{{ 'loupe bridge' }}</b>{# translation-check-ignore #}</p>
                        <p class="landing-explainer__reveal landing-explainer__reveal--first">{{ 'landing.explainer.build.started'|trans }}</p>
                        <p class="landing-explainer__reveal landing-explainer__reveal--second">{{ 'landing.explainer.build.edited'|trans }}</p>
                        <p class="landing-explainer__reveal landing-explainer__reveal--third">{{ 'landing.explainer.build.opened'|trans }}</p>
                        <p class="landing-explainer__terminal-result landing-explainer__reveal landing-explainer__reveal--fourth">{{ 'landing.explainer.build.moved'|trans }}</p>
                    </div>
                </div>
            </div>
        </li>

        <li class="landing-explainer__scene" data-landing-explainer-target="scene" aria-hidden="true">
            {{ _self.copy(4, scenes|length, 'agent_review', false) }}
            <div class="landing-explainer__visual">
                <div class="landing-explainer__window">
                    <div class="landing-explainer__bar"><i></i><i></i><i></i><span>{{ 'github.com/driftwood/web/' }}<b>{{ 'pull/641' }}</b></span></div>
                    <div class="landing-explainer__body">
                        <p class="landing-explainer__heading">{{ 'landing.explainer.review.heading'|trans }} <span class="landing-explainer__mono">{{ '#641' }}</span></p>
                        <div class="landing-explainer__swap landing-explainer__reveal landing-explainer__reveal--first">
                            <div class="landing-explainer__before">
                                <twig:Ds:Tag tone="amber">{{ 'landing.explainer.review.requested'|trans }}</twig:Ds:Tag>
                                <p class="landing-explainer__finding"><b>{{ 'landing.explainer.review.agent'|trans }}</b> {{ 'landing.explainer.review.finding'|trans }}</p>
                            </div>
                            <div class="landing-explainer__after">
                                <twig:Ds:Tag tone="green">{{ 'landing.explainer.review.passed'|trans }}</twig:Ds:Tag>
                                <p class="landing-explainer__finding"><b>{{ 'landing.explainer.review.worker'|trans }}</b> {{ 'landing.explainer.review.fix'|trans }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </li>

        <li class="landing-explainer__scene" data-landing-explainer-target="scene" aria-hidden="true">
            {{ _self.copy(5, scenes|length, 'site_review', true) }}
            <div class="landing-explainer__visual">
                <div class="landing-explainer__window">
                    <div class="landing-explainer__bar"><i></i><i></i><i></i><span>{{ 'pr-641.preview.driftwood.cabins/' }}<b>{{ 'search' }}</b></span></div>
                    <div class="landing-explainer__body landing-explainer__body--site">
                        <div class="landing-explainer__cabin">
                            <div class="landing-explainer__photo">
                                <span class="landing-explainer__label">{{ 'landing.explainer.site.label'|trans }}</span>
                                <span class="landing-explainer__badge">{{ 'landing.explainer.site.price'|trans }}</span>
                            </div>
                            <b>{{ 'landing.explainer.site.cabin'|trans }}</b>
                        </div>
                        <div class="landing-explainer__swap landing-explainer__reveal landing-explainer__reveal--second">
                            <div class="landing-explainer__before landing-explainer__widget">
                                <span class="landing-explainer__widget-label">{{ 'landing.explainer.site.selected'|trans }}</span>
                                <span class="landing-explainer__widget-text">{{ 'landing.explainer.site.note'|trans }}</span>
                                <span class="landing-explainer__widget-foot">{{ 'landing.explainer.site.saves'|trans }}</span>
                            </div>
                            <div class="landing-explainer__after landing-explainer__widget">
                                <twig:Ds:Tag tone="green">{{ 'landing.explainer.site.fixed'|trans }}</twig:Ds:Tag>
                                <span class="landing-explainer__widget-text">{{ 'landing.explainer.site.fix'|trans }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </li>

        <li class="landing-explainer__scene" data-landing-explainer-target="scene" aria-hidden="true">
            {{ _self.copy(6, scenes|length, 'done', false) }}
            <div class="landing-explainer__visual">
                <div class="landing-explainer__window">
                    <div class="landing-explainer__bar"><i></i><i></i><i></i><span>{{ 'github.com/driftwood/web/' }}<b>{{ 'pull/641' }}</b></span></div>
                    <div class="landing-explainer__body">
                        <p class="landing-explainer__heading">{{ 'landing.explainer.review.heading'|trans }} <span class="landing-explainer__mono">{{ '#641' }}</span></p>
                        <ul class="landing-explainer__checks">
                            <li class="landing-explainer__reveal landing-explainer__reveal--first"><twig:UX:Icon name="lucide:check" class="landing-explainer__tick" />{{ 'landing.explainer.done.checks'|trans }}</li>
                            <li class="landing-explainer__reveal landing-explainer__reveal--second"><twig:UX:Icon name="lucide:check" class="landing-explainer__tick" />{{ 'landing.explainer.done.agent_review'|trans }}</li>
                            <li class="landing-explainer__reveal landing-explainer__reveal--third"><twig:UX:Icon name="lucide:check" class="landing-explainer__tick" />{{ 'landing.explainer.done.site_review'|trans }}</li>
                        </ul>
                        <div class="landing-explainer__merged landing-explainer__reveal landing-explainer__reveal--fourth">
                            <twig:UX:Icon name="lucide:git-merge" class="landing-explainer__merge-icon" />
                            <span><b>{{ 'landing.explainer.done.merged'|trans }}</b> {{ 'landing.explainer.done.merged_note'|trans }}</span>
                        </div>
                        <div class="landing-explainer__card landing-explainer__reveal landing-explainer__reveal--fourth">
                            <span class="landing-explainer__mono">{{ '#42' }}</span>
                            <span class="landing-explainer__card-title">{{ 'landing.explainer.done.card'|trans }}</span>
                            <twig:Ds:Tag tone="green">{{ 'landing.explainer.done.column'|trans }}</twig:Ds:Tag>
                        </div>
                    </div>
                </div>
            </div>
        </li>
    </ol>

    <div class="landing-explainer__controls">
        <button type="button" class="landing-explainer__toggle" data-landing-explainer-target="toggle" data-action="landing-explainer#toggle" data-playing="true" aria-label="{{ 'landing.explainer.pause'|trans }}">
            <span data-landing-explainer-target="toggleLabel">{{ 'landing.explainer.pause'|trans }}</span>
        </button>
        <button type="button" class="landing-explainer__step-button" data-action="landing-explainer#previous" aria-label="{{ 'landing.explainer.previous'|trans }}">
            <twig:UX:Icon name="lucide:chevron-left" class="w-4 h-4" />
        </button>
        <nav class="landing-explainer__dots" aria-label="{{ 'landing.explainer.steps'|trans }}">
            {% for key in scenes %}
                <button type="button" class="landing-explainer__dot" data-landing-explainer-target="dot" data-action="landing-explainer#pick" data-landing-explainer-index-param="{{ loop.index0 }}" {% if loop.first %}aria-current="step"{% endif %}
                        aria-label="{{ 'landing.explainer.dot'|trans({'%number%': loop.index, '%title%': ('landing.explainer.scene.' ~ key ~ '.title')|trans}) }}"></button>
            {% endfor %}
        </nav>
        <button type="button" class="landing-explainer__step-button" data-action="landing-explainer#next" aria-label="{{ 'landing.explainer.next'|trans }}">
            <twig:UX:Icon name="lucide:chevron-right" class="w-4 h-4" />
        </button>
    </div>
</div>
