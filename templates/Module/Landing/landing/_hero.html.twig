<section id="top" class="lp-home-hero">
    <div class="lp-home-container lp-home-hero__copy">
        <h1 class="lp-home-hero__title">
            {{- 'landing.hero.title_before'|trans }}<span class="lp-home-hero__accent">{{ 'landing.hero.title_accent'|trans }}</span>{{ 'landing.hero.title_after'|trans -}}
        </h1>
        <p class="lp-home-hero__lead">
            <span class="lp-home-hero__line">{{ 'landing.hero.lead_first'|trans }}</span>
            <span class="lp-home-hero__line">{{ 'landing.hero.lead_second'|trans }}</span>
        </p>
        <twig:Ds:Button variant="primary" size="lg" href="{{ path('app_waitlist_join') }}" data-action="click->analytics#track click->modal#open" data-analytics-name-param="waitlist-click" data-analytics-button-param="hero" class="lp-home-hero__action">{{ 'landing.cta.join_beta'|trans }}</twig:Ds:Button>
    </div>

    <div class="lp-home-container lp-home-hero__stage">
        {% include '@Landing/landing/_explainer.html.twig' only %}
    </div>
</section>
