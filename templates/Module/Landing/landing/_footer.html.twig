<footer class="lp-home-footer">
    <div class="lp-home-container lp-home-footer__inner">
        <div class="lp-home-footer__columns">
            <div class="lp-home-footer__about">
                <a href="#top" class="lp-home-brand lp-home-brand--small">
                    <span class="lp-home-brand__mark" aria-hidden="true"></span>
                    {{ 'nav.brand'|trans }}
                </a>
                <p class="lp-home-footer__tagline">{{ 'landing.footer.tagline'|trans }}</p>
                <div class="lp-home-footer__social">
                    {% if app_source_url %}
                        <a href="{{ app_source_url }}" class="lp-home-footer__icon" target="_blank" rel="noopener noreferrer" aria-label="{{ 'landing.footer.source_label'|trans }}"><twig:UX:Icon name="simple-icons:github" class="w-4 h-4" aria-hidden="true" /></a>
                    {% endif %}
                    <a href="https://x.com/ubermuda" class="lp-home-footer__icon" target="_blank" rel="noopener noreferrer" aria-label="{{ 'footer.social.x'|trans }}"><twig:UX:Icon name="simple-icons:x" class="w-4 h-4" aria-hidden="true" /></a>
                    <a href="https://bsky.app/profile/ubermuda.xyz" class="lp-home-footer__icon" target="_blank" rel="noopener noreferrer" aria-label="{{ 'footer.social.bluesky'|trans }}"><twig:UX:Icon name="simple-icons:bluesky" class="w-4 h-4" aria-hidden="true" /></a>
                </div>
            </div>
            <nav class="lp-home-footer__column" aria-label="{{ 'landing.footer.product'|trans }}">
                <span class="lp-home-footer__heading">{{ 'landing.footer.product'|trans }}</span>
                <ul class="lp-home-footer__list">
                    <li><a href="#workflow" class="lp-home-footer__link">{{ 'landing.nav.workflow'|trans }}</a></li>
                    <li><a href="#features" class="lp-home-footer__link">{{ 'landing.nav.features'|trans }}</a></li>
                    <li><a href="#integrations" class="lp-home-footer__link">{{ 'landing.nav.works_with'|trans }}</a></li>
                    <li><a href="{{ path('app_waitlist_join') }}" class="lp-home-footer__link" data-action="click->modal#open">{{ 'landing.cta.join'|trans }}</a></li>
                </ul>
            </nav>
            <nav class="lp-home-footer__column" aria-label="{{ 'landing.footer.resources'|trans }}">
                <span class="lp-home-footer__heading">{{ 'landing.footer.resources'|trans }}</span>
                <ul class="lp-home-footer__list">
                    <li><a href="{{ app_docs_url }}/" class="lp-home-footer__link">{{ 'landing.footer.documentation'|trans }}</a></li>
                    <li><a href="{{ app_docs_url }}/getting-started/" class="lp-home-footer__link">{{ 'landing.footer.getting_started'|trans }}</a></li>
                    <li><a href="{{ app_docs_url }}/operating/install/docker-compose/" class="lp-home-footer__link">{{ 'landing.footer.self_hosting'|trans }}</a></li>
                    <li><a href="{{ app_docs_url }}/changelog/" class="lp-home-footer__link">{{ 'landing.footer.changelog'|trans }}</a></li>
                    {% if app_source_url %}
                        <li><a href="{{ app_source_url }}" class="lp-home-footer__link" target="_blank" rel="noopener noreferrer">{{ 'footer.source.label'|trans }}</a></li>
                    {% endif %}
                </ul>
            </nav>
            <nav class="lp-home-footer__column" aria-label="{{ 'landing.footer.legal'|trans }}">
                <span class="lp-home-footer__heading">{{ 'landing.footer.legal'|trans }}</span>
                <ul class="lp-home-footer__list">
                    <li><a href="{{ path('app_privacy') }}" class="lp-home-footer__link">{{ 'account.auth.footer.privacy'|trans }}</a></li>
                    <li><a href="{{ path('app_terms') }}" class="lp-home-footer__link">{{ 'account.auth.footer.terms'|trans }}</a></li>
                    <li><a href="{{ path('app_ai_policy') }}" class="lp-home-footer__link">{{ 'account.auth.footer.ai_policy'|trans }}</a></li>
                </ul>
            </nav>
        </div>
        <div class="lp-home-footer__base">
            <span>{{ 'account.auth.footer.copyright'|trans }}</span>
            <span>{{ 'landing.footer.license'|trans }}</span>
        </div>
    </div>
</footer>
