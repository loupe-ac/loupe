<footer class="lp-home-footer">
    <div class="lp-home-container lp-home-footer__inner">
        <div class="lp-home-footer__columns">
            <div class="lp-home-footer__about">
                <a href="{{ site_url('/') }}" data-turbo="false" class="lp-home-brand">
                    <twig:Ds:BrandMark size="sm" />
                </a>
                <p class="lp-home-footer__tagline">{{ 'landing.footer.tagline'|trans }}</p>
                <div class="lp-home-footer__social">
                    {% if site_source_url() %}
                        <a href="{{ site_source_url() }}" class="lp-home-footer__icon" target="_blank" rel="noopener noreferrer" aria-label="{{ 'landing.footer.source_label'|trans }}"><twig:UX:Icon name="simple-icons:github" class="w-4 h-4" aria-hidden="true" /></a>
                    {% endif %}
                    {% if site_x_url() %}
                        <a href="{{ site_x_url() }}" class="lp-home-footer__icon" target="_blank" rel="noopener noreferrer" aria-label="{{ 'landing.footer.x_label'|trans }}"><twig:UX:Icon name="simple-icons:x" class="w-4 h-4" aria-hidden="true" /></a>
                    {% endif %}
                    {% if site_discord_url() %}
                        <a href="{{ site_discord_url() }}" class="lp-home-footer__icon" target="_blank" rel="noopener noreferrer" aria-label="{{ 'landing.footer.discord_label'|trans }}"><twig:UX:Icon name="simple-icons:discord" class="w-4 h-4" aria-hidden="true" /></a>
                    {% endif %}
                </div>
            </div>
            <nav class="lp-home-footer__column" aria-label="{{ 'landing.footer.product'|trans }}">
                <span class="lp-home-footer__heading">{{ 'landing.footer.product'|trans }}</span>
                <ul class="lp-home-footer__list">
                    <li><a href="{{ site_url('/#workflow') }}" class="lp-home-footer__link">{{ 'landing.nav.workflow'|trans }}</a></li>
                    <li><a href="{{ site_url('/#features') }}" class="lp-home-footer__link">{{ 'landing.nav.features'|trans }}</a></li>
                    <li><a href="{{ site_url('/#integrations') }}" class="lp-home-footer__link">{{ 'landing.nav.works_with'|trans }}</a></li>
                    {% if has_comparisons() %}
                        <li><a href="{{ site_url('/compare') }}" class="lp-home-footer__link">{{ 'landing.compare.footer_link'|trans }}</a></li>
                    {% endif %}
                    {% if has_faq() %}
                        <li><a href="{{ site_url('/faq') }}" class="lp-home-footer__link">{{ 'landing.faq.footer_link'|trans }}</a></li>
                    {% endif %}
                    <li><a href="{{ site_url(path('app_waitlist_join')) }}" class="lp-home-footer__link" data-action="click->analytics#track click->modal#open" data-analytics-name-param="waitlist-click" data-analytics-button-param="footer">{{ 'landing.cta.join'|trans }}</a></li>
                </ul>
            </nav>
            <nav class="lp-home-footer__column" aria-label="{{ 'landing.footer.resources'|trans }}">
                <span class="lp-home-footer__heading">{{ 'landing.footer.resources'|trans }}</span>
                <ul class="lp-home-footer__list">
                    <li><a href="{{ app_docs_url }}/" class="lp-home-footer__link">{{ 'landing.footer.documentation'|trans }}</a></li>
                    <li><a href="{{ app_docs_url }}/getting-started/" class="lp-home-footer__link">{{ 'landing.footer.getting_started'|trans }}</a></li>
                    <li><a href="{{ app_docs_url }}/operating/install/docker-compose/" class="lp-home-footer__link">{{ 'landing.footer.self_hosting'|trans }}</a></li>
                    <li><a href="{{ app_docs_url }}/changelog/" class="lp-home-footer__link">{{ 'landing.footer.changelog'|trans }}</a></li>
                    {% if site_is_split() or has_blog() %}
                        <li><a href="{{ site_url('/blog') }}" class="lp-home-footer__link">{{ 'landing.footer.blog'|trans }}</a></li>
                    {% endif %}
                    {% if has_about() %}
                        <li><a href="{{ site_url('/about') }}" class="lp-home-footer__link">{{ 'landing.footer.about'|trans }}</a></li>
                    {% endif %}
                    {% if site_source_url() %}
                        <li><a href="{{ site_source_url() }}" class="lp-home-footer__link" target="_blank" rel="noopener noreferrer">{{ 'footer.source.label'|trans }}</a></li>
                    {% endif %}
                </ul>
            </nav>
            <nav class="lp-home-footer__column" aria-label="{{ 'landing.footer.legal'|trans }}">
                <span class="lp-home-footer__heading">{{ 'landing.footer.legal'|trans }}</span>
                <ul class="lp-home-footer__list">
                    {% include '_legal_links.html.twig' with {class: 'lp-home-footer__link', listItem: true} only %}
                </ul>
            </nav>
        </div>
        <div class="lp-home-footer__base">
            <span>{{ 'account.auth.footer.copyright'|trans }}</span>
            <span>{{ 'landing.footer.license'|trans }}</span>
        </div>
    </div>
</footer>
