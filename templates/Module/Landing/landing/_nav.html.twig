<header class="lp-home-nav">
    <a href="#top" data-turbo="false" class="lp-home-brand">
        <span class="lp-home-brand__mark" aria-hidden="true"></span>
        {{ 'nav.brand'|trans }}
    </a>
    <nav class="lp-home-nav__links" aria-label="{{ 'landing.nav.label'|trans }}">
        <a href="#workflow" data-turbo="false" class="lp-home-nav__link lp-home-nav__link--section">{{ 'landing.nav.workflow'|trans }}</a>
        <a href="#features" data-turbo="false" class="lp-home-nav__link lp-home-nav__link--section">{{ 'landing.nav.features'|trans }}</a>
        <a href="#integrations" data-turbo="false" class="lp-home-nav__link lp-home-nav__link--section">{{ 'landing.nav.works_with'|trans }}</a>
        <a href="#requirements" data-turbo="false" class="lp-home-nav__link lp-home-nav__link--section">{{ 'landing.nav.requirements'|trans }}</a>
        <a href="#opensource" data-turbo="false" class="lp-home-nav__link lp-home-nav__link--section">{{ 'landing.nav.open_source'|trans }}</a>
        <a href="{{ app_docs_url }}/" class="lp-home-nav__link lp-home-nav__link--section">{{ 'landing.nav.docs'|trans }}</a>
        <a href="{{ path('app_login') }}" class="lp-home-nav__link">{{ 'landing.nav.login'|trans }}</a>
        <twig:Ds:Button variant="primary" size="sm" href="{{ path('app_waitlist_join') }}" data-action="click->analytics#track click->modal#open" data-analytics-name-param="waitlist-click" data-analytics-button-param="nav">{{ 'landing.cta.join'|trans }}</twig:Ds:Button>
    </nav>
</header>
