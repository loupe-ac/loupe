{# The site bar: the brand, the section links, and the sign-in and waitlist links.
   Every link names a full address, so the bar also works inside the docs pages. #}
<header class="lp-home-nav">
    <a href="{{ site_url('/') }}" data-turbo="false" class="lp-home-brand">
        <twig:Ds:BrandMark />
    </a>
    <nav class="lp-home-nav__links" aria-label="{{ 'landing.nav.label'|trans }}">
        <a href="{{ app_docs_url }}/" class="lp-home-nav__link lp-home-nav__link--section">{{ 'landing.nav.docs'|trans }}</a>
        {% if site_is_split() or has_blog() %}
            <a href="{{ site_url('/blog') }}" class="lp-home-nav__link lp-home-nav__link--section">{{ 'landing.nav.blog'|trans }}</a>
        {% endif %}
        {% if app_source_url %}
            <a href="{{ app_source_url }}" class="lp-home-nav__link lp-home-nav__link--section">{{ 'landing.nav.github'|trans }}</a>
        {% endif %}
        <div class="lp-home-nav__actions">
            <a href="{{ app_url('app_login') }}" data-site-chrome="signed-out" class="lp-home-nav__link">{{ 'landing.nav.login'|trans }}</a>
            <twig:Ds:Button variant="primary" size="sm" href="{{ site_url(path('app_waitlist_join')) }}" data-site-chrome="signed-out" data-action="click->analytics#track click->modal#open" data-analytics-name-param="waitlist-click" data-analytics-button-param="nav">{{ 'landing.cta.join'|trans }}</twig:Ds:Button>
            <twig:Ds:Button variant="primary" size="sm" href="{{ app_url('app_home') }}" data-site-chrome="go-to-app" hidden>{{ 'landing.nav.go_to_app'|trans }}</twig:Ds:Button>
        </div>
    </nav>
</header>
