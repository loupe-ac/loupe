{% extends 'base.html.twig' %}

{% block title %}{{ 'landing.meta.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block meta_description %}<meta name="description" content="{{ 'landing.meta.description'|trans }}">{% endblock %}

{% block body_unauthenticated %}
<div class="lp-home">
    {% include '@Landing/landing/_nav.html.twig' only %}

    <main id="main-content" tabindex="-1">
        {% include '@Landing/landing/_hero.html.twig' only %}
        {% include '@Landing/landing/_workflow.html.twig' only %}
        {% include '@Landing/landing/_features.html.twig' only %}
        {% include '@Landing/landing/_works_with.html.twig' only %}
        {% include '@Landing/landing/_requirements.html.twig' with {notifyForm: notifyForm} only %}
        {% include '@Landing/landing/_open_source.html.twig' only %}
        {% include '@Landing/landing/_closing.html.twig' only %}
    </main>

    {% include '@Landing/landing/_footer.html.twig' only %}
</div>
{% endblock %}
