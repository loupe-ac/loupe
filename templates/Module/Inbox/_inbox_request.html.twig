{# One row of the list: the icon of the ask beside its title, then a meta line with the card number, the age, the mark of a blocking ask and how a closed one ended.
   Params: row (InboxRow), inbox (InboxPageView). #}
{% set card = row.firstCard %}
<a class="lp-inbox-request"
   href="{{ path('app_project_inbox', {id: inbox.project.id}|merge(row.pickedIn(inbox.view).toQuery)) }}"
   data-turbo-frame="inbox-view"
   data-inbox-request="{{ row.key }}"
   {%- if inbox.selected and inbox.selected.key == row.key %} aria-current="true"{% endif %}>
    <span class="lp-inbox-request__icon" data-inbox-kind="{{ row.kind.value }}">{% include '@Inbox/_inbox_kind_icon.html.twig' with {kind: row.kind.value} only %}</span>
    <span class="lp-inbox-request__title">{{ row.title }}</span>
    <span class="lp-inbox-request__meta">
        {%- if card -%}
            <span data-inbox-card title="{{ card.title }}">#{{ card.number }}{% if row.moreCards > 0 %} {{ 'inbox.row.more_cards'|trans({'%count%': row.moreCards}) }}{% endif %}</span>
        {%- else -%}
            <span data-inbox-source="{{ row.origin.value }}">{{ ('inbox.row.source.' ~ row.origin.value)|trans }}</span>
        {%- endif -%}
        <span aria-hidden="true">·</span>
        <time datetime="{{ row.createdAt|date('c') }}">{{ row.createdAt|inbox_age }}</time>
        {%- if row.outcome -%}
            <span aria-hidden="true">·</span>
            <span data-inbox-outcome="{{ row.outcome }}">{{ ('inbox.row.outcome.' ~ row.outcome)|trans }}</span>
        {%- elseif row.isClosed -%}
            <span aria-hidden="true">·</span>
            <span data-inbox-outcome="closed">{{ 'inbox.row.closed'|trans }}</span>
        {%- endif -%}
        {%- if row.blocking -%}
            <span aria-hidden="true">·</span>
            <span class="lp-inbox-request__blocking" data-inbox-blocking>{{ 'inbox.item.blocking'|trans }}</span>
        {%- endif -%}
    </span>
</a>
