{# One row of the list: the icon of the ask beside its title, then a meta line with the card number, the age, the mark of a blocking ask and how a closed one ended.
   The title of an agent's review ask is followed by a line that names its document or pull request.
   Params: row (InboxRow), inbox (InboxPageView). #}
{% set card = row.firstCard %}
<twig:Ds:ListRow
    :title="row.shortTitle|reference_plain"
    :subtitle="inbox_review_target(row.items)"
    :current="inbox.selected and inbox.selected.key == row.key"
    href="{{ path('app_project_inbox', {id: inbox.project.id}|merge(row.pickedIn(inbox.view).toQuery)) }}"
    data-turbo-frame="inbox-view"
    data-inbox-request="{{ row.key }}"
    icon:data-inbox-kind="{{ row.kind.value }}">
    <twig:block name="icon">{% include '@Inbox/_inbox_kind_icon.html.twig' with {kind: row.kind.value} only %}</twig:block>
    <twig:block name="meta">
        {%- if card -%}
            <span data-inbox-card title="{{ card.title|reference_plain }}">#{{ card.number }}{% if row.moreCards > 0 %} {{ 'inbox.row.more_cards'|trans({'%count%': row.moreCards}) }}{% endif %}</span>
        {%- else -%}
            <span data-inbox-source="{{ row.origin.value }}">{{ ('inbox.row.source.' ~ row.origin.value)|trans }}</span>
        {%- endif -%}
        <span aria-hidden="true">·</span>
        <time datetime="{{ row.createdAt|date('c') }}">{{ row.createdAt|inbox_age }}</time>
        {%- if row.outcome -%}
            <span aria-hidden="true">·</span>
            <span data-inbox-outcome="{{ row.outcome.key }}">{{ row.outcome.key|trans(row.outcome.parameters) }}</span>
        {%- elseif row.isClosed -%}
            <span aria-hidden="true">·</span>
            <span data-inbox-outcome="closed">{{ 'inbox.row.closed'|trans }}</span>
        {%- endif -%}
        {%- if row.blocking -%}
            <span aria-hidden="true">·</span>
            <span class="lp-list-row__flag" data-inbox-blocking>{{ 'inbox.item.blocking'|trans }}</span>
        {%- endif -%}
    </twig:block>
</twig:Ds:ListRow>
