{#- One row of the split button menu. A link goes to its address, a disabled row says why, and any other row posts the reply form to its action.
   Params: row (ThreadAction; a run-command row opens its dialog), actionParams, cardDrawer, drawerTitle (the ask title the card drawer shows while it loads). -#}
{% set kind = row.action.kind.value %}
{% set command = row.action.runCommand %}
{% set off = row.action.disabledReasonKey and not (command and (command.canOpenDialog or command.canAddEntry)) %}
{% set label %}
    {% include '@Inbox/_inbox_action_icon.html.twig' with {kind: kind} only %}
    <span class="lp-menu__text">
        <span class="lp-menu__label{{ kind == 'dismiss' ? ' inbox-split__danger' }}">{{ command ? (command.canAddEntry ? 'inbox.action.add-entry.label'|trans : 'inbox.action.run-command.run'|trans({'%entry%': command.entry, '%branch%': command.branch})) : row.action.labelKey|trans(row.action.labelParams) }}</span>
        <span class="lp-menu__line">{{ (off ? row.action.disabledReasonKey : (command and command.canAddEntry ? 'inbox.action.add-entry.effect' : row.action.effectKey))|trans }}</span>
    </span>
{% endset %}
{% if off %}
    <twig:Ds:MenuItem class="inbox-split__disabled" role="menuitem" aria-disabled="true" data-inbox-action="{{ kind }}">{{ label }}</twig:Ds:MenuItem>
{% elseif row.isLink %}
    {% if row.external %}
        <twig:Ds:MenuItem :href="row.href" role="menuitem" data-inbox-action="{{ kind }}" target="_blank" rel="noopener noreferrer">{{ label }}</twig:Ds:MenuItem>
    {% elseif row.card and cardDrawer %}
        <twig:Ds:MenuItem :href="row.href" role="menuitem" data-inbox-action="{{ kind }}" data-turbo-frame="card-drawer-frame" :data-drawer-title="drawerTitle" data-action="click->card-drawer#prepare">{{ label }}</twig:Ds:MenuItem>
    {% else %}
        <twig:Ds:MenuItem :href="row.href" role="menuitem" data-inbox-action="{{ kind }}" data-turbo-frame="_top">{{ label }}</twig:Ds:MenuItem>
    {% endif %}
{% elseif command %}
    <twig:Ds:MenuItem type="button" role="menuitem" data-action="click->split-button#close click->modal#open" data-inbox-action="{{ command.canAddEntry ? 'add-entry' : kind }}">{{ label }}</twig:Ds:MenuItem>
{% elseif kind == 'start-session' and row.action.sessionPrompt is not null %}
    {# The row shows the prompt field of the reply form first, so the owner reads the prompt before the session starts. #}
    <twig:Ds:MenuItem type="button" role="menuitem" data-action="click->split-button#close click->inbox-session-prompt#reveal" data-inbox-action="{{ kind }}">{{ label }}</twig:Ds:MenuItem>
{% else %}
    <twig:Ds:MenuItem type="submit" role="menuitem" :formaction="path('app_inbox_item_action', actionParams|merge({kind: kind}))" data-inbox-action="{{ kind }}">{{ label }}</twig:Ds:MenuItem>
{% endif %}
