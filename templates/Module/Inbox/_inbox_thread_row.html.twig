{#- One row of the split button menu. A link goes to its address, a disabled row says why, and any other row posts the reply form to its action.
   Params: row (ThreadAction), actionParams, declineFormId (the form Dismiss submits, or null), cardDrawer. -#}
{% set kind = row.action.kind.value %}
{% set label %}
    {% include '@Inbox/_inbox_action_icon.html.twig' with {kind: kind} only %}
    <span class="lp-menu__text">
        <span class="lp-menu__label{{ kind == 'dismiss' ? ' inbox-split__danger' }}">{{ row.action.labelKey|trans }}</span>
        <span class="lp-menu__line">{{ (row.action.disabledReasonKey ?? row.action.effectKey)|trans }}</span>
    </span>
{% endset %}
{% if row.action.disabledReasonKey %}
    <twig:Ds:MenuItem class="inbox-split__disabled" role="menuitem" aria-disabled="true" data-inbox-action="{{ kind }}">{{ label }}</twig:Ds:MenuItem>
{% elseif row.isLink %}
    {% if row.external %}
        <twig:Ds:MenuItem :href="row.href" role="menuitem" data-inbox-action="{{ kind }}" target="_blank" rel="noopener noreferrer">{{ label }}</twig:Ds:MenuItem>
    {% elseif row.card and cardDrawer %}
        <twig:Ds:MenuItem :href="row.href" role="menuitem" data-inbox-action="{{ kind }}" data-turbo-frame="card-drawer-frame" data-action="click->card-drawer#prepare">{{ label }}</twig:Ds:MenuItem>
    {% else %}
        <twig:Ds:MenuItem :href="row.href" role="menuitem" data-inbox-action="{{ kind }}" data-turbo-frame="_top">{{ label }}</twig:Ds:MenuItem>
    {% endif %}
{% elseif kind == 'dismiss' %}
    <twig:Ds:MenuItem type="submit" role="menuitem" form="{{ declineFormId }}" data-inbox-action="dismiss">{{ label }}</twig:Ds:MenuItem>
{% else %}
    <twig:Ds:MenuItem type="submit" role="menuitem" :formaction="path('app_inbox_item_action', actionParams|merge({kind: kind}))" data-inbox-action="{{ kind }}">{{ label }}</twig:Ds:MenuItem>
{% endif %}
