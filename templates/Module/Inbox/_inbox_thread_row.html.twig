{#- One row of the split button menu. A link goes to its address, a disabled row says why, and any other row posts the reply form to its action.
   Params: row (ThreadAction), actionParams, declineFormId (the form Dismiss submits, or null), cardDrawer. -#}
{% set kind = row.action.kind.value %}
{% set label %}
    {% include '@Inbox/_inbox_action_icon.html.twig' with {kind: kind} only %}
    <span class="lp-page-menu__text">
        <span class="lp-page-menu__label{{ kind == 'dismiss' ? ' inbox-split__danger' }}">{{ row.action.labelKey|trans }}</span>
        <span class="lp-page-menu__line">{{ (row.action.disabledReasonKey ?? row.action.effectKey)|trans }}</span>
    </span>
{% endset %}
{% if row.action.disabledReasonKey %}
    <div class="lp-page-menu__row inbox-split__disabled" role="menuitem" aria-disabled="true" data-inbox-action="{{ kind }}">{{ label }}</div>
{% elseif row.isLink %}
    <a class="lp-page-menu__row" role="menuitem" href="{{ row.href }}" data-inbox-action="{{ kind }}"
        {%- if row.external %} target="_blank" rel="noopener noreferrer"
        {%- else %} data-turbo-frame="{{ row.card and cardDrawer ? 'card-drawer-frame' : '_top' }}"{% if row.card and cardDrawer %} data-action="click->card-drawer#prepare"{% endif %}{% endif %}>{{ label }}</a>
{% elseif kind == 'dismiss' %}
    <button type="submit" class="lp-page-menu__row" role="menuitem" form="{{ declineFormId }}" data-inbox-action="dismiss">{{ label }}</button>
{% else %}
    <button type="submit" class="lp-page-menu__row" role="menuitem" formaction="{{ path('app_inbox_item_action', actionParams|merge({kind: kind})) }}" data-inbox-action="{{ kind }}">{{ label }}</button>
{% endif %}
