{#- The "⋯" menu of an ask: each card, document and pull request it links, once. Props: items (list of InboxItem), menuId (string). -#}
{% set cards = {} %}
{% set documents = {} %}
{% set pullRequests = {} %}
{% set reviewDocumentId = null %}
{% for item in items %}
    {% set review = item.kind.value == 'review' and not item.isAutomatic() ? inbox_review(item) : null %}
    {% if review and review.document %}
        {% set reviewDocumentId = review.document.id ~ '' %}
        {% set documents = documents|merge({(review.document.id ~ ''): {document: review.document, version: inbox_review_version(review)}}) %}
    {% endif %}
    {% if review and review.targetKind.value == 'pull-request' and review.pullRequest %}
        {% set pullRequests = pullRequests|merge({(review.pullRequest.url): review.pullRequest}) %}
    {% endif %}
    {% for link in item.documents %}
        {% if (link.document.id ~ '') not in documents|keys %}
            {% set documents = documents|merge({(link.document.id ~ ''): {document: link.document, version: null}}) %}
        {% endif %}
    {% endfor %}
    {% for link in item.cards %}
        {% if (link.card.id ~ '') not in cards|keys or item.number < cards[link.card.id ~ ''].item.number %}
            {% set cards = cards|merge({(link.card.id ~ ''): {card: link.card, item: item}}) %}
        {% endif %}
        {% for pullRequest in link.card.pullRequests %}
            {% if pullRequest.url not in pullRequests|keys %}
                {% set pullRequests = pullRequests|merge({(pullRequest.url): pullRequest}) %}
            {% endif %}
        {% endfor %}
    {% endfor %}
{% endfor %}
{% if cards|length > 0 or documents|length > 0 or pullRequests|length > 0 %}
<twig:Ds:Menu id="inbox-linked-menu-{{ menuId }}" size="md" data-inbox-linked-menu>
    <twig:block name="trigger">
        <twig:Ds:Button variant="ghost" size="sm" type="button" class="lp-page-menu__trigger"
                aria-label="{{ 'inbox.linked.menu_label'|trans }}"
                title="{{ 'inbox.linked.menu_label'|trans }}"
                aria-expanded="false"
                aria-controls="inbox-linked-menu-{{ menuId }}"
                data-popover-target="trigger"
                data-action="click->popover#toggle">
            <twig:ux:icon name="lucide:ellipsis" />
        </twig:Ds:Button>
    </twig:block>
    <twig:block name="content">
        {% for kind, entries in {card: cards, document: documents, pull_request: pullRequests}|filter(entries => entries|length > 0) %}
        <twig:Ds:MenuGroup data-linked-group="{{ kind }}"
                :heading="entries|length > 1 ? ('inbox.linked.menu_heading.' ~ kind)|trans({'%count%': entries|length}) : null"
                :moreLabel="entries|length > 3 ? 'inbox.linked.menu_show_more'|trans({'%count%': entries|length - 3}) : null">
            <twig:block name="content">
                {% for entry in entries|slice(0, 3) %}
                {% include '@Inbox/_ask_linked_row.html.twig' with {kind: kind, entry: entry, reviewDocumentId: reviewDocumentId} only %}
                {% endfor %}
            </twig:block>
            <twig:block name="more">
                {% for entry in entries|slice(3) %}
                {% include '@Inbox/_ask_linked_row.html.twig' with {kind: kind, entry: entry, reviewDocumentId: reviewDocumentId} only %}
                {% endfor %}
            </twig:block>
        </twig:Ds:MenuGroup>
        {% endfor %}
    </twig:block>
</twig:Ds:Menu>
{% endif %}
