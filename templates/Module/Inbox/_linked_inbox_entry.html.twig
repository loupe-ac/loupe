{% set ask = inbox.latestAsk(item) %}
<div class="lp-inbox-linked__entry" data-inbox-linked-entry>
    {% if ask and ask.context|trim is not empty %}
    <div class="lp-inbox-linked__context" data-inbox-linked-context>
        <span class="lp-inbox-linked__asked">{{ 'inbox.linked.asked'|trans({'%time%': ask.createdAt|relative_time}) }}</span>{# @design-system-ignore #}
        {# Agent Markdown, sanitized as on the inbox page, and cut to two lines here. #}
        {% apply link_references(ask.project) %}<div class="prose lp-prose lp-inbox-linked__context-text" data-references>{{ ask.context|inbox_markdown }}</div>{% endapply %}
    </div>
    {% endif %}
    {% include '@Inbox/_inbox_thread.html.twig' with {item: item, ask: null, inbox: inbox, refusedForm: refusedForm ?? null, hostCardId: hostCardId ?? null, showHead: true, cardDrawer: false} only %}
</div>
