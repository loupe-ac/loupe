{#- The agent's avatar with a presence dot, and a tooltip that names the bridge's
    state and the session. Loupe has no session, so it shows its avatar alone.
    Props: ask (InboxAsk or null), bridge (BridgeStatus or null), origin (InboxAskOrigin). -#}
{% if origin.value == 'loupe' %}
    <twig:Ds:Avatar icon="lucide:search" size="sm" tone="tint" aria-hidden="true" />
{% elseif ask is null %}
    <twig:Ds:Avatar icon="lucide:bot" size="sm" tone="tint" aria-hidden="true" />
{% else %}
    {% set state = ask.closedAt ? 'closed' : (bridge is null ? 'none' : (bridge.quiet ? 'quiet' : 'live')) %}
    <span class="lp-presence lp-presence--{{ state }}"
          tabindex="0"
          aria-label="{{ ('inbox.presence.label.' ~ state)|trans }}"
          aria-describedby="presence-{{ ask.id }}"
          data-inbox-presence="{{ state }}"
          {%- if bridge %} data-inbox-bridge="{{ bridge.lastSeenAt is null ? 'unheard' : (bridge.quiet ? 'quiet' : 'heard') }}"{% endif %}>
        <twig:Ds:Avatar icon="lucide:bot" size="sm" tone="tint" :presence="state == 'closed' ? null : state" aria-hidden="true" />
        <twig:Ds:Tooltip id="presence-{{ ask.id }}">
            {% if bridge %}
                <span class="lp-tooltip__line">
                    {% if bridge.lastSeenAt is null %}
                        {{ 'inbox.ask.bridge.unheard'|trans }}
                    {% else %}
                        <time datetime="{{ bridge.lastSeenAt|date('c') }}">{{ 'inbox.ask.bridge.last_heard'|trans({'%time%': bridge.lastSeenAt|relative_time(bridge.checkedAt)}) }}</time>{# @design-system-ignore #}
                    {% endif %}
                    {% if bridge.quiet %}{{ 'inbox.ask.bridge.quiet'|trans }}{% endif %}
                    {% if bridge.loginExpired %}<span data-inbox-login-expired>{{ 'inbox.ask.bridge.login_expired'|trans }}</span>{% endif %}
                </span>
            {% elseif state == 'none' %}
                <span class="lp-tooltip__line">{{ 'inbox.presence.no_bridge'|trans }}</span>
            {% endif %}
            {% if ask.sessionId %}<span class="lp-tooltip__line lp-tooltip__line--quiet">{{ 'inbox.ask.session'|trans({'%session%': ask.sessionId}) }}</span>{% endif %}
        </twig:Ds:Tooltip>
    </span>
{% endif %}
