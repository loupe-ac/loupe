{# The selected request: its title and byline, the message of its source, its items and the panel of what it links.
   The list row beside it carries Blocking, so an item head here leaves it out.
   Params: row (InboxRow), inbox (InboxPageView), refusedForm, cardDrawer (whether the page hosts the card drawer). #}
{% set ask = row.ask %}
{% set items = row.items %}
{% set origin = row.origin %}
<section class="lp-inbox-ask{{ ask and ask.closedAt ? ' lp-inbox-ask--closed' }}"
         id="{{ ask ? 'inbox-ask-' ~ ask.id : 'inbox-panel-' ~ items|first.id }}"
         {% if ask %}data-inbox-ask-id="{{ ask.id }}" data-inbox-ask-open="{{ ask.closedAt ? 'false' : 'true' }}"{% else %}data-inbox-item-number="{{ items|first.number }}"{% endif %}>
    <div class="lp-inbox-ask__main">
        <header class="lp-inbox-ask__summary">
            {# An ask stores no title. Its first item names it, as the request list does. #}
            <h2 class="lp-inbox-ask__title">{{ row.title }}</h2>
            <p class="lp-inbox-ask__byline">
                {# Who and when, then what it is, in the order of the document review byline. #}
                <span class="lp-inbox-ask__head">
                    {% include '@Inbox/_agent_presence.html.twig' with {ask: ask, bridge: ask ? inbox.bridgeStatus(ask) : null, origin: origin} only %}
                    <span class="lp-inbox-ask__source" data-inbox-source="{{ origin.value }}">{{ ('inbox.from.' ~ origin.value)|trans }}</span>
                </span>
                <span aria-hidden="true">·</span>
                <twig:Ds:RelativeTime :datetime="row.createdAt" />
                <span aria-hidden="true">·</span>
                <span class="lp-inbox-ask__kind">
                    {% include '@Inbox/_inbox_kind_icon.html.twig' with {kind: row.kind.value, class: 'lp-icon lp-icon--md'} only %}
                    {# A wait names the card that waits on the owner, as the document review byline does. #}
                    {% set waitCard = row.kind.value == 'wait' ? row.firstCard : null %}
                    {% if waitCard %}
                        <span class="lp-inbox-ask__wait" data-inbox-kind-label>
                            <a href="{{ path('app_board_card', {projectId: waitCard.project.id, cardId: waitCard.id}) }}" data-turbo-frame="card-drawer-frame" data-action="click->card-drawer#prepare" aria-describedby="inbox-wait-card-{{ waitCard.id }}" data-inbox-wait-card>#{{ waitCard.number }}</a>
                            <twig:Ds:Tooltip id="inbox-wait-card-{{ waitCard.id }}">
                                <span class="lp-tooltip__title">{{ 'inbox.wait.byline_tooltip'|trans({'%card%': waitCard.number}) }}</span>
                                <span class="lp-tooltip__line">{{ waitCard.title }}</span>
                            </twig:Ds:Tooltip>
                        </span>
                    {% else %}
                        <span data-inbox-kind-label>{{ ('inbox.item.kind.' ~ row.kind.value)|trans }}</span>
                    {% endif %}
                </span>
                {% if ask and ask.closedAt %}
                    <twig:Ds:StatusChip modifier="resolved">{{ 'inbox.ask.closed'|trans({'%time%': ask.closedAt|relative_time}) }}</twig:Ds:StatusChip>
                {% endif %}
            </p>
        </header>
        {% if ask and ask.context|trim is not empty %}
            <div class="lp-inbox-ask__message">
                {# Agent Markdown, rendered and sanitized the way a card body is. #}
                <div class="prose lp-prose lp-inbox-ask__context">{{ ask.context|inbox_markdown }}</div>
            </div>
        {% endif %}
        <div class="lp-inbox-ask__items">
            {% for item in items %}
                {% include '@Inbox/_inbox_item.html.twig' with {item: item, ask: ask, inbox: inbox, refusedForm: refusedForm, showHead: items|length > 1, showTitle: items|length > 1, showBlocking: false, position: loop.index, cardDrawer: cardDrawer ?? false} only %}
            {% endfor %}
        </div>
    </div>
    {% include '@Inbox/_ask_linked.html.twig' with {items: items} only %}
</section>
