{# The selected request: its title and byline, the message of its source, one thread per item. The byline holds the target of a review and the menu of what it links.
   Params: row (InboxRow), inbox (InboxPageView), refusedForm, cardDrawer (whether the page hosts the card drawer). #}
{% set ask = row.ask %}
{% set items = row.items %}
{% set origin = row.origin %}
<section class="lp-inbox-ask{{ ask and ask.closedAt ? ' lp-inbox-ask--closed' }}"
         id="{{ ask ? 'inbox-ask-' ~ ask.id : 'inbox-panel-' ~ items|first.id }}"
         {% if ask %}data-inbox-ask-id="{{ ask.id }}" data-inbox-ask-open="{{ ask.closedAt ? 'false' : 'true' }}"{% else %}data-inbox-item-number="{{ items|first.number }}"{% endif %}>
    <div class="lp-inbox-ask__main">
        <header class="lp-inbox-ask__summary">
            {# An ask stores no title. Its first item names it, as the request list does. #}
            <h2 class="lp-inbox-ask__title">{{ row.title|reference_plain }}</h2>
            <div class="lp-inbox-ask__byline">
                {# Who and when, then what it is, in the order of the document review byline. #}
                <span class="lp-inbox-ask__head">
                    {% include '@Inbox/_agent_presence.html.twig' with {ask: ask, bridge: ask ? inbox.bridgeStatus(ask) : null, origin: origin} only %}
                    <span class="lp-inbox-ask__source" data-inbox-source="{{ origin.value }}">{{ ('inbox.from.' ~ origin.value)|trans }}</span>
                </span>
                <span aria-hidden="true">·</span>
                <twig:Ds:RelativeTime :datetime="row.createdAt" />
                <span aria-hidden="true">·</span>
                <span class="lp-inbox-ask__kind">
                    {% include '@Inbox/_inbox_kind_icon.html.twig' with {kind: row.kind.value, class: 'lp-icon lp-icon--md'} only %}
                    {# A wait names the card that waits on the owner, as the document review byline does. #}
                    {% set isWait = row.leading.isAutomatic() %}
                    {% set waitCard = isWait ? row.firstCard : row.blockingCard %}
                    {% if isWait and waitCard %}
                        {% include '@Inbox/_ask_wait_card.html.twig' with {card: waitCard, kindLabel: true} only %}
                    {% else %}
                        <span data-inbox-kind-label>{{ ('inbox.item.kind.' ~ row.kind.value)|trans }}</span>
                    {% endif %}
                </span>
                {% if waitCard and not isWait %}
                    {# A blocking ask holds its card too, so the byline names the card that waits. #}
                    <span aria-hidden="true">·</span>
                    <span class="lp-inbox-ask__kind">
                        <twig:ux:icon name="lucide:hourglass" class="lp-icon lp-icon--md" aria-hidden="true" />
                        {% include '@Inbox/_ask_wait_card.html.twig' with {card: waitCard, kindLabel: false} only %}
                    </span>
                {% endif %}
                {% for review in inbox_review_targets(items) %}
                    <span aria-hidden="true">·</span>
                    <span class="lp-inbox-ask__kind" data-inbox-review-target>
                        {% if review.document %}
                            <twig:ux:icon name="lucide:file-text" class="lp-icon lp-icon--md" aria-hidden="true" />
                            <a href="{{ path('app_document_review', {projectId: review.document.project.id, documentId: review.document.id}) }}" data-turbo-frame="_top">{{ review.document.title|reference_plain }}</a>
                        {% elseif review.pullRequest and safe_pull_request_url(review.pullRequest.url) %}
                            <twig:ux:icon name="lucide:git-pull-request" class="lp-icon lp-icon--md" aria-hidden="true" />
                            <a href="{{ review.pullRequest.url }}" target="_blank" rel="noopener noreferrer">{{ review.pullRequest.number ? '#' ~ review.pullRequest.number : review.targetLabel }}</a>
                        {% else %}
                            <twig:ux:icon name="lucide:file-text" class="lp-icon lp-icon--md" aria-hidden="true" />
                            <span>{{ review.targetLabel }}</span>
                        {% endif %}
                    </span>
                {% endfor %}
                {% if ask and ask.closedAt %}
                    {% set outcomeTexts = [] %}
                    {% for outcome in items|map(item => inbox_outcome(item))|filter(outcome => outcome) %}
                        {% set text = outcome.key|trans(outcome.parameters) %}
                        {% set text = text|slice(0, 1)|lower ~ text|slice(1) %}
                        {% if text not in outcomeTexts %}{% set outcomeTexts = outcomeTexts|merge([text]) %}{% endif %}
                    {% endfor %}
                    {% set reason = outcomeTexts|join(', ') %}
                    <twig:Ds:StatusChip modifier="resolved" :reason="reason ? reason|slice(0, 1)|upper ~ reason|slice(1) : null" data-inbox-ask-closed>{{ 'inbox.ask.closed'|trans({'%time%': ask.closedAt|relative_time}) }}</twig:Ds:StatusChip>{# @design-system-ignore #}
                {% endif %}
                <div class="lp-inbox-ask__byline-actions">
                    {% include '@Inbox/_ask_linked.html.twig' with {items: items, menuId: ask ? ask.id : items|first.id} only %}
                </div>
            </div>
        </header>
        {% if ask and ask.context|trim is not empty %}
            <div class="lp-inbox-ask__message">
                {# Agent Markdown, rendered and sanitized the way a card body is. #}
                {% apply link_references(ask.project) %}<div class="prose lp-prose lp-inbox-ask__context" data-references>{{ ask.context|inbox_markdown }}</div>{% endapply %}
            </div>
        {% endif %}
        <div class="lp-inbox-ask__items">
            {% for item in items %}
                {% include '@Inbox/_inbox_thread.html.twig' with {item: item, ask: ask, inbox: inbox, refusedForm: refusedForm ?? null, showHead: items|length > 1, position: loop.index, cardDrawer: cardDrawer ?? false} only %}
            {% endfor %}
        </div>
    </div>
</section>
