{{ form_start(form, {action: path('app_inbox_item_action', actionParams|merge({kind: 'submit-review'})), attr: {id: form.vars.id, class: 'lp-form', 'data-turbo-frame': responseFrame, 'data-controller': 'form-draft', 'data-form-draft-owner-value': app.user.id, 'data-form-draft-key-value': review.item.id ~ ':review', 'data-action': 'submit->form-draft#start turbo:before-fetch-response->form-draft#response form-draft:cleared@document->form-draft#cleared'}}) }}
    <div class="lp-inbox-item__refusal" hidden data-form-draft-target="stale" role="status">
        <p>{{ 'inbox.review.stale_draft'|trans }}</p>
        <twig:Ds:Button variant="ghost" size="sm" type="button" data-action="form-draft#discard">{{ 'inbox.answer.discard_draft'|trans }}</twig:Ds:Button>
    </div>
    <twig:Ds:FieldErrors :fieldView="form" />
    {{ form_widget(form.versionNumber, {type: 'hidden', attr: {'data-form-draft-target': 'guard'}}) }}
    <twig:Ds:FieldErrors :fieldView="form.versionNumber" />
    {{ form_widget(form.expectedReviewId, {attr: {'data-form-draft-target': 'guard'}}) }}
    <twig:Ds:FieldErrors :fieldView="form.expectedReviewId" />
    {% if documentCard ?? true %}
        {% set version = inbox_review_version(review) %}
        <a class="lp-inbox-review-document" href="{{ path('app_document_review', {projectId: review.document.project.id, documentId: review.document.id}) }}" data-turbo-frame="_top" data-inbox-review-document-card>
            <twig:ux:icon name="lucide:file-text" class="lp-inbox-review-document__icon" />
            <span class="lp-inbox-review-document__text">
                <span class="lp-inbox-review-document__title">{{ review.document.title|reference_plain }}</span>
                <span class="lp-inbox-review-document__sub">{% if version %}{{ 'inbox.review.version'|trans({'%version%': version}) }} · {% endif %}{{ review.document.status.translationKey()|trans }}</span>
            </span>
            <span class="lp-inbox-review-document__action">{{ 'inbox.review.read_it'|trans }}</span>
        </a>
    {% endif %}
    {% include '@Inbox/_verdict_block.html.twig' with {form: form} only %}
    <div class="lp-inbox-item__buttons">{% include '@Inbox/_dismiss_button.html.twig' with {actionParams: actionParams, dismissible: dismissible, label: dismissLabel} only %}<twig:Ds:Button variant="primary" type="submit">{{ 'inbox.review.submit'|trans }}</twig:Ds:Button></div>
{{ form_widget(form._token) }}
{{ form_end(form, {render_rest: false}) }}
