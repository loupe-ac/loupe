{# The sidebar pill, in a frame the live-pill controller reloads when the count changes. #}
<turbo-frame id="inbox-open-count-{{ project.id }}" class="lp-sidebar__pill-frame" data-live-pill-target="frame">
    {% if openCount > 0 %}
    <span class="lp-sidebar__pill lp-sidebar__pill--amber" data-inbox-open-count aria-hidden="true">{{ openCount }}</span>
    <span class="sr-only">{{ 'inbox.nav.open_items'|trans({'%count%': openCount}) }}</span>
    {% endif %}
</turbo-frame>
