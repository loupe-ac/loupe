{# The sidebar pill, in a frame that the sidebar-counts stream replaces when a count changes. #}
<turbo-frame id="inbox-open-count-{{ project.id }}" class="lp-sidebar__pill-frame">
    {% if openCount > 0 %}
    <span class="lp-sidebar__pill lp-sidebar__pill--amber" data-inbox-open-count aria-hidden="true">{{ openCount }}</span>
    <span class="sr-only">{{ 'inbox.nav.open_items'|trans({'%count%': openCount}) }}</span>
    {% endif %}
</turbo-frame>
