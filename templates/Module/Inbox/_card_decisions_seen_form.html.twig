{#- Posted by the decisions-seen controller when the Decisions tab opens. Props: view. -#}
<form hidden method="post" action="{{ path('app_inbox_card_decisions_seen', {projectId: view.card.project.id, cardId: view.card.id}) }}" data-decisions-seen-target="form">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('inbox-decisions-seen') }}">
    <input type="hidden" name="through" value="{{ view.decisions[0].createdAt|date('Y-m-d H:i:s.u', false) }}">
</form>
