{% extends 'base.html.twig' %}

{% block title %}{{ 'inbox.account.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'inbox.account.page.title'|trans},
    ]" />
{% endblock %}

{% block body %}
<twig:Ds:Workspace class="lp-account-inbox">
    {% include '@Notification/_stopped_device_warning_live.html.twig' only %}
    <twig:Ds:PageHeader :title="'inbox.account.page.title'|trans" :description="'inbox.account.page.description'|trans" />

    {% do mercure_subscribe(inbox_topic(app.user)) %}
    {% do mercure_subscribe(account_topic(app.user)) %}
    {% include '@Inbox/_account_inbox_frame.html.twig' with {inbox: inbox} only %}
</twig:Ds:Workspace>
{% endblock %}
