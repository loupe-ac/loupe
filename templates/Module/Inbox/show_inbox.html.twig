{% extends 'base.html.twig' %}

{% block title %}{{ 'inbox.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <a class="lp-topbar__crumb" href="{{ path('app_project_documents', {id: inbox.project.id}) }}">{{ inbox.project.name }}</a>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'inbox.page.title'|trans }}</span>
{% endblock %}

{# The page has no header of its own, as the prototype draws it, so its two links sit in the top bar. #}
{% block topbar_actions %}
    <div class="lp-inbox-topbar-actions">
        <twig:Ds:Button variant="ghost" href="{{ path('app_project_activity', {id: inbox.project.id}) }}" aria-label="{{ 'inbox.activity'|trans }}">
            <twig:ux:icon name="lucide:activity" class="w-4 h-4" />
            <span class="lp-inbox-topbar-actions__label">{{ 'inbox.activity'|trans }}</span>
        </twig:Ds:Button>
        {% if is_granted(constant('App\\Module\\Project\\Security\\ProjectVoter::MANAGE'), inbox.project) %}
        <twig:Ds:Button variant="ghost" href="{{ path('app_inbox_settings', {id: inbox.project.id}) }}" aria-label="{{ 'inbox.settings_link'|trans }}">
            <twig:ux:icon name="lucide:settings" class="w-4 h-4" />
            <span class="lp-inbox-topbar-actions__label">{{ 'inbox.settings_link'|trans }}</span>
        </twig:Ds:Button>
        {% endif %}
    </div>
{% endblock %}

{% block body %}
{% set view = inbox.view %}
{% set closedSide = constant('App\\Module\\Inbox\\View\\InboxSide::Closed') %}
{% set openSide = constant('App\\Module\\Inbox\\View\\InboxSide::Open') %}
{% set section = view.isSearch ? 'search-results' : (view.side == closedSide ? 'closed-asks' : 'open-asks') %}
{# A live refresh reads the view again for a page that already shows a status line, and the refresh leaves the flash for the next full visit. #}
{% set liveRefresh = app.request.headers.has('X-Loupe-Live-Refresh') %}
{% do mercure_subscribe(inbox_page_topic(inbox.project)) %}
<twig:Ds:SplitView class="lp-workspace lp-needs-you lp-core-prototype-page lp-core-inbox" data-controller="inbox-anchor inbox-live">
    <h1 class="sr-only">{{ 'inbox.page.title'|trans }}</h1>

    {# The frame holds the whole view, so a row, the switch, a filter, the search and the pager each reload it and move the address on.
       A link or a form outside the view leaves the frame, which is why the frame targets the page. #}
    <turbo-frame id="inbox-view" class="lp-inbox-frame" target="_top" data-turbo-action="advance">
        <section class="lp-inbox-section lp-inbox-section--queue lp-split-region" data-inbox-section="{{ section }}">
            <div class="lp-split-view lp-inbox-split" data-inbox-picked="{{ view.isPicked ? 'true' : 'false' }}" data-inbox-empty="{{ inbox.rows is empty ? 'true' : 'false' }}">
                <div class="lp-inbox-request-list lp-split-pane">
                    <div class="lp-inbox-list-head">
                        <twig:Ds:Tabs class="lp-inbox-switch" aria-label="{{ 'inbox.view.label'|trans }}">
                            <a class="lp-tabs__tab"
                               href="{{ path('app_project_inbox', {id: inbox.project.id}|merge(view.onSide(openSide).toQuery)) }}"
                               data-turbo-frame="inbox-view"
                               data-inbox-side="open"
                               {%- if not view.isSearch and view.side == openSide %} aria-current="page"{% endif %}>{{ 'inbox.view.open'|trans({'%count%': inbox.openCount}) }}</a>
                            <a class="lp-tabs__tab"
                               href="{{ path('app_project_inbox', {id: inbox.project.id}|merge(view.onSide(closedSide).toQuery)) }}"
                               data-turbo-frame="inbox-view"
                               data-inbox-side="closed"
                               {%- if not view.isSearch and view.side == closedSide %} aria-current="page"{% endif %}>{{ 'inbox.view.closed'|trans }}</a>
                        </twig:Ds:Tabs>

                        {# A GET form, so the search lands in the address. A new search starts at page one and keeps the side and the type. #}
                        <form method="get"
                              action="{{ path('app_project_inbox', {id: inbox.project.id}) }}"
                              data-turbo-frame="inbox-view"
                              data-controller="autosearch"
                              data-autosearch-ignore-value="{{ ['side', 'type']|json_encode|e('html_attr') }}"
                              class="lp-filter-form">
                            <input type="hidden" name="side" value="{{ view.side.value }}">
                            {% if view.type %}<input type="hidden" name="type" value="{{ view.type.value }}">{% endif %}
                            <div class="lp-filter-search">
                                <twig:ux:icon name="lucide:search" class="lp-filter-search__icon" />
                                <label class="sr-only" for="inbox-search">{{ 'inbox.search.label'|trans }}</label>
                                <twig:Ds:Input type="search"
                                       id="inbox-search"
                                       name="q"
                                       class="lp-filter-input"
                                       value="{{ view.query }}"
                                       placeholder="{{ 'inbox.search.placeholder'|trans }}"
                                       data-autosearch-target="field"
                                       data-action="input->autosearch#search" />
                            </div>
                            {% if view.query != '' %}
                            <a href="{{ path('app_project_inbox', {id: inbox.project.id}|merge(view.withQuery('').toQuery)) }}"
                               data-turbo-frame="inbox-view"
                               data-autosearch-target="clearButton"
                               class="lp-filter-clear">{{ 'inbox.search.clear'|trans }}</a>
                            {% endif %}
                        </form>

                        <div class="lp-inbox-filter" role="group" aria-label="{{ 'inbox.filter.label'|trans }}">
                            <a class="lp-inbox-filter__button lp-inbox-filter__button--all"
                               href="{{ path('app_project_inbox', {id: inbox.project.id}|merge(view.withType(null).toQuery)) }}"
                               data-turbo-frame="inbox-view"
                               data-inbox-type="all"
                               {%- if not view.type %} aria-current="true"{% endif %}>{{ 'inbox.filter.all'|trans }}</a>
                            {% for kind in constant('App\\Module\\Inbox\\View\\InboxView::FILTER_KINDS') %}
                                <a class="lp-inbox-filter__button"
                                   href="{{ path('app_project_inbox', {id: inbox.project.id}|merge(view.withType(kind).toQuery)) }}"
                                   data-turbo-frame="inbox-view"
                                   data-inbox-type="{{ kind.value }}"
                                   aria-label="{{ ('inbox.filter.kind.' ~ kind.value)|trans }}"
                                   aria-describedby="inbox-filter-{{ kind.value }}"
                                   {%- if view.type == kind %} aria-current="true"{% endif %}>
                                    {% include '@Inbox/_inbox_kind_icon.html.twig' with {kind: kind.value} only %}
                                    <twig:Ds:Tooltip id="inbox-filter-{{ kind.value }}">{{ ('inbox.filter.kind.' ~ kind.value)|trans }}</twig:Ds:Tooltip>
                                </a>
                            {% endfor %}
                        </div>
                        {% if view.isSearch %}
                            <span class="lp-filter-count">{{ 'inbox.search.count'|trans({'%count%': inbox.total}) }}</span>
                        {% endif %}
                    </div>

                    <div class="lp-inbox-rows">
                        {% for row in inbox.rows %}
                            {% include '@Inbox/_inbox_request.html.twig' with {row: row, inbox: inbox} only %}
                        {% endfor %}
                    </div>

                    {# The open side is whole, so only the closed side and the search results page. A wrapper frame sends the pager links to the view. #}
                    {% if view.isSearch or view.side == closedSide %}
                        <turbo-frame id="inbox-pager" target="inbox-view">
                            <twig:Ds:Pagination route="app_project_inbox" :page="inbox.page" :totalPages="inbox.totalPages" :pageList="inbox.pageList" :routeParams="{id: inbox.project.id}|merge(view.withoutSelection.toQuery)" />
                        </turbo-frame>
                    {% endif %}
                </div>

                <div class="lp-inbox-request-detail lp-split-pane">
                    {# What the last response did, read once. Only this page reads the flash type. #}
                    {% for status in liveRefresh ? [] : app.flashes('inbox_status') %}
                        {% set verb = ('inbox.status.verb.' ~ status.verb)|trans %}
                        <p class="lp-inbox-status" role="status" data-inbox-status>
                            <twig:ux:icon name="lucide:check" class="lp-inbox-status__icon" />
                            {% if status.ask %}
                                <span>{{ 'inbox.status.ask_closed'|trans({'%verb%': verb}) }}</span>
                                <span class="lp-inbox-status__detail">{{ 'inbox.status.ask_closed_detail'|trans({'%title%': status.title}) }}</span>
                                <a href="{{ path('app_project_inbox', {id: inbox.project.id, side: 'closed', ask: status.ask}) }}" data-turbo-frame="inbox-view">{{ 'inbox.status.view'|trans }}</a>
                            {% elseif status.left > 0 %}
                                <span>{{ 'inbox.status.ask_left'|trans({'%verb%': verb, '%count%': status.left}) }}</span>
                            {% else %}
                                <span>{{ 'inbox.status.item'|trans({'%verb%': verb, '%number%': status.number}) }}</span>
                            {% endif %}
                        </p>
                    {% endfor %}
                    {# The ask that the page showed open has closed since: say why, and point to the next open ask. Only a live refresh that names the ask asks for it. #}
                    {% set watched = app.request.headers.get('X-Loupe-Inbox-Watching') %}
                    {% if watched and inbox.selected and inbox.selected.ask and inbox.selected.ask.closedAt and (inbox.selected.ask.id ~ '') == watched %}
                        {% set closedOutcome = inbox.selected.outcome ?? 'closed' %}
                        {% set closedReason = inbox.selected.closing.closeNote ?? null %}
                        <p class="lp-inbox-status" role="status" data-inbox-closed-notice="{{ closedOutcome }}">
                            <span>
                                {%- if closedOutcome in ['withdrawn', 'obsolete'] -%}
                                    {{ ('inbox.live.closed.' ~ closedOutcome)|trans }}
                                {%- else -%}
                                    {{ 'inbox.live.closed.other'|trans({'%outcome%': (closedOutcome == 'closed' ? 'inbox.row.closed' : 'inbox.row.outcome.' ~ closedOutcome)|trans}) }}
                                {%- endif -%}
                                {%- if closedReason %} {{ closedReason }}{% endif -%}
                            </span>
                            <a href="{{ path('app_project_inbox', {id: inbox.project.id}|merge(view.onSide(openSide).withoutSelection.toQuery)) }}" data-turbo-frame="inbox-view">{{ 'inbox.live.next'|trans }}</a>
                        </p>
                    {% endif %}
                    {% if view.isPicked %}
                        <a class="lp-inbox-back"
                           href="{{ path('app_project_inbox', {id: inbox.project.id}|merge(view.withoutSelection.toQuery)) }}"
                           data-turbo-frame="inbox-view">
                            <twig:ux:icon name="lucide:arrow-left" class="w-4 h-4" />
                            {{ 'inbox.pane.back'|trans }}
                        </a>
                    {% endif %}
                    {% if inbox.selected %}
                        {% include '@Inbox/_inbox_detail.html.twig' with {row: inbox.selected, inbox: inbox, refusedForm: refusedForm} only %}
                    {% elseif inbox.pickedNothing %}
                        <twig:Ds:EmptyState :title="'inbox.pane.missing'|trans" data-inbox-pane-missing />
                    {% elseif view.isSearch %}
                        <twig:Ds:EmptyState :title="'inbox.search.empty'|trans" data-inbox-search-empty />
                    {% elseif view.type %}
                        <twig:Ds:EmptyState :title="'inbox.filter.empty'|trans" data-inbox-type-empty />
                    {% elseif view.side == closedSide %}
                        <twig:Ds:EmptyState :title="'inbox.closed.empty'|trans" data-inbox-queue-empty="closed-asks" />
                    {% else %}
                        <twig:Ds:EmptyState :title="'inbox.empty.title'|trans" :body="'inbox.empty.body'|trans" data-inbox-queue-empty="open-asks">
                            <a class="lp-empty-state__link" href="{{ path('app_project_inbox', {id: inbox.project.id}|merge(view.onSide(closedSide).toQuery)) }}" data-turbo-frame="inbox-view">{{ 'inbox.empty.closed_link'|trans }}</a>
                        </twig:Ds:EmptyState>
                    {% endif %}
                </div>
            </div>
        </section>
    </turbo-frame>
</twig:Ds:SplitView>
{% endblock %}
