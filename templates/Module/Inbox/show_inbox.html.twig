{% extends 'base.html.twig' %}

{% block title %}{{ 'inbox.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'inbox.page.title'|trans},
    ]" />
{% endblock %}

{% block body %}
{% set view = inbox.view %}
{% set closedSide = constant('App\\Module\\Inbox\\View\\InboxSide::Closed') %}
{% set openSide = constant('App\\Module\\Inbox\\View\\InboxSide::Open') %}
{% set section = view.isSearch ? 'search-results' : (view.side == closedSide ? 'closed-asks' : 'open-asks') %}
{# A live refresh reads the view again for a page that already shows a status line, and the refresh leaves the flash for the next full visit. #}
{% set liveRefresh = app.request.headers.has('X-Loupe-Live-Refresh') %}
{% do mercure_subscribe(inbox_page_topic(inbox.project)) %}
{% do mercure_subscribe(worker_runs_topic(inbox.project)) %}
<twig:Ds:SplitView width="full" class="lp-needs-you lp-core-prototype-page lp-core-inbox" data-live-content data-controller="inbox-anchor inbox-live inbox-navigation card-drawer" data-inbox-live-rows-url-value="{{ path('app_project_inbox_rows', {id: inbox.project.id}) }}">
    <h1 class="sr-only">{{ 'inbox.page.title'|trans }}</h1>

    {% include '@Notification/_stopped_device_warning_live.html.twig' only %}

    {# A GET form, so the search lands in the address. It sits outside the view frame, so a search never replaces the field being typed into. The navigation controller copies the query, the side and the type from the address after each render. #}
    <div class="lp-inbox-search">
        <twig:Ds:FilterBar
            :action="path('app_project_inbox', {id: inbox.project.id})"
            :formAttributes="{'data-turbo-frame': 'inbox-view', 'data-turbo-action': 'advance', 'data-autosearch-ignore-value': ['side', 'type']|json_encode, 'data-inbox-search-form': true}"
            :search="{id: 'inbox-search', name: 'q', value: view.query, label: 'inbox.search.label'|trans, placeholder: 'inbox.search.placeholder'|trans}">
            <twig:block name="secondary">
                <input type="hidden" name="side" value="{{ view.side.value }}" data-default="{{ openSide.value }}">
                <input type="hidden" name="type" value="{{ view.type ? view.type.value : '' }}"{% if not view.type %} disabled{% endif %}>
            </twig:block>
        </twig:Ds:FilterBar>
    </div>

    {# The frame holds the whole view, so a row, the switch, a filter, the search and the pager each reload it and move the address on.
       A link or a form outside the view leaves the frame, which is why the frame targets the page. #}
    <turbo-frame id="inbox-view" class="lp-inbox-frame" target="_top" data-turbo-action="advance">
        <section class="lp-inbox-section lp-inbox-section--queue lp-split-region" data-inbox-section="{{ section }}">
            <div class="lp-split-view lp-inbox-split" data-inbox-picked="{{ view.isPicked ? 'true' : 'false' }}" data-inbox-empty="{{ inbox.rows is empty and inbox.digests is empty ? 'true' : 'false' }}">
                <div class="lp-inbox-request-list lp-split-pane">
                    <div class="lp-inbox-list-head">
                        <twig:Ds:Tabs variant="segmented" aria-label="{{ 'inbox.view.label'|trans }}">
                            <a class="lp-tabs__tab"
                               href="{{ path('app_project_inbox', {id: inbox.project.id}|merge(view.onSide(openSide).toQuery)) }}"
                               data-turbo-frame="inbox-view"
                               id="inbox-open-tab"
                               data-inbox-side="open"
                               {%- if not view.isSearch and view.side == openSide %} aria-current="page"{% endif %}>{{ 'inbox.view.open'|trans({'%count%': inbox.openCount}) }}</a>
                            <a class="lp-tabs__tab"
                               href="{{ path('app_project_inbox', {id: inbox.project.id}|merge(view.onSide(closedSide).toQuery)) }}"
                               data-turbo-frame="inbox-view"
                               data-inbox-side="closed"
                               {%- if not view.isSearch and view.side == closedSide %} aria-current="page"{% endif %}>{{ 'inbox.view.closed'|trans }}</a>
                        </twig:Ds:Tabs>

                        {% if view.isSearch %}
                            <twig:Ds:FilterBar
                                class="lp-inbox-search-state"
                                :clearHref="path('app_project_inbox', {id: inbox.project.id}|merge(view.withQuery('').toQuery))"
                                :clearLabel="'inbox.search.clear'|trans"
                                :clearAttributes="{'data-turbo-frame': 'inbox-view'}"
                                :count="'inbox.search.count'|trans({'%count%': inbox.total})" />
                        {% endif %}

                        <div class="lp-inbox-filter" role="group" aria-label="{{ 'inbox.filter.label'|trans }}">
                            <a class="lp-inbox-filter__button lp-inbox-filter__button--all"
                               href="{{ path('app_project_inbox', {id: inbox.project.id}|merge(view.withType(null).toQuery)) }}"
                               data-turbo-frame="inbox-view"
                               data-inbox-type="all"
                               {%- if not view.type %} aria-current="true"{% endif %}>{{ 'inbox.filter.all'|trans }}</a>
                            {% for kind in constant('App\\Module\\Inbox\\View\\InboxView::FILTER_KINDS') %}
                                <a class="lp-inbox-filter__button"
                                   href="{{ path('app_project_inbox', {id: inbox.project.id}|merge(view.withType(kind).toQuery)) }}"
                                   data-turbo-frame="inbox-view"
                                   data-inbox-type="{{ kind.value }}"
                                   aria-label="{{ ('inbox.filter.kind.' ~ kind.value)|trans }}"
                                   aria-describedby="inbox-filter-{{ kind.value }}"
                                   {%- if view.type == kind %} aria-current="true"{% endif %}>
                                    {% include '@Inbox/_inbox_kind_icon.html.twig' with {kind: kind.value} only %}
                                    <twig:Ds:Tooltip id="inbox-filter-{{ kind.value }}">{{ ('inbox.filter.kind.' ~ kind.value)|trans }}</twig:Ds:Tooltip>
                                </a>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="lp-inbox-rows" id="inbox-rows" data-inbox-scroll{% if inbox.groups is not null %} data-inbox-grouped{% endif %}>
                        {% if inbox.groups is not null %}
                            {% for group in inbox.groups %}
                                <section class="lp-inbox-group" data-inbox-group="{{ group.key }}" aria-labelledby="inbox-group-{{ group.key }}">
                                    <h2 class="lp-inbox-group__heading" id="inbox-group-{{ group.key }}">
                                        {%- if group.card -%}
                                            <twig:ux:icon name="lucide:layout-list" class="lp-icon lp-icon--sm" aria-hidden="true" />
                                            <span class="lp-inbox-group__number">#{{ group.card.number }}</span>
                                            <span class="lp-inbox-group__title">{{ group.card.title|reference_plain }}</span>
                                            <twig:Ds:Tag tone="neutral">{{ group.card.column.label }}</twig:Ds:Tag>
                                        {%- else -%}
                                            <span class="lp-inbox-group__title">{{ 'inbox.group.none'|trans }}</span>
                                        {%- endif -%}
                                        {% if group.rows is not empty %}<span class="lp-inbox-group__count">{{ 'inbox.group.open'|trans({'%count%': group.rows|length}) }}</span>{% endif %}
                                        {% if group.digest %}<span class="lp-inbox-group__count" data-inbox-digest-count>{{ 'inbox.digest.new'|trans({'%count%': group.digest.count}) }}</span>{% endif %}
                                    </h2>
                                    {% if group.digest %}
                                        {% include '@Inbox/_inbox_digest.html.twig' with {digest: group.digest} only %}
                                    {% endif %}
                                    {% for row in group.rows %}
                                        {% include '@Inbox/_inbox_request.html.twig' with {row: row, inbox: inbox} only %}
                                    {% endfor %}
                                </section>
                            {% endfor %}
                        {% else %}
                            {% for row in inbox.rows %}
                                {% include '@Inbox/_inbox_request.html.twig' with {row: row, inbox: inbox} only %}
                            {% endfor %}
                            {% for digest in inbox.digests %}
                                {% include '@Inbox/_inbox_digest.html.twig' with {digest: digest, withCard: true} only %}
                            {% endfor %}
                        {% endif %}
                    </div>

                    {# The open side is whole, so only the closed side and the search results page. A wrapper frame sends the pager links to the view. #}
                    {% if view.isSearch or view.side == closedSide %}
                        <turbo-frame id="inbox-pager" target="inbox-view">
                            <twig:Ds:Pagination route="app_project_inbox" :page="inbox.page" :totalPages="inbox.totalPages" :pageList="inbox.pageList" :routeParams="{id: inbox.project.id}|merge(view.withoutSelection.toQuery)" />
                        </turbo-frame>
                    {% endif %}
                </div>

                <div class="lp-inbox-request-detail lp-split-pane">
                    {# A row pick swaps only this frame, so the list keeps its place. Every other link and form of the pane targets the view frame. #}
                    <turbo-frame id="inbox-detail" target="_top" data-turbo-action="advance">
                        {# What the last response did, read once. Only this page reads the flash type. #}
                        {% for status in liveRefresh ? [] : app.flashes('inbox_status') %}
                            {% set verb = ('inbox.status.verb.' ~ status.verb)|trans %}
                            <p class="lp-inbox-status" role="status" data-inbox-status>
                                <twig:ux:icon name="lucide:check" class="lp-inbox-status__icon" />
                                {% if status.ask %}
                                    <span>{{ 'inbox.status.ask_closed'|trans({'%verb%': verb}) }}</span>
                                    <span class="lp-inbox-status__detail">{{ 'inbox.status.ask_closed_detail'|trans({'%title%': status.title|reference_plain}) }}</span>
                                    <a href="{{ path('app_project_inbox', {id: inbox.project.id, side: 'closed', ask: status.ask}) }}" data-turbo-frame="inbox-view">{{ 'inbox.status.view'|trans }}</a>
                                {% elseif status.left > 0 %}
                                    <span>{{ 'inbox.status.ask_left'|trans({'%verb%': verb, '%count%': status.left}) }}</span>
                                {% else %}
                                    <span>{{ 'inbox.status.item'|trans({'%verb%': verb, '%number%': status.number}) }}</span>
                                {% endif %}
                            </p>
                        {% endfor %}
                        {# The ask that the page showed open has closed since: say why, and point to the next open ask. Only a live refresh that names the ask asks for it. #}
                        {% set watched = app.request.headers.get('X-Loupe-Inbox-Watching') %}
                        {% if watched and inbox.selected and inbox.selected.ask and inbox.selected.ask.closedAt and (inbox.selected.ask.id ~ '') == watched %}
                            {% set closedOutcome = inbox.selected.outcome %}
                            <twig:Ds:Flash severity="info" class="lp-inbox-closed-notice" data-inbox-closed-notice="{{ closedOutcome ? closedOutcome.key : 'closed' }}">
                                {%- if closedOutcome and inbox.selected.closing.state.value == 'cancelled' -%}
                                    {{ 'inbox.live.closed.cancelled'|trans({'%outcome%': closedOutcome.key|trans(closedOutcome.parameters)}) }}
                                {%- else -%}
                                    {{ 'inbox.live.closed.other'|trans({'%outcome%': closedOutcome ? closedOutcome.key|trans(closedOutcome.parameters) : 'inbox.row.closed'|trans}) }}
                                {%- endif %}
                                <a href="{{ path('app_project_inbox', {id: inbox.project.id}|merge(view.onSide(openSide).withoutSelection.toQuery)) }}" data-turbo-frame="inbox-view">{{ 'inbox.live.next'|trans }}</a>
                            </twig:Ds:Flash>
                        {% endif %}
                        {% if view.isPicked %}
                            <a class="lp-inbox-back"
                               href="{{ path('app_project_inbox', {id: inbox.project.id}|merge(view.withoutSelection.toQuery)) }}"
                               data-turbo-frame="inbox-view">
                                <twig:ux:icon name="lucide:arrow-left" class="lp-icon lp-icon--md" />
                                {{ 'inbox.pane.back'|trans }}
                            </a>
                        {% endif %}
                        {% if inbox.selected %}
                            {% include '@Inbox/_inbox_detail.html.twig' with {row: inbox.selected, inbox: inbox, refusedForm: refusedForm, cardDrawer: true} only %}
                        {% elseif inbox.pickedNothing %}
                            <twig:Ds:EmptyState :title="'inbox.pane.missing'|trans" data-inbox-pane-missing />
                        {% elseif view.isSearch %}
                            <twig:Ds:EmptyState :title="'inbox.search.empty'|trans" data-inbox-search-empty />
                        {% elseif view.type %}
                            <twig:Ds:EmptyState :title="'inbox.filter.empty'|trans" data-inbox-type-empty />
                        {% elseif view.side == closedSide %}
                            <twig:Ds:EmptyState :title="'inbox.closed.empty'|trans" data-inbox-queue-empty="closed-asks" />
                        {% else %}
                            <twig:Ds:EmptyState icon="lucide:inbox" :title="'inbox.empty.title'|trans" :body="'inbox.empty.body'|trans" data-inbox-queue-empty="open-asks" />
                        {% endif %}
                    </turbo-frame>
                </div>
                {# Covers the detail pane, outside its scroll, while a picked row loads, as the board's card drawer does. #}
                <div class="lp-inbox-pane-loading" role="status">
                    <twig:ux:icon name="lucide:loader-circle" class="lp-icon lp-icon--lg" />
                    {{ 'inbox.pane.loading'|trans }}
                </div>
            </div>
        </section>
    </turbo-frame>
    {% include '@Board/_card_drawer.html.twig' with {project: inbox.project} only %}
</twig:Ds:SplitView>
{% endblock %}
