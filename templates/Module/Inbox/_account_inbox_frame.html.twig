{# The project list of the account inbox, in a live region. The page and the fragment route render it. Props: inbox (AccountInboxDetailView). #}
<turbo-frame id="account-inbox-list" refresh="morph" data-live-content data-controller="live-region" data-live-region-types-value="{{ ['inbox.open_count_changed', 'account.changed']|json_encode }}" data-live-region-match-value="{{ {area: [null]}|json_encode }}" data-live-region-url-value="{{ path('app_account_inbox_frame') }}" data-live-region-mode-value="frame">
    {% if inbox.isEmpty %}
    <twig:Ds:EmptyState icon="lucide:inbox" iconClass="text-accent" :title="'inbox.account.page.empty'|trans" />
    {% else %}
    <div class="lp-account-inbox__list">
        {% for row in inbox.rows %}
        <a class="lp-account-inbox-row" href="{{ path('app_project_inbox', {id: row.project.id}) }}" data-turbo-frame="_top" data-account-inbox-project="{{ row.project.id }}">
            <twig:Ds:Avatar :name="row.project.name" size="xs" shape="square" tone="tint" class="lp-account-inbox-row__avatar" aria-hidden="true" />
            <span class="lp-account-inbox-row__name">{{ row.project.name }}</span>
            <twig:ux:icon name="lucide:arrow-right" class="lp-account-inbox-row__go" />
            <span class="lp-account-inbox-row__meta">
                <span data-account-inbox-open-count>{{ 'inbox.account.project.open_asks'|trans({'%count%': row.openAskCount}) }}</span>
                {% if row.oldestWait %}
                <span class="lp-account-inbox-row__wait">{{ 'inbox.account.project.oldest'|trans({'%time%': row.oldestWait|relative_time}) }}</span>{# @design-system-ignore #}
                {% endif %}
                {% if row.blocking %}
                <span class="lp-account-inbox-row__blocking">{{ 'inbox.item.blocking'|trans }}</span>
                {% endif %}
            </span>
        </a>
        {% endfor %}
    </div>
    {% endif %}
</turbo-frame>
