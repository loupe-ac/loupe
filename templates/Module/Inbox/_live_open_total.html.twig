{# Hidden. Keeps the tab title prefix current. With live false the sidebar-counts stream replaces the frame. Otherwise the live-pill controller reloads it. #}
{% set live = live ?? true %}
{% if live %}
<div hidden data-controller="live-pill tab-count"
     data-action="turbo:frame-load->tab-count#sync"
     data-live-pill-events-value="{{ ['inbox.sidebar_count_changed']|json_encode }}"
     data-live-pill-url-value="{{ path('app_inbox_open_total') }}">
    {% include '@Inbox/_open_total.html.twig' with {total: total} only %}
</div>
{% else %}
<div hidden data-controller="tab-count"
     data-action="sidebar-counts:applied@window->tab-count#sync">
    {% include '@Inbox/_open_total.html.twig' with {total: total} only %}
</div>
{% endif %}
