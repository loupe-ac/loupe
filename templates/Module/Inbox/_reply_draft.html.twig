{#- The unsent reply of an item that closed while the owner typed. The reply card holds it in a template, and the live view fills it in. No params. -#}
<div class="lp-inbox-item__response" data-inbox-reply-draft data-controller="inbox-reply-draft">
    <twig:Ds:Label as="p">{{ 'inbox.answer.unsent'|trans }}</twig:Ds:Label>
    <p class="lp-inbox-item__note">{{ 'inbox.answer.unsent_closed'|trans }}</p>
    <ul class="lp-inbox-item__choices" data-inbox-reply-draft-target="choiceList"></ul>
    <div data-inbox-reply-draft-target="noteList"></div>
    <twig:Ds:Button variant="ghost" size="sm" type="button" data-action="inbox-reply-draft#discard">{{ 'inbox.answer.discard_draft'|trans }}</twig:Ds:Button>
</div>
