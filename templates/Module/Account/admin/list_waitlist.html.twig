{% extends '@UbermudaAdmin/base.html.twig' %}

{% block title %}{{ 'account.admin.waitlist.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <form method="post" action="{{ path('app_admin_waitlist_invite') }}" id="invite-selected-form">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin-waitlist-invite') }}">
    </form>
    <section class="mb-4" aria-label="{{ 'account.admin.waitlist.counts.title'|trans }}" data-waitlist-pick-counts>
        <h2 class="text-sm font-medium text-fg">{{ 'account.admin.waitlist.counts.title'|trans }}</h2>
        <ul class="mt-2 flex flex-wrap gap-2">
            {% for pick, count in pickCounts %}
                <li class="admin-badge {{ count > 0 ? 'admin-badge-count' : 'admin-badge-neutral' }}" data-pick="{{ pick }}">{{ ('account.form.waitlist_join_form.picks.choice.' ~ pick)|trans }}: {{ count }}</li>
            {% endfor %}
        </ul>
    </section>
    <section class="admin-card mb-4 flex flex-col gap-4 p-6" aria-labelledby="waitlist-block-patterns-title" data-waitlist-block-patterns>
        <div>
            <h2 id="waitlist-block-patterns-title" class="admin-section-title">{{ 'account.admin.waitlist.block_patterns.title'|trans }}</h2>
            <p class="admin-section-subtitle">{{ 'account.admin.waitlist.block_patterns.subtitle'|trans }}</p>
            <p class="admin-section-subtitle" data-waitlist-hidden-count="{{ hiddenCount }}">{{ 'account.admin.waitlist.block_patterns.hidden_count'|trans({'%count%': hiddenCount}) }}</p>
        </div>
        {% if blockPatterns is empty %}
            <p class="admin-section-subtitle">{{ 'account.admin.waitlist.block_patterns.empty'|trans }}</p>
        {% else %}
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>{{ 'account.admin.waitlist.block_patterns.column.pattern'|trans }}</th>
                        <th>{{ 'account.admin.waitlist.block_patterns.column.added'|trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for blockPattern in blockPatterns %}
                        <tr data-waitlist-block-pattern-id="{{ blockPattern.id }}">
                            <td><code>{{ blockPattern.pattern }}</code></td>
                            <td>{{ blockPattern.createdAt|date('Y-m-d H:i') }}</td>
                            <td>
                                <form method="post" action="{{ path('app_admin_waitlist_block_pattern_remove', {id: blockPattern.id}) }}"
                                      data-turbo-confirm="{{ 'account.admin.waitlist.block_patterns.remove_confirm'|trans({'%pattern%': blockPattern.pattern}) }}">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin-waitlist-block-pattern-remove') }}">
                                    <button type="submit" class="admin-button-secondary admin-button-small">{{ 'account.admin.waitlist.block_patterns.remove'|trans }}</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
        {{ form_start(blockPatternForm, {'action': path('app_admin_waitlist_block_pattern_add'), 'attr': {'novalidate': 'novalidate', 'class': 'flex flex-col gap-4', 'data-waitlist-block-pattern-add': ''}}) }}
            {{ form_errors(blockPatternForm) }}
            <div class="flex flex-col gap-1.5">
                {{ form_label(blockPatternForm.pattern, null, {'label_attr': {'class': 'admin-field-label'}}) }}
                {{ form_widget(blockPatternForm.pattern, {'attr': blockPatternForm.pattern.vars.attr|merge({'class': 'admin-field-input'})}) }}
                {{ form_help(blockPatternForm.pattern) }}
                {{ form_errors(blockPatternForm.pattern) }}
            </div>
            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="submit" class="admin-button">{{ 'account.admin.waitlist.block_patterns.add'|trans }}</button>
            </div>
        {{ form_end(blockPatternForm) }}
    </section>
    <twig:UbermudaAdmin:AdminList
        title="{{ 'account.admin.waitlist.title'|trans }}"
        :total="total"
        unitLabel="{{ 'account.admin.waitlist.unit'|trans }}"
        unitLabelPlural="{{ 'account.admin.waitlist.unit_plural'|trans }}"
        frameId="waitlist-table"
        :filters="filters"
        route="app_admin_waitlist_list"
        :page="page"
        :totalPages="totalPages"
        :pageList="pageList"
        sort="{{ sort }}"
        dir="{{ dir }}"
        tableClass="admin-table"
        emptyLabel="{{ 'account.admin.waitlist.empty'|trans }}"
    >
        <twig:block name="header_actions">
            <div class="flex items-center gap-3">
                <form method="post" action="{{ path('app_admin_waitlist_invite_oldest') }}" class="flex items-center gap-2">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin-waitlist-invite') }}">
                    <label class="text-sm text-fg-mute" for="waitlist-invite-oldest-count">{{ 'account.admin.waitlist.invite_oldest_label'|trans }}</label>
                    <input type="number" id="waitlist-invite-oldest-count" name="invite_oldest_waitlist_form[count]" value="10" min="1" max="100" class="admin-field-input !w-20">
                    <button type="submit" class="admin-button-secondary admin-button-small">{{ 'account.admin.waitlist.invite_oldest'|trans }}</button>
                </form>
                <button type="submit" form="invite-selected-form" class="admin-button admin-button-small">{{ 'account.admin.waitlist.invite_selected'|trans }}</button>
            </div>
        </twig:block>

        <twig:block name="thead">
            <tr>
                <th class="w-10"></th>
                <th><twig:UbermudaAdmin:AdminListSortLink route="app_admin_waitlist_list" column="email" label="{{ 'account.admin.waitlist.column.email'|trans }}" :currentSort="sort" :currentDir="dir" :filters="filters" /></th>
                <th><twig:UbermudaAdmin:AdminListSortLink route="app_admin_waitlist_list" column="createdAt" label="{{ 'account.admin.waitlist.column.joined'|trans }}" :currentSort="sort" :currentDir="dir" :filters="filters" /></th>
                <th><twig:UbermudaAdmin:AdminListSortLink route="app_admin_waitlist_list" column="invitedAt" label="{{ 'account.admin.waitlist.column.invited'|trans }}" :currentSort="sort" :currentDir="dir" :filters="filters" /></th>
                <th>{{ 'account.admin.waitlist.column.picks'|trans }}</th>
                <th>{{ 'account.admin.waitlist.column.status'|trans }}</th>
                <th></th>
            </tr>
        </twig:block>

        <twig:block name="tbody">
            {% for entry in entries %}
                <tr data-waitlist-entry-id="{{ entry.id }}">
                    <td>
                        {% if entry.needsInvite %}
                            <input type="checkbox" name="ids[]" value="{{ entry.id }}" form="invite-selected-form" class="h-4 w-4 rounded border-line text-accent">
                        {% endif %}
                    </td>
                    <td>{{ entry.email }}</td>
                    <td>{{ entry.createdAt|date('Y-m-d H:i') }}</td>
                    <td>{{ entry.invitedAt ? entry.invitedAt|date('Y-m-d H:i') : '—' }}</td>
                    <td data-waitlist-picks>
                        {% for pick in entry.picks %}
                            <span class="admin-badge admin-badge-neutral">{{ ('account.form.waitlist_join_form.picks.choice.' ~ pick)|trans }}</span>
                        {% endfor %}
                        {% if entry.otherPick %}
                            <span class="text-sm text-fg-mute">{{ entry.otherPick }}</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if entry.convertedAt %}
                            <span class="admin-badge admin-badge-on">{{ 'account.admin.waitlist.status.converted'|trans }}</span>
                        {% elseif entry.invitedAt and entry.needsInvite %}
                            <span class="admin-badge admin-badge-neutral">{{ 'account.admin.waitlist.status.expired'|trans }}</span>
                        {% elseif entry.invitedAt %}
                            <span class="admin-badge admin-badge-count">{{ 'account.admin.waitlist.status.invited'|trans }}</span>
                        {% else %}
                            <span class="admin-badge admin-badge-neutral">{{ 'account.admin.waitlist.status.waiting'|trans }}</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if entry.needsInvite %}
                            {# data-turbo-frame="_top": this form lives inside the waitlist-table
                               turbo-frame, but its redirect target renders the whole page (with
                               the success flash) — without this it would frame-scope to a morph
                               that drops the flash, unlike the bulk/oldest actions below, whose
                               forms already sit outside the frame. #}
                            <form method="post" action="{{ path('app_admin_waitlist_invite') }}" data-turbo-frame="_top">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin-waitlist-invite') }}">
                                <input type="hidden" name="ids[]" value="{{ entry.id }}">
                                <button type="submit" class="admin-button-secondary admin-button-small">{{ 'account.admin.waitlist.invite'|trans }}</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </twig:block>
    </twig:UbermudaAdmin:AdminList>
{% endblock %}
