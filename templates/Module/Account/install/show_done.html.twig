{% extends '@Account/auth_base.html.twig' %}

{% block title %}{{ 'account.install.done.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block auth_body %}
<div class="flex flex-col gap-1.5">
    <h1 class="auth-heading">{{ 'account.install.done.heading'|trans }}</h1>
    <p class="auth-subheading">{{ 'account.install.done.body'|trans }}</p>
</div>

<twig:Ds:Button variant="primary" size="lg" :href="path('app_login')" class="lp-auth__action">{{ 'account.install.done.login'|trans }}</twig:Ds:Button>
{% endblock %}
