{% extends '@Account/auth_base.html.twig' %}

{% block title %}{{ 'account.install.admin.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block auth_body %}
<div class="flex flex-col gap-1.5">
    <h1 class="auth-heading">{{ 'account.install.admin.heading'|trans }}</h1>
</div>

{{ form_start(form, {'attr': {
    'class': 'lp-form',
    'novalidate': 'novalidate',
    'data-controller': 'display-name-suggestion',
    'data-display-name-suggestion-max-length-value': constant('App\\Module\\Account\\Entity\\User::MAX_FULL_NAME_LENGTH'),
}}) }}

    {{ form_errors(form) }}

    <twig:Ds:FormField :fieldView="form.email" :widgetAttr="{
            'data-display-name-suggestion-target': 'email',
            'data-action': 'input->display-name-suggestion#suggest'
        }" />

    <twig:Ds:FormField :fieldView="form.fullName" :widgetAttr="{
            'data-display-name-suggestion-target': 'displayName',
            'data-action': 'input->display-name-suggestion#recordEdit change->display-name-suggestion#recordEdit'
        }" />

    <twig:Ds:FormField :fieldView="form.plainPassword" />

    <twig:Ds:Button variant="primary" size="lg" type="submit" class="lp-auth__action">{{ 'account.install.admin.submit'|trans }}</twig:Ds:Button>

{{ form_end(form) }}
{% endblock %}
