{% extends 'email/_layout.html.twig' %}

{% block title %}{{ 'account.email.account_deletion.html_title'|trans }}{% endblock %}

{% block content %}
    <h1>{{ 'account.email.account_deletion.heading'|trans }}</h1>
    <p class="body-text">{{ 'account.email.account_deletion.body'|trans }}</p>
    <a href="{{ confirmUrl }}" class="btn">{{ 'account.email.account_deletion.cta'|trans }}</a>
{% endblock %}

{% block footer %}
    {{ 'account.email.account_deletion.footer_expiry'|trans }}<br>
    {{ 'account.email.account_deletion.footer_not_you'|trans }}<br>
    {{ 'account.email.account_deletion.footer_copy_link'|trans }} {{ confirmUrl }}
{% endblock %}
