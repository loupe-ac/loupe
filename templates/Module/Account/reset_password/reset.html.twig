{% extends '@Account/auth_base.html.twig' %}

{% block title %}{{ 'account.reset_password.reset.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block auth_body %}
<div class="flex flex-col gap-1.5">
    <h1 class="auth-heading">{{ 'account.reset_password.reset.heading'|trans }}</h1>
    <p class="auth-subheading">{{ 'account.reset_password.reset.subheading'|trans }}</p>
</div>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="auth-error">
            <twig:UX:Icon name="lucide:x" class="w-3.5 h-3.5 shrink-0 mt-px" aria-hidden="true" />
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}

{{ form_start(form, {'attr': {'class': 'lp-form', 'novalidate': 'novalidate'}}) }}
    <twig:Ds:FormField :fieldView="form.plainPassword.first" :widgetAttr="{ 'placeholder': 'account.form.change_password_form.new_password.placeholder'}" />
    <twig:Ds:FormField :fieldView="form.plainPassword.second" :widgetAttr="{ 'placeholder': 'account.form.change_password_form.repeat_new_password.placeholder'}" />
    <twig:Ds:Button variant="primary" size="lg" type="submit" class="lp-auth__action">{{ 'account.reset_password.reset.form.submit'|trans }}</twig:Ds:Button>
{{ form_end(form) }}
{% endblock %}
