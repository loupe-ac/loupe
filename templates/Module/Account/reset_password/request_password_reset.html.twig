{% extends '@Account/auth_base.html.twig' %}

{% block title %}{{ 'account.reset_password.request.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block auth_body %}
<div class="flex flex-col gap-1.5">
    <h1 class="auth-heading">{{ 'account.reset_password.request.heading'|trans }}</h1>
    <p class="auth-subheading">{{ 'account.reset_password.request.subheading'|trans }}</p>
</div>

{{ form_start(form, {'attr': {'class': 'lp-form', 'novalidate': 'novalidate'}}) }}
    <twig:Ds:FormField :fieldView="form.email" :widgetAttr="{
            'autofocus': 'autofocus',
            'placeholder': 'account.form.reset_password_request_form.email.placeholder'
        }" />
    <twig:Ds:Button variant="primary" size="lg" type="submit" class="lp-auth__action">{{ 'account.form.reset_password_request_form.submit'|trans }}</twig:Ds:Button>
{{ form_end(form) }}

<div class="text-center">
    <a href="{{ path('app_login') }}" class="auth-link text-xs">{{ 'account.reset_password.request.back'|trans }}</a>
</div>
{% endblock %}
