{% extends 'layout_base.html.twig' %}

{% block page %}
<div class="lp-auth">

    {# Background effects #}
    <div class="lp-auth__grid"></div>
    <div class="lp-auth__glow"></div>

    {# Topbar #}
    <div class="lp-auth__topbar">
        <a href="/" class="lp-auth__brand">
            <twig:Ds:BrandMark />
        </a>
        <div class="lp-auth__topbar-nav">
            {% block topbar_nav %}{% endblock %}
        </div>
    </div>

    {# Card. The <main> landmark is the page's own: an auth page used to inherit
       one from the app shell, but only while the visitor happened to be signed
       in, so signed-out visitors never had one at all. #}
    <main id="main-content" tabindex="-1" class="lp-auth__main">
        <div class="{% block auth_shell_class %}lp-auth__card{% endblock %}">
            {% block auth_body %}{% endblock %}
        </div>
    </main>

    {# Footer #}
    <div class="lp-auth__footer">
        <span>{{ 'account.auth.footer.copyright'|trans }}</span>
        <div class="lp-auth__footer-links">
            {% include '_source_link.html.twig' with {class: 'lp-auth__footer-link gap-1.5'} only %}
            <a href="{{ app_docs_url }}/" class="lp-auth__footer-link">{{ 'account.auth.footer.docs'|trans }}</a>
            <a href="{{ path('app_privacy') }}" class="lp-auth__footer-link">{{ 'account.auth.footer.privacy'|trans }}</a>
            <a href="{{ path('app_terms') }}" class="lp-auth__footer-link">{{ 'account.auth.footer.terms'|trans }}</a>
            <a href="{{ path('app_ai_policy') }}" class="lp-auth__footer-link">{{ 'account.auth.footer.ai_policy'|trans }}</a>
        </div>
    </div>

</div>
{% endblock %}
