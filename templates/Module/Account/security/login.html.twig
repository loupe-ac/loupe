{% extends '@Account/auth_base.html.twig' %}

{% block title %}{{ 'account.login.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_nav %}
{% if registration_open %}
<span class="text-sm text-fg-mute">
    {{ 'account.login.topbar.prompt'|trans }}
    <a href="{{ path('app_register') }}" class="auth-link ml-1.5 text-xs">{{ 'account.login.topbar.link'|trans }}</a>
</span>
{% endif %}
{% endblock %}

{% block auth_body %}
<div class="flex flex-col gap-1.5">
    <h1 class="auth-heading">{{ 'account.login.heading'|trans }}</h1>
    <p class="auth-subheading">{{ 'account.login.subheading'|trans }}</p>
</div>

{% set social_error = app.request.query.get('social_error') %}
{% if social_error %}
    <div class="auth-error" role="alert">
        <twig:ux:icon name="lucide:x" class="lp-icon lp-icon--sm mt-px" aria-hidden="true" />
        {% if social_error == 'unverified' %}
            {{ 'account.social.error.unverified_email'|trans }}
        {% elseif social_error == 'closed' %}
            {{ 'account.social.error.registration_closed'|trans }}
        {% else %}
            {{ 'account.social.error.generic'|trans }}
        {% endif %}
    </div>
{% endif %}

{% include '@Account/security/_social_buttons.html.twig' with {} only %}

<form method="post" action="{{ path('app_login') }}" class="lp-form" novalidate>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

    {% if error %}
        <div class="auth-error">
            <twig:ux:icon name="lucide:x" class="lp-icon lp-icon--sm mt-px" aria-hidden="true" />
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <twig:Ds:FormField>
        <twig:Ds:Label for="email">{{ 'account.login.form.email.label'|trans }}</twig:Ds:Label>
        <twig:Ds:Input id="email" type="email" name="email" value="{{ last_username }}"
               autocomplete="email" autofocus placeholder="{{ 'account.login.form.email.placeholder'|trans }}" />
    </twig:Ds:FormField>

    <twig:Ds:FormField>
        <twig:Ds:Label for="password">{{ 'account.login.form.password.label'|trans }}</twig:Ds:Label>
        <twig:Ds:Input id="password" type="password" name="password"
               autocomplete="current-password" placeholder="{{ 'account.login.form.password.placeholder'|trans }}" />
    </twig:Ds:FormField>

    <label class="lp-auth__remember flex items-center gap-2 text-sm text-fg-mute cursor-pointer select-none mt-0.5">
        <input type="checkbox" name="_remember_me" class="w-3.5 h-3.5 cursor-pointer accent-accent">
        {{ 'account.login.form.remember_me'|trans }}
    </label>

    <twig:Ds:Button variant="primary" size="lg" type="submit" class="lp-auth__action">{{ 'account.login.form.submit'|trans }}</twig:Ds:Button>

    {# Last in the form, so the four controls tab in the order they are read:
       email, password, stay signed in, sign in. #}
    <a href="{{ path('app_forgot_password_request') }}" class="auth-forgot">{{ 'account.login.form.forgot_password'|trans }}</a>
</form>

{% if registration_open %}
<div class="text-center text-sm text-fg-mute">
    {{ 'account.login.footer.prompt'|trans }}
    <a href="{{ path('app_register') }}" class="auth-link pl-1 font-medium">{{ 'account.login.footer.link'|trans }}</a>
</div>
{% endif %}
{% endblock %}
