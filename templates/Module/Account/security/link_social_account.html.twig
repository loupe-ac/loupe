{% extends '@Account/auth_base.html.twig' %}

{% block title %}{{ 'account.social.link.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block auth_body %}
<div class="flex flex-col gap-1.5">
    <h1 class="auth-heading">{{ 'account.social.link.title'|trans }}</h1>
    <p class="auth-subheading">{{ 'account.social.link.subheading'|trans({'%email%': email, '%provider%': providerLabel}) }}</p>
</div>

{% if error %}
    <div class="auth-error" role="alert">
        <twig:ux:icon name="lucide:x" class="lp-icon lp-icon--sm mt-px" aria-hidden="true" />
        {{ error|trans }}
    </div>
{% endif %}

{{ form_start(form, {'attr': {'class': 'lp-form', 'novalidate': 'novalidate'}}) }}
    <twig:Ds:FormField :fieldView="form.password" :widgetAttr="{ 'placeholder': 'account.form.link_social_account_form.password.placeholder'}" />
    <twig:Ds:Button variant="primary" size="lg" type="submit" class="lp-auth__action">{{ 'account.social.link.form.submit.label'|trans }}</twig:Ds:Button>
{{ form_end(form) }}

<div class="text-center text-sm text-fg-mute">
    <a href="{{ path('app_login') }}" class="auth-link">{{ 'account.social.link.cancel'|trans }}</a>
</div>
{% endblock %}
