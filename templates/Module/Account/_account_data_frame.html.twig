{# The export list of the data page, in a live region. The page and the fragment route render it. Props: view (ShowAccountSettingsView). #}
<turbo-frame id="account-exports" class="lp-live-stack" refresh="morph" data-live-content data-controller="live-region" data-live-region-types-value="{{ ['account.changed']|json_encode }}" data-live-region-match-value="{{ {area: 'exports'}|json_encode }}" data-live-region-url-value="{{ path('app_account_data_frame') }}" data-live-region-mode-value="frame">
    {% for export in view.exports %}
    <div class="lp-identity-row" data-account-export="{{ export.id }}">
        <twig:ux:icon name="lucide:package" class="lp-icon lp-icon--md lp-identity-row__glyph" />
        <span class="lp-identity-row__text">
            <span class="lp-identity-row__name lp-identity-row__name--mono">{{ export.requestedAt|date('j M Y, H:i') }}</span>
            <span class="lp-identity-row__meta lp-identity-row__meta--plain">
                {% if export.isExpired %}
                    {{ 'account.settings.export.status.expired'|trans }}
                {% else %}
                    {{ ('account.settings.export.status.' ~ export.status.value)|trans }}
                {% endif %}
            </span>
        </span>
        {# Same gate the controller applies, so a rendered link never 404s.
           Turbo off: the response is a streamed ZIP, and a prefetch on hover
           would pull the whole archive down. #}
        {% if export.isDownloadable %}
        <twig:Ds:Button variant="ghost" href="{{ path('app_account_export_download', {id: export.id}) }}"
           data-turbo="false" data-turbo-prefetch="false">{{ 'account.settings.export.download_link'|trans }}</twig:Ds:Button>
        {% endif %}
    </div>
    {% endfor %}
</turbo-frame>
