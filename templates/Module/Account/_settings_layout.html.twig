{% extends 'base.html.twig' %}

{% block title %}{{ 'account.settings.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <twig:Ds:Breadcrumbs :items="[
        {label: 'nav.link.account'|trans},
        {label: 'account.settings.page.title'|trans},
    ]" />
{% endblock %}

{# Each section names itself, because a forwarded 422 render carries no _route. #}
{% block settings_section '' %}

{% block body %}
{% set section = block('settings_section') %}
{% set settingsContent %}{% if 'billing' != section %}<twig:BillingSummary />{% endif %}{% block settings_content %}{% endblock %}{% endset %}
{% set items = [
    {label: 'account.settings.nav.profile'|trans, url: path('app_account_profile'), icon: 'lucide:users', active: 'profile' == section},
    {label: 'account.settings.nav.notifications'|trans, url: path('app_account_notifications'), icon: 'lucide:bell', active: 'notifications' == section},
    {label: 'account.settings.nav.connected_apps'|trans, url: path('app_account_connected_apps'), icon: 'lucide:plug', active: 'connected-apps' == section},
    {label: 'account.settings.nav.api_keys'|trans, url: path('app_account_api_keys'), icon: 'lucide:key', active: 'api-keys' == section},
    {label: 'account.settings.nav.openrouter'|trans, url: path('app_account_openrouter'), icon: 'lucide:key-round', active: 'openrouter' == section},
    {label: 'account.settings.nav.data'|trans, url: path('app_account_data'), icon: 'lucide:archive', active: 'data' == section},
] %}
{% if 'billing' == section or is_feature_enabled('billing.enabled') %}
{% set items = items|merge([{label: 'account.settings.nav.billing'|trans, url: path('app_billing_subscribe'), icon: 'lucide:credit-card', active: 'billing' == section}]) %}
{% endif %}
<twig:Ds:Workspace class="lp-redesign-secondary lp-redesign-settings">
    <twig:Ds:SettingsLayout
        :title="'account.settings.page.title'|trans"
        :description="'account.settings.page.description'|trans"
        :items="items"
        :navLabel="'account.settings.nav.label'|trans"
    >
        {{ settingsContent }}
    </twig:Ds:SettingsLayout>
</twig:Ds:Workspace>
{% endblock %}
