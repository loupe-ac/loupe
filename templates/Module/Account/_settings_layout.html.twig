{% extends 'base.html.twig' %}

{% block title %}{{ 'account.settings.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_crumbs %}
    <span class="lp-topbar__crumb">{{ 'nav.link.account'|trans }}</span>
    <span class="lp-topbar__sep">/</span>
    <span class="lp-topbar__here">{{ 'account.settings.page.title'|trans }}</span>
{% endblock %}

{# Each section names itself, because a forwarded 422 render carries no _route. #}
{% block settings_section '' %}

{% block body %}
{% set section = block('settings_section') %}
{% set settingsContent %}<twig:BillingSummary />{% block settings_content %}{% endblock %}{% endset %}
{% set items = [
    {label: 'account.settings.nav.profile'|trans, url: path('app_account_profile'), icon: 'lucide:users', active: 'profile' == section},
    {label: 'account.settings.nav.connected_apps'|trans, url: path('app_account_connected_apps'), icon: 'lucide:plug', active: 'connected-apps' == section},
    {label: 'account.settings.nav.data'|trans, url: path('app_account_data'), icon: 'lucide:archive', active: 'data' == section},
] %}
<twig:Ds:Workspace class="lp-redesign-secondary lp-redesign-settings">
    <twig:Ds:SettingsLayout
        :title="'account.settings.page.title'|trans"
        :description="'account.settings.page.description'|trans"
        :items="items"
        :navLabel="'account.settings.nav.label'|trans"
    >
        {{ settingsContent }}
    </twig:Ds:SettingsLayout>
</twig:Ds:Workspace>
{% endblock %}
