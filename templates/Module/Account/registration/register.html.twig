{% extends '@Account/auth_base.html.twig' %}

{% block title %}{{ 'account.registration.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_nav %}
<span class="text-sm text-fg-mute">
    {{ 'account.registration.topbar.prompt'|trans }}
    <a href="{{ path('app_login') }}" class="auth-link ml-1.5 text-xs">{{ 'account.registration.topbar.link'|trans }}</a>
</span>
{% endblock %}

{% block auth_body %}
<div class="flex flex-col gap-1.5">
    <h1 class="auth-heading">{{ 'account.registration.heading'|trans }}</h1>
    <p class="auth-subheading">{{ 'account.registration.subheading'|trans }}</p>
</div>

{% include '@Account/security/_social_buttons.html.twig' with {} only %}

{{ form_start(form, {'attr': {
    'class': 'lp-form',
    'novalidate': 'novalidate',
    'data-controller': 'display-name-suggestion',
    'data-display-name-suggestion-max-length-value': constant('App\\Module\\Account\\Entity\\User::MAX_FULL_NAME_LENGTH'),
}}) }}

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="auth-error">
                {{ ux_icon('lucide:x', {'class': 'w-3.5 h-3.5 shrink-0 mt-px'}) }}
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <twig:Ds:FormField :fieldView="form.email" :widgetAttr="{
            'placeholder': 'account.form.registration_form.email.placeholder',
            'data-display-name-suggestion-target': 'email',
            'data-action': 'input->display-name-suggestion#suggest'
        }" />

    <twig:Ds:FormField :fieldView="form.fullName" :widgetAttr="{
            'placeholder': 'account.form.registration_form.full_name.placeholder',
            'data-display-name-suggestion-target': 'displayName',
            'data-action': 'input->display-name-suggestion#recordEdit change->display-name-suggestion#recordEdit'
        }" />

    <twig:Ds:FormField :fieldView="form.plainPassword" :widgetAttr="{
            'placeholder': 'account.form.registration_form.password.placeholder'
        }" />

    <label class="flex items-start gap-2 text-sm text-fg-mute cursor-pointer select-none mt-0.5">
        {{ form_widget(form.agreeTerms, {'attr': {'class': 'w-3.5 h-3.5 cursor-pointer accent-accent mt-0.5'}}) }}
        <span class="leading-normal">{{ 'account.form.registration_form.agree_terms.prefix'|trans }} <a href="{{ path('app_terms') }}" class="text-fg underline">{{ 'account.form.registration_form.agree_terms.terms'|trans }}</a> {{ 'account.form.registration_form.agree_terms.conjunction'|trans }} <a href="{{ path('app_privacy') }}" class="text-fg underline">{{ 'account.form.registration_form.agree_terms.privacy'|trans }}</a>.</span>
    </label>
    <twig:Ds:FieldErrors :fieldView="form.agreeTerms" />

    <twig:Ds:Button variant="primary" size="lg" type="submit" class="lp-auth__action">{{ 'account.form.registration_form.submit'|trans }}</twig:Ds:Button>

{{ form_end(form) }}

<div class="text-center text-sm text-fg-mute">
    {{ 'account.registration.footer.prompt'|trans }}
    <a href="{{ path('app_login') }}" class="auth-link pl-1 font-medium">{{ 'account.registration.footer.link'|trans }}</a>
</div>
{% endblock %}
