{% extends '@Account/auth_base.html.twig' %}

{% block title %}{{ 'account.registration.verify.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block auth_body %}
<div class="flex flex-col items-center gap-3 py-4 text-center">
    <div class="auth-icon-badge">
        <twig:ux:icon name="lucide:mail" class="lp-icon lp-icon--lg" aria-hidden="true" />
    </div>
    <div>
        <h1 class="text-xl font-semibold tracking-tight text-fg">{{ 'account.registration.verify.heading'|trans }}</h1>
        <div class="text-fg-mute text-sm mt-1.5 leading-normal">
            {{ 'account.registration.verify.body'|trans({'%email%': '<span class="font-medium text-fg">' ~ email|e ~ '</span>'})|raw }}
        </div>
    </div>

    <form method="post" action="{{ path('app_verify_email_submit') }}" class="w-full mt-1.5">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('verify-email') }}">
        <input type="hidden" name="token" value="{{ token }}">
        <twig:Ds:Button type="submit" variant="primary" class="w-full justify-center">
            {{ 'account.registration.verify.cta'|trans }}
        </twig:Ds:Button>
    </form>
</div>
{% endblock %}
