{% extends '@Account/auth_base.html.twig' %}

{% block title %}{{ 'account.waitlist.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block topbar_nav %}
<span class="text-sm text-fg-mute">
    {{ 'account.registration.topbar.prompt'|trans }}
    <a href="{{ path('app_login') }}" class="auth-link ml-1.5 text-xs">{{ 'account.registration.topbar.link'|trans }}</a>
</span>
{% endblock %}

{% block auth_body %}
<div class="flex flex-col gap-1.5">
    <h1 class="auth-heading">{{ 'account.waitlist.title'|trans }}</h1>
    <p class="auth-subheading">{{ 'account.waitlist.body'|trans }}</p>
</div>

<div class="{{ notify ? 'lp-home-ask' }}">
<turbo-frame id="{{ modal ? 'waitlist-modal' : 'waitlist-notify' }}">
    {% if notify %}
        {% include 'waitlist/_notify_form.html.twig' with {notifyForm: form} only %}
    {% elseif modal %}
        {% include 'waitlist/_modal_form.html.twig' with {modalForm: form} only %}
    {% else %}
    {% do form.picks.setRendered %}
    {% do form.other.setRendered %}
    {{ form_start(form, {'attr': {'class': 'lp-form', 'novalidate': 'novalidate'}}) }}

        <twig:Ds:FormField :fieldView="form.email" :widgetAttr="{ 'placeholder': 'account.form.waitlist_join_form.email.placeholder'}" />

        <twig:Ds:Button variant="primary" size="lg" type="submit" class="lp-auth__action">{{ 'account.waitlist.submit'|trans }}</twig:Ds:Button>

    {{ form_end(form) }}
    {% endif %}
</turbo-frame>
</div>
{% endblock %}
