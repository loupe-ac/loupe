{% extends '@Account/auth_base.html.twig' %}

{% block title %}{{ 'account.waitlist.joined.page.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block auth_body %}
{% if modal %}
<turbo-frame id="waitlist-modal">
    {% include 'waitlist/_modal_joined.html.twig' with {joinForm: joinForm} only %}
</turbo-frame>
{% else %}
<turbo-frame id="waitlist-notify">
    {% include 'waitlist/_notify_joined.html.twig' with {joinForm: joinForm} only %}
</turbo-frame>
{% endif %}
{% endblock %}
