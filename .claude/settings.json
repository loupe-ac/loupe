{
  "skillListingBudgetFraction": 0.02,
  "permissions": {
    "deny": [
      "Read(./terraform/terraform.tfvars)",
      "Read(./terraform/*.tfstate)",
      "Read(./terraform/*.tfstate.*)",
      "Read(./terraform/*.tfplan)",
      "Read(./terraform/.rotate-secrets.tmp.*)",
      "Read(./docker/compose/prod.env)"
    ]
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/worktree-create.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/worktree-remove.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/no-full-e2e.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/no-full-ci.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/no-unsafe-git.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor|Read|Grep|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agents/hooks/no-secret-reads.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
