#!/usr/bin/env bash
#
# Keeps the production deploy secrets in an encrypted sops file and passes them
# to Terraform as TF_VAR_* variables. It never prints a value, also on an error,
# and never puts a value in a process argument.
#
# Usage:
#   bin/tf-secrets exec -- <command>   run a command with the secrets in its environment
#   bin/tf-secrets set <name>          read one value from standard input into the store
#   bin/tf-secrets names               print the names the store holds
#   bin/tf-secrets import              copy each listed secret from terraform.tfvars into the store
#   bin/tf-secrets verify              compare the store with terraform.tfvars
#
# <name> is the environment name from terraform/secrets.list. With no store
# file, exec runs the command unchanged, so an operator with no store keeps
# passing secrets through terraform.tfvars.
#
# Environment, for tests: TF_SECRETS_ROOT is the Terraform folder, and
# TF_SECRETS_STORE, TF_SECRETS_TFVARS and TF_SECRETS_LIST name the three files.

set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
main=$(cd "$(git rev-parse --path-format=absolute --git-common-dir)/.." 2> /dev/null && pwd) || main=$root

TF_SECRETS_ROOT=${TF_SECRETS_ROOT:-$root/terraform}
if [ -z "${TF_SECRETS_TFVARS:-}" ]; then
    TF_SECRETS_TFVARS=$TF_SECRETS_ROOT/terraform.tfvars
    # A worktree has no terraform.tfvars of its own, so fall back to the main checkout.
    [ -f "$TF_SECRETS_TFVARS" ] || TF_SECRETS_TFVARS=$main/terraform/terraform.tfvars
fi
export TF_SECRETS_ROOT TF_SECRETS_TFVARS

# shellcheck source=lib/tf-secrets.sh
. "$root/bin/lib/tf-secrets.sh"

usage() {
    sed -n '3,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
    exit 2
}

cmd_exec() {
    local file arg quoted=""
    [ "${1:-}" = -- ] || usage
    shift
    [ $# -gt 0 ] || usage
    file=$(store_file)
    if [ -z "$file" ]; then
        echo "tf-secrets: no secret store is set up, so the command runs with the environment as is." >&2
        exec "$@"
    fi
    for arg in "$@"; do quoted+=$(printf '%q ' "$arg"); done
    exec sops exec-env "$file" "$quoted"
}

cmd_set() {
    local name=${1:-} value
    [ -n "$name" ] || usage
    [[ $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || ts_fail "'$name' is not an environment name."
    list_pairs | awk -v n="$name" '$2 == n { found = 1 } END { exit !found }' || ts_fail "$name is not in secrets.list."
    value=$(cat; echo x)
    value=${value%x}
    store_set_many "$name" "$value"
    echo "$name: stored"
}

cmd_names() {
    store_names
}

# The provider environment value for an input that terraform.tfvars leaves null.
provider_env_b64() {
    local v
    case $1 in
        do_token) v=${DIGITALOCEAN_TOKEN:-${DIGITALOCEAN_ACCESS_TOKEN:-}} ;;
        spaces_access_id) v=${SPACES_ACCESS_KEY_ID:-} ;;
        spaces_secret_key) v=${SPACES_SECRET_ACCESS_KEY:-} ;;
        *) v= ;;
    esac
    printf '%s' "$v" | openssl base64 -A
}

# The base64 of the value that Terraform uses today, empty when there is none.
file_side() {
    local b64
    b64=$(tfvars_file_b64 "$1") || exit 1
    if [ "$b64" = unset ]; then provider_env_b64 "$1"; else printf '%s' "$b64"; fi
}

cmd_import() {
    local tf env b64 value
    [ -f "$TF_SECRETS_TFVARS" ] || ts_fail "$TF_SECRETS_TFVARS does not exist."
    while read -r tf env; do
        b64=$(file_side "$tf") || exit 1
        if [ -z "$b64" ]; then echo "$env unset"; continue; fi
        value=$(printf '%s' "$b64" | openssl base64 -d -A; echo x)
        store_set_many "$env" "${value%x}"
        echo "$env copied"
    done < <(list_pairs)
}

cmd_verify() {
    local tf env file_b64 store_b status=0
    [ -f "$TF_SECRETS_TFVARS" ] || ts_fail "$TF_SECRETS_TFVARS does not exist."
    [ -n "$(store_file)" ] || ts_fail "no secret store is set up."
    while read -r tf env; do
        file_b64=$(file_side "$tf") || exit 1
        store_b=$(store_b64 "$env")
        if [ -z "$file_b64" ] && [ -z "$store_b" ]; then echo "$env unset"
        elif [ "$file_b64" = "$store_b" ]; then echo "$env same"
        else echo "$env differs"; status=1
        fi
    done < <(list_pairs)
    return "$status"
}

sub=${1:-}
[ $# -eq 0 ] || shift
case $sub in
    exec) cmd_exec "$@" ;;
    set) cmd_set "$@" ;;
    names) cmd_names ;;
    import) cmd_import ;;
    verify) cmd_verify ;;
    *) usage ;;
esac
