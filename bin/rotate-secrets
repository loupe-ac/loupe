#!/usr/bin/env bash
#
# Rotates secrets in terraform/terraform.tfvars, then applies them.
#
# It follows docs/operating/rotating-encryption-key.md for app_encryption_key.
# The script never prints a secret value, not even on an error.
#
# Environment, for tests: ROTATE_TFVARS is the file to edit, ROTATE_TF_ROOT is
# the Terraform root that reads it (default: terraform), and ROTATE_APPLY is the
# command that applies it (default: just tf-apply).
#
# A rotation that stops resumes on the next run. <tfvars>.rotating holds the
# deploy it reached and a SHA-256 of the new key, which tells the two keys apart.

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

TFVARS=${ROTATE_TFVARS:-terraform/terraform.tfvars}
TF_ROOT=${ROTATE_TF_ROOT:-terraform}
APPLY=${ROTATE_APPLY:-just tf-apply}
NAMES=(app_encryption_key app_encryption_key_previous)
WALK=(encryption_key)

fail() { echo "rotate-secrets: $*" >&2; exit 1; }

# The step that owns a secret. A name of a pair maps to the step of its group.
step_of() {
    case $1 in
        app_encryption_key | app_encryption_key_previous) echo encryption_key ;;
        *) return 1 ;;
    esac
}

absolute() { printf '%s/%s' "$(cd "$(dirname "$1")" && pwd)" "$(basename "$1")"; }

# The base64 of a variable's value, empty when it is unset or empty. Terraform
# parses the file, so a heredoc, an escape or an inline comment reads right.
# Terraform prints warnings on standard output, so only the last line counts.
# Standard error is dropped because a parse error quotes the offending line.
tfvars_b64() {
    local name=$1 extra=${2:-} out
    local args=(-no-color "-var-file=$(absolute "$TFVARS")")
    [ -z "$extra" ] || args+=("-var-file=$(absolute "$extra")")
    out=$(TF_INPUT=0 terraform -chdir="$TF_ROOT" console "${args[@]}" 2>/dev/null \
        <<< "nonsensitive(var.$name == null) ? \"unset\" : base64encode(nonsensitive(var.$name))" | tail -n 1) \
        || fail "terraform could not read $name."
    [[ $out =~ ^\"([A-Za-z0-9+/=]*)\"$ ]] || fail "terraform could not read $name."
    [ "${BASH_REMATCH[1]}" != unset ] || return 0
    printf '%s' "${BASH_REMATCH[1]}"
}

# The value of a variable. Only ever captured, never printed. A command
# substitution drops trailing line breaks, so compare with tfvars_b64 instead.
tfvars_value() {
    local b64
    b64=$(tfvars_b64 "$@") || exit 1
    printf '%s' "$b64" | openssl base64 -d -A
}

# Prints "<name>: not set, skipped" and fails when the variable is empty or unset.
skip_if_unset() {
    local b64
    b64=$(tfvars_b64 "$1") || exit 1
    [ -n "$b64" ] || { echo "$1: not set, skipped"; return 1; }
}

TMP=
cleanup() { [ -z "$TMP" ] || rm -f -- "$TMP"; }

# Replaces the live assignments, or appends them, in one rename, so a failed
# write leaves the old file whole. Takes name and value pairs. Each value
# becomes one quoted HCL string on one line, then is read back through
# Terraform. The values reach the tools through the environment, never through
# an argument, so they never appear in a process list.
tfvars_write() {
    local names=() values=() i n enc mode bad=() dir
    while [ $# -gt 1 ]; do names+=("$1"); values+=("$2"); shift 2; done
    n=${#names[@]}
    [ "$n" -gt 0 ] && [ $# -eq 0 ] || fail "tfvars_write takes name and value pairs."
    for ((i = 0; i < n; i++)); do
        case ${values[i]} in
            *$'\b'* | *$'\f'*) fail "the value of ${names[i]} has a backspace or form feed, which HCL cannot escape." ;;
        esac
    done

    dir=$(dirname "$TFVARS")
    TMP=$(mktemp "$dir/.rotate-secrets.tmp.XXXXXX")
    trap cleanup EXIT
    trap 'exit 1' INT TERM HUP

    (
        for ((i = 0; i < n; i++)); do
            enc=$(V=${values[i]} jq -rn 'env.V | tojson' | sed -e 's/\${/$${/g' -e 's/%{/%%{/g')
            export "ROT_NAME_$i=${names[i]}" "ROT_VALUE_$i=$enc"
        done
        ROT_COUNT=$n awk '
            BEGIN {
                n = ENVIRON["ROT_COUNT"]
                for (i = 0; i < n; i++) { name[i] = ENVIRON["ROT_NAME_" i]; value[i] = ENVIRON["ROT_VALUE_" i]; done[i] = 0 }
            }
            term != "" {
                t = $0; gsub(/^[ \t]+|[ \t]+$/, "", t)
                if (t == term) term = ""
                if (!dropping) print
                next
            }
            {
                hit = -1
                for (i = 0; i < n; i++) if ($0 ~ "^[ \t]*" name[i] "[ \t]*=") hit = i
                if (hit >= 0) {
                    if (!done[hit]) { printf "%s = %s\n", name[hit], value[hit]; done[hit] = 1 }
                    dropping = 1
                } else { dropping = 0; print }
                if ($0 ~ /^[ \t]*[A-Za-z0-9_]+[ \t]*=[ \t]*<<-?[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*$/) {
                    term = $0; sub(/^[^<]*<<-?[ \t]*/, "", term); sub(/[ \t]+$/, "", term)
                }
            }
            END { for (i = 0; i < n; i++) if (!done[i]) printf "%s = %s\n", name[i], value[i] }
        ' "$TFVARS" > "$TMP"
    ) || fail "could not write $TFVARS. It is unchanged."

    mode=$(stat -c %a "$TFVARS" 2>/dev/null || stat -f %Lp "$TFVARS")
    chmod "$mode" "$TMP"

    for ((i = 0; i < n; i++)); do
        [ "$(tfvars_b64 "${names[i]}" "$TMP")" = "$(printf '%s' "${values[i]}" | openssl base64 -A)" ] || bad+=("${names[i]}")
    done
    [ ${#bad[@]} -eq 0 ] || fail "${bad[*]} did not read back the same. $TFVARS is unchanged."

    mv -f "$TMP" "$TFVARS"
    TMP=
    trap - EXIT INT TERM HUP
}

fingerprint() { printf '%s' "$1" | openssl dgst -sha256 -r | cut -d' ' -f1; }

apply() {
    echo "-- applying: $1 (terraform masks sensitive values, and asks you to confirm)"
    # shellcheck disable=SC2086
    $APPLY || fail "the apply failed. Run 'just tf-plan' to read the cause."
}

step_encryption_key() {
    local state="$TFVARS.rotating" current previous old new stage=1 hash
    current=$(tfvars_value app_encryption_key)
    previous=$(tfvars_value app_encryption_key_previous)
    [ -n "$current" ] || fail "app_encryption_key is not set in $TFVARS."
    old=$current

    if [ -f "$state" ]; then
        read -r stage hash < "$state"
        if [ "$(fingerprint "$current")" = "$hash" ]; then
            new=$current old=$previous
        elif [ -n "$previous" ] && [ "$(fingerprint "$previous")" = "$hash" ]; then
            new=$previous
        elif [ "$stage" != 1 ]; then
            fail "$state names a new key that $TFVARS does not hold. Read the runbook, and finish by hand."
        fi
        echo "app_encryption_key: resuming a rotation at deploy $stage of 3."
    elif [ -n "$previous" ]; then
        fail "app_encryption_key_previous is set, and no rotation is saved in $state. Read the runbook, and finish by hand."
    fi
    [ "$stage" -ge 3 ] || [ -n "$old" ] || fail "$TFVARS holds the new key but not the old one. Read the runbook, and finish by hand."
    [ -n "${new:-}" ] || new=$(openssl rand -base64 32)
    hash=$(fingerprint "$new")

    if [ "$stage" -le 1 ]; then
        echo "1 $hash" > "$state"
        echo "app_encryption_key: deploy 1 of 3. Every container learns the new key."
        tfvars_write app_encryption_key "$old" app_encryption_key_previous "$new"
        apply "the new key as the previous key"
    fi

    if [ "$stage" -le 2 ]; then
        echo "2 $hash" > "$state"
        echo "app_encryption_key: deploy 2 of 3. The new key encrypts, the old key still decrypts."
        tfvars_write app_encryption_key "$new" app_encryption_key_previous "$old"
        apply "the new key as the current key"

        echo
        echo "Run this on production, then read the table it prints:"
        echo "    bin/console doctrine-extra:reencrypt"
        echo "Every 'unreadable' count must be 0. If one is not, answer no and read the runbook."
        read -r -p "Is every unreadable count 0? Type yes to remove the old key: " answer
        [ "$answer" = "yes" ] || fail "stopped. The old key stays in app_encryption_key_previous. Run this recipe again to resume."
    fi

    echo "3 $hash" > "$state"
    echo "app_encryption_key: deploy 3 of 3. The old key leaves the environment."
    tfvars_write app_encryption_key "$new" app_encryption_key_previous ""
    apply "no previous key"
    rm -f "$state"

    REVOKE+=("The old APP_ENCRYPTION_KEY. Delete every copy of it, and the database dumps made before this rotation.")
}

main() {
    local names=("$@") name step selected=" "
    [ ${#names[@]} -gt 0 ] || names=("${NAMES[@]}")
    [ -f "$TFVARS" ] || fail "$TFVARS does not exist."
    for name in "${names[@]}"; do
        step=$(step_of "$name") || fail "unknown secret '$name'. Known: ${NAMES[*]}"
        selected="$selected$step "
    done

    REVOKE=()
    for step in "${WALK[@]}"; do
        case $selected in *" $step "*) "step_$step" ;; esac
    done

    echo
    echo "Revoke by hand:"
    for item in ${REVOKE[@]+"${REVOKE[@]}"}; do echo "  - $item"; done
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
