#!/usr/bin/env bash
#
# Rotates the production deploy secrets in two phases. A secret listed in
# terraform/secrets.list lives in the secret store (bin/tf-secrets). Every other
# value lives in terraform/terraform.tfvars.
#
# Usage:
#   bin/rotate-secrets [collect] [name | @group ...]
#   bin/rotate-secrets apply [--reencrypted] [--allow <address | field> ...]
#   bin/rotate-secrets discard
#
# collect makes or asks for every new value in one pass, and saves them in a
# pending store next to the live one. The live store and production stay as
# they are. It then offers to start a Claude session, whose project-rotate-secrets
# skill runs apply. With no names it walks every secret except the web push key.
# An impact group, such as @no-relogin, picks every secret whose rotation has
# the same effect. A secret that is empty or unset is skipped.
#
# apply moves the pending values into the live store and applies them. Each
# apply saves a plan, checks that it changes only the app environment variables
# of the rotated secrets, and the export bucket key when that rotates, and
# applies that plan. The encryption key goes first, in three deploys, as
# docs/operating/rotating-encryption-key.md says. apply resumes where it
# stopped. It exits 10 after the second key deploy, until it runs with
# --reencrypted, and 11 when a plan changes another resource or app field,
# until --allow names it. discard deletes the pending values before an apply
# starts, and refuses after.
#
# The script never prints a secret value, not even on an error.
#
# Environment, for tests: ROTATE_TFVARS is the file to edit, ROTATE_TF_ROOT is
# the Terraform root that reads it (default: terraform), ROTATE_PLAN makes a
# plan file (default: just tf-plan), ROTATE_PLAN_SHOW prints it as JSON
# (default: terraform show -json), ROTATE_APPLY applies it (default: just tf-apply),
# ROTATE_SESSION starts the apply session (empty: print the command),
# ROTATE_APP_ID replaces the app_id output, ROTATE_VAPID_CMD makes a web push
# key pair, ROTATE_GITHUB_API is the GitHub API root, and ROTATE_POLL_SECONDS,
# ROTATE_POLL_TIMEOUT, ROTATE_RESEND_SECONDS and ROTATE_RESEND_TIMEOUT set the
# waits. TF_SECRETS_PENDING names the pending store.
#
# <tfvars>.rotating holds the encryption key deploy that a rotation reached and
# a SHA-256 of the new key. .rotate-secrets.webhook-since, next to the tfvars
# file, holds a webhook secret switch that has not finished.

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
ROOT=$(pwd)

TFVARS=${ROTATE_TFVARS:-terraform/terraform.tfvars}
TF_ROOT=${ROTATE_TF_ROOT:-terraform}
# Absolute, because the apply command runs bin/tf-secrets from another folder.
TF_SECRETS_ROOT=$(cd "$TF_ROOT" && pwd)
TF_SECRETS_TFVARS=$(cd "$(dirname "$TFVARS")" && pwd)/$(basename "$TFVARS")
TF_SECRETS_FAIL=fail
export TF_SECRETS_ROOT TF_SECRETS_TFVARS
# shellcheck source=lib/tf-secrets.sh
. bin/lib/tf-secrets.sh
APPLY=${ROTATE_APPLY:-just tf-apply}
PLAN=${ROTATE_PLAN:-just tf-plan}
PLAN_SHOW=${ROTATE_PLAN_SHOW:-terraform -chdir=$TF_SECRETS_ROOT show -json}
SESSION_PROMPT="Use the project-rotate-secrets skill to apply the pending secret rotation."
PENDING=${TF_SECRETS_PENDING:-$TF_SECRETS_ROOT/secrets.pending.enc.yaml}
MANIFEST=$(dirname "$TF_SECRETS_TFVARS")/.rotate-secrets.pending
PENDING_PLAIN=$(dirname "$TF_SECRETS_TFVARS")/.rotate-secrets.tmp.pending.json
ALLOW=()
REENCRYPTED=0
VENDOR=(do_token spaces_access_id spaces_secret_key registry_credentials mailer_dsn stripe_secret_key stripe_webhook_secret
    oauth_google_secret oauth_github_secret github_app_client_secret github_app_private_key
    export_storage_key export_storage_secret site_review_widget_preview_token)
NAMES=(app_encryption_key app_encryption_key_previous app_secret install_token health_probe_token mercure_jwt_secret
    oauth_encryption_key oauth_private_key oauth_private_key_passphrase oauth_public_key export_bucket_key
    github_app_webhook_secret "${VENDOR[@]}" vapid_private_key vapid_public_key)
WALK=(encryption_key app_secret install_token health_probe_token mercure_jwt_secret oauth_encryption_key oauth_keys
    export_bucket_key github_app_webhook_secret "${VENDOR[@]}")
IMPACT_GROUPS=(@no-relogin @relogin-users @relogin-clients)

WEBHOOK_FILE="$(dirname "$TFVARS")/.rotate-secrets.webhook-since"
WEBHOOK_RETRY="Run 'bin/rotate-secrets apply' to finish the switch."
GITHUB_API=${ROTATE_GITHUB_API:-https://api.github.com}
POLL_SECONDS=${ROTATE_POLL_SECONDS:-15}
POLL_TIMEOUT=${ROTATE_POLL_TIMEOUT:-1800}
RESEND_SECONDS=${ROTATE_RESEND_SECONDS:-10}
RESEND_TIMEOUT=${ROTATE_RESEND_TIMEOUT:-120}
VAPID_CMD=${ROTATE_VAPID_CMD:-just exec bin/console app:notifications:generate-keys}

REVOKE=()
WRITES=()
FLAGS=()
REPLACE=()
WEBHOOK_RUN=0

fail() { echo "rotate-secrets: $*" >&2; exit 1; }

# The step that owns a secret. A name of a pair maps to the step of its group.
step_of() {
    local v
    case $1 in
        app_encryption_key | app_encryption_key_previous) echo encryption_key ;;
        oauth_private_key | oauth_private_key_passphrase | oauth_public_key) echo oauth_keys ;;
        vapid_private_key | vapid_public_key) echo vapid ;;
        app_secret | install_token | health_probe_token | mercure_jwt_secret | oauth_encryption_key \
            | export_bucket_key | github_app_webhook_secret) echo "$1" ;;
        *)
            for v in "${VENDOR[@]}"; do
                [ "$v" != "$1" ] || { echo "$1"; return 0; }
            done
            return 1
            ;;
    esac
}

group_steps() {
    case $1 in
        @no-relogin) echo "encryption_key install_token health_probe_token mercure_jwt_secret export_bucket_key github_app_webhook_secret ${VENDOR[*]}" ;;
        @relogin-users) echo app_secret ;;
        @relogin-clients) echo "oauth_encryption_key oauth_keys" ;;
        *) return 1 ;;
    esac
}

# The impact groups that a selection of steps does not hold in full.
groups_left_out() {
    local group step out=()
    for group in "${IMPACT_GROUPS[@]}"; do
        for step in $(group_steps "$group"); do
            case $1 in *" $step "*) ;; *) out+=("$group"); break ;; esac
        done
    done
    echo "${out[*]}"
}

# The base64 of a variable's value, empty when it is unset or empty. A listed
# secret reads from the store when one is set up, and everything else reads
# from the tfvars file through the library.
tfvars_b64() {
    local name=$1 extra=${2:-} ename out
    if [ -z "$extra" ] && [ -n "$(store_file)" ] && ename=$(env_name_of "$name"); then
        store_b64 "$ename"
        return
    fi
    out=$(tfvars_file_b64 "$name" "$extra") || exit 1
    [ "$out" != unset ] || return 0
    printf '%s' "$out"
}

# The value of a variable. Only ever captured, never printed. A command
# substitution drops trailing line breaks, so compare with tfvars_b64 instead.
tfvars_value() {
    local b64
    b64=$(tfvars_b64 "$@") || exit 1
    printf '%s' "$b64" | openssl base64 -d -A
}

# Prints "<name>: not set, skipped" and fails when the variable is empty or unset.
skip_if_unset() {
    local b64
    b64=$(tfvars_b64 "$1") || exit 1
    [ -n "$b64" ] || { echo "$1: not set, skipped"; return 1; }
}

TMP=
cleanup() { [ -z "$TMP" ] || rm -f -- "$TMP"; }

# Writes name and value pairs. A listed secret goes to the store when one is
# set up, and the rest go to the tfvars file. The store write runs first, so a
# failed file write leaves a new secret in the store and no apply has run.
tfvars_write() {
    local to_store=() to_file=() ename
    while [ $# -gt 1 ]; do
        if [ -n "$(store_file)" ] && ename=$(env_name_of "$1"); then to_store+=("$ename" "$2"); else to_file+=("$1" "$2"); fi
        shift 2
    done
    [ $# -eq 0 ] || fail "tfvars_write takes name and value pairs."
    if [ ${#to_store[@]} -gt 0 ]; then store_set_many "${to_store[@]}"; fi
    if [ ${#to_file[@]} -gt 0 ]; then tfvars_file_write "${to_file[@]}"; fi
}

# Replaces the live assignments, or appends them, in one rename, so a failed
# write leaves the old file whole. Takes name and value pairs. Each value
# becomes one quoted HCL string on one line, then is read back through
# Terraform. The values reach the tools through the environment, never through
# an argument, so they never appear in a process list.
tfvars_file_write() {
    local names=() values=() i n enc mode bad=() dir
    while [ $# -gt 1 ]; do names+=("$1"); values+=("$2"); shift 2; done
    n=${#names[@]}
    [ "$n" -gt 0 ] && [ $# -eq 0 ] || fail "tfvars_file_write takes name and value pairs."
    for ((i = 0; i < n; i++)); do
        case ${values[i]} in
            *$'\b'* | *$'\f'*) fail "the value of ${names[i]} has a backspace or form feed, which HCL cannot escape." ;;
        esac
    done

    dir=$(dirname "$TFVARS")
    TMP=$(mktemp "$dir/.rotate-secrets.tmp.XXXXXX")
    trap cleanup EXIT
    trap 'exit 1' INT TERM HUP

    (
        for ((i = 0; i < n; i++)); do
            enc=$(V=${values[i]} jq -rn 'env.V | tojson' | sed -e 's/\${/$${/g' -e 's/%{/%%{/g')
            export "ROT_NAME_$i=${names[i]}" "ROT_VALUE_$i=$enc"
        done
        ROT_COUNT=$n awk '
            BEGIN {
                n = ENVIRON["ROT_COUNT"]
                for (i = 0; i < n; i++) { name[i] = ENVIRON["ROT_NAME_" i]; value[i] = ENVIRON["ROT_VALUE_" i]; done[i] = 0 }
            }
            term != "" {
                t = $0; gsub(/^[ \t]+|[ \t]+$/, "", t)
                if (t == term) term = ""
                if (!dropping) print
                next
            }
            {
                hit = -1
                for (i = 0; i < n; i++) if ($0 ~ "^[ \t]*" name[i] "[ \t]*=") hit = i
                if (hit >= 0) {
                    if (!done[hit]) { printf "%s = %s\n", name[hit], value[hit]; done[hit] = 1 }
                    dropping = 1
                } else { dropping = 0; print }
                if ($0 ~ /^[ \t]*[A-Za-z0-9_]+[ \t]*=[ \t]*<<-?[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*$/) {
                    term = $0; sub(/^[^<]*<<-?[ \t]*/, "", term); sub(/[ \t]+$/, "", term)
                }
            }
            END { for (i = 0; i < n; i++) if (!done[i]) printf "%s = %s\n", name[i], value[i] }
        ' "$TFVARS" > "$TMP"
    ) || fail "could not write $TFVARS. It is unchanged."

    mode=$(stat -c %a "$TFVARS" 2>/dev/null || stat -f %Lp "$TFVARS")
    chmod "$mode" "$TMP"

    for ((i = 0; i < n; i++)); do
        [ "$(tfvars_b64 "${names[i]}" "$TMP")" = "$(printf '%s' "${values[i]}" | openssl base64 -A)" ] || bad+=("${names[i]}")
    done
    [ ${#bad[@]} -eq 0 ] || fail "${bad[*]} did not read back the same. $TFVARS is unchanged."

    mv -f "$TMP" "$TFVARS"
    TMP=
    trap - EXIT INT TERM HUP
}

fingerprint() { printf '%s' "$1" | openssl dgst -sha256 -r | cut -d' ' -f1; }

print_revoke() {
    local item
    echo
    if [ ${#REVOKE[@]} -eq 0 ]; then echo "Nothing to revoke by hand."; return 0; fi
    echo "Revoke by hand:"
    for item in "${REVOKE[@]}"; do echo "  - $item"; done
}

PLAN_FILE=
plan_cleanup() { [ -z "$PLAN_FILE" ] || rm -f -- "$PLAN_FILE"; }

# Prints "resource <address> <actions>" for each change, except an update of the
# app, which prints "field <name>" for each changed field of its spec instead.
# An environment variable is one field, spec.<path>.env.<KEY>, in any order.
# shellcheck disable=SC2016
PLAN_CHANGES='
def norm: if type == "object" then with_entries(if .key == "env" and (.value | type) == "array"
        then .value |= (map({(.key): .}) | add // {}) else .value |= norm end)
    elif type == "array" then map(norm) else . end;
def field_name: map(select(type == "string")) | index("env") as $i | (if $i == null then . else .[: $i + 2] end) | join(".");
.resource_changes[]
| select(.change.actions != ["no-op"])
| if .address == "module.app.digitalocean_app.app" and .change.actions == ["update"] then
    (.change.before.spec | norm) as $b | (.change.after.spec | norm) as $a
    | [[$b, $a][] | paths(type != "object" and type != "array")] | unique[]
    | . as $p
    | select((try ($b | getpath($p)) catch "unreadable") != (try ($a | getpath($p)) catch "unreadable"))
    | "field spec." + field_name
  else "resource " + .address + " " + (.change.actions | join(",")) end'

# The app environment variables that the secrets of this rotation feed.
ROTATED_ENV=()
rotated_env_add() {
    local name key
    for name in "$@"; do
        key=$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')
        ROTATED_ENV+=("$key")
        [ "$name" != mercure_jwt_secret ] || ROTATED_ENV+=(MERCURE_PUBLISHER_JWT_KEY MERCURE_SUBSCRIBER_JWT_KEY)
    done
}

field_allowed() {
    local key
    case $1 in *.registry_credentials) for key in ${ROTATED_ENV[@]+"${ROTATED_ENV[@]}"}; do [ "$key" != REGISTRY_CREDENTIALS ] || return 0; done ;; esac
    case $1 in *.env.*) ;; *) return 1 ;; esac
    for key in ${ROTATED_ENV[@]+"${ROTATED_ENV[@]}"}; do [ "${1##*.env.}" != "$key" ] || return 0; done
    return 1
}

# Exits 11 with the names when the plan changes more than the rotated secrets: a
# resource other than the app and the rotated export bucket key, or an app field
# other than the environment variables of the rotated secrets.
check_plan() {
    local changes kind name actions bad=() allowed a
    changes=$($PLAN_SHOW "$1" | jq -r "$PLAN_CHANGES") || fail "could not read the plan."
    while read -r kind name actions; do
        [ -n "$kind" ] || continue
        allowed=0
        if [ "$kind" = field ]; then
            ! field_allowed "$name" || allowed=1
            for a in ${ALLOW[@]+"${ALLOW[@]}"}; do [ "$a" != module.app.digitalocean_app.app ] || allowed=1; done
        else
            case "$name $actions" in
                "digitalocean_spaces_key.exports[0] delete,create" | "digitalocean_spaces_key.exports[0] create,delete")
                    [ ${#REPLACE[@]} -eq 0 ] || allowed=1 ;;
            esac
        fi
        for a in ${ALLOW[@]+"${ALLOW[@]}"}; do [ "$a" != "$name" ] || allowed=1; done
        [ "$allowed" = 1 ] || bad+=("$name${actions:+ $actions}")
    done <<< "$(printf '%s\n' "$changes" | sort -u)"
    if [ ${#bad[@]} -gt 0 ]; then
        echo "rotate-secrets: the plan changes more than the rotated secrets:" >&2
        for a in "${bad[@]}"; do echo "  $a" >&2; done
        echo "rotate-secrets: nothing was applied. Run 'bin/rotate-secrets apply --allow <name>' for each one you accept." >&2
        exit 11
    fi
}

apply() {
    local label=$1 cmd
    shift
    echo "-- applying: $label"
    # Absolute, because just tf-plan and just tf-apply run in the Terraform root.
    PLAN_FILE=$(mktemp "$(dirname "$TF_SECRETS_TFVARS")/.rotate-secrets.tmp.plan.XXXXXX")
    trap plan_cleanup EXIT
    read -ra cmd <<< "$PLAN"
    "${cmd[@]}" -input=false -out="$PLAN_FILE" ${1+"$@"} > /dev/null || {
        print_revoke
        fail "the plan failed. Run 'just tf-plan' to read the cause."
    }
    check_plan "$PLAN_FILE"
    read -ra cmd <<< "$APPLY"
    "${cmd[@]}" "$PLAN_FILE" || {
        print_revoke
        if [ "$WEBHOOK_RUN" = 1 ]; then
            fail "the apply failed. Fix the cause. $WEBHOOK_RETRY"
        fi
        fail "the apply failed. Run 'just tf-plan' to read the cause."
    }
    plan_cleanup
    PLAN_FILE=
    trap - EXIT
}

step_encryption_key() {
    local state="$TFVARS.rotating" current previous old new stage=1 hash
    current=$(tfvars_value app_encryption_key)
    previous=$(tfvars_value app_encryption_key_previous)
    [ -n "$current" ] || fail "app_encryption_key is not set in $TFVARS."
    old=$current

    if [ -f "$state" ]; then
        read -r stage hash < "$state"
        if [ "$(fingerprint "$current")" = "$hash" ]; then
            new=$current old=$previous
        elif [ -n "$previous" ] && [ "$(fingerprint "$previous")" = "$hash" ]; then
            new=$previous
        elif [ "$stage" != 1 ]; then
            fail "$state names a new key that $TFVARS does not hold. Read the runbook, and finish by hand."
        fi
        echo "app_encryption_key: resuming a rotation at deploy $stage of 3."
    elif [ -n "$previous" ]; then
        fail "app_encryption_key_previous is set, and no rotation is saved in $state. Read the runbook, and finish by hand."
    fi
    [ "$stage" -ge 3 ] || [ -n "$old" ] || fail "$TFVARS holds the new key but not the old one. Read the runbook, and finish by hand."
    [ -n "${new:-}" ] || new=$(pending_value app_encryption_key)
    [ -n "$new" ] || fail "the pending store holds no new app_encryption_key. Run 'bin/rotate-secrets discard', then collect again."
    hash=$(fingerprint "$new")

    if [ "$stage" -le 1 ]; then
        echo "1 $hash" > "$state"
        echo "app_encryption_key: deploy 1 of 3. Every container learns the new key."
        tfvars_write app_encryption_key "$old" app_encryption_key_previous "$new"
        apply "the new key as the previous key"
    fi

    # --reencrypted counts only for a deploy 2 that an earlier run made.
    if [ "$stage" -lt 2 ] || { [ "$stage" -eq 2 ] && [ "$REENCRYPTED" != 1 ]; }; then
        echo "2 $hash" > "$state"
        echo "app_encryption_key: deploy 2 of 3. The new key encrypts, the old key still decrypts."
        tfvars_write app_encryption_key "$new" app_encryption_key_previous "$old"
        apply "the new key as the current key"

        echo
        echo "Run this on production, then read the table it prints:"
        echo "    bin/console doctrine-extra:reencrypt"
        echo "When every 'unreadable' count is 0, run 'bin/rotate-secrets apply --reencrypted' to remove the old key."
        echo "If one is not 0, read docs/operating/rotating-encryption-key.md. The old key stays in app_encryption_key_previous."
        exit 10
    fi

    echo "3 $hash" > "$state"
    echo "app_encryption_key: deploy 3 of 3. The old key leaves the environment."
    tfvars_write app_encryption_key "$new" app_encryption_key_previous ""
    apply "no previous key"
    rm -f "$state"

    REVOKE+=("The old APP_ENCRYPTION_KEY. Delete every copy of it, and the database dumps made before this rotation.")
}

# Makes the new key, unless a rotation already saved its own in the state file.
collect_encryption_key() {
    local current previous
    if [ -f "$TFVARS.rotating" ]; then
        echo "app_encryption_key: a rotation is in progress. apply resumes it."
        FLAGS+=(encryption_key)
        return 0
    fi
    current=$(tfvars_b64 app_encryption_key) || exit 1
    previous=$(tfvars_b64 app_encryption_key_previous) || exit 1
    [ -n "$current" ] || fail "app_encryption_key is not set in $TFVARS."
    [ -z "$previous" ] || fail "app_encryption_key_previous is set, and no rotation is saved in $TFVARS.rotating. Read the runbook, and finish by hand."
    WRITES+=(app_encryption_key "$(openssl rand -base64 32)")
    FLAGS+=(encryption_key)
    echo "app_encryption_key: made a new key. It takes three deploys."
}

generate() {
    skip_if_unset "$1" || return 0
    WRITES+=("$1" "$(openssl rand -hex "$2")")
}

step_oauth_keys() {
    local pass="" key pub
    skip_if_unset oauth_private_key || return 0
    [ -z "$(tfvars_b64 oauth_private_key_passphrase)" ] || pass=$(openssl rand -hex 32)
    if [ -n "$pass" ]; then
        key=$(P=$pass openssl genrsa -aes256 -passout env:P 2048 2>/dev/null; echo x)
    else
        key=$(openssl genrsa 2048 2>/dev/null; echo x)
    fi
    key=${key%x}
    case $key in *"-----BEGIN "*) ;; *) fail "openssl could not make an OAuth key." ;; esac
    pub=$(printf '%s' "$key" | P=$pass openssl rsa -pubout -passin env:P 2>/dev/null; echo x)
    pub=${pub%x}
    case $pub in *"-----BEGIN PUBLIC KEY-----"*) ;; *) fail "openssl could not read the public half of the OAuth key." ;; esac
    WRITES+=(oauth_private_key "$key" oauth_public_key "$pub")
    [ -z "$pass" ] || WRITES+=(oauth_private_key_passphrase "$pass")
}

step_export_bucket_key() {
    if [ "$(tfvars_value create_export_bucket)" != true ]; then
        echo "export_bucket_key: create_export_bucket is false, skipped"
        return 0
    fi
    REPLACE+=("-replace=digitalocean_spaces_key.exports[0]")
    echo "export_bucket_key: the apply makes a new bucket key."
}

step_vapid() {
    local out pub priv cmd
    skip_if_unset vapid_private_key || return 0
    read -ra cmd <<< "$VAPID_CMD"
    out=$("${cmd[@]}") || fail "the key command failed."
    pub=$(printf '%s\n' "$out" | tr -d '\r' | sed -n 's/^VAPID_PUBLIC_KEY=//p')
    priv=$(printf '%s\n' "$out" | tr -d '\r' | sed -n 's/^VAPID_PRIVATE_KEY=//p')
    [ -n "$pub" ] && [ -n "$priv" ] || fail "the key command did not print a key pair."
    WRITES+=(vapid_private_key "$priv" vapid_public_key "$pub")
    echo "vapid_private_key: made a new pair. Every push subscription stops."
}

VENDOR_URL=
VENDOR_NOTE=
vendor_page() {
    VENDOR_URL=
    VENDOR_NOTE="make a new value at the vendor."
    case $1 in
        do_token) VENDOR_URL=https://cloud.digitalocean.com/account/api/tokens; VENDOR_NOTE="make a new token with full access, or with custom scopes: app and database (all), project (read, update, assign_resource), spaces_key (all), regions:read." ;;
        spaces_access_id | spaces_secret_key) VENDOR_URL=https://cloud.digitalocean.com/account/api/spaces ;;
        registry_credentials) VENDOR_URL=https://github.com/settings/tokens; VENDOR_NOTE="make a new token with read:packages. Type it as user:token." ;;
        stripe_secret_key) VENDOR_URL=https://dashboard.stripe.com/apikeys ;;
        stripe_webhook_secret) VENDOR_URL=https://dashboard.stripe.com/webhooks ;;
        oauth_google_secret) VENDOR_URL=https://console.cloud.google.com/apis/credentials ;;
        oauth_github_secret) VENDOR_URL=https://github.com/settings/developers ;;
        github_app_client_secret) VENDOR_URL=https://github.com/settings/apps ;;
        github_app_private_key) VENDOR_URL=https://github.com/settings/apps; VENDOR_NOTE="make a new private key. Paste it and end with a line that holds only a period, or type the path of the file." ;;
        mailer_dsn) VENDOR_NOTE="make a new SMTP password at your mail provider." ;;
        site_review_widget_preview_token) VENDOR_NOTE="issue a new token with the loupe CLI." ;;
    esac
}

announce() {
    vendor_page "$1"
    echo "$1: $VENDOR_NOTE"
    [ -z "$VENDOR_URL" ] || echo "  $VENDOR_URL"
}

revoke_line() {
    vendor_page "$1"
    case $1 in
        github_app_private_key) echo "The old GitHub App private key. Delete it on the App page, $VENDOR_URL" ;;
        registry_credentials) echo "The old GHCR token. Delete it at $VENDOR_URL" ;;
        mailer_dsn) echo "The old mail password of mailer_dsn. Delete it at your mail provider." ;;
        *) echo "The old value of $1. Revoke it${VENDOR_URL:+ at $VENDOR_URL}." ;;
    esac
}

# Sets SECRET. A multi-line value ends at a line that holds only a period, or
# is the content of a file whose path is the first line.
read_secret() {
    local multi=$2 line
    SECRET=
    printf '%s: new value (hidden): ' "$1" >&2
    IFS= read -rs line || true
    [ ! -t 0 ] || echo >&2
    if [ "$multi" = multi ]; then
        if [ -f "$line" ]; then
            SECRET=$(cat -- "$line"; echo x)
            SECRET=${SECRET%x}
            return 0
        fi
        while [ "$line" != . ]; do
            SECRET="$SECRET$line"$'\n'
            IFS= read -rs line || break
        done
    else
        SECRET=$line
    fi
}

shape_fail() { fail "the new value for $1 $2. Nothing was changed."; }

check_shape() {
    local name=$1 value=$2 plain
    [ -n "$value" ] || shape_fail "$name" "is empty"
    plain=${value//$'\n'/}
    plain=${plain//$'\t'/}
    case $plain in *[[:cntrl:]]*) shape_fail "$name" "has a control character" ;; esac
    case $name in
        github_app_private_key)
            case $value in *"-----BEGIN "*) ;; *) shape_fail "$name" "is not a PEM key" ;; esac
            ;;
        registry_credentials)
            [[ $value =~ ^[^:[:space:]]+:[^[:space:]]+$ ]] || shape_fail "$name" "needs the form user:token"
            ;;
    esac
}

step_vendor() {
    local name=$1 shape=single
    skip_if_unset "$name" || return 0
    announce "$name"
    [ "$name" != github_app_private_key ] || shape=multi
    read_secret "$name" "$shape"
    check_shape "$name" "$SECRET"
    WRITES+=("$name" "$SECRET")
    SECRET=
    REVOKE+=("$(revoke_line "$name")")
}

step_mailer_dsn() {
    local current head tail enc
    local re='^([A-Za-z][A-Za-z0-9+.-]*://[^:/@]+:)[^@]*(@.*)$'
    skip_if_unset mailer_dsn || return 0
    current=$(tfvars_value mailer_dsn)
    if ! [[ $current =~ $re ]]; then
        echo "mailer_dsn: the DSN has no password, skipped"
        return 0
    fi
    head=${BASH_REMATCH[1]}
    tail=${BASH_REMATCH[2]}
    announce mailer_dsn
    read_secret "mailer_dsn password" single
    check_shape mailer_dsn "$SECRET"
    enc=$(P=$SECRET jq -rn 'env.P | @uri')
    SECRET=
    WRITES+=(mailer_dsn "$head$enc$tail")
    REVOKE+=("$(revoke_line mailer_dsn)")
}

step_github_app_webhook_secret() {
    skip_if_unset github_app_webhook_secret || return 0
    [ -n "$(tfvars_b64 github_app_id)" ] && [ -n "$(tfvars_b64 github_app_private_key)" ] \
        || fail "github_app_id and github_app_private_key must be set to switch the webhook secret at GitHub."
    WRITES+=(github_app_webhook_secret "$(openssl rand -hex 32)")
    FLAGS+=(webhook)
}

now_epoch() { date -u +%s; }

to_epoch() {
    T=$1 jq -rn 'env.T | fromdateiso8601' 2> /dev/null || fail "'$1' is not a time."
}

app_id() {
    if [ -n "${ROTATE_APP_ID:-}" ]; then printf '%s' "$ROTATE_APP_ID"; return 0; fi
    terraform -chdir="$TF_ROOT" output -raw app_id 2> /dev/null || fail "terraform could not read the app_id output."
}

active_deployment() {
    local app out
    app=$(app_id) || exit 1
    out=$(doctl apps get "$app" --format ActiveDeployment.ID --no-header 2> /dev/null) \
        || fail "doctl could not read the active deployment."
    printf '%s' "$out" | tr -d '[:space:]'
}

# Lines: start time, phase (applying or applied), active deployment before the apply.
webhook_file_write() {
    printf '%s\n%s\n%s\n' "$1" "$2" "$3" > "$WEBHOOK_FILE.tmp"
    mv -f "$WEBHOOK_FILE.tmp" "$WEBHOOK_FILE"
}

WH_START=
WH_PHASE=
WH_RECORDED=
webhook_load() {
    { IFS= read -r WH_START; IFS= read -r WH_PHASE; IFS= read -r WH_RECORDED || true; } < "$WEBHOOK_FILE"
    case $WH_PHASE in applying | applied) ;; *) fail "$WEBHOOK_FILE is not readable. Delete it after you check the GitHub App by hand." ;; esac
}

wait_for_deployment() {
    local recorded=$1 since=$2 app active deps created bad end
    app=$(app_id) || exit 1
    end=$((SECONDS + POLL_TIMEOUT))
    echo "github_app_webhook_secret: waiting for a new deployment to become active."
    while :; do
        active=$(active_deployment)
        deps=$(doctl apps list-deployments "$app" -o json 2> /dev/null) \
            || fail "doctl could not list the deployments. $WEBHOOK_RETRY"
        if [ -n "$active" ] && [ "$active" != "$recorded" ]; then
            created=$(printf '%s' "$deps" | A=$active jq -r '[.[] | select(.id == env.A) | .created_at | sub("\\.[0-9]+"; "") | fromdateiso8601][0] // 0')
            [ "$created" -lt "$since" ] || return 0
        fi
        bad=$(printf '%s' "$deps" | S=$since jq -r '
            map(select((.created_at | sub("\\.[0-9]+"; "") | fromdateiso8601) >= (env.S | tonumber)))
            | sort_by(.created_at) | last // empty
            | select(.phase == "ERROR" or .phase == "CANCELED") | .id + " " + .phase')
        [ -z "$bad" ] || fail "deployment ${bad% *} ended in ${bad#* }. Fix the cause. $WEBHOOK_RETRY"
        [ "$SECONDS" -lt "$end" ] || fail "no new deployment became active within ${POLL_TIMEOUT}s. $WEBHOOK_RETRY"
        sleep "$POLL_SECONDS"
    done
}

GH_ID=
GH_KEY=
github_load() {
    GH_ID=$(tfvars_value github_app_id)
    GH_KEY=$(tfvars_value github_app_private_key)
    [ -n "$GH_ID" ] && [ -n "$GH_KEY" ] || fail "github_app_id and github_app_private_key must be set."
}

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

github_jwt() {
    local now header payload sig
    now=$(now_epoch)
    header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
    payload=$(N=$now I=$GH_ID jq -cn '{iat: (env.N | tonumber - 60), exp: (env.N | tonumber + 540), iss: env.I}' | b64url)
    sig=$(printf '%s' "$header.$payload" | openssl dgst -sha256 -sign <(printf '%s' "$GH_KEY") 2> /dev/null | b64url) \
        || fail "could not sign the GitHub App token. Check github_app_private_key."
    printf '%s.%s.%s' "$header" "$payload" "$sig"
}

# Prints the whole response, headers first. The third argument is a secret for the PATCH body.
gh_call() {
    local method=$1 url=$2 secret=${3:-}
    if [ -n "$secret" ]; then
        curl -sS -f -i -X "$method" \
            -H @<(printf 'Authorization: Bearer %s' "$(github_jwt)") \
            -H 'Accept: application/vnd.github+json' -H 'X-GitHub-Api-Version: 2022-11-28' \
            --data-binary @<(S=$secret jq -cn '{secret: env.S}') "$url"
    else
        curl -sS -f -i -X "$method" \
            -H @<(printf 'Authorization: Bearer %s' "$(github_jwt)") \
            -H 'Accept: application/vnd.github+json' -H 'X-GitHub-Api-Version: 2022-11-28' "$url"
    fi || { echo "rotate-secrets: GitHub refused $method ${url#"$GITHUB_API"}." >&2; return 1; }
}

# The deliveries since an epoch time, as one JSON array, page by page.
deliveries_since() {
    local since=$1 url="$GITHUB_API/app/hook/deliveries?per_page=100" resp headers body all='[]' next old
    while [ -n "$url" ]; do
        resp=$(gh_call GET "$url") || return 1
        headers=${resp%%$'\r\n\r\n'*}
        body=${resp#*$'\r\n\r\n'}
        all=$(printf '%s\n%s' "$all" "$body" | jq -cs 'add')
        old=$(printf '%s' "$body" | S=$since jq -r 'map(select((.delivered_at | sub("\\.[0-9]+"; "") | fromdateiso8601) < (env.S | tonumber))) | length')
        next=
        if [ "$old" = 0 ]; then
            next=$(printf '%s' "$headers" | tr -d '\r' | sed -n 's/^[Ll][Ii][Nn][Kk]:.*<\([^>]*\)>; *rel="next".*/\1/p')
        fi
        case $next in
            "") url= ;;
            "$GITHUB_API"/*) url=$next ;;
            *) echo "rotate-secrets: GitHub sent a next page on another host." >&2; return 1 ;;
        esac
    done
    printf '%s' "$all"
}

# The newest delivery id of each event since an epoch time that has no status_code from 200 to 399.
undelivered() {
    printf '%s' "$1" | S=$2 jq -r '
        map(select((.delivered_at | sub("\\.[0-9]+"; "") | fromdateiso8601) >= (env.S | tonumber)))
        | group_by(.guid)
        | map(select(all(.[]; (.status_code // 0) < 200 or (.status_code // 0) >= 400)) | (sort_by(.delivered_at, .id) | last | .id))
        | .[]'
}

recover_deliveries() {
    local since=$1 all ids id n end
    all=$(deliveries_since "$since") || fail "could not list the webhook deliveries. $WEBHOOK_RETRY"
    ids=$(undelivered "$all" "$since")
    if [ -z "$ids" ]; then
        echo "github_app_webhook_secret: no failed events to send again."
        return 0
    fi
    n=$(printf '%s\n' "$ids" | wc -l | tr -d ' ')
    echo "github_app_webhook_secret: sending $n failed event(s) again."
    for id in $ids; do
        gh_call POST "$GITHUB_API/app/hook/deliveries/$id/attempts" > /dev/null || true
    done
    end=$((SECONDS + RESEND_TIMEOUT))
    while :; do
        sleep "$RESEND_SECONDS"
        all=$(deliveries_since "$since") || fail "could not list the webhook deliveries. $WEBHOOK_RETRY"
        ids=$(undelivered "$all" "$since")
        if [ -z "$ids" ]; then
            echo "github_app_webhook_secret: every failed event arrived."
            return 0
        fi
        [ "$SECONDS" -lt "$end" ] || break
    done
    n=$(printf '%s\n' "$ids" | wc -l | tr -d ' ')
    fail "$n event(s) are still not delivered. $WEBHOOK_RETRY"
}

webhook_switch() {
    local secret
    webhook_load
    secret=$(tfvars_value github_app_webhook_secret)
    [ -n "$secret" ] || fail "github_app_webhook_secret is not set in $TFVARS."
    github_load
    gh_call PATCH "$GITHUB_API/app/hook/config" "$secret" > /dev/null || fail "GitHub did not take the new webhook secret. $WEBHOOK_RETRY"
    echo "github_app_webhook_secret: GitHub signs with the new secret."
    recover_deliveries "$(to_epoch "$WH_START")"
    rm -f "$WEBHOOK_FILE"
}

webhook_after_apply() {
    webhook_load
    wait_for_deployment "$WH_RECORDED" "$(to_epoch "$WH_START")"
    webhook_file_write "$WH_START" applied "$WH_RECORDED"
    webhook_switch
}

webhook_begin() {
    local recorded
    recorded=$(active_deployment)
    webhook_file_write "$(date -u +%Y-%m-%dT%H:%M:%SZ)" applying "$recorded"
}

webhook_resume() {
    webhook_load
    WEBHOOK_RUN=1
    if [ $(($(now_epoch) - $(to_epoch "$WH_START"))) -gt 259200 ]; then
        echo "rotate-secrets: the switch started at $WH_START, more than 3 days ago. GitHub sends again only the last 3 days, so older failed events stay lost." >&2
    fi
    echo "github_app_webhook_secret: finishing the switch that started at $WH_START ($WH_PHASE)."
    if [ "$WH_PHASE" = applying ]; then
        apply "the pending webhook secret" ${REPLACE[@]+"${REPLACE[@]}"}
        webhook_after_apply
    else
        webhook_switch
    fi
    WEBHOOK_RUN=0
}

run_step() {
    case $1 in
        encryption_key) collect_encryption_key ;;
        app_secret)
            skip_if_unset app_secret || return 0
            WRITES+=(app_secret "$(openssl rand -hex 16)")
            FLAGS+=(app_secret)
            ;;
        install_token | health_probe_token | mercure_jwt_secret | oauth_encryption_key) generate "$1" 32 ;;
        oauth_keys) step_oauth_keys ;;
        export_bucket_key) step_export_bucket_key ;;
        github_app_webhook_secret) step_github_app_webhook_secret ;;
        mailer_dsn) step_mailer_dsn ;;
        vapid) step_vapid ;;
        *) step_vendor "$1" ;;
    esac
}

# The pending values wait in a second sops store next to the live one. With no
# live store, they wait in a plain file as private as the tfvars file.
pending_plain() { [ -z "$(store_file)" ]; }

# The value of a pending secret, trailing line breaks kept. Only ever captured.
pending_value() {
    local v
    if pending_plain; then
        [ -f "$PENDING_PLAIN" ] || return 0
        N=$1 jq -j '.[env.N] // empty' "$PENDING_PLAIN"
        return 0
    fi
    [ -f "$PENDING" ] || return 0
    v=$(store_b64 "$1" "$PENDING" | openssl base64 -d -A; echo x)
    printf '%s' "${v%x}"
}

pending_save() {
    local tmp json='{}'
    if pending_plain; then
        while [ $# -gt 1 ]; do
            json=$(N=$1 V=$2 jq -c '. + {(env.N): env.V}' <<< "$json")
            shift 2
        done
        tmp=$(mktemp "$(dirname "$TFVARS")/.rotate-secrets.tmp.XXXXXX")
        chmod 600 "$tmp"
        printf '%s' "$json" > "$tmp"
        mv -f "$tmp" "$PENDING_PLAIN"
        return 0
    fi
    (
        export TF_SECRETS_LIVE_STORE=${TF_SECRETS_STORE:-} TF_SECRETS_STORE=$PENDING
        store_set_many "$@"
    )
}

pending_drop() { rm -f -- "$PENDING" "$PENDING_PLAIN" "$MANIFEST"; }

manifest_add() { printf '%s %s\n' "$1" "$2" >> "$MANIFEST"; }
manifest_has() { [ -f "$MANIFEST" ] && grep -qxF "$1 $2" "$MANIFEST"; }
manifest_list() { [ -f "$MANIFEST" ] || return 0; awk -v k="$1" '$1 == k { sub(/^[^ ]+ /, ""); print }' "$MANIFEST"; }

collect_main() {
    local names=("$@") name step steps selected=" " all=0 left_out i secrets=() answer cmd
    [ ! -f "$MANIFEST" ] || fail "a rotation is pending. Run 'bin/rotate-secrets apply' to finish it, or 'bin/rotate-secrets discard'."
    [ ! -f "$WEBHOOK_FILE" ] || fail "a webhook secret switch is pending. Run 'bin/rotate-secrets apply' to finish it first."
    if [ ${#names[@]} -eq 0 ]; then
        all=1
        selected=" ${WALK[*]} "
    else
        for name in "${names[@]}"; do
            if [[ $name == @* ]]; then
                steps=$(group_steps "$name") || fail "unknown group '$name'. Groups: ${IMPACT_GROUPS[*]}"
            else
                steps=$(step_of "$name") || fail "unknown secret '$name'. Known: ${NAMES[*]}"
            fi
            selected="$selected$steps "
        done
    fi
    left_out=$(groups_left_out "$selected")
    if [ -f "$TFVARS.rotating" ]; then
        case $selected in *" encryption_key "*) ;; *) selected=" encryption_key${selected}" ;; esac
    fi

    for step in "${WALK[@]}" vapid; do
        case $selected in *" $step "*) run_step "$step" ;; esac
    done

    if [ "$all" = 1 ]; then
        echo "vapid_private_key: skipped, rotate it by name; every push subscription stops"
    fi
    if [ ${#WRITES[@]} -eq 0 ] && [ ${#REPLACE[@]} -eq 0 ] && [ ${#FLAGS[@]} -eq 0 ]; then
        echo "Nothing to rotate."
        [ -z "$left_out" ] || echo "Not rotated in full: $left_out"
        return 0
    fi

    if [ ${#WRITES[@]} -gt 0 ]; then pending_save "${WRITES[@]}"; fi
    : > "$MANIFEST"
    for ((i = 0; i < ${#WRITES[@]}; i += 2)); do
        secrets+=("${WRITES[i]}")
        manifest_add secret "${WRITES[i]}"
    done
    for i in ${FLAGS[@]+"${FLAGS[@]}"}; do manifest_add flag "$i"; done
    for i in ${REPLACE[@]+"${REPLACE[@]}"}; do manifest_add replace "$i"; done
    for i in ${REVOKE[@]+"${REVOKE[@]}"}; do manifest_add revoke "$i"; done

    echo
    echo "Collected, and not applied yet: ${secrets[*]:-}${REPLACE[*]:+ ${REPLACE[*]}}"
    [ -z "$left_out" ] || echo "Not rotated in full: $left_out"
    if [ "${ROTATE_SESSION+set}" = set ] && [ -z "$ROTATE_SESSION" ]; then
        echo "To apply them, run: claude \"$SESSION_PROMPT\""
        return 0
    fi
    read -r -p "Start a Claude session that applies them now? [y/N] " answer || answer=
    case $answer in
        y | Y | yes) ;;
        *)
            echo "Nothing was applied. Later, run: claude \"$SESSION_PROMPT\""
            echo "To drop the new values, run: bin/rotate-secrets discard"
            return 0
            ;;
    esac
    read -ra cmd <<< "${ROTATE_SESSION:-claude}"
    exec "${cmd[@]}" "$SESSION_PROMPT"
}

apply_main() {
    local pairs=() name value flag
    while [ $# -gt 0 ]; do
        case $1 in
            --reencrypted) REENCRYPTED=1; shift ;;
            --allow) [ $# -ge 2 ] || fail "--allow takes a resource address or an app field."; ALLOW+=("$2"); shift 2 ;;
            *) fail "apply takes --reencrypted and --allow <address | field>." ;;
        esac
    done
    if [ ! -f "$MANIFEST" ] && [ ! -f "$TFVARS.rotating" ] && [ ! -f "$WEBHOOK_FILE" ]; then
        echo "Nothing is pending."
        return 0
    fi
    # From here on the live store can differ from production, so discard refuses.
    if [ -f "$MANIFEST" ] && ! manifest_has started apply; then manifest_add started apply; fi
    while IFS= read -r flag; do REPLACE+=("$flag"); done < <(manifest_list replace)
    while IFS= read -r flag; do REVOKE+=("$flag"); done < <(manifest_list revoke)
    while IFS= read -r name; do rotated_env_add "$name"; done < <(manifest_list secret)
    if [ -f "$TFVARS.rotating" ] || manifest_has flag encryption_key; then rotated_env_add app_encryption_key app_encryption_key_previous; fi
    [ ${#REPLACE[@]} -eq 0 ] || rotated_env_add export_storage_key export_storage_secret

    if [ -f "$WEBHOOK_FILE" ]; then
        # The values moved to the live store before the switch began, so this apply carries them.
        webhook_resume
        if [ -f "$MANIFEST" ]; then manifest_add done batch; manifest_add done webhook; fi
    fi
    if [ -f "$TFVARS.rotating" ] || { manifest_has flag encryption_key && ! manifest_has done encryption_key; }; then
        step_encryption_key
        [ ! -f "$MANIFEST" ] || manifest_add done encryption_key
    fi

    if [ -f "$MANIFEST" ] && ! manifest_has done batch; then
        while IFS= read -r name; do
            [ "$name" != app_encryption_key ] || continue
            value=$(pending_value "$name"; echo x)
            pairs+=("$name" "${value%x}")
        done < <(manifest_list secret)
        if [ ${#pairs[@]} -gt 0 ] || [ ${#REPLACE[@]} -gt 0 ]; then
            if [ ${#pairs[@]} -gt 0 ]; then tfvars_write "${pairs[@]}"; fi
            pairs=()
            if manifest_has flag webhook && ! manifest_has done webhook; then
                WEBHOOK_RUN=1
                webhook_begin
            fi
            apply "every new value" ${REPLACE[@]+"${REPLACE[@]}"}
            manifest_add done batch
            if manifest_has flag app_secret; then
                echo "app_secret: signed-in sessions outlive the new value. End them on production:"
                echo "    bin/console dbal:run-sql 'DELETE FROM sessions'"
            fi
            if [ "$WEBHOOK_RUN" = 1 ]; then
                # The apply changed the credentials, so a webhook failure must still list the old ones.
                trap 'print_revoke' EXIT
                webhook_after_apply
                trap - EXIT
                manifest_add done webhook
            fi
        fi
    fi

    print_revoke
    pending_drop
}

discard_main() {
    if manifest_has started apply; then
        fail "apply has started, so the live store can hold values that production lacks. Run 'bin/rotate-secrets apply' to finish the rotation."
    fi
    pending_drop
    echo "The pending values are gone. Production and the live store are unchanged."
    [ ! -f "$TFVARS.rotating" ] || echo "An encryption key rotation is still in progress. Run 'bin/rotate-secrets apply' to finish it."
}

main() {
    local mode=collect
    case ${1:-} in
        collect) shift ;;
        apply) mode=apply; shift ;;
        discard) mode=discard; shift ;;
    esac
    [ -f "$TFVARS" ] || fail "$TFVARS does not exist."
    case $mode in
        collect) collect_main "$@" ;;
        apply) apply_main "$@" ;;
        discard) discard_main ;;
    esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
