#!/usr/bin/env bash
#
# Rotates secrets in terraform/terraform.tfvars, then applies them.
#
# Today it knows one secret, app_encryption_key. It follows
# docs/operating/rotating-encryption-key.md. The script never prints a secret
# value, not even on an error.
#
# Environment, for tests: ROTATE_TFVARS is the file to edit, and ROTATE_APPLY is
# the command that applies it (default: just tf-apply).

set -euo pipefail

cd "$(dirname "$0")/.."

TFVARS=${ROTATE_TFVARS:-terraform/terraform.tfvars}
APPLY=${ROTATE_APPLY:-just tf-apply}
KNOWN=(app_encryption_key)

fail() { echo "rotate-secrets: $*" >&2; exit 1; }

# The live value of a variable, or nothing. Only ever captured, never printed.
value_of() {
    awk -v name="$1" '
        $0 ~ "^[ \t]*" name "[ \t]*=" {
            v = $0; sub(/^[^=]*=[ \t]*/, "", v); gsub(/^"|"[ \t]*$/, "", v); print v; exit
        }' "$TFVARS"
}

# Replaces the live assignment, or appends one. The value goes through the
# environment so it never appears in a process list.
set_value() {
    local name=$1 value=$2 tmp
    tmp=$(mktemp)
    NAME=$name VALUE=$value awk '
        BEGIN { name = ENVIRON["NAME"]; value = ENVIRON["VALUE"]; done = 0 }
        $0 ~ "^[ \t]*" name "[ \t]*=" { if (!done) { print name " = \"" value "\""; done = 1 } ; next }
        { print }
        END { if (!done) print name " = \"" value "\"" }
    ' "$TFVARS" > "$tmp"
    cat "$tmp" > "$TFVARS"
    rm -f "$tmp"
}

apply() {
    echo "-- applying: $1 (terraform masks sensitive values, and asks you to confirm)"
    # shellcheck disable=SC2086
    $APPLY || fail "the apply failed. Run 'just tf-plan' to read the cause."
}

rotate_app_encryption_key() {
    local old new
    old=$(value_of app_encryption_key)
    [ -n "$old" ] || fail "app_encryption_key is not set in $TFVARS."
    new=$(openssl rand -base64 32)

    echo "app_encryption_key: deploy 1 of 3. Every container learns the new key."
    set_value app_encryption_key_previous "$new"
    apply "the new key as the previous key"

    echo "app_encryption_key: deploy 2 of 3. The new key encrypts, the old key still decrypts."
    set_value app_encryption_key "$new"
    set_value app_encryption_key_previous "$old"
    apply "the new key as the current key"

    echo
    echo "Run this on production, then read the table it prints:"
    echo "    bin/console doctrine-extra:reencrypt"
    echo "Every 'unreadable' count must be 0. If one is not, answer no and read the runbook."
    read -r -p "Is every unreadable count 0? Type yes to remove the old key: " answer
    [ "$answer" = "yes" ] || fail "stopped. The old key stays in app_encryption_key_previous."

    echo "app_encryption_key: deploy 3 of 3. The old key leaves the environment."
    set_value app_encryption_key_previous ""
    apply "no previous key"

    REVOKE+=("The old APP_ENCRYPTION_KEY. Delete every copy of it, and the database dumps made before this rotation.")
}

names=("$@")
[ ${#names[@]} -gt 0 ] || names=("${KNOWN[@]}")
[ -f "$TFVARS" ] || fail "$TFVARS does not exist."

REVOKE=()
for name in "${names[@]}"; do
    case "$name" in
        app_encryption_key) rotate_app_encryption_key ;;
        *) fail "unknown secret '$name'. Known: ${KNOWN[*]}" ;;
    esac
done

echo
echo "Revoke by hand:"
for item in "${REVOKE[@]}"; do echo "  - $item"; done
