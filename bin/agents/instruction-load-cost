#!/usr/bin/env bash
# Ranks the agent instruction files of this repository by load cost over recent Claude Code sessions.
#
# Usage:
#   bin/agents/instruction-load-cost [--days <n>] [--with <skill>]
#
# Reads the *.jsonl transcripts under ~/.claude/projects and ~/.claude-worker/projects
# whose project directory is this repository, one of its .worktrees or a bridge card worktree,
# modified in the last n days (default 30).
# Loads: each Skill tool call counts once by its tool-use id. AGENTS.md loads once per top-level session.
# Words: the current "wc -w" of AGENTS.md and of <name>/SKILL.md under .agents/skills, plugins/loupe/skills or plugins/loupe-lifecycle/skills. Cost: loads x words.
# --with <skill>: per skill, the top-level sessions that load it and those that also load <skill>.
# Prints counts and skill names only, never transcript content.
# Requires: git, find, grep, awk, wc

set -euo pipefail

DAYS=30
WITH=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --days) DAYS="${2:?--days needs a number}"; shift 2 ;;
    --with) WITH="${2:?--with needs a skill name}"; shift 2 ;;
    *) echo "Usage: $(basename "$0") [--days <n>] [--with <skill>]" >&2; exit 1 ;;
  esac
done
[[ "$DAYS" =~ ^[0-9]+$ ]] || { echo "--days must be a whole number" >&2; exit 1; }

# The main checkout, also from inside a worktree, because transcripts of every worktree count.
MAIN=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
SLUG=$(printf '%s' "$MAIN" | sed 's/[^A-Za-z0-9]/-/g')
REPO=$(basename "$MAIN" | sed 's/[^A-Za-z0-9]/-/g')

DIRS=()
for root in "$HOME/.claude/projects" "$HOME/.claude-worker/projects"; do
  for dir in "$root/$SLUG" "$root/$SLUG"--worktrees-* "$root"/*-loupe-worktrees-"$REPO"-card-*; do
    [[ -d "$dir" ]] && DIRS+=("$dir")
  done
done
[[ ${#DIRS[@]} -gt 0 ]] || { echo "No transcripts found for $SLUG" >&2; exit 1; }

SKILL_DIRS=(.agents/skills plugins/loupe/skills plugins/loupe-lifecycle/skills)

FILES=$(mktemp)
HITS=$(mktemp)
ALIASES=$(mktemp)
trap 'rm -f "$FILES" "$HITS" "$ALIASES"' EXIT

# "<name>\t<folder>" for each skill whose frontmatter name differs from its folder, such as product-design.
for d in "${SKILL_DIRS[@]}"; do
  for f in "$MAIN/$d"/*/SKILL.md; do
    [[ -f "$f" ]] || continue
    name=$(awk '/^name:/ { gsub(/["\047]/, "", $2); print $2; exit }' "$f")
    folder=$(basename "$(dirname "$f")")
    if [[ -n "$name" && "$name" != "$folder" ]]; then printf '%s\t%s\n' "$name" "$folder" >>"$ALIASES"; fi
  done
done

find "${DIRS[@]}" -type f -name '*.jsonl' -mtime "-$DAYS" -print0 >"$FILES"
LC_ALL=C xargs -0 grep -oHE '"type":"tool_use","id":"[^"]+","name":"Skill","input":\{"skill":"[^"]+"' <"$FILES" >"$HITS" || true

SESSIONS=$(tr '\0' '\n' <"$FILES" | grep -vc '/subagents/' || true)

# Maps a recorded skill name to its folder name: a plugin prefix such as loupe-lifecycle: is stripped,
# and a frontmatter name such as product-design maps to its folder. Load the alias file as ARGV[1] first.
NORMALIZE='
  FILENAME == ARGV[1] { split($0, a, "\t"); folder[a[1]] = a[2]; next }
  function folder_of(skill) {
    sub(/^[^:]*\/[^:]*:/, "", skill); sub(/^[A-Za-z0-9_.-]+:/, "", skill)
    return (skill in folder) ? folder[skill] : skill
  }'

# Emits "<path>\t<id>\t<skill>" once per tool-use id, with the skill as its folder name.
calls() {
  awk "$NORMALIZE"'
  {
    at = index($0, ":\"type\":\"tool_use\"")
    path = substr($0, 1, at - 1)
    split(substr($0, at), f, "\"")
    id = f[8]; skill = folder_of(f[18])
    if (!(id in seen)) { seen[id] = 1; print path "\t" id "\t" skill }
  }' "$ALIASES" "$HITS"
}

words() { [[ -f "$1" ]] && wc -w <"$1" | tr -d ' ' || echo ""; }

skill_words() {
  local d w
  for d in "${SKILL_DIRS[@]}"; do
    w=$(words "$MAIN/$d/$1/SKILL.md")
    if [[ -n "$w" ]]; then echo "$w"; return; fi
  done
  echo ""
}

echo "Window: last $DAYS days. Top-level sessions: $SESSIONS."
echo

{
  printf 'AGENTS.md\t%s\t%s\n' "$SESSIONS" "$(words "$MAIN/AGENTS.md")"
  calls | cut -f3 | sort | uniq -c | while read -r n skill; do
    printf '%s\t%s\t%s\n' "$skill" "$n" "$(skill_words "$skill")"
  done
} | awk -F'\t' '
  $3 == "" { missing = missing sprintf("%s%s (%d)", missing == "" ? "" : ", ", $1, $2); next }
  { name[++n] = $1; loads[n] = $2; words[n] = $3; cost[n] = $2 * $3; total += cost[n] }
  END {
    for (i = 1; i <= n; i++) for (j = i + 1; j <= n; j++) if (cost[j] > cost[i]) {
      t = name[i]; name[i] = name[j]; name[j] = t
      t = loads[i]; loads[i] = loads[j]; loads[j] = t
      t = words[i]; words[i] = words[j]; words[j] = t
      t = cost[i]; cost[i] = cost[j]; cost[j] = t
    }
    printf "%-36s %7s %7s %11s %7s\n", "file", "loads", "words", "load cost", "share"
    for (i = 1; i <= n; i++) {
      printf "%-36s %7d %7d %11d %6.1f%%\n", name[i], loads[i], words[i], cost[i], total ? 100 * cost[i] / total : 0
      if (i <= 7) top += cost[i]
    }
    printf "\nTotal load cost: %d words. Top 7 share: %.1f%%.\n", total, total ? 100 * top / total : 0
    if (missing != "") printf "Not in a skills folder (loads): %s\n", missing
  }'

if [[ -n "$WITH" ]]; then
  WITH=$(printf '%s\n' "$WITH" | awk "$NORMALIZE"' { print folder_of($0) }' "$ALIASES" -)
  echo
  echo "Top-level sessions per skill, and those that also load $WITH:"
  calls | grep -v '/subagents/' | awk -F'\t' -v with="$WITH" '
    { has[$1 SUBSEP $3] = 1; skills[$3] = 1; sessions[$1] = 1 }
    END {
      for (s in sessions) if ((s SUBSEP with) in has) both++
      printf "%-36s %8s %8s\n", "skill", "sessions", "with"
      cmd = "sort -k2,2nr -k1,1"
      for (k in skills) {
        if (k == with) continue
        a = 0; b = 0
        for (s in sessions) if ((s SUBSEP k) in has) { a++; if ((s SUBSEP with) in has) b++ }
        printf "%-36s %8d %8d\n", k, a, b | cmd
      }
      close(cmd)
      printf "Sessions that load %s: %d\n", with, both + 0
    }'
fi
