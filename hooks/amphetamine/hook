#!/bin/sh
set -u

quiet="${LOUPE_HOOK_SETTING_QUIET_HOURS-23:00-06:00}"
# bridge holds the last busy or idle the hook got, so tick knows it.
bridge="${LOUPE_HOOK_STATE_DIR:-.}/bridge"

amph() {
    osascript -e "tell application \"Amphetamine\" to $1"
}

# minutes HH:MM prints the minute of the day, or fails on a bad time.
minutes() {
    case $1 in
        [01][0-9]:[0-5][0-9] | 2[0-3]:[0-5][0-9]) ;;
        *) return 1 ;;
    esac
    h=${1%%:*} m=${1#*:}
    echo $((${h#0} * 60 + ${m#0}))
}

if [ -n "$quiet" ]; then
    case $quiet in
        ??:??-??:??) ;;
        *) quiet="bad $quiet" ;;
    esac
    from=$(minutes "${quiet%-*}") && to=$(minutes "${quiet#*-}") || {
        echo "quiet_hours must be HH:MM-HH:MM, not ${quiet#bad }" >&2
        exit 5
    }
fi

stamp=$(date '+%H:%M %s') || exit $?
epoch=${stamp#* }
now=$(minutes "${stamp% *}") || exit $?

# offset T prints the UTC offset in minutes at Unix time T.
offset() {
    z=$(date -r "$1" +%z) || exit $?
    h=${z#?} m=${z#???}
    h=${h%??}
    mins=$((${h#0} * 60 + ${m#0}))
    case $z in -*) echo $((-mins)) ;; *) echo "$mins" ;; esac
}

in_quiet_hours() {
    [ -n "$quiet" ] || return 1
    if [ "$from" -le "$to" ]; then
        [ "$now" -ge "$from" ] && [ "$now" -lt "$to" ]
    else
        [ "$now" -ge "$from" ] || [ "$now" -lt "$to" ]
    fi
}

# closed_display switches on closed-display mode, so a closed lid keeps the Mac
# awake, and fails when it stays off.
closed_display() {
    amph 'enable closed display mode' >/dev/null || exit $?
    closed=$(amph 'closed display mode enabled') || exit $?
    if [ "$closed" != true ]; then
        echo 'closed-display mode is off' >&2
        exit 3
    fi
}

# The bridge has no work. In quiet hours the session ends. Otherwise the Mac
# stays awake in a timed session that ends when quiet hours start. With keep,
# an active session stays as it is.
release() {
    active=$(amph 'session is active') || exit $?
    if [ -z "$quiet" ] || in_quiet_hours; then
        [ "$active" = true ] || return 0
        amph 'end session' >/dev/null || exit $?
        return 0
    fi
    [ "${1:-}" = keep ] && [ "$active" = true ] && return 0
    # Count by the clock, then correct for a change of UTC offset on the way.
    minute=$((epoch - epoch % 60))
    at=$((minute + (from - now + 1440) % 1440 * 60))
    before=$(offset "$minute") && after=$(offset "$at") || exit $?
    if [ "$before" != "$after" ]; then
        moved=$((at + (before - after) * 60))
        shifted=$(offset "$moved") || exit $?
        if [ "$shifted" = "$after" ]; then
            at=$moved
        else
            # The start is in the skipped hour, so quiet hours start at the change.
            low=$moved
            while [ $((at - low)) -gt 60 ]; do
                mid=$((low + (at - low) / 120 * 60))
                if [ "$(offset "$mid")" = "$after" ]; then at=$mid; else low=$mid; fi
            done
        fi
    fi
    # A start that passed today can come again when the clock falls back.
    back=$((before - $(offset $((minute + 7200)))))
    if [ "$back" -gt 0 ]; then
        again=$((minute + ((from - now + 1440) % 1440 - 1440 + back) * 60))
        if [ "$again" -gt "$minute" ] && [ "$again" -lt "$at" ] &&
            [ "$(date -r "$again" +%H:%M)" = "${quiet%-*}" ]; then
            at=$again
        fi
    fi
    left=$(((at - epoch) / 60))
    [ "$left" -gt 0 ] || left=1
    amph "start new session with options {duration:$left, interval:minutes, displaySleepAllowed:false}" >/dev/null || exit $?
    closed_display
}

# The bridge has work. The Mac stays awake with no end, at any hour. With keep,
# an active session stays as it is.
hold() {
    if [ "${1:-}" = keep ]; then
        active=$(amph 'session is active') || exit $?
        [ "$active" = true ] && return 0
    fi
    amph 'start new session with options {duration:0, interval:0, displaySleepAllowed:false}' >/dev/null || exit $?
    closed_display
}

end_session() {
    active=$(amph 'session is active') || exit $?
    [ "$active" = true ] || return 0
    amph 'end session' >/dev/null || exit $?
}

case "${1:-}" in
    busy)
        echo busy >"$bridge" || exit $?
        hold
        ;;
    idle | start)
        echo idle >"$bridge" || exit $?
        release
        ;;
    tick)
        if [ "$(cat "$bridge" 2>/dev/null)" = busy ]; then hold keep; else release keep; fi
        ;;
    stop)
        echo idle >"$bridge" || exit $?
        end_session
        ;;
    *)
        echo "unknown event: ${1:-}" >&2
        exit 2
        ;;
esac
