# The Terraform inputs that are secrets. bin/tf-secrets keeps their values in
# the secret store and passes them to Terraform as environment variables.
# Field 1 is the Terraform input name. Field 2 is the environment name; with
# no field 2 it is TF_VAR_<field 1>. Names only, never a value.
do_token DIGITALOCEAN_TOKEN
spaces_secret_key SPACES_SECRET_ACCESS_KEY
registry_credentials
app_secret
app_encryption_key
app_encryption_key_previous
mailer_dsn
site_review_widget_preview_token
health_probe_token
install_token
export_storage_key
export_storage_secret
mercure_jwt_secret
stripe_secret_key
stripe_webhook_secret
github_app_client_secret
github_app_webhook_secret
github_app_private_key
oauth_google_secret
oauth_github_secret
oauth_private_key
oauth_private_key_passphrase
oauth_encryption_key
vapid_private_key
