---
import Default from '@astrojs/starlight/components/PageFrame.astro';
import { FOOTER_MARKER } from '../chrome-markers.mjs';
---

<Default>
  <slot name="header" slot="header" />
  <slot name="sidebar" slot="sidebar" />
  <slot />
</Default>
<div class="site-footer-wrap">
  <site-chrome part-name="footer">
    <template shadowrootmode="open"><Fragment set:html={FOOTER_MARKER} /></template>
  </site-chrome>
</div>
