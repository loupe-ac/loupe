#!/bin/sh
self='bin'
real=
oldifs=$IFS
IFS=:
for d in $PATH; do
  [ -n "$d" ] && [ "$d" != "$self" ] && [ -f "$d/gh" ] && [ -x "$d/gh" ] && { real="$d/gh"; break; }
done
IFS=$oldifs
if [ -z "$real" ]; then
  echo "loupe: gh is not on the PATH" >&2
  exit 127
fi
TOKEN=$('/installed/loupe' credential) || {
  echo "loupe: no GitHub token for gh, so gh does not run" >&2
  exit 1
}
GH_TOKEN="$TOKEN" exec "$real" "$@"
